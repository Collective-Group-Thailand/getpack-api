  factoryId      BigInt           @map("factory_id")
  customerId     BigInt           @map("customer_id")
  billingNo      String           @map("billing_no")
  status         ErpBillingStatus @default(issued)
  billingDate    DateTime         @map("billing_date") @db.Date
  collectOn      DateTime?        @map("collect_on") @db.Date
  total          Decimal          @db.Decimal(14, 2)
  note           String?
  buyerSnapshot  Json?            @map("buyer_snapshot")
  sellerSnapshot Json?            @map("seller_snapshot")
  cancelledAt    DateTime?        @map("cancelled_at") @db.Timestamptz(6)
  cancelReason   String?          @map("cancel_reason")
  pdfFileId      BigInt?          @map("pdf_file_id")
  pdfVersion     Int?             @map("pdf_version")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById    BigInt           @map("created_by")

  factory   Factory                 @relation("ErpBillingNoteFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_billing_notes__factory_id")
  createdBy User                    @relation("ErpBillingNoteCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_billing_notes__created_by")
  customer  ErpTradingPartner       @relation("ErpBillingNoteCustomer", fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_billing_notes__customer_id")
  pdfFile   FileObject?             @relation("ErpBillingNotePdf", fields: [pdfFileId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_billing_notes__pdf_file_id")
  lines     ErpBillingNoteInvoice[] @relation("ErpBillingNoteInvoices")

  @@unique([factoryId, billingNo], map: "ux_erp_billing_notes__factory_id__billing_no")
  @@index([factoryId, billingDate(sort: Desc)], map: "ix_erp_billing_notes__factory_id__billing_date")
  @@index([customerId], map: "ix_erp_billing_notes__customer_id")
  @@index([pdfFileId], map: "ix_erp_billing_notes__pdf_file_id")
  @@index([createdById], map: "ix_erp_billing_notes__created_by_id")
  @@map("erp_billing_notes")
}

model ErpBillingNoteInvoice {
