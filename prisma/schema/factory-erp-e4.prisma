// getpack Factory ERP E4 (D-359 – D-371): CRM, quotations, sales orders, delivery notes, the factory’s own
// invoices / tax invoices, credit and debit notes, receipts, billing notes, 50 ทวิ certificates and sales targets.

enum ErpLeadSource {
  walk_in
  phone
  line
  facebook
  website
  referral
  exhibition
  getpack
  other

  @@map("erp_lead_source")
}

enum ErpLeadStage {
  new
  contacted
  qualified
  converted
  lost

  @@map("erp_lead_stage")
}

enum ErpOpportunityStage {
  prospecting
  proposal
  negotiation
  won
  lost

  @@map("erp_opportunity_stage")
}

enum ErpActivityKind {
  call
  visit
  meeting
  email
  line
  task
  note

  @@map("erp_activity_kind")
}

enum ErpQuotationStatus {
  draft
  sent
  accepted
  rejected
  expired
  superseded
  cancelled

  @@map("erp_quotation_status")
}

enum ErpSalesOrderStatus {
  draft
  confirmed
  partially_delivered
  delivered
  closed
  cancelled

  @@map("erp_sales_order_status")
}

enum ErpFulfilment {
  stock
  make
  service

  @@map("erp_fulfilment")
}

enum ErpDeliveryStatus {
  draft
  issued
  delivered
  cancelled

  @@map("erp_delivery_status")
}

enum ErpInvoiceForm {
  invoice
  invoice_receipt

  @@map("erp_invoice_form")
}

enum ErpSalesInvoiceStatus {
  draft
  issued
  partially_paid
  paid
  voided

  @@map("erp_sales_invoice_status")
}

enum ErpSalesNoteKind {
  credit
  debit

  @@map("erp_sales_note_kind")
}

enum ErpSalesNoteReason {
  price_reduced
  goods_returned
  defective
  discount_after_sale
  overcharged
  price_increased
  undercharged
  extra_goods
  other

  @@map("erp_sales_note_reason")
}

enum ErpIssuedStatus {
  draft
  issued
  voided

  @@map("erp_issued_status")
}

enum ErpReceiptKind {
  receipt
  refund

  @@map("erp_receipt_kind")
}

enum ErpReceiptStatus {
  issued
  cancelled

  @@map("erp_receipt_status")
}

enum ErpBillingStatus {
  issued
  cancelled

  @@map("erp_billing_status")
}

enum ErpEntityType {
  juristic
  individual

  @@map("erp_entity_type")
}

enum ErpWhtForm {
  pnd3
  pnd53

  @@map("erp_wht_form")
}

enum ErpWhtIncomeType {
  fees_commission
  rent
  hire_of_work
  transport
  advertising
  service
  prize
  other

  @@map("erp_wht_income_type")
}

/// D-359: a prospect not yet a customer.
model ErpLead {
  id            BigInt        @id(map: "pk_erp_leads") @default(autoincrement())
  publicId      String        @unique(map: "ux_erp_leads__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  factoryId     BigInt        @map("factory_id")
  salespersonId BigInt?       @map("salesperson_id")
  customerId    BigInt?       @map("customer_id")
  name          String
  contactName   String?       @map("contact_name")
  phone         String?
  email         String?
  lineId        String?       @map("line_id")
  address       String?
  source        ErpLeadSource @default(other)
  stage         ErpLeadStage  @default(new)
  expectedValue Decimal?      @map("expected_value") @db.Decimal(14, 2)
  lostReason    String?       @map("lost_reason")
  note          String?
  convertedAt   DateTime?     @map("converted_at") @db.Timestamptz(6)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById   BigInt        @map("created_by")
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById   BigInt?       @map("updated_by")
  rowVersion    Int           @default(1) @map("row_version")

  factory       Factory            @relation("ErpLeadFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_leads__factory_id")
  createdBy     User               @relation("ErpLeadCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_leads__created_by")
  updatedBy     User?              @relation("ErpLeadUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_leads__updated_by")
  salesperson   User?              @relation("ErpLeadSalesperson", fields: [salespersonId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_leads__salesperson_id")
  customer      ErpTradingPartner? @relation("ErpLeadCustomer", fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_leads__customer_id")
  opportunities ErpOpportunity[]   @relation("ErpOpportunityLead")
  activities    ErpActivity[]      @relation("ErpActivityLead")

  @@index([factoryId, stage, createdAt(sort: Desc)], map: "ix_erp_leads__factory_id__stage__created_at")
  @@index([salespersonId], map: "ix_erp_leads__salesperson_id")
  @@index([customerId], map: "ix_erp_leads__customer_id")
  @@index([createdById], map: "ix_erp_leads__created_by_id")
  @@index([updatedById], map: "ix_erp_leads__updated_by_id")
  @@map("erp_leads")
}

/// D-359: a deal for a customer (or a lead), by stage.
model ErpOpportunity {
  id              BigInt              @id(map: "pk_erp_opportunities") @default(autoincrement())
  publicId        String              @unique(map: "ux_erp_opportunities__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  factoryId       BigInt              @map("factory_id")
  customerId      BigInt?             @map("customer_id")
  leadId          BigInt?             @map("lead_id")
  salespersonId   BigInt?             @map("salesperson_id")
  title           String
  stage           ErpOpportunityStage @default(prospecting)
  value           Decimal             @default(0) @db.Decimal(14, 2)
  probabilityPct  Int                 @default(10) @map("probability_pct")
  expectedCloseOn DateTime?           @map("expected_close_on") @db.Date
  lostReason      String?             @map("lost_reason")
  note            String?
  wonAt           DateTime?           @map("won_at") @db.Timestamptz(6)
  closedAt        DateTime?           @map("closed_at") @db.Timestamptz(6)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById     BigInt              @map("created_by")
  updatedAt       DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById     BigInt?             @map("updated_by")
  rowVersion      Int                 @default(1) @map("row_version")

  factory     Factory            @relation("ErpOpportunityFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_opportunities__factory_id")
  createdBy   User               @relation("ErpOpportunityCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_opportunities__created_by")
  updatedBy   User?              @relation("ErpOpportunityUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_opportunities__updated_by")
  customer    ErpTradingPartner? @relation("ErpOpportunityCustomer", fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_opportunities__customer_id")
  lead        ErpLead?           @relation("ErpOpportunityLead", fields: [leadId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_opportunities__lead_id")
  salesperson User?              @relation("ErpOpportunitySalesperson", fields: [salespersonId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_opportunities__salesperson_id")
  activities  ErpActivity[]      @relation("ErpActivityOpportunity")
  quotations  ErpQuotation[]     @relation("ErpQuotationOpportunity")
  salesOrders ErpSalesOrder[]    @relation("ErpSalesOrderOpportunity")

  @@index([factoryId, stage, expectedCloseOn], map: "ix_erp_opportunities__factory_id__stage__expected_close_on")
  @@index([customerId], map: "ix_erp_opportunities__customer_id")
  @@index([leadId], map: "ix_erp_opportunities__lead_id")
  @@index([salespersonId], map: "ix_erp_opportunities__salesperson_id")
  @@index([createdById], map: "ix_erp_opportunities__created_by_id")
  @@index([updatedById], map: "ix_erp_opportunities__updated_by_id")
  @@map("erp_opportunities")
}

/// D-359: a call, visit, task or note about a lead, an opportunity or a customer.
model ErpActivity {
  id            BigInt          @id(map: "pk_erp_activities") @default(autoincrement())
  publicId      String          @unique(map: "ux_erp_activities__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  factoryId     BigInt          @map("factory_id")
  leadId        BigInt?         @map("lead_id")
  opportunityId BigInt?         @map("opportunity_id")
  customerId    BigInt?         @map("customer_id")
  assigneeId    BigInt          @map("assignee_id")
  kind          ErpActivityKind
  subject       String
  detail        String?
  dueAt         DateTime?       @map("due_at") @db.Timestamptz(6)
  doneAt        DateTime?       @map("done_at") @db.Timestamptz(6)
  outcome       String?
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById   BigInt          @map("created_by")
  updatedAt     DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById   BigInt?         @map("updated_by")
  rowVersion    Int             @default(1) @map("row_version")

  factory     Factory            @relation("ErpActivityFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_activities__factory_id")
  createdBy   User               @relation("ErpActivityCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_activities__created_by")
  updatedBy   User?              @relation("ErpActivityUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_activities__updated_by")
  lead        ErpLead?           @relation("ErpActivityLead", fields: [leadId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_activities__lead_id")
  opportunity ErpOpportunity?    @relation("ErpActivityOpportunity", fields: [opportunityId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_activities__opportunity_id")
  customer    ErpTradingPartner? @relation("ErpActivityCustomer", fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_activities__customer_id")
  assignee    User               @relation("ErpActivityAssignee", fields: [assigneeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_activities__assignee_id")

  @@index([factoryId, assigneeId, doneAt, dueAt], map: "ix_erp_activities__factory_id__assignee_id__done_at__due_at")
  @@index([leadId], map: "ix_erp_activities__lead_id")
  @@index([opportunityId], map: "ix_erp_activities__opportunity_id")
  @@index([customerId], map: "ix_erp_activities__customer_id")
  @@index([assigneeId], map: "ix_erp_activities__assignee_id")
  @@index([createdById], map: "ix_erp_activities__created_by_id")
  @@index([updatedById], map: "ix_erp_activities__updated_by_id")
  @@map("erp_activities")
}

/// D-360: a quotation; a revision keeps the number with the next revision.
model ErpQuotation {
  id               BigInt             @id(map: "pk_erp_quotations") @default(autoincrement())
  publicId         String             @unique(map: "ux_erp_quotations__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  factoryId        BigInt             @map("factory_id")
  customerId       BigInt             @map("customer_id")
  opportunityId    BigInt?            @map("opportunity_id")
  salespersonId    BigInt?            @map("salesperson_id")
  previousId       BigInt?            @map("previous_id")
  quoteNo          String             @map("quote_no")
  revision         Int                @default(1)
  status           ErpQuotationStatus @default(draft)
  quoteDate        DateTime           @map("quote_date") @db.Date
  validUntil       DateTime           @map("valid_until") @db.Date
  paymentTermDays  Int                @default(0) @map("payment_term_days")
  leadTimeDays     Int?               @map("lead_time_days")
  terms            String?
  note             String?
  vatMode          ErpVatMode         @default(exclusive) @map("vat_mode")
  vatRatePct       Decimal            @default(7) @map("vat_rate_pct") @db.Decimal(7, 4)
  subtotal         Decimal            @default(0) @db.Decimal(14, 2)
  vatAmount        Decimal            @default(0) @map("vat_amount") @db.Decimal(14, 2)
  total            Decimal            @default(0) @db.Decimal(14, 2)
  buyerSnapshot    Json?              @map("buyer_snapshot")
  sentAt           DateTime?          @map("sent_at") @db.Timestamptz(6)
  linkTokenHash    Bytes?             @map("link_token_hash")
  linkExpiresAt    DateTime?          @map("link_expires_at") @db.Timestamptz(6)
  acceptedAt       DateTime?          @map("accepted_at") @db.Timestamptz(6)
  acceptedName     String?            @map("accepted_name")
  acceptedPosition String?            @map("accepted_position")
  acceptedVia      String?            @map("accepted_via")
  customerPoNo     String?            @map("customer_po_no")
  rejectedAt       DateTime?          @map("rejected_at") @db.Timestamptz(6)
  rejectReason     String?            @map("reject_reason")
  cancelReason     String?            @map("cancel_reason")
  pdfFileId        BigInt?            @map("pdf_file_id")
  pdfVersion       Int?               @map("pdf_version")
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById      BigInt             @map("created_by")
  updatedAt        DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById      BigInt?            @map("updated_by")
  rowVersion       Int                @default(1) @map("row_version")

  factory       Factory            @relation("ErpQuotationFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_quotations__factory_id")
  createdBy     User               @relation("ErpQuotationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_quotations__created_by")
  updatedBy     User?              @relation("ErpQuotationUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_quotations__updated_by")
  customer      ErpTradingPartner  @relation("ErpQuotationCustomer", fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_quotations__customer_id")
  opportunity   ErpOpportunity?    @relation("ErpQuotationOpportunity", fields: [opportunityId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_quotations__opportunity_id")
  salesperson   User?              @relation("ErpQuotationSalesperson", fields: [salespersonId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_quotations__salesperson_id")
  previous      ErpQuotation?      @relation("ErpQuotationRevision", fields: [previousId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_quotations__previous_id")
  nextRevisions ErpQuotation[]     @relation("ErpQuotationRevision")
  pdfFile       FileObject?        @relation("ErpQuotationPdf", fields: [pdfFileId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_quotations__pdf_file_id")
  lines         ErpQuotationLine[] @relation("ErpQuotationLines")
  salesOrders   ErpSalesOrder[]    @relation("ErpSalesOrderQuotation")

  @@unique([factoryId, quoteNo, revision], map: "ux_erp_quotations__factory_id__quote_no__revision")
  @@index([factoryId, status, quoteDate(sort: Desc)], map: "ix_erp_quotations__factory_id__status__quote_date")
  @@index([customerId], map: "ix_erp_quotations__customer_id")
  @@index([opportunityId], map: "ix_erp_quotations__opportunity_id")
  @@index([salespersonId], map: "ix_erp_quotations__salesperson_id")
  @@index([previousId], map: "ix_erp_quotations__previous_id")
  @@index([pdfFileId], map: "ix_erp_quotations__pdf_file_id")
  @@index([createdById], map: "ix_erp_quotations__created_by_id")
  @@index([updatedById], map: "ix_erp_quotations__updated_by_id")
  @@map("erp_quotations")
}

model ErpQuotationLine {
  id          BigInt  @id(map: "pk_erp_quotation_lines") @default(autoincrement())
  quotationId BigInt  @map("quotation_id")
  itemId      BigInt? @map("item_id")
  lineNo      Int     @map("line_no")
  description String
  quantity    Decimal @db.Decimal(14, 3)
  unit        ErpUnit
  unitPrice   Decimal @map("unit_price") @db.Decimal(18, 6)
  discountPct Decimal @default(0) @map("discount_pct") @db.Decimal(7, 4)
  amount      Decimal @db.Decimal(14, 2)

  quotation ErpQuotation @relation("ErpQuotationLines", fields: [quotationId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_erp_quotation_lines__quotation_id")
  item      ErpItem?     @relation("ErpQuotationLineItem", fields: [itemId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_quotation_lines__item_id")

  @@unique([quotationId, lineNo], map: "ux_erp_quotation_lines__quotation_id__line_no")
  @@index([itemId], map: "ix_erp_quotation_lines__item_id")
  @@map("erp_quotation_lines")
}

/// D-361: the customer’s order, delivered from stock or made to order.
model ErpSalesOrder {
  id                   BigInt              @id(map: "pk_erp_sales_orders") @default(autoincrement())
  publicId             String              @unique(map: "ux_erp_sales_orders__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  factoryId            BigInt              @map("factory_id")
  customerId           BigInt              @map("customer_id")
  quotationId          BigInt?             @map("quotation_id")
  opportunityId        BigInt?             @map("opportunity_id")
  salespersonId        BigInt?             @map("salesperson_id")
  warehouseId          BigInt              @map("warehouse_id")
  confirmedById        BigInt?             @map("confirmed_by_id")
  soNo                 String              @map("so_no")
  status               ErpSalesOrderStatus @default(draft)
  orderDate            DateTime            @map("order_date") @db.Date
  deliveryDate         DateTime?           @map("delivery_date") @db.Date
  customerPoNo         String?             @map("customer_po_no")
  paymentTermDays      Int                 @default(0) @map("payment_term_days")
  shipToAddress        String?             @map("ship_to_address")
  note                 String?
  vatMode              ErpVatMode          @default(exclusive) @map("vat_mode")
  vatRatePct           Decimal             @default(7) @map("vat_rate_pct") @db.Decimal(7, 4)
  subtotal             Decimal             @default(0) @db.Decimal(14, 2)
  vatAmount            Decimal             @default(0) @map("vat_amount") @db.Decimal(14, 2)
  total                Decimal             @default(0) @db.Decimal(14, 2)
  confirmedAt          DateTime?           @map("confirmed_at") @db.Timestamptz(6)
  creditOverrideReason String?             @map("credit_override_reason")
  closedAt             DateTime?           @map("closed_at") @db.Timestamptz(6)
  closeReason          String?             @map("close_reason")
  cancelledAt          DateTime?           @map("cancelled_at") @db.Timestamptz(6)
  cancelReason         String?             @map("cancel_reason")
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById          BigInt              @map("created_by")
  updatedAt            DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById          BigInt?             @map("updated_by")
  rowVersion           Int                 @default(1) @map("row_version")

  factory       Factory             @relation("ErpSalesOrderFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_sales_orders__factory_id")
  createdBy     User                @relation("ErpSalesOrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_sales_orders__created_by")
  updatedBy     User?               @relation("ErpSalesOrderUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_sales_orders__updated_by")
  customer      ErpTradingPartner   @relation("ErpSalesOrderCustomer", fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_sales_orders__customer_id")
  quotation     ErpQuotation?       @relation("ErpSalesOrderQuotation", fields: [quotationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_sales_orders__quotation_id")
  opportunity   ErpOpportunity?     @relation("ErpSalesOrderOpportunity", fields: [opportunityId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_sales_orders__opportunity_id")
  salesperson   User?               @relation("ErpSalesOrderSalesperson", fields: [salespersonId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_sales_orders__salesperson_id")
  warehouse     ErpWarehouse        @relation("ErpSalesOrderWarehouse", fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_sales_orders__warehouse_id")
  confirmedBy   User?               @relation("ErpSalesOrderConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_sales_orders__confirmed_by_id")
  lines         ErpSalesOrderLine[] @relation("ErpSalesOrderLines")
  deliveryNotes ErpDeliveryNote[]   @relation("ErpDeliveryNoteSalesOrder")
  invoices      ErpSalesInvoice[]   @relation("ErpSalesInvoiceSalesOrder")

  @@unique([factoryId, soNo], map: "ux_erp_sales_orders__factory_id__so_no")
  @@index([factoryId, status, orderDate(sort: Desc)], map: "ix_erp_sales_orders__factory_id__status__order_date")
  @@index([customerId], map: "ix_erp_sales_orders__customer_id")
  @@index([quotationId], map: "ix_erp_sales_orders__quotation_id")
  @@index([opportunityId], map: "ix_erp_sales_orders__opportunity_id")
  @@index([salespersonId], map: "ix_erp_sales_orders__salesperson_id")
  @@index([warehouseId], map: "ix_erp_sales_orders__warehouse_id")
  @@index([confirmedById], map: "ix_erp_sales_orders__confirmed_by_id")
  @@index([createdById], map: "ix_erp_sales_orders__created_by_id")
  @@index([updatedById], map: "ix_erp_sales_orders__updated_by_id")
  @@map("erp_sales_orders")
}

model ErpSalesOrderLine {
  id                BigInt        @id(map: "pk_erp_sales_order_lines") @default(autoincrement())
  salesOrderId      BigInt        @map("sales_order_id")
  itemId            BigInt?       @map("item_id")
  productionOrderId BigInt?       @map("production_order_id")
  lineNo            Int           @map("line_no")
  description       String
  quantity          Decimal       @db.Decimal(14, 3)
  unit              ErpUnit
  unitPrice         Decimal       @map("unit_price") @db.Decimal(18, 6)
  discountPct       Decimal       @default(0) @map("discount_pct") @db.Decimal(7, 4)
  amount            Decimal       @db.Decimal(14, 2)
  fulfilment        ErpFulfilment @default(stock)
  reservedQty       Decimal       @default(0) @map("reserved_qty") @db.Decimal(14, 3)
  deliveredQty      Decimal       @default(0) @map("delivered_qty") @db.Decimal(14, 3)
  invoicedQty       Decimal       @default(0) @map("invoiced_qty") @db.Decimal(14, 3)

  salesOrder      ErpSalesOrder         @relation("ErpSalesOrderLines", fields: [salesOrderId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_erp_sales_order_lines__sales_order_id")
  item            ErpItem?              @relation("ErpSalesOrderLineItem", fields: [itemId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_sales_order_lines__item_id")
