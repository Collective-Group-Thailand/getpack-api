/// D-366: a 50 ทวิ certificate the factory issues for a supplier payment.
model ErpWhtCertificate {
  id            BigInt          @id(map: "pk_erp_wht_certificates") @default(autoincrement())
  publicId      String          @unique(map: "ux_erp_wht_certificates__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  factoryId     BigInt          @map("factory_id")
  paymentId     BigInt          @map("payment_id")
  supplierId    BigInt          @map("supplier_id")
  certNo        String          @map("cert_no")
  status        ErpIssuedStatus @default(issued)
  form          ErpWhtForm
  paidOn        DateTime        @map("paid_on") @db.Date
  baseAmount    Decimal         @map("base_amount") @db.Decimal(14, 2)
  whtAmount     Decimal         @map("wht_amount") @db.Decimal(14, 2)
  payerSnapshot Json            @map("payer_snapshot")
  payeeSnapshot Json            @map("payee_snapshot")
  voidedAt      DateTime?       @map("voided_at") @db.Timestamptz(6)
  voidReason    String?         @map("void_reason")
  pdfFileId     BigInt?         @map("pdf_file_id")
  pdfVersion    Int?            @map("pdf_version")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById   BigInt          @map("created_by")

  factory   Factory                 @relation("ErpWhtCertificateFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_wht_certificates__factory_id")
  createdBy User                    @relation("ErpWhtCertificateCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_wht_certificates__created_by")
  payment   ErpSupplierPayment      @relation("ErpWhtCertificatePayment", fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_wht_certificates__payment_id")
  supplier  ErpTradingPartner       @relation("ErpWhtCertificateSupplier", fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_wht_certificates__supplier_id")
  pdfFile   FileObject?             @relation("ErpWhtCertificatePdf", fields: [pdfFileId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_wht_certificates__pdf_file_id")
  lines     ErpWhtCertificateLine[] @relation("ErpWhtCertificateLines")

  @@unique([factoryId, certNo], map: "ux_erp_wht_certificates__factory_id__cert_no")
  @@index([factoryId, paidOn(sort: Desc)], map: "ix_erp_wht_certificates__factory_id__paid_on")
  @@index([paymentId], map: "ix_erp_wht_certificates__payment_id")
  @@index([supplierId], map: "ix_erp_wht_certificates__supplier_id")
  @@index([pdfFileId], map: "ix_erp_wht_certificates__pdf_file_id")
  @@index([createdById], map: "ix_erp_wht_certificates__created_by_id")
  @@map("erp_wht_certificates")
}

model ErpWhtCertificateLine {
  id            BigInt           @id(map: "pk_erp_wht_certificate_lines") @default(autoincrement())
  certificateId BigInt           @map("certificate_id")
  lineNo        Int              @map("line_no")
  incomeType    ErpWhtIncomeType @map("income_type")
  description   String?
  ratePct       Decimal          @map("rate_pct") @db.Decimal(7, 4)
  baseAmount    Decimal          @map("base_amount") @db.Decimal(14, 2)
  whtAmount     Decimal          @map("wht_amount") @db.Decimal(14, 2)

  certificate ErpWhtCertificate @relation("ErpWhtCertificateLines", fields: [certificateId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_erp_wht_certificate_lines__certificate_id")

  @@unique([certificateId, lineNo], map: "ux_erp_wht_certificate_lines__certificate_id__line_no")
  @@map("erp_wht_certificate_lines")
}

/// D-369: a salesperson’s monthly target and commission rate.
model ErpSalesTarget {
  id            BigInt   @id(map: "pk_erp_sales_targets") @default(autoincrement())
  publicId      String   @unique(map: "ux_erp_sales_targets__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  factoryId     BigInt   @map("factory_id")
  salespersonId BigInt   @map("salesperson_id")
  month         DateTime @db.Date
  targetNet     Decimal  @map("target_net") @db.Decimal(14, 2)
  commissionPct Decimal  @default(0) @map("commission_pct") @db.Decimal(7, 4)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById   BigInt   @map("created_by")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById   BigInt?  @map("updated_by")
  rowVersion    Int      @default(1) @map("row_version")

  factory     Factory @relation("ErpSalesTargetFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_sales_targets__factory_id")
  createdBy   User    @relation("ErpSalesTargetCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_sales_targets__created_by")
  updatedBy   User?   @relation("ErpSalesTargetUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_sales_targets__updated_by")
  salesperson User    @relation("ErpSalesTargetSalesperson", fields: [salespersonId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_sales_targets__salesperson_id")

  @@unique([factoryId, salespersonId, month], map: "ux_erp_sales_targets__factory_id__salesperson_id__month")
  @@index([salespersonId], map: "ix_erp_sales_targets__salesperson_id")
  @@index([createdById], map: "ix_erp_sales_targets__created_by_id")
  @@index([updatedById], map: "ix_erp_sales_targets__updated_by_id")
  @@map("erp_sales_targets")
}
