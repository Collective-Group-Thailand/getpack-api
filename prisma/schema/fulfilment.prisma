/// Drawing log: one request to the dieline engine (`@packio/dieline`).
model DrawingJob {
  id               BigInt           @id(map: "pk_drawing_jobs") @default(autoincrement())
  publicId         String           @unique(map: "ux_drawing_jobs__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  requestedById    BigInt?          @map("requested_by")
  orderId          BigInt?          @map("order_id")
  designDocumentId BigInt?          @map("design_document_id")
  patternId        BigInt           @map("pattern_id")
  lengthMm         Decimal          @map("length_mm") @db.Decimal(10, 2)
  widthMm          Decimal          @map("width_mm") @db.Decimal(10, 2)
  heightMm         Decimal          @map("height_mm") @db.Decimal(10, 2)
  /// D-182: the basis of the sizes (existing rows: internal, A-80).
  measurementBasis MeasurementBasis @default(internal) @map("measurement_basis")
  format           DrawingFormat
  engineVersion    String?          @map("engine_version")
  status           DrawingStatus    @default(queued)
  outputFileId     BigInt?          @map("output_file_id")
  error            String?
  attempts         Int              @default(0) @db.SmallInt
  lockedUntil      DateTime?        @map("locked_until") @db.Timestamptz(6)
  completedAt      DateTime?        @map("completed_at") @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  requestedBy       User?             @relation("DrawingJobRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_drawing_jobs__requested_by")
  order             Order?            @relation("DrawingJobOrder", fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_drawing_jobs__order_id")
  designDocument    DesignDocument?   @relation("DrawingJobDesignDocument", fields: [designDocumentId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_drawing_jobs__design_document_id")
  pattern           Pattern           @relation("DrawingJobPattern", fields: [patternId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_drawing_jobs__pattern_id")
  outputFile        FileObject?       @relation("DrawingJobOutputFile", fields: [outputFileId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_drawing_jobs__output_file_id")
  dielineDeliveries DielineDelivery[]

  @@index([requestedById], map: "ix_drawing_jobs__requested_by")
  @@index([orderId], map: "ix_drawing_jobs__order_id")
  @@index([designDocumentId], map: "ix_drawing_jobs__design_document_id")
  @@index([patternId], map: "ix_drawing_jobs__pattern_id")
  @@index([outputFileId], map: "ix_drawing_jobs__output_file_id")
  @@index([status, lockedUntil], map: "ix_drawing_jobs__queue", where: raw("(status = ANY (ARRAY['queued'::drawing_status, 'running'::drawing_status]))"))
  @@map("drawing_jobs")
}

// --- Production (D-073…D-076, D-012, D-101, B4.2) ---------------------------------------------------

enum EvidenceRequirement {
  none
  photo
  qc_form
  photo_and_qc_form

  @@map("evidence_requirement")
}

enum JobKind {
  production
  mockup
  reproduction

  @@map("job_kind")
}

enum ProductionJobStatus {
  released
  accepted
  rejected
  in_progress
  on_hold
  completed
  cancelled

  @@map("production_job_status")
}

enum AssignmentReason {
  initial
  rejected
  acceptance_overdue
  manual

  @@map("assignment_reason")
}

enum AssignmentMode {
  auto
  manual
  escalated

  @@map("assignment_mode")
}

enum MilestoneStatus {
  pending
  in_progress
  completed
  skipped

  @@map("milestone_status")
}

enum QcResult {
  pass
  fail
  conditional

  @@map("qc_result")
}

enum InspectionReason {
  value_100_pct
  value_band_sample
  trial_factory
  high_defect_factory
  special_finish_or_food

  @@map("inspection_reason")
}

enum InspectionStatus {
  planned
  in_progress
  passed
  failed
  waived

  @@map("inspection_status")
}

enum IssueStatus {
  open
  resolved

  @@map("issue_status")
}

/// Identity of an editable milestone route (D-075): per product type, optional print type and a variant.
model MilestoneRoute {
  id            BigInt   @id(map: "pk_milestone_routes") @default(autoincrement())
  publicId      String   @unique(map: "ux_milestone_routes__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  productTypeId BigInt   @map("product_type_id")
  printTypeId   BigInt?  @map("print_type_id")
  /// `standard`, `mockup`, `digital`… (lower snake case).
  variant       String
  name          String
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById   BigInt?  @map("created_by")

  productType ProductType             @relation("MilestoneRouteProductType", fields: [productTypeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_milestone_routes__product_type_id")
  printType   PrintType?              @relation("MilestoneRoutePrintType", fields: [printTypeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_milestone_routes__print_type_id")
  createdBy   User?                   @relation("MilestoneRouteCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_milestone_routes__created_by")
  versions    MilestoneRouteVersion[]

  // ux (product_type_id, coalesce(print_type_id, 0), variant) is an expression index in the migration SQL.
  @@index([productTypeId], map: "ix_milestone_routes__product_type_id")
  @@index([printTypeId], map: "ix_milestone_routes__print_type_id")
  @@index([createdById], map: "ix_milestone_routes__created_by")
  @@map("milestone_routes")
}

model MilestoneRouteVersion {
  id                BigInt              @id(map: "pk_milestone_route_versions") @default(autoincrement())
  publicId          String              @unique(map: "ux_milestone_route_versions__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  routeId           BigInt              @map("route_id")
  versionNo         Int                 @map("version_no")
  effectiveFrom     DateTime            @map("effective_from") @db.Timestamptz(6)
  status            ConfigVersionStatus @default(draft)
  reason            String
  approvalRequestId BigInt?             @map("approval_request_id")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById       BigInt?             @map("created_by")
  decidedAt         DateTime?           @map("decided_at") @db.Timestamptz(6)
  decidedById       BigInt?             @map("decided_by")

  route           MilestoneRoute       @relation(fields: [routeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_milestone_route_versions__route_id")
  approvalRequest ApprovalRequest?     @relation("MilestoneRouteVersionApprovalRequest", fields: [approvalRequestId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_milestone_route_versions__approval_request_id")
  createdBy       User?                @relation("MilestoneRouteVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_milestone_route_versions__created_by")
  decidedBy       User?                @relation("MilestoneRouteVersionDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_milestone_route_versions__decided_by")
  steps           MilestoneRouteStep[]
  jobs            ProductionJob[]

  @@unique([routeId, versionNo], map: "ux_milestone_route_versions__route_id__version_no")
  @@index([routeId, effectiveFrom(sort: Desc), versionNo(sort: Desc)], map: "ix_milestone_route_versions__resolution", where: raw("(status = 'approved'::config_version_status)"))
  @@index([approvalRequestId], map: "ix_milestone_route_versions__approval_request_id")
  @@index([createdById], map: "ix_milestone_route_versions__created_by")
  @@index([decidedById], map: "ix_milestone_route_versions__decided_by")
  @@map("milestone_route_versions")
}

model MilestoneRouteStep {
  id              BigInt              @id(map: "pk_milestone_route_steps") @default(autoincrement())
  versionId       BigInt              @map("version_id")
  seq             Int                 @db.SmallInt
  key             String
  nameTh          String              @map("name_th")
  nameEn          String              @map("name_en")
  customerVisible Boolean             @default(false) @map("customer_visible")
  customerLabelTh String?             @map("customer_label_th")
  customerLabelEn String?             @map("customer_label_en")
  evidence        EvidenceRequirement @default(none)
  tracksQuantity  Boolean             @default(false) @map("tracks_quantity")
  /// Share of the planned production time (for due dates); null = spread evenly.
  plannedSharePct Decimal?            @map("planned_share_pct") @db.Decimal(7, 4)

  version MilestoneRouteVersion @relation(fields: [versionId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_milestone_route_steps__version_id")

  @@unique([versionId, seq], map: "ux_milestone_route_steps__version_id__seq")
  @@unique([versionId, key], map: "ux_milestone_route_steps__version_id__key")
  @@map("milestone_route_steps")
}

/// One job per (order, factory) and kind (D-073): what the factory is asked to make, with its snapshots.
model ProductionJob {
  id                     BigInt              @id(map: "pk_production_jobs") @default(autoincrement())
  publicId               String              @unique(map: "ux_production_jobs__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  jobNo                  String              @unique(map: "ux_production_jobs__job_no") @map("job_no")
  entityId               BigInt              @map("entity_id")
  orderId                BigInt              @map("order_id")
  factoryId              BigInt              @map("factory_id")
  jobKind                JobKind             @map("job_kind")
  reproductionOfJobId    BigInt?             @map("reproduction_of_job_id")
  /// P24 re-production for a claim.
  claimId                BigInt?             @map("claim_id")
  /// The factory PO (FK added with purchase orders, B5.3).
  purchaseOrderId        BigInt?             @map("purchase_order_id")
  /// The add-on line a mockup job makes (D-072).
  orderLineId            BigInt?             @map("order_line_id")
  status                 ProductionJobStatus @default(released)
  statusChangedAt        DateTime            @default(now()) @map("status_changed_at") @db.Timestamptz(6)
  releasedAt             DateTime            @default(now()) @map("released_at") @db.Timestamptz(6)
  releaseMode            ProductionStartMode @map("release_mode")
  releaseReason          String?             @map("release_reason")
  releasedById           BigInt?             @map("released_by")
  acceptDueAt            DateTime            @map("accept_due_at") @db.Timestamptz(6)
  acceptedAt             DateTime?           @map("accepted_at") @db.Timestamptz(6)
  acceptedById           BigInt?             @map("accepted_by")
  rejectedAt             DateTime?           @map("rejected_at") @db.Timestamptz(6)
  rejectedById           BigInt?             @map("rejected_by")
  rejectReasonCode       String?             @map("reject_reason_code")
  rejectNote             String?             @map("reject_note")
  /// Set once the acceptance SLA passed and the job was escalated (D-074).
  escalatedAt            DateTime?           @map("escalated_at") @db.Timestamptz(6)
  plannedStartOn         DateTime?           @map("planned_start_on") @db.Date
  plannedFinishOn        DateTime?           @map("planned_finish_on") @db.Date
  promisedShipDate       DateTime?           @map("promised_ship_date") @db.Date
  predictedFinishOn      DateTime?           @map("predicted_finish_on") @db.Date
  atRiskSince            DateTime?           @map("at_risk_since") @db.Timestamptz(6)
  actualStartAt          DateTime?           @map("actual_start_at") @db.Timestamptz(6)
  actualFinishAt         DateTime?           @map("actual_finish_at") @db.Timestamptz(6)
  priority               Int                 @default(0) @db.SmallInt
  lotNo                  String?             @map("lot_no")
  quantityOrdered        Int                 @map("quantity_ordered")
  quantityGood           Int?                @map("quantity_good")
  quantityScrap          Int?                @map("quantity_scrap")
  specSnapshot           Json                @map("spec_snapshot")
  routeVersionId         BigInt              @map("route_version_id")
  routeSnapshot          Json                @map("route_snapshot")
  priceListVersionId     BigInt?             @map("price_list_version_id")
  /// Staff-only (D-141): the factory's buy price for this job.
  buyPriceSnapshot       Json                @map("buy_price_snapshot")
  toleranceShortagePct   Decimal?            @map("tolerance_shortage_pct") @db.Decimal(7, 4)
  toleranceOveragePct    Decimal?            @map("tolerance_overage_pct") @db.Decimal(7, 4)
  /// D-186: published dimensional (± mm) and colour (ΔE2000 vs the approved proof) tolerances, frozen; null = none.
  toleranceDimensionalMm Decimal?            @map("tolerance_dimensional_mm") @db.Decimal(6, 2)
  toleranceColourDeltaE  Decimal?            @map("tolerance_colour_delta_e") @db.Decimal(5, 2)
  inspectionRequired     Boolean             @default(false) @map("inspection_required")
  inspectionReasons      String[]            @default([]) @map("inspection_reasons")
  holdReason             String?             @map("hold_reason")
  cancelReason           String?             @map("cancel_reason")
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById            BigInt?             @map("updated_by")
  rowVersion             Int                 @default(1) @map("row_version")

  entity           Entity                @relation("ProductionJobEntity", fields: [entityId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_production_jobs__entity_id")
  order            Order                 @relation("ProductionJobOrder", fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_production_jobs__order_id")
  factory          Factory               @relation("ProductionJobFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_production_jobs__factory_id")
  reproductionOf   ProductionJob?        @relation("ProductionJobReproduction", fields: [reproductionOfJobId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_production_jobs__reproduction_of_job_id")
  reproductions    ProductionJob[]       @relation("ProductionJobReproduction")
  orderLine        OrderLine?            @relation("ProductionJobOrderLine", fields: [orderLineId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_production_jobs__order_line_id")
  releasedBy       User?                 @relation("ProductionJobReleasedBy", fields: [releasedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_production_jobs__released_by")
  acceptedBy       User?                 @relation("ProductionJobAcceptedBy", fields: [acceptedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_production_jobs__accepted_by")
  rejectedBy       User?                 @relation("ProductionJobRejectedBy", fields: [rejectedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_production_jobs__rejected_by")
  updatedBy        User?                 @relation("ProductionJobUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_production_jobs__updated_by")
  routeVersion     MilestoneRouteVersion @relation(fields: [routeVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_production_jobs__route_version_id")
  priceListVersion PriceListVersion?     @relation("ProductionJobPriceListVersion", fields: [priceListVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_production_jobs__price_list_version_id")
  assignments      JobAssignment[]
  milestones       JobMilestone[]
  qcChecks         QcCheck[]
  inspections      Inspection[]
  issues           JobIssue[]
  capacityBooking  CapacityBooking?      @relation("CapacityBookingJob")
  claim            Claim?                @relation("ProductionJobClaim", fields: [claimId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_production_jobs__claim_id")

  // --- Fulfilment B4.3 (generated back-relations)
  shipmentItems ShipmentItem[] @relation("ShipmentItemJob")
  // --- end Fulfilment B4.3

  // --- Fulfilment B4.5 (generated back-relations)
  claims           Claim[]           @relation("ClaimProductionJob")
  claimResolutions ClaimResolution[] @relation("ClaimResolutionJob")
  // --- end Fulfilment B4.5

  // --- Finance B5.3 (generated back-relations)
  purchaseOrder PurchaseOrder? @relation("PurchaseOrderJob")
  // --- end Finance B5.3

  @@unique([orderId], map: "ux_production_jobs__one_live_production", where: raw("((job_kind = 'production'::job_kind) AND (status <> ALL (ARRAY['rejected'::production_job_status, 'cancelled'::production_job_status])))"))
  @@unique([orderId], map: "ux_production_jobs__one_live_mockup", where: raw("((job_kind = 'mockup'::job_kind) AND (status <> ALL (ARRAY['rejected'::production_job_status, 'cancelled'::production_job_status])))"))
  @@index([orderId], map: "ix_production_jobs__order_id")
  @@index([factoryId, status], map: "ix_production_jobs__factory_id__status")
  @@index([status, acceptDueAt], map: "ix_production_jobs__status__accept_due_at")
  @@index([factoryId, promisedShipDate], map: "ix_production_jobs__factory_id__promised_ship_date")
  @@index([entityId], map: "ix_production_jobs__entity_id")
  @@index([reproductionOfJobId], map: "ix_production_jobs__reproduction_of_job_id")
  @@index([claimId], map: "ix_production_jobs__claim_id")
  @@index([purchaseOrderId], map: "ix_production_jobs__purchase_order_id")
  @@index([orderLineId], map: "ix_production_jobs__order_line_id")
  @@index([releasedById], map: "ix_production_jobs__released_by")
  @@index([acceptedById], map: "ix_production_jobs__accepted_by")
  @@index([rejectedById], map: "ix_production_jobs__rejected_by")
  @@index([updatedById], map: "ix_production_jobs__updated_by")
  @@index([routeVersionId], map: "ix_production_jobs__route_version_id")
  @@index([priceListVersionId], map: "ix_production_jobs__price_list_version_id")
  @@index([releasedAt], map: "ix_production_jobs__released_at")
  @@map("production_jobs")
}

/// Assignment history (D-012): who the job went to and why.
model JobAssignment {
  id             BigInt           @id(map: "pk_job_assignments") @default(autoincrement())
  jobId          BigInt           @map("job_id")
  fromFactoryId  BigInt?          @map("from_factory_id")
  toFactoryId    BigInt?          @map("to_factory_id")
  reason         AssignmentReason
  /// Staff-only (D-141): the margin the new factory leaves.
  marginAfterPct Decimal?         @map("margin_after_pct") @db.Decimal(9, 4)
  mode           AssignmentMode
  note           String?
  decidedById    BigInt?          @map("decided_by")
  decidedAt      DateTime         @default(now()) @map("decided_at") @db.Timestamptz(6)

  job         ProductionJob @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_job_assignments__job_id")
  fromFactory Factory?      @relation("JobAssignmentFrom", fields: [fromFactoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_job_assignments__from_factory_id")
  toFactory   Factory?      @relation("JobAssignmentTo", fields: [toFactoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_job_assignments__to_factory_id")
  decidedBy   User?         @relation("JobAssignmentDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_job_assignments__decided_by")

  @@index([jobId], map: "ix_job_assignments__job_id")
  @@index([fromFactoryId], map: "ix_job_assignments__from_factory_id")
  @@index([toFactoryId], map: "ix_job_assignments__to_factory_id")
  @@index([decidedById], map: "ix_job_assignments__decided_by")
  @@map("job_assignments")
}

model JobMilestone {
  id                 BigInt              @id(map: "pk_job_milestones") @default(autoincrement())
  publicId           String              @unique(map: "ux_job_milestones__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  jobId              BigInt              @map("job_id")
  /// Denormalised for partner scoping (schema-design §2.5).
  factoryId          BigInt              @map("factory_id")
  seq                Int                 @db.SmallInt
  stepKey            String              @map("step_key")
  evidence           EvidenceRequirement @default(none)
  tracksQuantity     Boolean             @default(false) @map("tracks_quantity")
  customerVisible    Boolean             @default(false) @map("customer_visible")
  status             MilestoneStatus     @default(pending)
  dueAt              DateTime?           @map("due_at") @db.Timestamptz(6)
  startedAt          DateTime?           @map("started_at") @db.Timestamptz(6)
  completedAt        DateTime?           @map("completed_at") @db.Timestamptz(6)
  quantityIn         Int?                @map("quantity_in")
  quantityOut        Int?                @map("quantity_out")
  quantityScrap      Int?                @map("quantity_scrap")
  reportedById       BigInt?             @map("reported_by")
  reportedByClientId BigInt?             @map("reported_by_client_id")
  /// Idempotent partner updates: the device's id of its last update (server wins on conflict).
  clientRef          String?             @map("client_ref") @db.Uuid
  clientReportedAt   DateTime?           @map("client_reported_at") @db.Timestamptz(6)
  /// Completed (or started) on time, for the scorecard's on-time updates (D-075, D-155).
  onTime             Boolean?            @map("on_time")
  note               String?
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion         Int                 @default(1) @map("row_version")

  job              ProductionJob @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_job_milestones__job_id")
  factory          Factory       @relation("JobMilestoneFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_job_milestones__factory_id")
  reportedBy       User?         @relation("JobMilestoneReportedBy", fields: [reportedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_job_milestones__reported_by")
  reportedByClient ApiClient?    @relation("JobMilestoneReportedByClient", fields: [reportedByClientId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_job_milestones__reported_by_client_id")

  @@unique([jobId, seq], map: "ux_job_milestones__job_id__seq")
  @@unique([jobId, clientRef], map: "ux_job_milestones__job_id__client_ref", where: raw("(client_ref IS NOT NULL)"))
  @@index([factoryId, status], map: "ix_job_milestones__factory_id__status")
  @@index([reportedById], map: "ix_job_milestones__reported_by")
  @@index([reportedByClientId], map: "ix_job_milestones__reported_by_client_id")
  @@map("job_milestones")
}

/// Factory QC with photo evidence (D-076).
model QcCheck {
  id                BigInt   @id(map: "pk_qc_checks") @default(autoincrement())
  publicId          String   @unique(map: "ux_qc_checks__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  jobId             BigInt   @map("job_id")
  factoryId         BigInt   @map("factory_id")
  checklistVersion  String   @map("checklist_version")
  checklist         Json
  result            QcResult
  isFirstPass       Boolean  @map("is_first_pass")
  defects           Json     @default("[]")
  quantityChecked   Int?     @map("quantity_checked")
  quantityDefective Int?     @map("quantity_defective")
  note              String?
  performedById     BigInt?  @map("performed_by")
  performedAt       DateTime @default(now()) @map("performed_at") @db.Timestamptz(6)

  job         ProductionJob @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_qc_checks__job_id")
  factory     Factory       @relation("QcCheckFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_qc_checks__factory_id")
  performedBy User?         @relation("QcCheckPerformedBy", fields: [performedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_qc_checks__performed_by")

  @@index([jobId, performedAt], map: "ix_qc_checks__job_id__performed_at")
  @@index([factoryId, performedAt], map: "ix_qc_checks__factory_id__performed_at")
  @@index([performedById], map: "ix_qc_checks__performed_by")
  @@map("qc_checks")
}

/// Packio risk-based inspection (D-076).
model Inspection {
  id              BigInt             @id(map: "pk_inspections") @default(autoincrement())
  publicId        String             @unique(map: "ux_inspections__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  jobId           BigInt             @unique(map: "ux_inspections__job_id") @map("job_id")
  reasons         InspectionReason[]
  /// Setting versions and the sampling maths used (`qc.inspection_sampling`).
  samplingRefs    Json               @map("sampling_refs")
  /// Probability the reasons give (percent) and the random draw's outcome.
  ratePct         Decimal            @map("rate_pct") @db.Decimal(7, 4)
  selected        Boolean
  lotSize         Int                @map("lot_size")
  sampleSize      Int                @map("sample_size")
  aqlCritical     Decimal            @map("aql_critical") @db.Decimal(5, 2)
  aqlMajor        Decimal            @map("aql_major") @db.Decimal(5, 2)
  aqlMinor        Decimal            @map("aql_minor") @db.Decimal(5, 2)
  acceptCritical  Int                @map("accept_critical")
  acceptMajor     Int                @map("accept_major")
  acceptMinor     Int                @map("accept_minor")
  foundCritical   Int?               @map("found_critical")
  foundMajor      Int?               @map("found_major")
  foundMinor      Int?               @map("found_minor")
  inspectorUserId BigInt?            @map("inspector_user_id")
  scheduledAt     DateTime?          @map("scheduled_at") @db.Timestamptz(6)
  status          InspectionStatus   @default(planned)
  resultAt        DateTime?          @map("result_at") @db.Timestamptz(6)
  notes           String?
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion      Int                @default(1) @map("row_version")

  job       ProductionJob @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_inspections__job_id")
  inspector User?         @relation("InspectionInspector", fields: [inspectorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_inspections__inspector_user_id")

  @@index([status, scheduledAt], map: "ix_inspections__status__scheduled_at")
  @@index([inspectorUserId], map: "ix_inspections__inspector_user_id")
  @@map("inspections")
}

model JobIssue {
  id             BigInt      @id(map: "pk_job_issues") @default(autoincrement())
  publicId       String      @unique(map: "ux_job_issues__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  jobId          BigInt      @map("job_id")
  factoryId      BigInt      @map("factory_id")
  kind           String
  description    String
  raisedById     BigInt?     @map("raised_by")
  status         IssueStatus @default(open)
  resolvedAt     DateTime?   @map("resolved_at") @db.Timestamptz(6)
  resolvedById   BigInt?     @map("resolved_by")
  resolutionNote String?     @map("resolution_note")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  job        ProductionJob @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_job_issues__job_id")
  factory    Factory       @relation("JobIssueFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_job_issues__factory_id")
  raisedBy   User?         @relation("JobIssueRaisedBy", fields: [raisedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_job_issues__raised_by")
  resolvedBy User?         @relation("JobIssueResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_job_issues__resolved_by")

  @@index([jobId], map: "ix_job_issues__job_id")
  @@index([factoryId, status], map: "ix_job_issues__factory_id__status")
  @@index([raisedById], map: "ix_job_issues__raised_by")
  @@index([resolvedById], map: "ix_job_issues__resolved_by")
  @@map("job_issues")
}

/// Monthly factory scorecard (D-155), visible to the factory.
model FactoryScorecard {
  id                  BigInt   @id(map: "pk_factory_scorecards") @default(autoincrement())
  factoryId           BigInt   @map("factory_id")
  /// First day of the Bangkok month.
  month               DateTime @db.Date
  onTimeAcceptancePct Decimal? @map("on_time_acceptance_pct") @db.Decimal(7, 4)
  onTimeShippingPct   Decimal? @map("on_time_shipping_pct") @db.Decimal(7, 4)
  qcFirstPassPct      Decimal? @map("qc_first_pass_pct") @db.Decimal(7, 4)
  claimRatePct        Decimal? @map("claim_rate_pct") @db.Decimal(7, 4)
  onTimeUpdatesPct    Decimal? @map("on_time_updates_pct") @db.Decimal(7, 4)
  jobsCount           Int      @map("jobs_count")
  inputs              Json
  computedAt          DateTime @default(now()) @map("computed_at") @db.Timestamptz(6)

  factory Factory @relation("FactoryScorecardFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_factory_scorecards__factory_id")

  @@unique([factoryId, month], map: "ux_factory_scorecards__factory_id__month")
  @@map("factory_scorecards")
}

// =====================================================================================================
// Logistics (D-013, D-021, D-080, D-081, D-114, D-142, D-165; B4.3)
// =====================================================================================================

enum ShipmentStatus {
  draft
  ready
  picked_up
  in_transit
  out_for_delivery
  delivered
  failed
  returned
  cancelled

  @@map("shipment_status")
}

enum ShipmentEventSource {
  factory
  carrier_webhook
  carrier_poll
  staff

  @@map("shipment_event_source")
}

enum PodKind {
  factory_photo_signature
  carrier_pod

  @@map("pod_kind")
}

/// Staff check of a recorded proof of delivery (D-229): informational, it never reverses the delivery.
enum PodReviewDecision {
  accepted
  rejected

  @@map("pod_review_decision")
}

/// How staff closed a delivery exception (D-230).
enum ShipmentExceptionResolution {
  retry
  return
  cancel

  @@map("shipment_exception_resolution")
}

enum ToleranceOutcome {
  exact
  shortage_within
  overage_within
  shortage_outside
  overage_outside

  @@map("tolerance_outcome")
}

/// One trip to one address. The destination is a snapshot of the order destination(s) it serves, so the
/// partner projection never reads users or customer addresses (D-142). Items may come from several
/// orders of the same factory when they go to the same address.
model Shipment {
  id                     BigInt                       @id(map: "pk_shipments") @default(autoincrement())
  publicId               String                       @unique(map: "ux_shipments__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  shipmentNo             String                       @unique(map: "ux_shipments__shipment_no") @map("shipment_no")
  entityId               BigInt                       @map("entity_id")
  factoryId              BigInt                       @map("factory_id")
  /// `factory_fleet` by default (D-013); a Packio-booked carrier as fallback (D-114).
  carrierId              BigInt                       @map("carrier_id")
  carrierBookingRef      String?                      @map("carrier_booking_ref")
  trackingNo             String?                      @map("tracking_no")
  trackingUrl            String?                      @map("tracking_url")
  bookedAt               DateTime?                    @map("booked_at") @db.Timestamptz(6)
  status                 ShipmentStatus               @default(draft)
  statusChangedAt        DateTime                     @default(now()) @map("status_changed_at") @db.Timestamptz(6)
  recipientName          String                       @map("recipient_name")
  phone                  String
  line1                  String
  line2                  String?
  subdistrictId          BigInt?                      @map("subdistrict_id")
  postcode               String                       @db.Char(5)
  provinceId             BigInt                       @map("province_id")
  cartonsCount           Int                          @map("cartons_count")
  weightG                Int                          @map("weight_g")
  volumeCm3              BigInt?                      @map("volume_cm3")
  plannedShipOn          DateTime?                    @map("planned_ship_on") @db.Date
  readyAt                DateTime?                    @map("ready_at") @db.Timestamptz(6)
  pickedUpAt             DateTime?                    @map("picked_up_at") @db.Timestamptz(6)
  deliveredAt            DateTime?                    @map("delivered_at") @db.Timestamptz(6)
  cancelledAt            DateTime?                    @map("cancelled_at") @db.Timestamptz(6)
  cancelReason           String?                      @map("cancel_reason")
  labelFileId            BigInt?                      @map("label_file_id")
  packingListFileId      BigInt?                      @map("packing_list_file_id")
  customerRateVersionId  BigInt?                      @map("customer_rate_version_id")
  /// Staff-only (P15): the factory's shipping payout for this trip, frozen when it is ready.
  factoryPayoutVersionId BigInt?                      @map("factory_payout_version_id")
  payoutAmount           Decimal?                     @map("payout_amount") @db.Decimal(14, 2)
  /// Staff-only (P25): what the fallback carrier charges Packio.
  carrierCostAmount      Decimal?                     @map("carrier_cost_amount") @db.Decimal(14, 2)
  note                   String?
  /// The factory asked Packio for a fallback carrier (D-013, D-114; U-B0.3): Logistics books it.
  carrierRequestedAt     DateTime?                    @map("carrier_requested_at") @db.Timestamptz(6)
  carrierRequestReason   String?                      @map("carrier_request_reason")
  carrierRequestedById   BigInt?                      @map("carrier_requested_by")
  /// The shipment this one was split from (D-230), same factory, destination and draft state.
  splitFromId            BigInt?                      @map("split_from_id")
  /// Staff resolution of a failed or returned delivery (D-230).
  exceptionResolution    ShipmentExceptionResolution? @map("exception_resolution")
  exceptionResolvedAt    DateTime?                    @map("exception_resolved_at") @db.Timestamptz(6)
  exceptionResolvedById  BigInt?                      @map("exception_resolved_by")
  exceptionNote          String?                      @map("exception_note")
  createdAt              DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById            BigInt?                      @map("created_by")
  updatedAt              DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById            BigInt?                      @map("updated_by")
  rowVersion             Int                          @default(1) @map("row_version")

  carrierRequestedBy   User?                            @relation("ShipmentCarrierRequestedBy", fields: [carrierRequestedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_shipments__carrier_requested_by")
  splitFrom            Shipment?                        @relation("ShipmentSplitFrom", fields: [splitFromId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_shipments__split_from_id")
  splits               Shipment[]                       @relation("ShipmentSplitFrom")
  exceptionResolvedBy  User?                            @relation("ShipmentExceptionResolvedBy", fields: [exceptionResolvedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_shipments__exception_resolved_by")
  entity               Entity                           @relation("ShipmentEntity", fields: [entityId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_shipments__entity_id")
  factory              Factory                          @relation("ShipmentFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_shipments__factory_id")
  carrier              Carrier                          @relation("ShipmentCarrier", fields: [carrierId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_shipments__carrier_id")
  subdistrict          GeoSubdistrict?                  @relation("ShipmentSubdistrict", fields: [subdistrictId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_shipments__subdistrict_id")
  province             GeoProvince                      @relation("ShipmentProvince", fields: [provinceId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_shipments__province_id")
  labelFile            FileObject?                      @relation("ShipmentLabelFile", fields: [labelFileId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_shipments__label_file_id")
  packingListFile      FileObject?                      @relation("ShipmentPackingListFile", fields: [packingListFileId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_shipments__packing_list_file_id")
  customerRateVersion  CustomerShippingRateCardVersion? @relation("ShipmentCustomerRateVersion", fields: [customerRateVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_shipments__customer_rate_version_id")
  factoryPayoutVersion FactoryShippingRateCardVersion?  @relation("ShipmentFactoryPayoutVersion", fields: [factoryPayoutVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_shipments__factory_payout_version_id")
  createdBy            User?                            @relation("ShipmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_shipments__created_by")
  updatedBy            User?                            @relation("ShipmentUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_shipments__updated_by")
  items                ShipmentItem[]
  cartons              ShipmentCarton[]
  events               ShipmentEvent[]
  proofOfDelivery      ProofOfDelivery?
  trackingLinks        TrackingLink[]

  // --- Fulfilment B4.5 (generated back-relations)
  claims Claim[] @relation("ClaimShipment")
  // --- end Fulfilment B4.5

  // --- Finance B5.3 (generated back-relations)
  goodsReceiptLines GoodsReceiptLine[] @relation("GoodsReceiptLineShipment")
  vendorInvoices    VendorInvoice[]    @relation("VendorInvoiceShipment")
  // --- end Finance B5.3

  @@index([factoryId, status], map: "ix_shipments__factory_id__status")
  @@index([trackingNo], map: "ix_shipments__tracking_no")
  @@index([carrierId, carrierBookingRef], map: "ix_shipments__carrier_id__carrier_booking_ref")
  @@index([status, statusChangedAt], map: "ix_shipments__status__status_changed_at")
  @@index([entityId], map: "ix_shipments__entity_id")
  @@index([subdistrictId], map: "ix_shipments__subdistrict_id")
  @@index([provinceId], map: "ix_shipments__province_id")
  @@index([labelFileId], map: "ix_shipments__label_file_id")
  @@index([packingListFileId], map: "ix_shipments__packing_list_file_id")
  @@index([customerRateVersionId], map: "ix_shipments__customer_rate_version_id")
  @@index([factoryPayoutVersionId], map: "ix_shipments__factory_payout_version_id")
  @@index([createdById], map: "ix_shipments__created_by")
  @@index([updatedById], map: "ix_shipments__updated_by")
  @@index([splitFromId], map: "ix_shipments__split_from_id")
  @@index([carrierRequestedById], map: "ix_shipments__carrier_requested_by")
  @@index([exceptionResolvedById], map: "ix_shipments__exception_resolved_by")
  @@index([pickedUpAt], map: "ix_shipments__picked_up_at", where: raw("(picked_up_at IS NOT NULL)"))
  @@index([deliveredAt], map: "ix_shipments__delivered_at", where: raw("(delivered_at IS NOT NULL)"))
  @@index([shipmentNo(ops: raw("gin_trgm_ops"))], type: Gin, map: "ix_shipments__shipment_no_trgm")
  @@map("shipments")
}

/// What a shipment carries for one order destination, from the job that made it. The delivered
/// quantity is reported with the proof of delivery and drives tolerance (D-021, D-080).
model ShipmentItem {
  id                 BigInt   @id(map: "pk_shipment_items") @default(autoincrement())
  shipmentId         BigInt   @map("shipment_id")
  orderId            BigInt   @map("order_id")
  orderDestinationId BigInt   @map("order_destination_id")
  productionJobId    BigInt   @map("production_job_id")
  quantity           Int
  deliveredQuantity  Int?     @map("delivered_quantity")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  shipment         Shipment         @relation(fields: [shipmentId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_shipment_items__shipment_id")
  order            Order            @relation("ShipmentItemOrder", fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_shipment_items__order_id")
  orderDestination OrderDestination @relation("ShipmentItemDestination", fields: [orderDestinationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_shipment_items__order_destination_id")
  productionJob    ProductionJob    @relation("ShipmentItemJob", fields: [productionJobId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_shipment_items__production_job_id")

  @@unique([shipmentId, orderDestinationId], map: "ux_shipment_items__shipment_id__order_destination_id")
  @@index([orderId], map: "ix_shipment_items__order_id")
  @@index([orderDestinationId], map: "ix_shipment_items__order_destination_id")
  @@index([productionJobId], map: "ix_shipment_items__production_job_id")
  @@map("shipment_items")
}

/// One 100×150 mm label per carton; its QR carries the public tracking token (B4.4).
model ShipmentCarton {
  id         BigInt   @id(map: "pk_shipment_cartons") @default(autoincrement())
  shipmentId BigInt   @map("shipment_id")
  seq        Int      @db.SmallInt
  labelCode  String   @unique(map: "ux_shipment_cartons__label_code") @map("label_code")
  weightG    Int?     @map("weight_g")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_shipment_cartons__shipment_id")

  @@unique([shipmentId, seq], map: "ux_shipment_cartons__shipment_id__seq")
  @@map("shipment_cartons")
}

/// Append-only status history from the factory, the carrier (webhook or poll) or staff.
model ShipmentEvent {
  id             BigInt              @id(map: "pk_shipment_events") @default(autoincrement())
  shipmentId     BigInt              @map("shipment_id")
  occurredAt     DateTime            @map("occurred_at") @db.Timestamptz(6)
  status         ShipmentStatus
  source         ShipmentEventSource
  location       String?
  note           String?
  carrierEventId String?             @map("carrier_event_id")
  providerStatus String?             @map("provider_status")
  raw            Json?
  recordedById   BigInt?             @map("recorded_by")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_shipment_events__shipment_id")
  recordedBy User?    @relation("ShipmentEventRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_shipment_events__recorded_by")

  @@unique([shipmentId, carrierEventId], map: "ux_shipment_events__shipment_id__carrier_event_id", where: raw("(carrier_event_id IS NOT NULL)"))
  @@index([shipmentId, occurredAt], map: "ix_shipment_events__shipment_id__occurred_at")
  @@index([recordedById], map: "ix_shipment_events__recorded_by")
  @@map("shipment_events")
}

/// Mandatory for factory deliveries (D-013): photo(s) + receiver name + signature, or the carrier's POD.
/// Photos are attachments (`proof_of_delivery`). Unlocks payout eligibility (B5).
model ProofOfDelivery {
  id                BigInt   @id(map: "pk_proofs_of_delivery") @default(autoincrement())
  publicId          String   @unique(map: "ux_proofs_of_delivery__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  shipmentId        BigInt   @unique(map: "ux_proofs_of_delivery__shipment_id") @map("shipment_id")
  kind              PodKind
  /// PII (receiver).
  receiverName      String   @map("receiver_name")
  signatureFileId   BigInt?  @map("signature_file_id")
  deliveredQuantity Int      @map("delivered_quantity")
  capturedAt        DateTime @map("captured_at") @db.Timestamptz(6)
  capturedById      BigInt?  @map("captured_by")
  lat               Decimal? @db.Decimal(9, 6)
  lng               Decimal? @db.Decimal(9, 6)
  carrierPodRef     String?  @map("carrier_pod_ref")
  note              String?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  shipment      Shipment                @relation(fields: [shipmentId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_proofs_of_delivery__shipment_id")
  signatureFile FileObject?             @relation("ProofOfDeliverySignature", fields: [signatureFileId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_proofs_of_delivery__signature_file_id")
  reviews       ProofOfDeliveryReview[]
  capturedBy    User?                   @relation("ProofOfDeliveryCapturedBy", fields: [capturedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_proofs_of_delivery__captured_by")

  @@index([signatureFileId], map: "ix_proofs_of_delivery__signature_file_id")
  @@index([capturedById], map: "ix_proofs_of_delivery__captured_by")
  @@map("proofs_of_delivery")
}

/// Staff reviews of a proof of delivery (D-229), append-only: the latest one is the POD's review state.
model ProofOfDeliveryReview {
  id                BigInt            @id(map: "pk_proof_of_delivery_reviews") @default(autoincrement())
  publicId          String            @unique(map: "ux_proof_of_delivery_reviews__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  proofOfDeliveryId BigInt            @map("proof_of_delivery_id")
  decision          PodReviewDecision
  note              String?
  reviewedById      BigInt            @map("reviewed_by")
  reviewedAt        DateTime          @default(now()) @map("reviewed_at") @db.Timestamptz(6)

  proofOfDelivery ProofOfDelivery @relation(fields: [proofOfDeliveryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_proof_of_delivery_reviews__proof_of_delivery_id")
  reviewedBy      User            @relation("ProofOfDeliveryReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_proof_of_delivery_reviews__reviewed_by")

  @@index([proofOfDeliveryId, reviewedAt], map: "ix_proof_of_delivery_reviews__pod_id__reviewed_at")
  @@index([reviewedById], map: "ix_proof_of_delivery_reviews__reviewed_by")
  @@map("proof_of_delivery_reviews")
}

/// Delivered vs ordered once the order is delivered, with the tolerance frozen in the quote (D-021,
/// D-080): shortage within → pro-rata credit (P19); overage within → no charge; outside → automatic
/// claim (B4.5). The factory is paid min(delivered, ordered) (D-165).
model DeliveryReconciliation {
  id                   BigInt           @id(map: "pk_delivery_reconciliations") @default(autoincrement())
  orderId              BigInt           @unique(map: "ux_delivery_reconciliations__order_id") @map("order_id")
  orderedQuantity      Int              @map("ordered_quantity")
  deliveredQuantity    Int              @map("delivered_quantity")
  payableQuantity      Int              @map("payable_quantity")
  toleranceShortagePct Decimal          @map("tolerance_shortage_pct") @db.Decimal(7, 4)
  toleranceOveragePct  Decimal          @map("tolerance_overage_pct") @db.Decimal(7, 4)
  deviationPct         Decimal          @map("deviation_pct") @db.Decimal(9, 4)
  outcome              ToleranceOutcome
  creditNetAmount      Decimal?         @map("credit_net_amount") @db.Decimal(14, 2)
  creditVatAmount      Decimal?         @map("credit_vat_amount") @db.Decimal(14, 2)
  /// Gross pro-rata credit (net + VAT), shortage within tolerance only.
  creditAmount         Decimal?         @map("credit_amount") @db.Decimal(14, 2)
  /// The automatic claim (B4.5).
  claimId              BigInt?          @map("claim_id")
  evaluatedAt          DateTime         @map("evaluated_at") @db.Timestamptz(6)
  domainEventId        String?          @map("domain_event_id") @db.Uuid

  order       Order        @relation("DeliveryReconciliationOrder", fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_delivery_reconciliations__order_id")
  claim       Claim?       @relation("DeliveryReconciliationClaim", fields: [claimId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_delivery_reconciliations__claim_id")
  domainEvent DomainEvent? @relation("DeliveryReconciliationEvent", fields: [domainEventId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_delivery_reconciliations__domain_event_id")

  @@index([claimId], map: "ix_delivery_reconciliations__claim_id")
  @@index([domainEventId], map: "ix_delivery_reconciliations__domain_event_id")
  @@map("delivery_reconciliations")
}

/// Public tracking (B4.4): only the SHA-256 of the token is stored; the page shows no PII.
model TrackingLink {
  id           BigInt    @id(map: "pk_tracking_links") @default(autoincrement())
  tokenHash    Bytes     @unique(map: "ux_tracking_links__token_hash") @map("token_hash")
  orderId      BigInt    @map("order_id")
  shipmentId   BigInt?   @map("shipment_id")
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  views        Int       @default(0)
  lastViewedAt DateTime? @map("last_viewed_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  order    Order     @relation("TrackingLinkOrder", fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_tracking_links__order_id")
  shipment Shipment? @relation(fields: [shipmentId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_tracking_links__shipment_id")

  @@index([orderId], map: "ix_tracking_links__order_id")
  @@index([shipmentId], map: "ix_tracking_links__shipment_id")
  @@map("tracking_links")
}

// =====================================================================================================
// Claims (D-082, D-083, D-080; B4.5)
// =====================================================================================================

enum ClaimType {
  damaged
  wrong_spec
  print_defect
  quantity_short
  late
  other

  @@map("claim_type")
}

enum ClaimOrigin {
  customer
  tolerance_auto
  staff

  @@map("claim_origin")
}

enum ClaimStatus {
  submitted
  under_review
  need_info
  factory_review
  approved
  rejected
  resolved
  closed

  @@map("claim_status")
}

enum ClaimResolutionKind {
  reprint
  partial_refund
  full_refund
  credit

  @@map("claim_resolution_kind")
}

enum ClaimLiability {
  factory
  customer
  carrier
  packio
  undetermined

  @@map("claim_liability")
}

enum FactoryClaimResponse {
  accepted
  disputed

  @@map("factory_claim_response")
}

enum ClaimAction {
  reproduction_job
  refund
  credit_note
  store_credit
  factory_deduction
  carrier_recovery

  @@map("claim_action")
}

/// A customer's claim within the window after receipt (D-082), an automatic one from a tolerance breach
/// (D-080) or one staff open. Evidence photos are attachments (`claim.product_photo`, `claim.carton_photo`).
/// Liability follows the rules (D-083) unless overridden with a reason by permission.
model Claim {
  id                      BigInt                @id(map: "pk_claims") @default(autoincrement())
  publicId                String                @unique(map: "ux_claims__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  claimNo                 String                @unique(map: "ux_claims__claim_no") @map("claim_no")
  entityId                BigInt                @map("entity_id")
  orderId                 BigInt                @map("order_id")
  shipmentId              BigInt?               @map("shipment_id")
  /// The job whose goods are claimed (liable factory's job).
  productionJobId         BigInt?               @map("production_job_id")
  customerUserId          BigInt                @map("customer_user_id")
  type                    ClaimType
  origin                  ClaimOrigin
  status                  ClaimStatus           @default(submitted)
  statusChangedAt         DateTime              @default(now()) @map("status_changed_at") @db.Timestamptz(6)
  description             String
  receivedAt              DateTime              @map("received_at") @db.Timestamptz(6)
  windowEndsAt            DateTime              @map("window_ends_at") @db.Timestamptz(6)
  submittedAt             DateTime              @default(now()) @map("submitted_at") @db.Timestamptz(6)
  requestedResolution     ClaimResolutionKind   @map("requested_resolution")
  claimedQuantity         Int?                  @map("claimed_quantity")
  claimedAmount           Decimal?              @map("claimed_amount") @db.Decimal(14, 2)
  liability               ClaimLiability        @default(undetermined)
  liabilityByRule         ClaimLiability        @map("liability_by_rule")
  liabilityOverriddenById BigInt?               @map("liability_overridden_by")
  overrideReason          String?               @map("override_reason")
  factoryId               BigInt?               @map("factory_id")
  factoryResponse         FactoryClaimResponse? @map("factory_response")
  factoryResponseNote     String?               @map("factory_response_note")
  factoryRespondedAt      DateTime?             @map("factory_responded_at") @db.Timestamptz(6)
  factoryRespondedById    BigInt?               @map("factory_responded_by")
  infoRequest             String?               @map("info_request")
  infoResponse            String?               @map("info_response")
  decisionNote            String?               @map("decision_note")
  decidedById             BigInt?               @map("decided_by")
  decidedAt               DateTime?             @map("decided_at") @db.Timestamptz(6)
  resolvedAt              DateTime?             @map("resolved_at") @db.Timestamptz(6)
  closedAt                DateTime?             @map("closed_at") @db.Timestamptz(6)
  createdById             BigInt?               @map("created_by")
  createdAt               DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion              Int                   @default(1) @map("row_version")

  entity                Entity                   @relation("ClaimEntity", fields: [entityId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_claims__entity_id")
  order                 Order                    @relation("ClaimOrder", fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_claims__order_id")
  shipment              Shipment?                @relation("ClaimShipment", fields: [shipmentId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_claims__shipment_id")
  productionJob         ProductionJob?           @relation("ClaimProductionJob", fields: [productionJobId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_claims__production_job_id")
  customer              User                     @relation("ClaimCustomer", fields: [customerUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_claims__customer_user_id")
  factory               Factory?                 @relation("ClaimFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_claims__factory_id")
  liabilityOverriddenBy User?                    @relation("ClaimLiabilityOverriddenBy", fields: [liabilityOverriddenById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_claims__liability_overridden_by")
  factoryRespondedBy    User?                    @relation("ClaimFactoryRespondedBy", fields: [factoryRespondedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_claims__factory_responded_by")
  decidedBy             User?                    @relation("ClaimDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_claims__decided_by")
  createdBy             User?                    @relation("ClaimCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_claims__created_by")
  resolutions           ClaimResolution[]
  reproductionJobs      ProductionJob[]          @relation("ProductionJobClaim")
  reconciliations       DeliveryReconciliation[] @relation("DeliveryReconciliationClaim")

  // --- Finance B5.2 (generated back-relations)
  creditNoteRequests CreditNoteRequest[] @relation("CreditNoteRequestClaim")
  // --- end Finance B5.2

  // --- Finance B5.3 (generated back-relations)
  vendorDeductions VendorDeduction[] @relation("VendorDeductionClaim")
  // --- end Finance B5.3

  @@index([orderId], map: "ix_claims__order_id")
  @@index([status, statusChangedAt], map: "ix_claims__status__status_changed_at")
  @@index([factoryId, status], map: "ix_claims__factory_id__status")
  @@index([customerUserId, createdAt(sort: Desc)], map: "ix_claims__customer_user_id__created_at")
  @@index([entityId], map: "ix_claims__entity_id")
  @@index([shipmentId], map: "ix_claims__shipment_id")
  @@index([productionJobId], map: "ix_claims__production_job_id")
  @@index([liabilityOverriddenById], map: "ix_claims__liability_overridden_by")
  @@index([factoryRespondedById], map: "ix_claims__factory_responded_by")
  @@index([decidedById], map: "ix_claims__decided_by")
  @@index([createdById], map: "ix_claims__created_by")
  @@index([submittedAt], map: "ix_claims__submitted_at")
  @@index([claimNo(ops: raw("gin_trgm_ops"))], type: Gin, map: "ix_claims__claim_no_trgm")
  @@map("claims")
}

/// What was done to resolve an approved claim, through existing mechanisms only (re-production PO, refund,
/// credit note / store credit, factory deduction, carrier recovery — the finance documents in B5).
model ClaimResolution {
  id                 BigInt      @id(map: "pk_claim_resolutions") @default(autoincrement())
  publicId           String      @unique(map: "ux_claim_resolutions__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  claimId            BigInt      @map("claim_id")
  action             ClaimAction
  amount             Decimal?    @db.Decimal(14, 2)
  quantity           Int?
  productionJobId    BigInt?     @map("production_job_id")
  refundId           BigInt?     @map("refund_id")
  /// The customer credit note / store credit document (FK with customer documents, B5).
  customerDocumentId BigInt?     @map("customer_document_id")
  /// The factory deduction (FK with vendor deductions, B5).
  vendorDeductionId  BigInt?     @map("vendor_deduction_id")
  note               String?
  executedAt         DateTime    @default(now()) @map("executed_at") @db.Timestamptz(6)
  executedById       BigInt      @map("executed_by")

  customerDocument CustomerDocument? @relation("ClaimResolutionCustomerDocument", fields: [customerDocumentId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_claim_resolutions__customer_document_id")
  vendorDeduction  VendorDeduction?  @relation("ClaimResolutionVendorDeduction", fields: [vendorDeductionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_claim_resolutions__vendor_deduction_id")

  claim         Claim          @relation(fields: [claimId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_claim_resolutions__claim_id")
  productionJob ProductionJob? @relation("ClaimResolutionJob", fields: [productionJobId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_claim_resolutions__production_job_id")
  refund        Refund?        @relation("ClaimResolutionRefund", fields: [refundId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_claim_resolutions__refund_id")
  executedBy    User           @relation("ClaimResolutionExecutedBy", fields: [executedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_claim_resolutions__executed_by")

  @@index([claimId], map: "ix_claim_resolutions__claim_id")
  @@index([productionJobId], map: "ix_claim_resolutions__production_job_id")
  @@index([refundId], map: "ix_claim_resolutions__refund_id")
  @@index([customerDocumentId], map: "ix_claim_resolutions__customer_document_id")
  @@index([vendorDeductionId], map: "ix_claim_resolutions__vendor_deduction_id")
  @@index([executedById], map: "ix_claim_resolutions__executed_by")
  @@map("claim_resolutions")
}

// =====================================================================================================
// LINE & conversations (D-143, D-151; B4.6)
// =====================================================================================================

enum LineFriendStatus {
  followed
  blocked
  unknown

  @@map("line_friend_status")
}

enum RichMenuAudience {
  guest
  member

  @@map("rich_menu_audience")
}

enum ConversationChannel {
  line
  web
  /// A guest's contact-form or hand-off ticket (D-221): no account, CS answers by phone or e-mail.
  contact

  @@map("conversation_channel")
}

enum ConversationStatus {
  open
  pending
  closed

  @@map("conversation_status")
}

enum MessageDirection {
  inbound
  outbound

  @@map("message_direction")
}

enum MessageKind {
  text
  image
  file
  sticker
  system

  @@map("message_kind")
}

/// A LINE user of Packio's official account (friend status from follow / unfollow), linked to a customer
/// once they sign in with LINE Login / LIFF (D-151). PII: the LINE user id, name and picture.
model LineAccount {
  id           BigInt           @id(map: "pk_line_accounts") @default(autoincrement())
  publicId     String           @unique(map: "ux_line_accounts__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  userId       BigInt?          @map("user_id")
  lineUserId   String           @map("line_user_id")
  channelId    String           @map("channel_id")
  displayName  String?          @map("display_name")
  pictureUrl   String?          @map("picture_url")
  friendStatus LineFriendStatus @default(unknown) @map("friend_status")
  richMenuKey  String?          @map("rich_menu_key")
  linkedAt     DateTime?        @map("linked_at") @db.Timestamptz(6)
  unlinkedAt   DateTime?        @map("unlinked_at") @db.Timestamptz(6)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user          User?          @relation("LineAccountUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_line_accounts__user_id")
  conversations Conversation[]

  @@unique([channelId, lineUserId], map: "ux_line_accounts__channel_id__line_user_id")
  @@index([userId], map: "ix_line_accounts__user_id")
  @@map("line_accounts")
}

/// The OA rich menus (created in LINE, registered here): one active per audience.
model LineRichMenu {
  id             BigInt           @id(map: "pk_line_rich_menus") @default(autoincrement())
  key            String           @unique(map: "ux_line_rich_menus__key")
  audience       RichMenuAudience
  providerMenuId String           @map("provider_menu_id")
  active         Boolean          @default(false)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById    BigInt?          @map("updated_by")

  updatedBy User? @relation("LineRichMenuUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_line_rich_menus__updated_by")

  @@unique([audience], map: "ux_line_rich_menus__one_active", where: raw("active"))
  @@index([updatedById], map: "ix_line_rich_menus__updated_by")
  @@map("line_rich_menus")
}

/// Chat with CS (D-151): from LINE or the web / LIFF; staff answer from the inbox.
model Conversation {
  id             BigInt              @id(map: "pk_conversations") @default(autoincrement())
  publicId       String              @unique(map: "ux_conversations__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  channel        ConversationChannel
  customerUserId BigInt?             @map("customer_user_id")
  lineAccountId  BigInt?             @map("line_account_id")
  status         ConversationStatus  @default(open)
  assignedUserId BigInt?             @map("assigned_user_id")
  lastMessageAt  DateTime            @default(now()) @map("last_message_at") @db.Timestamptz(6)
  closedAt       DateTime?           @map("closed_at") @db.Timestamptz(6)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion     Int                 @default(1) @map("row_version")

  customer     User?                 @relation("ConversationCustomer", fields: [customerUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_conversations__customer_user_id")
  lineAccount  LineAccount?          @relation(fields: [lineAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_conversations__line_account_id")
  assignedUser User?                 @relation("ConversationAssignedUser", fields: [assignedUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_conversations__assigned_user_id")
  messages     ConversationMessage[]
  tickets      SupportTicket[]

  @@unique([lineAccountId], map: "ux_conversations__one_live_line", where: raw("((line_account_id IS NOT NULL) AND (status <> 'closed'::conversation_status))"))
  @@unique([customerUserId], map: "ux_conversations__one_live_web", where: raw("((channel = 'web'::conversation_channel) AND (status <> 'closed'::conversation_status))"))
  @@index([status, lastMessageAt(sort: Desc)], map: "ix_conversations__status__last_message_at")
  @@index([assignedUserId, status], map: "ix_conversations__assigned_user_id__status")
  @@index([customerUserId], map: "ix_conversations__customer_user_id")
  @@index([lineAccountId], map: "ix_conversations__line_account_id")
  @@map("conversations")
}

enum SupportTicketSource {
  contact_form
  handoff

  @@map("support_ticket_source")
}

/// A request to CS from the storefront's contact form or guided-help hand-off (D-221), opened on a CS conversation
/// (a signed-in customer's live web conversation, or a new one for a guest). The contact details of a guest are PII:
/// shown to CS only, never logged. `respond_by` = submission + `support.first_response_business_days` business days.
model SupportTicket {
  id                BigInt              @id(map: "pk_support_tickets") @default(autoincrement())
  publicId          String              @unique(map: "ux_support_tickets__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  ticketNo          String              @unique(map: "ux_support_tickets__ticket_no") @map("ticket_no")
  conversationId    BigInt              @map("conversation_id")
  customerUserId    BigInt?             @map("customer_user_id")
  source            SupportTicketSource
  topic             String
  contactName       String?             @map("contact_name")
  contactPhone      String?             @map("contact_phone")
  contactEmail      String?             @map("contact_email")
  /// The order code the requester typed (not resolved: a guest cannot prove the order is theirs).
  orderRef          String?             @map("order_ref")
  callbackRequested Boolean             @default(false) @map("callback_requested")
  /// Hand-off: the page and the guided-help answers / recommendation (bounded JSON).
  context           Json?
  respondBy         DateTime            @map("respond_by") @db.Timestamptz(6)
  firstRespondedAt  DateTime?           @map("first_responded_at") @db.Timestamptz(6)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_support_tickets__conversation_id")
  customer     User?        @relation("SupportTicketCustomer", fields: [customerUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_support_tickets__customer_user_id")

  @@index([conversationId], map: "ix_support_tickets__conversation_id")
  @@index([customerUserId], map: "ix_support_tickets__customer_user_id")
  @@index([respondBy], map: "ix_support_tickets__unanswered__respond_by", where: raw("(first_responded_at IS NULL)"))
  @@map("support_tickets")
}

model ConversationMessage {
  id                BigInt           @id(map: "pk_conversation_messages") @default(autoincrement())
  publicId          String           @unique(map: "ux_conversation_messages__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  conversationId    BigInt           @map("conversation_id")
  direction         MessageDirection
  senderUserId      BigInt?          @map("sender_user_id")
  kind              MessageKind
  body              String?
  fileObjectId      BigInt?          @map("file_object_id")
  providerMessageId String?          @unique(map: "ux_conversation_messages__provider_message_id") @map("provider_message_id")
  sentAt            DateTime         @map("sent_at") @db.Timestamptz(6)
  readAt            DateTime?        @map("read_at") @db.Timestamptz(6)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_conversation_messages__conversation_id")
  senderUser   User?        @relation("ConversationMessageSender", fields: [senderUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_conversation_messages__sender_user_id")
  fileObject   FileObject?  @relation("ConversationMessageFile", fields: [fileObjectId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_conversation_messages__file_object_id")

  @@index([conversationId, sentAt], map: "ix_conversation_messages__conversation_id__sent_at")
  @@index([senderUserId], map: "ix_conversation_messages__sender_user_id")
  @@index([fileObjectId], map: "ix_conversation_messages__file_object_id")
  @@map("conversation_messages")
}
