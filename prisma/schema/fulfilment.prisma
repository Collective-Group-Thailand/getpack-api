  company            Company?                @relation("DesignDocumentCompany", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_design_documents__company_id")
  catalogProduct     CatalogProduct          @relation("DesignDocumentCatalogProduct", fields: [catalogProductId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_design_documents__catalog_product_id")
  pattern            Pattern?                @relation("DesignDocumentPattern", fields: [patternId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_design_documents__pattern_id")
  material           Material?               @relation("DesignDocumentMaterial", fields: [materialId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_design_documents__material_id")
  semiDesignTemplate SemiDesignTemplate?     @relation("DesignDocumentSemiDesignTemplate", fields: [semiDesignTemplateId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_design_documents__semi_design_template_id")
  thumbnailFile      FileObject?             @relation("DesignDocumentThumbnail", fields: [thumbnailFileId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_design_documents__thumbnail_file_id")
  currentVersion     DesignDocumentVersion?  @relation("DesignDocumentCurrentVersion", fields: [currentVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_design_documents__current_version_id")
  versions           DesignDocumentVersion[] @relation("DesignDocumentVersions")
  assets             DesignAsset[]
