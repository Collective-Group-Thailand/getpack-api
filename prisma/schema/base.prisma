// Datasource and generator only. Models live in one file per bounded context, following
// docs/schema-design.md (platform.prisma and iam.prisma from B1.2).

generator client {
  provider            = "prisma-client"
  output              = "../../src/generated/prisma"
  moduleFormat        = "cjs"
  runtime             = "nodejs"
  importFileExtension = ""
  // Partial unique indexes (schema-design §1.5).
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}
