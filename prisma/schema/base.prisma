// Datasource and generator only. Models live in one file per bounded context, following
// docs/schema-design.md (platform.prisma and iam.prisma from B1.2).

// The clients are generated by `pnpm prisma:generate` (scripts/prisma-clients.mjs, ADR-0013), which copies this
// block with its own output per client. This output only catches a bare `prisma generate` of the full schema,
// outside the TypeScript program.
generator client {
  provider            = "prisma-client"
  output              = "../../node_modules/.prisma-full-schema"
  moduleFormat        = "cjs"
  runtime             = "nodejs"
  importFileExtension = ""
  // Partial unique indexes (schema-design §1.5).
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}
