/// Charge lines of an order (§2.9 amount set). Replaced only by a re-price before production.
model OrderLine {
  id                BigInt          @id(map: "pk_order_lines") @default(autoincrement())
  publicId          String          @unique(map: "ux_order_lines__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  orderId           BigInt          @map("order_id")
  lineNo            Int             @map("line_no") @db.SmallInt
  lineType          OrderLineType   @map("line_type")
  descriptionTh     String          @map("description_th")
  descriptionEn     String          @map("description_en")
  quantity          Decimal         @db.Decimal(14, 3)
  unit              ProductUnit
  unitPrice         Decimal         @map("unit_price") @db.Decimal(18, 6)
  netAmount         Decimal         @map("net_amount") @db.Decimal(14, 2)
  discountAmount    Decimal         @default(0) @map("discount_amount") @db.Decimal(14, 2)
  vatRatePct        Decimal         @map("vat_rate_pct") @db.Decimal(7, 4)
  vatAmount         Decimal         @map("vat_amount") @db.Decimal(14, 2)
  grossAmount       Decimal         @map("gross_amount") @db.Decimal(14, 2)
  whtCategory       WhtCategory     @map("wht_category")
  whtRatePct        Decimal         @default(0) @map("wht_rate_pct") @db.Decimal(7, 4)
  whtAmount         Decimal         @default(0) @map("wht_amount") @db.Decimal(14, 2)
  revenueCategory   RevenueCategory @map("revenue_category")
  taxNature         TaxNature       @map("tax_nature")
  isReusableTooling Boolean         @default(false) @map("is_reusable_tooling")
  waivedReason      String?         @map("waived_reason")
  /// Staff-only.
  buyCostNet        Decimal?        @map("buy_cost_net") @db.Decimal(14, 2)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  order     Order           @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_order_lines__order_id")
  discounts OrderDiscount[]

  // --- Fulfilment B4.1 (generated back-relations)
  designRounds     DesignRound[] @relation("DesignRoundOrderLine")
  addOnInstalments Instalment[]  @relation("InstalmentAddOnLine")
  // --- end Fulfilment B4.1

  // --- Fulfilment B4.2 (generated back-relations)
  productionJobs ProductionJob[] @relation("ProductionJobOrderLine")
  // --- end Fulfilment B4.2

  // --- Finance B5.2 (generated back-relations)
  customerDocumentLines CustomerDocumentLine[] @relation("CustomerDocumentLineOrderLine")
  // --- end Finance B5.2

  sample Sample? @relation("SampleOrderLine")

  review OrderReview? @relation("OrderReviewOrderLine")

  @@unique([orderId, lineNo], map: "ux_order_lines__order_id__line_no")
  @@map("order_lines")
}

/// Every discount applied to an order (feeds P09/P11 with its source dimension). Promotion, coupon,
/// campaign and memo references are added by B3.3 and B3.5.
model OrderDiscount {
  id              BigInt         @id(map: "pk_order_discounts") @default(autoincrement())
  orderId         BigInt         @map("order_id")
  orderLineId     BigInt?        @map("order_line_id")
  source          DiscountSource
  grantedByUserId BigInt?        @map("granted_by_user_id")
  pct             Decimal?       @db.Decimal(7, 4)
  amount          Decimal        @db.Decimal(14, 2)
  /// Amount the margin guard removed (D-053).
  cappedAmount    Decimal        @default(0) @map("capped_amount") @db.Decimal(14, 2)
  capReason       String?        @map("cap_reason")
  promotionId     BigInt?        @map("promotion_id")
  couponCodeId    BigInt?        @map("coupon_code_id")
  campaignId      BigInt?        @map("campaign_id")
  redemptionId    BigInt?        @map("redemption_id")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  discountMemoId  BigInt?        @map("discount_memo_id")

  order      Order                @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_order_discounts__order_id")
  orderLine  OrderLine?           @relation(fields: [orderLineId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_order_discounts__order_line_id")
  grantedBy  User?                @relation("OrderDiscountGrantedBy", fields: [grantedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_order_discounts__granted_by_user_id")
  promotion  Promotion?           @relation("OrderDiscountPromotion", fields: [promotionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_order_discounts__promotion_id")
  couponCode CouponCode?          @relation("OrderDiscountCoupon", fields: [couponCodeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_order_discounts__coupon_code_id")
  campaign   Campaign?            @relation("OrderDiscountCampaign", fields: [campaignId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_order_discounts__campaign_id")
  redemption PromotionRedemption? @relation("OrderDiscountRedemption", fields: [redemptionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_order_discounts__redemption_id")

  discountMemo DiscountMemo? @relation("OrderDiscountMemo", fields: [discountMemoId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_order_discounts__discount_memo_id")

  @@index([discountMemoId], map: "ix_order_discounts__discount_memo_id")
  @@index([orderId], map: "ix_order_discounts__order_id")
  @@index([orderLineId], map: "ix_order_discounts__order_line_id")
  @@index([grantedByUserId], map: "ix_order_discounts__granted_by_user_id")
  @@index([promotionId], map: "ix_order_discounts__promotion_id")
  @@index([couponCodeId], map: "ix_order_discounts__coupon_code_id")
  @@index([campaignId], map: "ix_order_discounts__campaign_id")
  @@index([redemptionId], map: "ix_order_discounts__redemption_id")
  @@map("order_discounts")
}

/// Delivery destination snapshot: the only customer data a factory sees (D-142). PII.
model OrderDestination {
