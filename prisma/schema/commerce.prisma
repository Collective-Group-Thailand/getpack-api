  @@map("promotion_kind")
}

enum StackingMode {
  exclusive
  stackable
  best_of

  @@map("stacking_mode")
}

enum PromotionStatus {
  draft
  active
  paused
  ended

  @@map("promotion_status")
}

enum CouponKind {
  single
  bulk_unique
  per_customer

  @@map("coupon_kind")
}

enum CouponStatus {
  active
  used_up
  disabled

  @@map("coupon_status")
}

enum RedemptionStatus {
