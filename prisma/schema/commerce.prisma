// --- Promotions, campaigns, referral (D-053, D-136, D-154, B3.3) ----------------------------------

/// A time-boxed container with a THB budget (D-154): auto-stop when spent, Marketing alerted at 80 %.
model Campaign {
  id                BigInt         @id(map: "pk_campaigns") @default(autoincrement())
  publicId          String         @unique(map: "ux_campaigns__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  entityId          BigInt         @map("entity_id")
  code              String         @unique(map: "ux_campaigns__code")
  name              String
  startsAt          DateTime       @map("starts_at") @db.Timestamptz(6)
  endsAt            DateTime?      @map("ends_at") @db.Timestamptz(6)
  budgetAmount      Decimal?       @map("budget_amount") @db.Decimal(14, 2)
  spentAmount       Decimal        @default(0) @map("spent_amount") @db.Decimal(14, 2)
  /// Snapshot of `campaigns.budget_alert_pct` when the campaign was created (D-154).
  alertThresholdPct Decimal        @map("alert_threshold_pct") @db.Decimal(7, 4)
  alertedAt         DateTime?      @map("alerted_at") @db.Timestamptz(6)
  status            CampaignStatus @default(draft)
  goals             Json           @default("{}")
  ownerUserId       BigInt         @map("owner_user_id")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById       BigInt?        @map("created_by")
  updatedAt         DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion        Int            @default(1) @map("row_version")

  entity      Entity                @relation("CampaignEntity", fields: [entityId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_campaigns__entity_id")
  owner       User                  @relation("CampaignOwner", fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_campaigns__owner_user_id")
  createdBy   User?                 @relation("CampaignCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_campaigns__created_by")
  promotions  Promotion[]
  redemptions PromotionRedemption[]
  discounts   OrderDiscount[]       @relation("OrderDiscountCampaign")

  // --- Finance B5.1 (generated back-relations)
  journalLines JournalLine[] @relation("JournalLineCampaign")
  // --- end Finance B5.1

  @@index([status, startsAt], map: "ix_campaigns__status__starts_at")
  @@index([entityId], map: "ix_campaigns__entity_id")
  @@index([ownerUserId], map: "ix_campaigns__owner_user_id")
  @@index([createdById], map: "ix_campaigns__created_by")
  @@map("campaigns")
}

/// A promotion (D-053): conditions and benefit as versioned JSON; redemptions snapshot what was used.
model Promotion {
  id                      BigInt          @id(map: "pk_promotions") @default(autoincrement())
  publicId                String          @unique(map: "ux_promotions__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  entityId                BigInt          @map("entity_id")
  campaignId              BigInt?         @map("campaign_id")
  name                    String
  description             String?
  kind                    PromotionKind
  priority                Int             @db.SmallInt
  stacking                StackingMode
  stackGroup              String?         @map("stack_group")
  startsAt                DateTime        @map("starts_at") @db.Timestamptz(6)
  endsAt                  DateTime?       @map("ends_at") @db.Timestamptz(6)
  conditions              Json
  conditionsSchemaVersion Int             @default(1) @map("conditions_schema_version") @db.SmallInt
  benefit                 Json
  benefitSchemaVersion    Int             @default(1) @map("benefit_schema_version") @db.SmallInt
  usageLimitTotal         Int?            @map("usage_limit_total")
  usageLimitPerCustomer   Int?            @map("usage_limit_per_customer")
  budgetAmount            Decimal?        @map("budget_amount") @db.Decimal(14, 2)
  spentAmount             Decimal         @default(0) @map("spent_amount") @db.Decimal(14, 2)
  status                  PromotionStatus @default(draft)
  createdAt               DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById             BigInt?         @map("created_by")
  updatedAt               DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById             BigInt?         @map("updated_by")
  rowVersion              Int             @default(1) @map("row_version")

  entity      Entity                  @relation("PromotionEntity", fields: [entityId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_promotions__entity_id")
  campaign    Campaign?               @relation(fields: [campaignId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_promotions__campaign_id")
  createdBy   User?                   @relation("PromotionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_promotions__created_by")
  updatedBy   User?                   @relation("PromotionUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_promotions__updated_by")
  batches     CouponBatch[]
  codes       CouponCode[]
  counters    PromotionUsageCounter[]
  redemptions PromotionRedemption[]
  cartCodes   CartCode[]              @relation("CartCodePromotion")
  discounts   OrderDiscount[]         @relation("OrderDiscountPromotion")

  // --- Finance B5.1 (generated back-relations)
  journalLines JournalLine[] @relation("JournalLinePromotion")
  // --- end Finance B5.1

  @@index([status, kind, startsAt], map: "ix_promotions__status__kind__starts_at")
  @@index([entityId], map: "ix_promotions__entity_id")
  @@index([campaignId], map: "ix_promotions__campaign_id")
  @@index([createdById], map: "ix_promotions__created_by")
  @@index([updatedById], map: "ix_promotions__updated_by")
  @@map("promotions")
}

/// A batch of codes generated for a coupon promotion.
model CouponBatch {
  id          BigInt     @id(map: "pk_coupon_batches") @default(autoincrement())
  publicId    String     @unique(map: "ux_coupon_batches__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  promotionId BigInt     @map("promotion_id")
  kind        CouponKind
  count       Int
  prefix      String?
  generatedAt DateTime   @default(now()) @map("generated_at") @db.Timestamptz(6)
  createdById BigInt?    @map("created_by")

  promotion Promotion    @relation(fields: [promotionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_coupon_batches__promotion_id")
  createdBy User?        @relation("CouponBatchCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_coupon_batches__created_by")
  codes     CouponCode[]

  @@index([promotionId], map: "ix_coupon_batches__promotion_id")
  @@index([createdById], map: "ix_coupon_batches__created_by")
  @@map("coupon_batches")
}

/// A coupon code (case-insensitive, unique); per-customer codes are assigned to one customer.
model CouponCode {
  id             BigInt       @id(map: "pk_coupon_codes") @default(autoincrement())
  publicId       String       @unique(map: "ux_coupon_codes__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  promotionId    BigInt       @map("promotion_id")
  batchId        BigInt?      @map("batch_id")
  code           String       @unique(map: "ux_coupon_codes__code") @db.Citext
  assignedUserId BigInt?      @map("assigned_user_id")
  usageLimit     Int?         @map("usage_limit")
  usedCount      Int          @default(0) @map("used_count")
  status         CouponStatus @default(active)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  promotion    Promotion             @relation(fields: [promotionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_coupon_codes__promotion_id")
  batch        CouponBatch?          @relation(fields: [batchId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_coupon_codes__batch_id")
  assignedUser User?                 @relation("CouponCodeAssignedUser", fields: [assignedUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_coupon_codes__assigned_user_id")
  redemptions  PromotionRedemption[]
  savedBy      CustomerSavedCoupon[]
  cartCodes    CartCode[]            @relation("CartCodeCoupon")
  discounts    OrderDiscount[]       @relation("OrderDiscountCoupon")

  @@index([promotionId], map: "ix_coupon_codes__promotion_id")
  @@index([batchId], map: "ix_coupon_codes__batch_id")
  @@index([assignedUserId], map: "ix_coupon_codes__assigned_user_id")
  @@map("coupon_codes")
}

/// Usage of a promotion: `customer_key` 0 counts every use, a user id counts that customer (row-locked).
model PromotionUsageCounter {
  id          BigInt @id(map: "pk_promotion_usage_counters") @default(autoincrement())
  promotionId BigInt @map("promotion_id")
  customerKey BigInt @default(0) @map("customer_key")
  usedCount   Int    @default(0) @map("used_count")

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_promotion_usage_counters__promotion_id")

  @@unique([promotionId, customerKey], map: "ux_promotion_usage_counters__promotion_id__customer_key")
  @@map("promotion_usage_counters")
}

/// A promotion used on an order group: reserved at checkout, applied once paid, reversed on cancel.
model PromotionRedemption {
  id             BigInt           @id(map: "pk_promotion_redemptions") @default(autoincrement())
  publicId       String           @unique(map: "ux_promotion_redemptions__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  promotionId    BigInt           @map("promotion_id")
  couponCodeId   BigInt?          @map("coupon_code_id")
  campaignId     BigInt?          @map("campaign_id")
  orderGroupId   BigInt           @map("order_group_id")
  customerUserId BigInt           @map("customer_user_id")
  amount         Decimal          @db.Decimal(14, 2)
  cappedAmount   Decimal          @default(0) @map("capped_amount") @db.Decimal(14, 2)
  status         RedemptionStatus @default(reserved)
  snapshot       Json
  reservedAt     DateTime         @default(now()) @map("reserved_at") @db.Timestamptz(6)
  appliedAt      DateTime?        @map("applied_at") @db.Timestamptz(6)
  reversedAt     DateTime?        @map("reversed_at") @db.Timestamptz(6)

  promotion  Promotion       @relation(fields: [promotionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_promotion_redemptions__promotion_id")
  couponCode CouponCode?     @relation(fields: [couponCodeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_promotion_redemptions__coupon_code_id")
  campaign   Campaign?       @relation(fields: [campaignId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_promotion_redemptions__campaign_id")
  orderGroup OrderGroup      @relation("PromotionRedemptionGroup", fields: [orderGroupId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_promotion_redemptions__order_group_id")
  customer   User            @relation("PromotionRedemptionCustomer", fields: [customerUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_promotion_redemptions__customer_user_id")
  discounts  OrderDiscount[] @relation("OrderDiscountRedemption")

  @@unique([promotionId, orderGroupId], map: "ux_promotion_redemptions__promotion_id__order_group_id")
  @@index([orderGroupId], map: "ix_promotion_redemptions__order_group_id")
  @@index([couponCodeId], map: "ix_promotion_redemptions__coupon_code_id")
  @@index([campaignId], map: "ix_promotion_redemptions__campaign_id")
  @@index([customerUserId], map: "ix_promotion_redemptions__customer_user_id")
  @@index([appliedAt], map: "ix_promotion_redemptions__applied_at", where: raw("(applied_at IS NOT NULL)"))
  @@map("promotion_redemptions")
}

/// Coupons a customer keeps in their wallet.
model CustomerSavedCoupon {
  userId       BigInt   @map("user_id")
  couponCodeId BigInt   @map("coupon_code_id")
  savedAt      DateTime @default(now()) @map("saved_at") @db.Timestamptz(6)

  user       User       @relation("CustomerSavedCouponUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_customer_saved_coupons__user_id")
  couponCode CouponCode @relation(fields: [couponCodeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_customer_saved_coupons__coupon_code_id")

  @@id([userId, couponCodeId], map: "pk_customer_saved_coupons")
  @@index([couponCodeId], map: "ix_customer_saved_coupons__coupon_code_id")
  @@map("customer_saved_coupons")
}

/// Hashed identity traits for abuse controls (D-053, D-136): phone, delivery address, card token, device.
model IdentityFingerprint {
  id          BigInt          @id(map: "pk_identity_fingerprints") @default(autoincrement())
  userId      BigInt          @map("user_id")
  kind        FingerprintKind
  valueHash   Bytes           @map("value_hash")
  firstSeenAt DateTime        @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt  DateTime        @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  user User @relation("IdentityFingerprintUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_identity_fingerprints__user_id")

  @@unique([userId, kind, valueHash], map: "ux_identity_fingerprints__user_id__kind__value_hash")
  @@index([kind, valueHash], map: "ix_identity_fingerprints__kind__value_hash")
  @@map("identity_fingerprints")
}

/// Referee → referrer (D-136); rewarded after the referee's first order passes the claim window.
model ReferralAttribution {
  id                BigInt         @id(map: "pk_referral_attributions") @default(autoincrement())
  publicId          String         @unique(map: "ux_referral_attributions__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  referrerUserId    BigInt         @map("referrer_user_id")
  refereeUserId     BigInt         @unique(map: "ux_referral_attributions__referee_user_id") @map("referee_user_id")
  referralCode      String         @map("referral_code")
  attributedAt      DateTime       @default(now()) @map("attributed_at") @db.Timestamptz(6)
  firstOrderGroupId BigInt?        @map("first_order_group_id")
  status            ReferralStatus @default(pending)
  fraudFlags        String[]       @default([]) @map("fraud_flags")
  approvalRequestId BigInt?        @map("approval_request_id")
  qualifiedAt       DateTime?      @map("qualified_at") @db.Timestamptz(6)
  decidedAt         DateTime?      @map("decided_at") @db.Timestamptz(6)
  rewardedAt        DateTime?      @map("rewarded_at") @db.Timestamptz(6)

  referrer        User             @relation("ReferralReferrer", fields: [referrerUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_referral_attributions__referrer_user_id")
  referee         User             @relation("ReferralReferee", fields: [refereeUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_referral_attributions__referee_user_id")
  firstOrderGroup OrderGroup?      @relation("ReferralFirstOrderGroup", fields: [firstOrderGroupId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_referral_attributions__first_order_group_id")
  approvalRequest ApprovalRequest? @relation("ReferralApprovalRequest", fields: [approvalRequestId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_referral_attributions__approval_request_id")

  pointsEntries PointsEntry[]

  @@index([referrerUserId, status], map: "ix_referral_attributions__referrer_user_id__status")
  @@index([firstOrderGroupId], map: "ix_referral_attributions__first_order_group_id")
  @@index([approvalRequestId], map: "ix_referral_attributions__approval_request_id")
  @@map("referral_attributions")
}

// --- Loyalty (D-130…D-135, B3.4; schema-design §3.6) -----------------------------------------------

enum LoyaltyTier {
  member
  silver
  gold

  @@map("loyalty_tier")
}

enum PointsEntryType {
  earn_order
  earn_signup
  earn_line_link
  earn_review
  earn_referral
  earn_bonus
  redeem
  redeem_reversal
  reversal_claim_refund
  expire
  adjust

  @@map("points_entry_type")
}

enum PointsStatus {
  pending
  available
  expired
  reversed

  @@map("points_status")
}

enum ReviewStatus {
  pending
  published
  hidden

  @@map("review_status")
}

/// A customer's tier from 12-month spend, recalculated nightly (D-134); thresholds are settings.
model LoyaltyMembership {
  userId                BigInt      @id(map: "pk_loyalty_memberships") @map("user_id")
  tier                  LoyaltyTier @default(member)
  spend12m              Decimal     @default(0) @map("spend_12m") @db.Decimal(14, 2)
  multiplier            Decimal     @default(1) @db.Decimal(5, 2)
  tiersSettingVersionId BigInt?     @map("tiers_setting_version_id")
  evaluatedAt           DateTime?   @map("evaluated_at") @db.Timestamptz(6)
  createdAt             DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion            Int         @default(1) @map("row_version")

  user                User            @relation("LoyaltyMembershipUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_loyalty_memberships__user_id")
  tiersSettingVersion SettingVersion? @relation("LoyaltyMembershipTiersVersion", fields: [tiersSettingVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_loyalty_memberships__tiers_setting_version_id")

  @@index([tiersSettingVersionId], map: "ix_loyalty_memberships__tiers_setting_version_id")
  @@map("loyalty_memberships")
}

/// Append-only points ledger (D-130…D-133): signed points at the point value in force; only the status
/// of an earning moves (pending → available | reversed, available → expired).
model PointsEntry {
  id                         BigInt          @id(map: "pk_points_ledger") @default(autoincrement())
  publicId                   String          @unique(map: "ux_points_ledger__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  userId                     BigInt          @map("user_id")
  entryType                  PointsEntryType @map("entry_type")
  points                     Int
  pointValue                 Decimal         @map("point_value") @db.Decimal(18, 6)
  pointValueSettingVersionId BigInt?         @map("point_value_setting_version_id")
  bahtValue                  Decimal         @map("baht_value") @db.Decimal(14, 2)
  status                     PointsStatus
  availableAt                DateTime?       @map("available_at") @db.Timestamptz(6)
  expiresAt                  DateTime?       @map("expires_at") @db.Timestamptz(6)
  orderId                    BigInt?         @map("order_id")
  orderGroupId               BigInt?         @map("order_group_id")
  reviewId                   BigInt?         @map("review_id")
  referralAttributionId      BigInt?         @map("referral_attribution_id")
  reversesEntryId            BigInt?         @map("reverses_entry_id")
  reason                     String?
  domainEventId              String?         @map("domain_event_id") @db.Uuid
  createdAt                  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById                BigInt?         @map("created_by")

  user                User                   @relation("PointsEntryUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_points_ledger__user_id")
  pointValueVersion   SettingVersion?        @relation("PointsEntryPointValueVersion", fields: [pointValueSettingVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_points_ledger__point_value_setting_version_id")
  order               Order?                 @relation("PointsEntryOrder", fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_points_ledger__order_id")
  orderGroup          OrderGroup?            @relation("PointsEntryOrderGroup", fields: [orderGroupId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_points_ledger__order_group_id")
  review              OrderReview?           @relation(fields: [reviewId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_points_ledger__review_id")
  referralAttribution ReferralAttribution?   @relation(fields: [referralAttributionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_points_ledger__referral_attribution_id")
  reversesEntry       PointsEntry?           @relation("PointsEntryReverses", fields: [reversesEntryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_points_ledger__reverses_entry_id")
  reversedBy          PointsEntry[]          @relation("PointsEntryReverses")
  createdBy           User?                  @relation("PointsEntryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_points_ledger__created_by")
  lot                 PointsLot?
  consumptions        PointsLotConsumption[]

  @@unique([userId, entryType], map: "ux_points_ledger__one_off_rewards", where: raw("(entry_type = ANY (ARRAY['earn_signup'::points_entry_type, 'earn_line_link'::points_entry_type]))"))
  @@unique([reviewId], map: "ux_points_ledger__review_reward", where: raw("(entry_type = 'earn_review'::points_entry_type)"))
  @@unique([orderId, entryType], map: "ux_points_ledger__order_earning", where: raw("(entry_type = 'earn_order'::points_entry_type)"))
  @@unique([referralAttributionId], map: "ux_points_ledger__referral_reward", where: raw("(entry_type = 'earn_referral'::points_entry_type)"))
  @@unique([orderGroupId], map: "ux_points_ledger__group_redemption", where: raw("(entry_type = 'redeem'::points_entry_type)"))
  @@index([userId, createdAt(sort: Desc)], map: "ix_points_ledger__user_id__created_at")
  @@index([availableAt], map: "ix_points_ledger__pending", where: raw("(status = 'pending'::points_status)"))
  @@index([pointValueSettingVersionId], map: "ix_points_ledger__point_value_setting_version_id")
  @@index([orderId], map: "ix_points_ledger__order_id")
  @@index([orderGroupId], map: "ix_points_ledger__order_group_id")
  @@index([reviewId], map: "ix_points_ledger__review_id")
  @@index([referralAttributionId], map: "ix_points_ledger__referral_attribution_id")
  @@index([reversesEntryId], map: "ix_points_ledger__reverses_entry_id")
  @@index([createdById], map: "ix_points_ledger__created_by")
  @@map("points_ledger")
}

/// One lot per credited earning; redemptions, reversals and expiry consume lots FIFO by expiry (D-132).
model PointsLot {
  id          BigInt    @id(map: "pk_points_lots") @default(autoincrement())
  earnEntryId BigInt    @unique(map: "ux_points_lots__earn_entry_id") @map("earn_entry_id")
  userId      BigInt    @map("user_id")
  points      Int
  remaining   Int
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  remindedAt  DateTime? @map("reminded_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  earnEntry    PointsEntry            @relation(fields: [earnEntryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_points_lots__earn_entry_id")
  user         User                   @relation("PointsLotUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_points_lots__user_id")
  consumptions PointsLotConsumption[]

  @@index([userId, expiresAt], map: "ix_points_lots__open", where: raw("(remaining > 0)"))
  @@map("points_lots")
}

/// What each entry took from (positive) or gave back to (negative) a lot; append-only.
model PointsLotConsumption {
  id               BigInt   @id(map: "pk_points_lot_consumptions") @default(autoincrement())
  lotId            BigInt   @map("lot_id")
  consumingEntryId BigInt   @map("consuming_entry_id")
  points           Int
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  lot            PointsLot   @relation(fields: [lotId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_points_lot_consumptions__lot_id")
  consumingEntry PointsEntry @relation(fields: [consumingEntryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_points_lot_consumptions__consuming_entry_id")

  @@index([lotId], map: "ix_points_lot_consumptions__lot_id")
  @@index([consumingEntryId], map: "ix_points_lot_consumptions__consuming_entry_id")
  @@map("points_lot_consumptions")
}

/// A customer's review of a delivered order (D-135 activity reward); CS may hide it.
model OrderReview {
  id            BigInt       @id(map: "pk_order_reviews") @default(autoincrement())
  publicId      String       @unique(map: "ux_order_reviews__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  orderId       BigInt       @unique(map: "ux_order_reviews__order_id") @map("order_id")
  /// D-265: the product line reviewed (one per line; an order has one product line).
  orderLineId   BigInt?      @unique(map: "ux_order_reviews__order_line_id") @map("order_line_id")
  userId        BigInt       @map("user_id")
  rating        Int          @db.SmallInt
  comment       String?
  status        ReviewStatus @default(published)
  moderatedById BigInt?      @map("moderated_by")
  moderatedAt   DateTime?    @map("moderated_at") @db.Timestamptz(6)
  /// D-265: one reply by CS, editable with audit.
  replyBody     String?      @map("reply_body")
  repliedAt     DateTime?    @map("replied_at") @db.Timestamptz(6)
  repliedById   BigInt?      @map("replied_by")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion    Int          @default(1) @map("row_version")

  order         Order         @relation("OrderReviewOrder", fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_order_reviews__order_id")
  user          User          @relation("OrderReviewUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_order_reviews__user_id")
  moderatedBy   User?         @relation("OrderReviewModeratedBy", fields: [moderatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_order_reviews__moderated_by")
  orderLine     OrderLine?    @relation("OrderReviewOrderLine", fields: [orderLineId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_order_reviews__order_line_id")
  repliedBy     User?         @relation("OrderReviewRepliedBy", fields: [repliedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_order_reviews__replied_by")
  pointsEntries PointsEntry[]

  @@index([userId], map: "ix_order_reviews__user_id")
  @@index([moderatedById], map: "ix_order_reviews__moderated_by")
  @@index([repliedById], map: "ix_order_reviews__replied_by")
  @@index([status, createdAt], map: "ix_order_reviews__status__created_at")
  @@map("order_reviews")
}

// --- B2B companies & discount memos (D-120…D-125, D-052, B3.5; schema-design §3.6) -----------------

enum CompanyStatus {
  applied
  kyc_review
  active
  suspended
  closed

  @@map("company_status")
}

enum CreditStatus {
  prepaid
  eligible
  credit
  blocked_overdue

  @@map("credit_status")
}

enum PoNumberPolicy {
  required
  optional
  none

  @@map("po_number_policy")
}

enum MemberStatus {
  invited
  active
  removed

  @@map("member_status")
}

enum MemoStatus {
  draft
  pending_approval
  approved
  rejected
  withdrawn
  expired
  applied

  @@map("memo_status")
}

/// A B2B customer company (D-120…D-125). Members act for it through company-scoped roles.
model Company {
  id                     BigInt         @id(map: "pk_companies") @default(autoincrement())
  publicId               String         @unique(map: "ux_companies__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  entityId               BigInt         @map("entity_id")
  companyCode            String?        @unique(map: "ux_companies__company_code") @map("company_code")
  legalName              String         @map("legal_name")
  tradeName              String?        @map("trade_name")
  taxId                  String         @map("tax_id") @db.Char(13)
  isVatRegistered        Boolean        @default(true) @map("is_vat_registered")
  /// The company withholds tax on payments to Packio (accounting-design §2, P03).
  withholdsTax           Boolean        @default(false) @map("withholds_tax")
  documentEmail          String?        @map("document_email") @db.Citext
  /// The authorised signatory (D-120): needed before the KYC review.
  signatoryName          String?        @map("signatory_name")
  signatoryPosition      String?        @map("signatory_position")
  contactPhone           String?        @map("contact_phone")
  status                 CompanyStatus  @default(applied)
  creditStatus           CreditStatus   @default(prepaid) @map("credit_status")
  poNumberPolicy         PoNumberPolicy @default(optional) @map("po_number_policy")
  /// Orders above this value wait for the company's approver (D-123); null = never.
  orderApprovalThreshold Decimal?       @map("order_approval_threshold") @db.Decimal(14, 2)
  /// Cache of paid order groups for credit eligibility (D-121).
  paidOrdersCount        Int            @default(0) @map("paid_orders_count")
  appliedById            BigInt         @map("applied_by")
  kycReviewedById        BigInt?        @map("kyc_reviewed_by")
  kycApprovedAt          DateTime?      @map("kyc_approved_at") @db.Timestamptz(6)
  statusReason           String?        @map("status_reason")
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById            BigInt?        @map("updated_by")
  rowVersion             Int            @default(1) @map("row_version")

  entity        Entity               @relation("CompanyEntity", fields: [entityId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_companies__entity_id")
  appliedBy     User                 @relation("CompanyAppliedBy", fields: [appliedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_companies__applied_by")
  kycReviewedBy User?                @relation("CompanyKycReviewedBy", fields: [kycReviewedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_companies__kyc_reviewed_by")
  updatedBy     User?                @relation("CompanyUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_companies__updated_by")
  branches      CompanyBranch[]
  members       CompanyMember[]
  kycDocuments  CompanyKycDocument[]
  creditLimit   CompanyCreditLimit?
  discount      CompanyDiscount?
  brandAssets   CompanyBrandAsset[]
  discountMemos DiscountMemo[]
  carts         Cart[]               @relation("CartCompany")
  orderGroups   OrderGroup[]         @relation("OrderGroupCompany")
  orders        Order[]              @relation("OrderCompany")
  addresses     CustomerAddress[]    @relation("CustomerAddressCompany")
  quotes        Quote[]              @relation("QuoteCompany")
  files         FileObject[]         @relation("FileObjectOwnerCompany")

  // --- Fulfilment B4.1 (generated back-relations)
  designDocuments DesignDocument[] @relation("DesignDocumentCompany")
  // --- end Fulfilment B4.1

  // --- Finance B5.1 (generated back-relations)
  journalLines JournalLine[] @relation("JournalLineCompany")
  // --- end Finance B5.1

  // --- Finance B5.2 (generated back-relations)
  customerDocuments       CustomerDocument[]       @relation("CustomerDocumentCompany")
  customerWhtCertificates CustomerWhtCertificate[] @relation("CustomerWhtCertificateCompany")
  receivableItems         ReceivableItem[]         @relation("ReceivableItemCompany")
  statements              CompanyStatement[]       @relation("CompanyStatementCompany")
  // --- end Finance B5.2

  brandKits     BrandKit[]                @relation("BrandKitCompany")
  elementRights ElementRightDeclaration[] @relation("ElementRightCompany")

  reorderSuggestions ReorderSuggestion[] @relation("ReorderSuggestionCompany")

  @@unique([taxId], map: "ux_companies__tax_id", where: raw("(status <> 'closed'::company_status)"))
  @@index([status], map: "ix_companies__status")
  @@index([entityId], map: "ix_companies__entity_id")
  @@index([appliedById], map: "ix_companies__applied_by")
  @@index([kycReviewedById], map: "ix_companies__kyc_reviewed_by")
  @@index([updatedById], map: "ix_companies__updated_by")
  @@index([legalName(ops: raw("gin_trgm_ops"))], type: Gin, map: "ix_companies__legal_name_trgm")
  @@map("companies")
}

/// Head office and branches: the tax invoice names the branch (D-125).
model CompanyBranch {
  id            BigInt     @id(map: "pk_company_branches") @default(autoincrement())
  publicId      String     @unique(map: "ux_company_branches__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  companyId     BigInt     @map("company_id")
  branchType    BranchType @map("branch_type")
  branchCode    String     @map("branch_code") @db.Char(5)
  name          String
  line1         String
  line2         String?
  subdistrictId BigInt?    @map("subdistrict_id")
  postcode      String     @db.Char(5)
  provinceId    BigInt     @map("province_id")
  isDefault     Boolean    @default(false) @map("is_default")
  deletedAt     DateTime?  @map("deleted_at") @db.Timestamptz(6)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById   BigInt?    @map("created_by")
  updatedAt     DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion    Int        @default(1) @map("row_version")

  company     Company         @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_company_branches__company_id")
  subdistrict GeoSubdistrict? @relation("CompanyBranchSubdistrict", fields: [subdistrictId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_company_branches__subdistrict_id")
  province    GeoProvince     @relation("CompanyBranchProvince", fields: [provinceId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_company_branches__province_id")
  createdBy   User?           @relation("CompanyBranchCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_company_branches__created_by")
  orderGroups OrderGroup[]    @relation("OrderGroupCompanyBranch")

  // --- Finance B5.2 (generated back-relations)
  customerDocuments CustomerDocument[] @relation("CustomerDocumentCompanyBranch")
  // --- end Finance B5.2

  @@unique([companyId, branchCode], map: "ux_company_branches__company_id__branch_code", where: raw("(deleted_at IS NULL)"))
  @@unique([companyId], map: "ux_company_branches__one_default", where: raw("(is_default AND (deleted_at IS NULL))"))
  @@index([companyId], map: "ix_company_branches__company_id")
  @@index([subdistrictId], map: "ix_company_branches__subdistrict_id")
  @@index([provinceId], map: "ix_company_branches__province_id")
  @@index([createdById], map: "ix_company_branches__created_by")
  @@map("company_branches")
}

/// Membership of a customer account in a company; company roles are `user_roles` in scope `company`.
model CompanyMember {
  id          BigInt       @id(map: "pk_company_members") @default(autoincrement())
  publicId    String       @unique(map: "ux_company_members__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  companyId   BigInt       @map("company_id")
  userId      BigInt       @map("user_id")
  status      MemberStatus @default(invited)
  roleKeys    String[]     @default([]) @map("role_keys")
  invitedById BigInt?      @map("invited_by")
  invitedAt   DateTime     @default(now()) @map("invited_at") @db.Timestamptz(6)
  joinedAt    DateTime?    @map("joined_at") @db.Timestamptz(6)
  removedAt   DateTime?    @map("removed_at") @db.Timestamptz(6)
  rowVersion  Int          @default(1) @map("row_version")

  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_company_members__company_id")
  user      User    @relation("CompanyMemberUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_company_members__user_id")
  invitedBy User?   @relation("CompanyMemberInvitedBy", fields: [invitedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_company_members__invited_by")

  @@unique([companyId, userId], map: "ux_company_members__company_id__user_id")
  @@index([userId], map: "ix_company_members__user_id")
  @@index([invitedById], map: "ix_company_members__invited_by")
  @@map("company_members")
}

enum CompanyAssetKind {
  logo
  guideline
  font
  artwork
  other

  @@map("company_asset_kind")
}

/// The company's shared brand library (D-227): the Company Admin adds and removes files, every member uses them.
/// Removing keeps the file (orders and designs may reference it). U4.B5 brand kits extend it.
model CompanyBrandAsset {
  id           BigInt           @id(map: "pk_company_brand_assets") @default(autoincrement())
  publicId     String           @unique(map: "ux_company_brand_assets__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  companyId    BigInt           @map("company_id")
  fileObjectId BigInt           @map("file_object_id")
  kind         CompanyAssetKind
  name         String
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById  BigInt           @map("created_by")
  removedAt    DateTime?        @map("removed_at") @db.Timestamptz(6)
  removedById  BigInt?          @map("removed_by")

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_company_brand_assets__company_id")
  fileObject FileObject @relation("CompanyBrandAssetFile", fields: [fileObjectId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_company_brand_assets__file_object_id")
  createdBy  User       @relation("CompanyBrandAssetCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_company_brand_assets__created_by")
  removedBy  User?      @relation("CompanyBrandAssetRemovedBy", fields: [removedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_company_brand_assets__removed_by")

  kitLogos BrandKitLogo[] @relation("BrandKitLogoAsset")

  @@unique([companyId, fileObjectId], map: "ux_company_brand_assets__live_file", where: raw("(removed_at IS NULL)"))
  @@index([companyId], map: "ix_company_brand_assets__company_id")
  @@index([fileObjectId], map: "ix_company_brand_assets__file_object_id")
  @@index([createdById], map: "ix_company_brand_assets__created_by")
  @@index([removedById], map: "ix_company_brand_assets__removed_by")
  @@map("company_brand_assets")
}

/// KYC documents reviewed by staff (D-120: certificate ≤ 6 months old, ภ.พ.20 if VAT-registered, signatory).
model CompanyKycDocument {
  id           BigInt     @id(map: "pk_company_kyc_documents") @default(autoincrement())
  publicId     String     @unique(map: "ux_company_kyc_documents__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  companyId    BigInt     @map("company_id")
  docType      KycDocType @map("doc_type")
  fileObjectId BigInt     @map("file_object_id")
  issuedOn     DateTime?  @map("issued_on") @db.Date
  status       KycStatus  @default(pending)
  verifiedById BigInt?    @map("verified_by")
  verifiedAt   DateTime?  @map("verified_at") @db.Timestamptz(6)
  note         String?
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById  BigInt?    @map("created_by")
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion   Int        @default(1) @map("row_version")

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_company_kyc_documents__company_id")
  fileObject FileObject @relation("CompanyKycDocumentFile", fields: [fileObjectId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_company_kyc_documents__file_object_id")
  verifiedBy User?      @relation("CompanyKycDocumentVerifiedBy", fields: [verifiedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_company_kyc_documents__verified_by")
  createdBy  User?      @relation("CompanyKycDocumentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_company_kyc_documents__created_by")

  @@index([companyId, docType], map: "ix_company_kyc_documents__company_id__doc_type")
  @@index([fileObjectId], map: "ix_company_kyc_documents__file_object_id")
  @@index([verifiedById], map: "ix_company_kyc_documents__verified_by")
  @@index([createdById], map: "ix_company_kyc_documents__created_by")
  @@map("company_kyc_documents")
}

/// Credit limit identity per company; limits and terms are effective-dated versions (D-121).
model CompanyCreditLimit {
  id        BigInt   @id(map: "pk_company_credit_limits") @default(autoincrement())
  publicId  String   @unique(map: "ux_company_credit_limits__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  companyId BigInt   @unique(map: "ux_company_credit_limits__company_id") @map("company_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company  Company                     @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_company_credit_limits__company_id")
  versions CompanyCreditLimitVersion[]

  @@map("company_credit_limits")
}

model CompanyCreditLimitVersion {
  id                BigInt              @id(map: "pk_company_credit_limit_versions") @default(autoincrement())
  publicId          String              @unique(map: "ux_company_credit_limit_versions__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  creditLimitId     BigInt              @map("credit_limit_id")
  versionNo         Int                 @map("version_no")
  effectiveFrom     DateTime            @map("effective_from") @db.Timestamptz(6)
  status            ConfigVersionStatus @default(draft)
  limitAmount       Decimal             @map("limit_amount") @db.Decimal(14, 2)
  termDays          Int                 @map("term_days") @db.SmallInt
  /// Why the company is eligible (D-121): paid orders or a financial-statement review.
  eligibilityBasis  String              @map("eligibility_basis")
  reason            String
  approvalRequestId BigInt?             @map("approval_request_id")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById       BigInt?             @map("created_by")
  decidedAt         DateTime?           @map("decided_at") @db.Timestamptz(6)

  creditLimit     CompanyCreditLimit @relation(fields: [creditLimitId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_company_credit_limit_versions__credit_limit_id")
  approvalRequest ApprovalRequest?   @relation("CompanyCreditLimitVersionApprovalRequest", fields: [approvalRequestId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_company_credit_limit_versions__approval_request_id")
  createdBy       User?              @relation("CompanyCreditLimitVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_company_credit_limit_versions__created_by")

  @@unique([creditLimitId, versionNo], map: "ux_company_credit_limit_versions__credit_limit_id__version_no")
  @@index([creditLimitId, effectiveFrom(sort: Desc), versionNo(sort: Desc)], map: "ix_company_credit_limit_versions__resolution", where: raw("(status = 'approved'::config_version_status)"))
  @@index([approvalRequestId], map: "ix_company_credit_limit_versions__approval_request_id")
  @@index([createdById], map: "ix_company_credit_limit_versions__created_by")
  @@map("company_credit_limit_versions")
}

/// Company-level discount identity; each % is a version granted through a discount memo (D-124).
model CompanyDiscount {
  id        BigInt   @id(map: "pk_company_discounts") @default(autoincrement())
  publicId  String   @unique(map: "ux_company_discounts__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  companyId BigInt   @unique(map: "ux_company_discounts__company_id") @map("company_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company  Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_company_discounts__company_id")
  versions CompanyDiscountVersion[]

  @@map("company_discounts")
}

model CompanyDiscountVersion {
  id             BigInt              @id(map: "pk_company_discount_versions") @default(autoincrement())
  publicId       String              @unique(map: "ux_company_discount_versions__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  discountId     BigInt              @map("discount_id")
  versionNo      Int                 @map("version_no")
  effectiveFrom  DateTime            @map("effective_from") @db.Timestamptz(6)
  validTo        DateTime?           @map("valid_to") @db.Timestamptz(6)
  status         ConfigVersionStatus @default(draft)
  discountPct    Decimal             @map("discount_pct") @db.Decimal(7, 4)
  discountMemoId BigInt              @map("discount_memo_id")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  discount     CompanyDiscount @relation(fields: [discountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_company_discount_versions__discount_id")
  discountMemo DiscountMemo    @relation("CompanyDiscountVersionMemo", fields: [discountMemoId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_company_discount_versions__discount_memo_id")

  @@unique([discountId, versionNo], map: "ux_company_discount_versions__discount_id__version_no")
  @@index([discountId, effectiveFrom(sort: Desc), versionNo(sort: Desc)], map: "ix_company_discount_versions__resolution", where: raw("(status = 'approved'::config_version_status)"))
  @@index([discountMemoId], map: "ix_company_discount_versions__discount_memo_id")
  @@map("company_discount_versions")
}

/// A discount above the CS limit, routed by the approval matrix (D-052, D-162); a company memo sets the
/// company discount (D-124). Evidence files are attachments of the memo.
model DiscountMemo {
  id                  BigInt     @id(map: "pk_discount_memos") @default(autoincrement())
  publicId            String     @unique(map: "ux_discount_memos__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  entityId            BigInt     @map("entity_id")
  scope               String
  requestedById       BigInt     @map("requested_by")
  customerUserId      BigInt?    @map("customer_user_id")
  companyId           BigInt?    @map("company_id")
  quoteId             BigInt?    @map("quote_id")
  cartId              BigInt?    @map("cart_id")
  orderValue          Decimal    @map("order_value") @db.Decimal(14, 2)
  requestedPct        Decimal    @map("requested_pct") @db.Decimal(7, 4)
  requestedAmount     Decimal    @map("requested_amount") @db.Decimal(14, 2)
  resultingMarginPct  Decimal?   @map("resulting_margin_pct") @db.Decimal(9, 4)
  belowMarginFloor    Boolean    @default(false) @map("below_margin_floor")
  reason              String
  evidenceFileIds     BigInt[]   @default([]) @map("evidence_file_ids")
  status              MemoStatus @default(pending_approval)
  approvalRequestId   BigInt?    @map("approval_request_id")
  approvedPct         Decimal?   @map("approved_pct") @db.Decimal(7, 4)
  validUntil          DateTime   @map("valid_until") @db.Timestamptz(6)
  decidedAt           DateTime?  @map("decided_at") @db.Timestamptz(6)
  appliedOrderGroupId BigInt?    @map("applied_order_group_id")
  appliedAt           DateTime?  @map("applied_at") @db.Timestamptz(6)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion          Int        @default(1) @map("row_version")

  entity            Entity                   @relation("DiscountMemoEntity", fields: [entityId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_discount_memos__entity_id")
  requestedBy       User                     @relation("DiscountMemoRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_discount_memos__requested_by")
  customer          User?                    @relation("DiscountMemoCustomer", fields: [customerUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_discount_memos__customer_user_id")
  company           Company?                 @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_discount_memos__company_id")
  quote             Quote?                   @relation("DiscountMemoQuote", fields: [quoteId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_discount_memos__quote_id")
  cart              Cart?                    @relation("DiscountMemoCart", fields: [cartId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_discount_memos__cart_id")
  approvalRequest   ApprovalRequest?         @relation("DiscountMemoApprovalRequest", fields: [approvalRequestId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_discount_memos__approval_request_id")
  appliedOrderGroup OrderGroup?              @relation("DiscountMemoAppliedGroup", fields: [appliedOrderGroupId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_discount_memos__applied_order_group_id")
  companyDiscounts  CompanyDiscountVersion[] @relation("CompanyDiscountVersionMemo")
  orderDiscounts    OrderDiscount[]          @relation("OrderDiscountMemo")
  orderGroups       OrderGroup[]             @relation("OrderGroupDiscountMemo")

  goodwillClaims Claim[] @relation("ClaimGoodwillMemo")

  @@index([status, validUntil], map: "ix_discount_memos__status__valid_until")
  @@index([entityId], map: "ix_discount_memos__entity_id")
  @@index([requestedById], map: "ix_discount_memos__requested_by")
  @@index([customerUserId], map: "ix_discount_memos__customer_user_id")
  @@index([companyId], map: "ix_discount_memos__company_id")
  @@index([quoteId], map: "ix_discount_memos__quote_id")
  @@index([cartId], map: "ix_discount_memos__cart_id")
  @@index([approvalRequestId], map: "ix_discount_memos__approval_request_id")
  @@index([appliedOrderGroupId], map: "ix_discount_memos__applied_order_group_id")
  @@map("discount_memos")
}

// --- U2.7 reorder suggestions (A-103; D-204, D-288) ------------------------------------------------------------

enum ReorderSuggestionStatus {
  open
  /// CS reached the customer about it.
  contacted
  /// The customer (or CS) set it aside until the SKU is ordered again.
  dismissed

  @@map("reorder_suggestion_status")
}

/// D-288 a reorder suggestion per SKU — the customer (or company) × the specification × the approved artwork — with at
/// least `reorder.min_orders` earlier orders, recomputed nightly; a new order of the SKU starts a new cycle (open).
model ReorderSuggestion {
  id                  BigInt                  @id(map: "pk_reorder_suggestions") @default(autoincrement())
  publicId            String                  @unique(map: "ux_reorder_suggestions__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  /// sha256 of owner + specification + artwork.
  skuSha256           Bytes                   @map("sku_sha256")
  /// The owner: a customer's own orders, or a company's.
  customerUserId      BigInt?                 @map("customer_user_id")
  companyId           BigInt?                 @map("company_id")
  productTypeId       BigInt                  @map("product_type_id")
  lastOrderId         BigInt                  @map("last_order_id")
  orderCount          Int                     @map("order_count")
  averageIntervalDays Decimal                 @map("average_interval_days") @db.Decimal(8, 2)
  lastLeadTimeDays    Int                     @map("last_lead_time_days")
  nextNeedOn          DateTime                @map("next_need_on") @db.Date
  suggestedOn         DateTime                @map("suggested_on") @db.Date
  suggestedQuantity   Int                     @map("suggested_quantity")
  status              ReorderSuggestionStatus @default(open)
  /// The `reorder.*` setting versions the computation used.
  settingVersionIds   Json                    @map("setting_version_ids")
  computedAt          DateTime                @map("computed_at") @db.Timestamptz(6)
  contactedAt         DateTime?               @map("contacted_at") @db.Timestamptz(6)
  contactedById       BigInt?                 @map("contacted_by")
  contactNote         String?                 @map("contact_note")
  dismissedAt         DateTime?               @map("dismissed_at") @db.Timestamptz(6)
  dismissedById       BigInt?                 @map("dismissed_by")
  /// The marketing reminder of this cycle was handed to the notification router (D-144 applies there).
  remindedAt          DateTime?               @map("reminded_at") @db.Timestamptz(6)
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer    User?       @relation("ReorderSuggestionCustomer", fields: [customerUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_reorder_suggestions__customer_user_id")
  company     Company?    @relation("ReorderSuggestionCompany", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_reorder_suggestions__company_id")
  productType ProductType @relation("ReorderSuggestionProductType", fields: [productTypeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_reorder_suggestions__product_type_id")
  lastOrder   Order       @relation("ReorderSuggestionLastOrder", fields: [lastOrderId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_reorder_suggestions__last_order_id")
  contactedBy User?       @relation("ReorderSuggestionContactedBy", fields: [contactedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_reorder_suggestions__contacted_by")
  dismissedBy User?       @relation("ReorderSuggestionDismissedBy", fields: [dismissedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_reorder_suggestions__dismissed_by")

  @@unique([skuSha256], map: "ux_reorder_suggestions__sku_sha256")
  @@index([customerUserId], map: "ix_reorder_suggestions__customer_user_id")
  @@index([companyId], map: "ix_reorder_suggestions__company_id")
  @@index([productTypeId], map: "ix_reorder_suggestions__product_type_id")
  @@index([lastOrderId], map: "ix_reorder_suggestions__last_order_id")
  @@index([status, suggestedOn], map: "ix_reorder_suggestions__status__suggested_on")
  @@index([contactedById], map: "ix_reorder_suggestions__contacted_by")
  @@index([dismissedById], map: "ix_reorder_suggestions__dismissed_by")
  @@map("reorder_suggestions")
}
