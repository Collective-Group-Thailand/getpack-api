  reorders              Order[]                @relation("OrderReorderOf")
  quoteOutcomes         QuoteOutcome[]         @relation("QuoteOutcomeOrder")
  cancelReason          OrderCancelReason?     @relation("OrderCancelReason", fields: [cancelReasonId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_orders__cancel_reason_id")
  selectedFactory       Factory?               @relation("OrderSelectedFactory", fields: [selectedFactoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_orders__selected_factory_id")
