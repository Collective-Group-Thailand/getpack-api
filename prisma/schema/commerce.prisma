  claimWindowEndsAt       DateTime?            @map("claim_window_ends_at") @db.Timestamptz(6)
  cancelledAt             DateTime?            @map("cancelled_at") @db.Timestamptz(6)
  cancelReasonId          BigInt?              @map("cancel_reason_id")
  cancelNote              String?              @map("cancel_note")
  /// Staff-only (D-044, D-050, D-141).
  selectedFactoryId       BigInt?              @map("selected_factory_id")
  buyCostNet              Decimal?             @map("buy_cost_net") @db.Decimal(14, 2)
  marginAmount            Decimal?             @map("margin_amount") @db.Decimal(14, 2)
  marginPct               Decimal?             @map("margin_pct") @db.Decimal(9, 4)
  belowMarginFloor        Boolean              @default(false) @map("below_margin_floor")
  createdAt               DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
