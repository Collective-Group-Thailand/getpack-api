  stockMovements        StockMovement[]        @relation("StockMovementOrder")
  instalmentAllocations InstalmentAllocation[] @relation("InstalmentAllocationOrder")
  refunds               Refund[]               @relation("RefundOrder")

  pointsEntries PointsEntry[] @relation("PointsEntryOrder")
  review        OrderReview?  @relation("OrderReviewOrder")

  company Company? @relation("OrderCompany", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_orders__company_id")

  designDocument        DesignDocument?        @relation("OrderDesignDocument", fields: [designDocumentId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_orders__design_document_id")
  designDocumentVersion DesignDocumentVersion? @relation("OrderDesignVersion", fields: [designDocumentVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_orders__design_document_version_id")
  designsLocked         DesignDocument[]       @relation("DesignDocumentLockedByOrder")
  prepressAssignee      User?                  @relation("OrderPrepressAssignee", fields: [prepressAssigneeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_orders__prepress_assignee_id")
