  catalogProduct        CatalogProduct?        @relation("OrderCatalogProduct", fields: [catalogProductId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_orders__catalog_product_id")
  stockProduct          StockProduct?          @relation("OrderStockProduct", fields: [stockProductId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_orders__stock_product_id")
  quote                 Quote                  @relation("OrderQuote", fields: [quoteId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_orders__quote_id")
