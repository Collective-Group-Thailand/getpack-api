/// One per configuration (legacy rule, A-6). Status is driven by facts (B3.1 state machine). The
/// pricing snapshot is write-once except an audited re-price before production (`order_price_revisions`).
model Order {
  id                      BigInt               @id(map: "pk_orders") @default(autoincrement())
  publicId                String               @unique(map: "ux_orders__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  orderCode               String               @unique(map: "ux_orders__order_code") @map("order_code")
  entityId                BigInt               @map("entity_id")
  orderGroupId            BigInt               @map("order_group_id")
  /// D-253: `sample` = a standalone sample bought on its own (its job is a `mockup` job).
  kind                    OrderKind            @default(standard)
  customerUserId          BigInt               @map("customer_user_id")
  productTypeId           BigInt               @map("product_type_id")
  catalogProductId        BigInt?              @map("catalog_product_id")
  stockProductId          BigInt?              @map("stock_product_id")
  quoteId                 BigInt               @map("quote_id")
  quoteOptionId           BigInt               @map("quote_option_id")
  reorderOfOrderId        BigInt?              @map("reorder_of_order_id")
  status                  OrderStatus          @default(waiting_payment)
  statusChangedAt         DateTime             @default(now()) @map("status_changed_at") @db.Timestamptz(6)
  artworkStatus           ArtworkStatus        @map("artwork_status")
  designOption            DesignOption         @map("design_option")
  designNote              String?              @map("design_note")
  /// The customer's online design (B4.1).
  designDocumentId        BigInt?              @map("design_document_id")
  /// D-276 the immutable design version ordered.
  designDocumentVersionId BigInt?              @map("design_document_version_id")
  /// The Prepress member who owns the order's artwork (U-B0.2); null while unassigned.
  prepressAssigneeId      BigInt?              @map("prepress_assignee_id")
  /// Reorder with unchanged artwork: the approved proof carried over, proof skipped (D-153).
  reuseArtworkProofId     BigInt?              @map("reuse_artwork_proof_id")
  mockupOption            MockupOption         @default(none) @map("mockup_option")
  quantityOrdered         Int                  @map("quantity_ordered")
  quantityDelivered       Int?                 @map("quantity_delivered")
  unit                    ProductUnit
  toleranceShortagePct    Decimal?             @map("tolerance_shortage_pct") @db.Decimal(7, 4)
  toleranceOveragePct     Decimal?             @map("tolerance_overage_pct") @db.Decimal(7, 4)
  /// D-186: published dimensional (± mm) and colour (ΔE2000 vs the approved proof) tolerances, frozen; null = none.
  toleranceDimensionalMm  Decimal?             @map("tolerance_dimensional_mm") @db.Decimal(6, 2)
  toleranceColourDeltaE   Decimal?             @map("tolerance_colour_delta_e") @db.Decimal(5, 2)
  taxNature               TaxNature            @map("tax_nature")
  pricingSnapshot         Json                 @map("pricing_snapshot")
  configRefs              Json                 @map("config_refs")
  snapshotSha256          Bytes                @map("snapshot_sha256")
  pricingRevision         Int                  @default(1) @map("pricing_revision")
  netAmount               Decimal              @map("net_amount") @db.Decimal(14, 2)
  discountAmount          Decimal              @default(0) @map("discount_amount") @db.Decimal(14, 2)
  shippingNetAmount       Decimal              @default(0) @map("shipping_net_amount") @db.Decimal(14, 2)
  vatAmount               Decimal              @map("vat_amount") @db.Decimal(14, 2)
  grossAmount             Decimal              @map("gross_amount") @db.Decimal(14, 2)
  whtAmount               Decimal              @default(0) @map("wht_amount") @db.Decimal(14, 2)
  cashAmount              Decimal              @map("cash_amount") @db.Decimal(14, 2)
  leadTimeDays            Int?                 @map("lead_time_days") @db.SmallInt
  promisedShipDate        DateTime?            @map("promised_ship_date") @db.Date
  confirmedProductionDate DateTime?            @map("confirmed_production_date") @db.Date
  paidForProductionAt     DateTime?            @map("paid_for_production_at") @db.Timestamptz(6)
  artworkApprovedAt       DateTime?            @map("artwork_approved_at") @db.Timestamptz(6)
  productionStartedAt     DateTime?            @map("production_started_at") @db.Timestamptz(6)
  startMode               ProductionStartMode? @map("start_mode")
  shippedAt               DateTime?            @map("shipped_at") @db.Timestamptz(6)
  deliveredAt             DateTime?            @map("delivered_at") @db.Timestamptz(6)
  completedAt             DateTime?            @map("completed_at") @db.Timestamptz(6)
