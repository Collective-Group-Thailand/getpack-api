  shippingNetAmount Decimal  @default(0) @map("shipping_net_amount") @db.Decimal(14, 2)
  sort              Int      @default(0) @db.SmallInt
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order           Order            @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_order_destinations__order_id")
