  entity                Entity                 @relation("OrderEntity", fields: [entityId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_orders__entity_id")
  orderGroup            OrderGroup             @relation(fields: [orderGroupId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_orders__order_group_id")
