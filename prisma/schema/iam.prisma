// IAM & auth context — docs/schema-design.md §3.2 (B1.2), ADR-0004.
// Secrets are stored hashed (refresh tokens, OTP codes, reset tokens) or with argon2id (passwords,
// PINs, client secrets); they are never logged (PDPA).

// ---------------------------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------------------------

enum UserKind {
  customer
  staff
  partner

  @@map("user_kind")
}

enum UserStatus {
  pending_verification
  active
  suspended
  inactive

  @@map("user_status")
}

enum IdentityProvider {
  phone_otp
  firebase_google
  firebase_apple
  line

  @@map("identity_provider")
}

enum LoginMethod {
  password
  phone_otp
  firebase_google
  firebase_apple
  line
  line_liff
  device_pin

  @@map("login_method")
}

enum TokenAudience {
  customer
  staff
  partner

  @@map("token_audience")
}

enum SessionRevokeReason {
  logout
  reuse_detected
  admin
  password_changed
  user_suspended
  expired

  @@map("session_revoke_reason")
}

enum OtpPurpose {
  login
  verify_phone
  liff_login
  link_phone

  @@map("otp_purpose")
}

enum ApiClientStatus {
  active
  suspended
  revoked

  @@map("api_client_status")
}

enum RoleScopeType {
  platform
  factory
  company

  @@map("role_scope_type")
}

enum SodRuleKind {
  role_pair
  action_pair

  @@map("sod_rule_kind")
}

enum SodSubjectMatch {
  same_subject
  same_vendor
  same_customer

  @@map("sod_subject_match")
}

enum SodEnforcement {
  block
  warn

  @@map("sod_enforcement")
}

enum ConsentSource {
  web
  line_liff
  cs
  partner_zone

  @@map("consent_source")
}

// ---------------------------------------------------------------------------------------------
// Users & identities
// ---------------------------------------------------------------------------------------------

/// Every human principal; the audience is `kind` (ADR-0004). PDPA erasure = anonymise in place.
model User {
  id                BigInt     @id(map: "pk_users") @default(autoincrement())
  publicId          String     @unique(map: "ux_users__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  kind              UserKind
  status            UserStatus @default(pending_verification)
  email             String?    @db.Citext
  emailVerifiedAt   DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  /// E.164 (+66…).
  phone             String?
  phoneVerifiedAt   DateTime?  @map("phone_verified_at") @db.Timestamptz(6)
  displayName       String     @map("display_name")
  firstName         String?    @map("first_name")
  lastName          String?    @map("last_name")
  locale            LocaleCode @default(th)
  /// argon2id; never set for customers (passwordless).
  passwordHash      String?    @map("password_hash")
  passwordChangedAt DateTime?  @map("password_changed_at") @db.Timestamptz(6)
  failedLoginCount  Int        @default(0) @map("failed_login_count") @db.SmallInt
  lockedUntil       DateTime?  @map("locked_until") @db.Timestamptz(6)
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz(6)
  anonymisedAt      DateTime?  @map("anonymised_at") @db.Timestamptz(6)
  deletedAt         DateTime?  @map("deleted_at") @db.Timestamptz(6)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById       BigInt?    @map("created_by")
  updatedAt         DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById       BigInt?    @map("updated_by")
  rowVersion        Int        @default(1) @map("row_version")

  createdBy User? @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_users__created_by")
  updatedBy User? @relation("UserUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_users__updated_by")

  // --- IAM
  usersCreated                  User[]                  @relation("UserCreatedBy")
  usersUpdated                  User[]                  @relation("UserUpdatedBy")
  identities                    UserIdentity[]
  staffProfile                  StaffProfile?
  sessions                      AuthSession[]
  devicePins                    DevicePin[]
  passwordResetTokens           PasswordResetToken[]
  roles                         UserRole[]              @relation("UserRoleUser")
