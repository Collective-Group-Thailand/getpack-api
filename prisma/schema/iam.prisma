model Role {
  id          BigInt        @id(map: "pk_roles") @default(autoincrement())
  publicId    String        @unique(map: "ux_roles__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  key         String        @unique(map: "ux_roles__key")
  audience    TokenAudience
  scopeType   RoleScopeType @map("scope_type")
  nameTh      String        @map("name_th")
  nameEn      String        @map("name_en")
  /// Seeded roles (D-140) cannot be deleted.
  isSystem    Boolean       @default(false) @map("is_system")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById BigInt?       @map("created_by")
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById BigInt?       @map("updated_by")
  rowVersion  Int           @default(1) @map("row_version")

  createdBy               User?                 @relation("RoleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_roles__created_by")
  updatedBy               User?                 @relation("RoleUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_roles__updated_by")
  permissions             RolePermission[]
  userRoles               UserRole[]
  sodRulesA               SodRule[]             @relation("SodRuleRoleA")
  sodRulesB               SodRule[]             @relation("SodRuleRoleB")
  approvalSteps           ApprovalStep[]        @relation("ApprovalStepApproverRole")
  approvalStepEscalations ApprovalStep[]        @relation("ApprovalStepEscalateRole")
  approvalRequestSteps    ApprovalRequestStep[]

  @@map("roles")
}

/// Catalogue from code (`resource.action`), seeded (B1.2) and extended by each module.
model Permission {
  id           BigInt        @id(map: "pk_permissions") @default(autoincrement())
  key          String        @unique(map: "ux_permissions__key")
  audience     TokenAudience
  description  String
  /// Cost / margin data (D-141) and similar.
  isSensitive  Boolean       @default(false) @map("is_sensitive")
  decisionRefs String[]      @default([]) @map("decision_refs")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       BigInt   @map("role_id")
  permissionId BigInt   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById  BigInt?  @map("created_by")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_role_permissions__role_id")
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_role_permissions__permission_id")
  createdBy  User?      @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_role_permissions__created_by")

  @@id([roleId, permissionId], map: "pk_role_permissions")
  @@index([permissionId], map: "ix_role_permissions__permission_id")
  @@map("role_permissions")
}

/// Role grants with scope (`platform | factory:{id} | company:{id}`). Active ux is an expression index
/// in the migration SQL; a trigger checks the scope and the user's audience against the role.
model UserRole {
  id          BigInt        @id(map: "pk_user_roles") @default(autoincrement())
  publicId    String        @unique(map: "ux_user_roles__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  userId      BigInt        @map("user_id")
  roleId      BigInt        @map("role_id")
  scopeType   RoleScopeType @map("scope_type")
  scopeId     BigInt?       @map("scope_id")
  validFrom   DateTime      @default(now()) @map("valid_from") @db.Timestamptz(6)
  /// Time-boxed access, e.g. Auditor (accounting-design.md §8).
  validTo     DateTime?     @map("valid_to") @db.Timestamptz(6)
  grantedById BigInt?       @map("granted_by")
  revokedAt   DateTime?     @map("revoked_at") @db.Timestamptz(6)
  revokedById BigInt?       @map("revoked_by")
  reason      String
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user      User  @relation("UserRoleUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_user_roles__user_id")
  role      Role  @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_user_roles__role_id")
  grantedBy User? @relation("UserRoleGrantedBy", fields: [grantedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_user_roles__granted_by")
  revokedBy User? @relation("UserRoleRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_user_roles__revoked_by")

  @@index([userId], map: "ix_user_roles__user_id")
  @@index([roleId], map: "ix_user_roles__role_id")
  @@index([scopeType, scopeId], map: "ix_user_roles__scope")
  @@map("user_roles")
}

model SodRule {
  id           BigInt           @id(map: "pk_sod_rules") @default(autoincrement())
  publicId     String           @unique(map: "ux_sod_rules__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  key          String           @unique(map: "ux_sod_rules__key")
  kind         SodRuleKind
  roleAId      BigInt?          @map("role_a_id")
  roleBId      BigInt?          @map("role_b_id")
  /// Permission keys, e.g. payout_run.create / payout_run.approve.
  actionA      String?          @map("action_a")
  actionB      String?          @map("action_b")
  subjectMatch SodSubjectMatch? @map("subject_match")
  enforcement  SodEnforcement   @default(block)
  description  String
  decisionRefs String[]         @default([]) @map("decision_refs")
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById  BigInt?          @map("created_by")
  updatedAt    DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById  BigInt?          @map("updated_by")
  rowVersion   Int              @default(1) @map("row_version")

  roleA     Role? @relation("SodRuleRoleA", fields: [roleAId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sod_rules__role_a_id")
  roleB     Role? @relation("SodRuleRoleB", fields: [roleBId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sod_rules__role_b_id")
  createdBy User? @relation("SodRuleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sod_rules__created_by")
  updatedBy User? @relation("SodRuleUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sod_rules__updated_by")

  @@index([roleAId], map: "ix_sod_rules__role_a_id")
  @@index([roleBId], map: "ix_sod_rules__role_b_id")
  @@map("sod_rules")
}

// ---------------------------------------------------------------------------------------------
// Consent (D-005 own consent management, D-144)
// ---------------------------------------------------------------------------------------------

model ConsentPurpose {
  id          BigInt   @id(map: "pk_consent_purposes") @default(autoincrement())
  publicId    String   @unique(map: "ux_consent_purposes__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  key         String   @unique(map: "ux_consent_purposes__key")
  required    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById BigInt?  @map("created_by")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById BigInt?  @map("updated_by")
  rowVersion  Int      @default(1) @map("row_version")

  createdBy User?                   @relation("ConsentPurposeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_consent_purposes__created_by")
  updatedBy User?                   @relation("ConsentPurposeUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_consent_purposes__updated_by")
  versions  ConsentPurposeVersion[]
  records   ConsentRecord[]

  @@map("consent_purposes")
}

model ConsentPurposeVersion {
  id                BigInt              @id(map: "pk_consent_purpose_versions") @default(autoincrement())
  purposeId         BigInt              @map("purpose_id")
  versionNo         Int                 @map("version_no")
  effectiveFrom     DateTime            @map("effective_from") @db.Timestamptz(6)
  status            ConfigVersionStatus @default(draft)
  textTh            String              @map("text_th")
  textEn            String              @map("text_en")
  summaryTh         String?             @map("summary_th")
  summaryEn         String?             @map("summary_en")
  reason            String
  approvalRequestId BigInt?             @map("approval_request_id")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById       BigInt?             @map("created_by")
  decidedAt         DateTime?           @map("decided_at") @db.Timestamptz(6)
  decidedById       BigInt?             @map("decided_by")

  purpose         ConsentPurpose   @relation(fields: [purposeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_consent_purpose_versions__purpose_id")
  approvalRequest ApprovalRequest? @relation(fields: [approvalRequestId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_consent_purpose_versions__approval_request_id")
  createdBy       User?            @relation("ConsentPurposeVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_consent_purpose_versions__created_by")
  decidedBy       User?            @relation("ConsentPurposeVersionDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_consent_purpose_versions__decided_by")
  records         ConsentRecord[]

  @@unique([purposeId, versionNo], map: "ux_consent_purpose_versions__purpose_id__version_no")
  @@index([purposeId, effectiveFrom(sort: Desc), versionNo(sort: Desc)], map: "ix_consent_purpose_versions__resolution", where: raw("status = 'approved'"))
  @@index([approvalRequestId], map: "ix_consent_purpose_versions__approval_request_id")
  @@map("consent_purpose_versions")
}

/// Append-only; the latest record per (user, purpose) wins.
model ConsentRecord {
  id               BigInt        @id(map: "pk_consent_records") @default(autoincrement())
  userId           BigInt?       @map("user_id")
  anonymousId      String?       @map("anonymous_id")
  purposeId        BigInt        @map("purpose_id")
  purposeVersionId BigInt        @map("purpose_version_id")
  granted          Boolean
  source           ConsentSource
  ip               String?       @db.Inet
  userAgent        String?       @map("user_agent")
  recordedAt       DateTime      @default(now()) @map("recorded_at") @db.Timestamptz(6)

  user           User?                 @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_consent_records__user_id")
  purpose        ConsentPurpose        @relation(fields: [purposeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_consent_records__purpose_id")
  purposeVersion ConsentPurposeVersion @relation(fields: [purposeVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_consent_records__purpose_version_id")

  @@index([userId, purposeId, recordedAt(sort: Desc)], map: "ix_consent_records__user__purpose__recorded_at")
  @@index([anonymousId, purposeId, recordedAt(sort: Desc)], map: "ix_consent_records__anonymous__purpose__recorded_at")
  @@index([purposeVersionId], map: "ix_consent_records__purpose_version_id")
  @@index([purposeId], map: "ix_consent_records__purpose_id")
  @@map("consent_records")
}

/// PDPA data-subject requests (D-222, schema-design A-55).
enum PrivacyRequestKind {
  export
  deletion

  @@map("privacy_request_kind")
}

enum PrivacyRequestStatus {
  submitted
  completed
  rejected

  @@map("privacy_request_status")
}

/// A customer's PDPA request (D-222): answered by the Data Protection Officer within `privacy.response_days`. An export
/// is a JSON file of the customer's data, downloadable for `privacy.export_link_days`; a deletion anonymises the customer.
model PrivacyRequest {
  id              BigInt               @id(map: "pk_privacy_requests") @default(autoincrement())
  publicId        String               @unique(map: "ux_privacy_requests__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  userId          BigInt               @map("user_id")
  kind            PrivacyRequestKind
  status          PrivacyRequestStatus @default(submitted)
  note            String?
  answer          String?
  dueAt           DateTime             @map("due_at") @db.Timestamptz(6)
  exportFileId    BigInt?              @map("export_file_id")
  exportExpiresAt DateTime?            @map("export_expires_at") @db.Timestamptz(6)
  decidedById     BigInt?              @map("decided_by")
  decidedAt       DateTime?            @map("decided_at") @db.Timestamptz(6)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion      Int                  @default(1) @map("row_version")

  user       User        @relation("PrivacyRequestUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_privacy_requests__user_id")
  exportFile FileObject? @relation("PrivacyRequestExportFile", fields: [exportFileId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_privacy_requests__export_file_id")
  decidedBy  User?       @relation("PrivacyRequestDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_privacy_requests__decided_by")

  @@unique([userId, kind], map: "ux_privacy_requests__one_open", where: raw("(status = 'submitted'::privacy_request_status)"))
  @@index([userId, createdAt(sort: Desc)], map: "ix_privacy_requests__user_id__created_at")
  @@index([status, dueAt], map: "ix_privacy_requests__status__due_at")
  @@index([exportFileId], map: "ix_privacy_requests__export_file_id")
  @@map("privacy_requests")
}
