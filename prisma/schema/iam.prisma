/// Rotating refresh tokens; `family_id` is the JWT `sid`. Reuse of a rotated row revokes the family.
model AuthSession {
  id               BigInt               @id(map: "pk_auth_sessions") @default(autoincrement())
  publicId         String               @unique(map: "ux_auth_sessions__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  userId           BigInt               @map("user_id")
  audience         TokenAudience
  familyId         String               @map("family_id") @db.Uuid
  refreshTokenHash Bytes                @unique(map: "ux_auth_sessions__refresh_token_hash") @map("refresh_token_hash")
  parentSessionId  BigInt?              @map("parent_session_id")
  loginMethod      LoginMethod          @map("login_method")
  issuedAt         DateTime             @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt        DateTime             @map("expires_at") @db.Timestamptz(6)
  idleExpiresAt    DateTime             @map("idle_expires_at") @db.Timestamptz(6)
  rotatedAt        DateTime?            @map("rotated_at") @db.Timestamptz(6)
  revokedAt        DateTime?            @map("revoked_at") @db.Timestamptz(6)
  revokeReason     SessionRevokeReason? @map("revoke_reason")
  ip               String?              @db.Inet
  userAgent        String?              @map("user_agent")
  deviceId         String?              @map("device_id")
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_auth_sessions__user_id")
  parentSession AuthSession?  @relation("AuthSessionRotation", fields: [parentSessionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_auth_sessions__parent_session_id")
  children      AuthSession[] @relation("AuthSessionRotation")

  @@index([familyId], map: "ix_auth_sessions__family_id")
  @@index([userId, revokedAt], map: "ix_auth_sessions__user_id__revoked_at")
  @@index([parentSessionId], map: "ix_auth_sessions__parent_session_id")
  @@map("auth_sessions")
}

/// The OTP code is never stored or logged — only its HMAC. Rows are deleted after expiry + 24 h.
model OtpChallenge {
  id                BigInt     @id(map: "pk_otp_challenges") @default(autoincrement())
  publicId          String     @unique(map: "ux_otp_challenges__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  phone             String
  purpose           OtpPurpose
  codeHash          Bytes      @map("code_hash")
  expiresAt         DateTime   @map("expires_at") @db.Timestamptz(6)
  attempts          Int        @default(0) @db.SmallInt
  maxAttempts       Int        @map("max_attempts") @db.SmallInt
  consumedAt        DateTime?  @map("consumed_at") @db.Timestamptz(6)
  requestIp         String?    @map("request_ip") @db.Inet
  providerMessageId String?    @map("provider_message_id")
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([phone, createdAt(sort: Desc)], map: "ix_otp_challenges__phone__created_at")
  @@index([expiresAt], map: "ix_otp_challenges__expires_at")
  @@map("otp_challenges")
}

