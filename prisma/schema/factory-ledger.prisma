// Packio Factory ERP E6 (D-385 – D-396): the factory's own general ledger — chart of accounts, periods,
// journals posted from ERP documents by versioned rules, manual and recurring journals, fixed assets,
// bank reconciliation and the month-end close. Factory-private (D-317): `erp_gl_*` tables keyed by factory,
// never read by a staff endpoint; Packio's own books stay in `accounts` / `journal_entries`.

enum ErpGlDimension {
  item
  partner
  warehouse
  production_order
  machine
  bank_account

  @@map("erp_gl_dimension")
}

enum ErpGlAssetStatus {
  active
  disposed
  written_off

  @@map("erp_gl_asset_status")
}

enum ErpGlBankLineStatus {
  open
  matched
  ignored

  @@map("erp_gl_bank_line_status")
}

enum ErpGlBankMatchTarget {
  supplier_payment
  customer_receipt
  journal_entry
  bank_fee
  interest

  @@map("erp_gl_bank_match_target")
}

enum ErpGlTaxReturn {
  pp30
  pnd3
  pnd53

  @@map("erp_gl_tax_return")
}

/// D-385: one row per factory, created when the owner switches the ledger on.
model ErpGlSettings {
  id                   BigInt   @id(map: "pk_erp_gl_settings") @default(autoincrement())
  factoryId            BigInt   @unique(map: "ux_erp_gl_settings__factory_id") @map("factory_id")
  /// First month of the fiscal year (1 = January).
  fiscalYearStartMonth Int      @default(1) @map("fiscal_year_start_month")
  /// Documents dated before this day are not posted (the opening balance covers them).
  ledgerStartOn        DateTime @map("ledger_start_on") @db.Date
  /// Item kind → inventory account code (D-386), overriding the template.
  itemKindAccounts     Json     @default("{}") @map("item_kind_accounts")
  /// Bank / cash account code for payments and receipts by method (`transfer`, `cash`, `cheque`, `other`).
  methodAccounts       Json     @default("{}") @map("method_accounts")
  cpaName              String?  @map("cpa_name")
  cpaContact           String?  @map("cpa_contact")
  chartTemplateVersion Int      @default(1) @map("chart_template_version")
  rulesTemplateVersion Int      @default(1) @map("rules_template_version")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById          BigInt   @map("created_by")
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById          BigInt?  @map("updated_by")
  rowVersion           Int      @default(1) @map("row_version")

  factory   Factory @relation("ErpGlSettingsFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_settings__factory_id")
  createdBy User    @relation("ErpGlSettingsCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_settings__created_by")
  updatedBy User?   @relation("ErpGlSettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_settings__updated_by")

  @@index([createdById], map: "ix_erp_gl_settings__created_by")
  @@index([updatedById], map: "ix_erp_gl_settings__updated_by")
  @@map("erp_gl_settings")
}

/// D-386: the factory's chart of accounts (TFRS for NPAEs, DBD layout), from the template on first use.
model ErpGlAccount {
  id            BigInt        @id(map: "pk_erp_gl_accounts") @default(autoincrement())
  publicId      String        @unique(map: "ux_erp_gl_accounts__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  factoryId     BigInt        @map("factory_id")
  code          String
  nameTh        String        @map("name_th")
  nameEn        String        @map("name_en")
  accountType   AccountType   @map("account_type")
  normalSide    LedgerSide    @map("normal_side")
  parentId      BigInt?       @map("parent_id")
  /// Sub-ledger (automatic) postings only: AR, AP, inventory, GR/IR.
  isControl     Boolean       @default(false) @map("is_control")
  isPostable    Boolean       @default(true) @map("is_postable")
  cashFlowClass CashFlowClass @map("cash_flow_class")
  /// DBD financial-statement line the account rolls into (`BS.A1`, `PL.R1`, ...).
  statementLine String        @map("statement_line")
  status        AccountStatus @default(active)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById   BigInt?       @map("created_by")
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById   BigInt?       @map("updated_by")
  rowVersion    Int           @default(1) @map("row_version")

  factory   Factory        @relation("ErpGlAccountFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_accounts__factory_id")
  parent    ErpGlAccount?  @relation("ErpGlAccountParent", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_accounts__parent_id")
  children  ErpGlAccount[] @relation("ErpGlAccountParent")
  createdBy User?          @relation("ErpGlAccountCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_accounts__created_by")
  updatedBy User?          @relation("ErpGlAccountUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_accounts__updated_by")

  lines              ErpGlJournalLine[]
  changes            ErpGlAccountChange[]
  bankAccounts       ErpGlBankAccount[]   @relation("ErpGlBankAccountGl")
  categoriesAsset    ErpGlAssetCategory[] @relation("ErpGlAssetCategoryAsset")
  categoriesAccum    ErpGlAssetCategory[] @relation("ErpGlAssetCategoryAccumulated")
  categoriesExpense  ErpGlAssetCategory[] @relation("ErpGlAssetCategoryExpense")
  categoriesGainLoss ErpGlAssetCategory[] @relation("ErpGlAssetCategoryGainLoss")

  @@unique([factoryId, code], map: "ux_erp_gl_accounts__factory_id__code")
  @@index([parentId], map: "ix_erp_gl_accounts__parent_id")
  @@index([createdById], map: "ix_erp_gl_accounts__created_by")
  @@index([updatedById], map: "ix_erp_gl_accounts__updated_by")
  @@map("erp_gl_accounts")
}

/// D-386: a chart change proposed by `factory_ledger.configure`, applied when `factory_ledger.approve` approves it.
model ErpGlAccountChange {
  id           BigInt              @id(map: "pk_erp_gl_account_changes") @default(autoincrement())
  publicId     String              @unique(map: "ux_erp_gl_account_changes__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  factoryId    BigInt              @map("factory_id")
  accountId    BigInt?             @map("account_id")
  kind         AccountChangeKind
  proposed     Json
  reason       String
  status       ConfigVersionStatus @default(proposed)
  decisionNote String?             @map("decision_note")
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById  BigInt              @map("created_by")
  decidedAt    DateTime?           @map("decided_at") @db.Timestamptz(6)
  decidedById  BigInt?             @map("decided_by")

  factory   Factory       @relation("ErpGlAccountChangeFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_account_changes__factory_id")
  account   ErpGlAccount? @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_account_changes__account_id")
  createdBy User          @relation("ErpGlAccountChangeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_account_changes__created_by")
  decidedBy User?         @relation("ErpGlAccountChangeDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_account_changes__decided_by")

  @@index([factoryId, status], map: "ix_erp_gl_account_changes__factory_id__status")
  @@index([accountId], map: "ix_erp_gl_account_changes__account_id")
  @@index([createdById], map: "ix_erp_gl_account_changes__created_by")
  @@index([decidedById], map: "ix_erp_gl_account_changes__decided_by")
  @@map("erp_gl_account_changes")
}

/// D-387: a fiscal year of the factory with its 12 monthly periods, created on demand.
model ErpGlFiscalYear {
  id             BigInt   @id(map: "pk_erp_gl_fiscal_years") @default(autoincrement())
  publicId       String   @unique(map: "ux_erp_gl_fiscal_years__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  factoryId      BigInt   @map("factory_id")
  label          String
  startDate      DateTime @map("start_date") @db.Date
  endDate        DateTime @map("end_date") @db.Date
  locked         Boolean  @default(false)
  /// The closing entry (profit to retained earnings) once the year is closed.
  closingEntryId BigInt?  @map("closing_entry_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  factory Factory       @relation("ErpGlFiscalYearFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_fiscal_years__factory_id")
  periods ErpGlPeriod[]

  @@unique([factoryId, startDate], map: "ux_erp_gl_fiscal_years__factory_id__start_date")
  @@map("erp_gl_fiscal_years")
}

/// D-387: a month: `open → soft_closed → closed → locked`, closing in order.
model ErpGlPeriod {
  id                BigInt       @id(map: "pk_erp_gl_periods") @default(autoincrement())
  publicId          String       @unique(map: "ux_erp_gl_periods__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  factoryId         BigInt       @map("factory_id")
  fiscalYearId      BigInt       @map("fiscal_year_id")
  periodNo          Int          @map("period_no") @db.SmallInt
  startDate         DateTime     @map("start_date") @db.Date
  endDate           DateTime     @map("end_date") @db.Date
  status            PeriodStatus @default(open)
  statusChangedAt   DateTime?    @map("status_changed_at") @db.Timestamptz(6)
  statusChangedById BigInt?      @map("status_changed_by")
  /// The close checklist as it stood when the month closed (D-393).
  closeChecklist    Json?        @map("close_checklist")
  closeNote         String?      @map("close_note")

  factory          Factory                @relation("ErpGlPeriodFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_periods__factory_id")
  fiscalYear       ErpGlFiscalYear        @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_periods__fiscal_year_id")
  statusChangedBy  User?                  @relation("ErpGlPeriodStatusChangedBy", fields: [statusChangedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_periods__status_changed_by")
  entries          ErpGlJournalEntry[]
  lines            ErpGlJournalLine[]
  depreciationRuns ErpGlDepreciationRun[]

  @@unique([fiscalYearId, periodNo], map: "ux_erp_gl_periods__fiscal_year_id__period_no")
  @@index([factoryId, startDate], map: "ix_erp_gl_periods__factory_id__start_date")
  @@index([statusChangedById], map: "ix_erp_gl_periods__status_changed_by")
  @@map("erp_gl_periods")
}

/// D-388: a journal entry. Posted entries never change; corrections are reversals. One entry per (event, rule).
model ErpGlJournalEntry {
  id                     BigInt        @id(map: "pk_erp_gl_journal_entries") @default(autoincrement())
  publicId               String        @unique(map: "ux_erp_gl_journal_entries__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  factoryId              BigInt        @map("factory_id")
  periodId               BigInt        @map("period_id")
  /// `JV-YYMM-NNNN`, assigned at posting (D-323).
  entryNo                String?       @map("entry_no")
  entryDate              DateTime      @map("entry_date") @db.Date
  documentDate           DateTime      @map("document_date") @db.Date
  kind                   JournalKind
  status                 JournalStatus @default(draft)
  sourceDocumentType     String?       @map("source_document_type")
  sourceDocumentPublicId String?       @map("source_document_public_id") @db.Uuid
  sourceDocumentNo       String?       @map("source_document_no")
  domainEventId          String?       @map("domain_event_id") @db.Uuid
  postingRuleId          BigInt?       @map("posting_rule_id")
  postingRuleVersionId   BigInt?       @map("posting_rule_version_id")
  reversesEntryId        BigInt?       @unique(map: "ux_erp_gl_journal_entries__reverses_entry_id") @map("reverses_entry_id")
  recurringJournalId     BigInt?       @map("recurring_journal_id")
  autoReverseOn          DateTime?     @map("auto_reverse_on") @db.Date
  description            String
  totalDebit             Decimal       @default(0) @map("total_debit") @db.Decimal(14, 2)
  totalCredit            Decimal       @default(0) @map("total_credit") @db.Decimal(14, 2)
  rejectionReason        String?       @map("rejection_reason")
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById            BigInt?       @map("created_by")
  approvedAt             DateTime?     @map("approved_at") @db.Timestamptz(6)
  approvedById           BigInt?       @map("approved_by")
  postedAt               DateTime?     @map("posted_at") @db.Timestamptz(6)
  postedById             BigInt?       @map("posted_by")
  updatedAt              DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion             Int           @default(1) @map("row_version")

  factory            Factory                  @relation("ErpGlJournalEntryFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_journal_entries__factory_id")
  period             ErpGlPeriod              @relation(fields: [periodId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_journal_entries__period_id")
  postingRule        ErpGlPostingRule?        @relation(fields: [postingRuleId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_journal_entries__posting_rule_id")
  postingRuleVersion ErpGlPostingRuleVersion? @relation(fields: [postingRuleVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_journal_entries__posting_rule_version_id")
  reverses           ErpGlJournalEntry?       @relation("ErpGlJournalEntryReversal", fields: [reversesEntryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_journal_entries__reverses_entry_id")
  reversedBy         ErpGlJournalEntry?       @relation("ErpGlJournalEntryReversal")
  recurringJournal   ErpGlRecurringJournal?   @relation(fields: [recurringJournalId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_journal_entries__recurring_journal_id")
  createdBy          User?                    @relation("ErpGlJournalEntryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_journal_entries__created_by")
  approvedBy         User?                    @relation("ErpGlJournalEntryApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_journal_entries__approved_by")
  postedBy           User?                    @relation("ErpGlJournalEntryPostedBy", fields: [postedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_journal_entries__posted_by")
  lines              ErpGlJournalLine[]
  depreciationRun    ErpGlDepreciationRun?
  bankMatches        ErpGlBankMatch[]

  @@unique([factoryId, entryNo], map: "ux_erp_gl_journal_entries__factory_id__entry_no")
  @@unique([domainEventId, postingRuleId], map: "ux_erp_gl_journal_entries__domain_event_id__posting_rule_id", where: raw("(domain_event_id IS NOT NULL)"))
  @@index([factoryId, entryDate], map: "ix_erp_gl_journal_entries__factory_id__entry_date")
  @@index([periodId, status], map: "ix_erp_gl_journal_entries__period_id__status")
  @@index([factoryId, sourceDocumentType, sourceDocumentPublicId], map: "ix_erp_gl_journal_entries__source")
  @@index([postingRuleId], map: "ix_erp_gl_journal_entries__posting_rule_id")
  @@index([postingRuleVersionId], map: "ix_erp_gl_journal_entries__posting_rule_version_id")
  @@index([recurringJournalId], map: "ix_erp_gl_journal_entries__recurring_journal_id")
  @@index([createdById], map: "ix_erp_gl_journal_entries__created_by")
  @@index([approvedById], map: "ix_erp_gl_journal_entries__approved_by")
  @@index([postedById], map: "ix_erp_gl_journal_entries__posted_by")
  @@index([autoReverseOn], map: "ix_erp_gl_journal_entries__auto_reverse_on", where: raw("(auto_reverse_on IS NOT NULL)"))
  @@map("erp_gl_journal_entries")
}

/// D-388: one side of an entry with the ERP dimensions it is about and its tax tag.
model ErpGlJournalLine {
  id                BigInt   @id(map: "pk_erp_gl_journal_lines") @default(autoincrement())
  entryId           BigInt   @map("entry_id")
  lineNo            Int      @map("line_no") @db.SmallInt
  accountId         BigInt   @map("account_id")
  debit             Decimal  @default(0) @db.Decimal(14, 2)
  credit            Decimal  @default(0) @db.Decimal(14, 2)
  description       String?
  itemId            BigInt?  @map("item_id")
  partnerId         BigInt?  @map("partner_id")
  warehouseId       BigInt?  @map("warehouse_id")
  productionOrderId BigInt?  @map("production_order_id")
  machineId         BigInt?  @map("machine_id")
  bankAccountId     BigInt?  @map("bank_account_id")
  taxCode           TaxCode? @map("tax_code")
  taxBaseAmount     Decimal? @map("tax_base_amount") @db.Decimal(14, 2)
  factoryId         BigInt   @map("factory_id")
  periodId          BigInt   @map("period_id")
  entryDate         DateTime @map("entry_date") @db.Date
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  entry           ErpGlJournalEntry   @relation(fields: [entryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_journal_lines__entry_id")
  account         ErpGlAccount        @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_journal_lines__account_id")
  item            ErpItem?            @relation("ErpGlJournalLineItem", fields: [itemId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_journal_lines__item_id")
  partner         ErpTradingPartner?  @relation("ErpGlJournalLinePartner", fields: [partnerId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_journal_lines__partner_id")
  warehouse       ErpWarehouse?       @relation("ErpGlJournalLineWarehouse", fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_journal_lines__warehouse_id")
  productionOrder ErpProductionOrder? @relation("ErpGlJournalLineMo", fields: [productionOrderId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_journal_lines__production_order_id")
  machine         FactoryMachine?     @relation("ErpGlJournalLineMachine", fields: [machineId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_journal_lines__machine_id")
  bankAccount     ErpGlBankAccount?   @relation("ErpGlJournalLineBank", fields: [bankAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_journal_lines__bank_account_id")
  factory         Factory             @relation("ErpGlJournalLineFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_journal_lines__factory_id")
  period          ErpGlPeriod         @relation(fields: [periodId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_journal_lines__period_id")

  @@unique([entryId, lineNo], map: "ux_erp_gl_journal_lines__entry_id__line_no")
  @@index([accountId, entryDate], map: "ix_erp_gl_journal_lines__account_id__entry_date")
  @@index([factoryId, periodId, accountId], map: "ix_erp_gl_journal_lines__factory_id__period_id__account_id")
  @@index([periodId], map: "ix_erp_gl_journal_lines__period_id")
  @@index([itemId], map: "ix_erp_gl_journal_lines__item_id", where: raw("(item_id IS NOT NULL)"))
  @@index([partnerId], map: "ix_erp_gl_journal_lines__partner_id", where: raw("(partner_id IS NOT NULL)"))
  @@index([warehouseId], map: "ix_erp_gl_journal_lines__warehouse_id", where: raw("(warehouse_id IS NOT NULL)"))
  @@index([productionOrderId], map: "ix_erp_gl_journal_lines__production_order_id", where: raw("(production_order_id IS NOT NULL)"))
  @@index([machineId], map: "ix_erp_gl_journal_lines__machine_id", where: raw("(machine_id IS NOT NULL)"))
  @@index([bankAccountId], map: "ix_erp_gl_journal_lines__bank_account_id", where: raw("(bank_account_id IS NOT NULL)"))
  @@index([taxCode, entryDate], map: "ix_erp_gl_journal_lines__tax_code__entry_date", where: raw("(tax_code IS NOT NULL)"))
  @@map("erp_gl_journal_lines")
}

/// D-389: a posting rule of the factory (F01 – F15), copied from the template; versions hold the journal template.
model ErpGlPostingRule {
  id          BigInt   @id(map: "pk_erp_gl_posting_rules") @default(autoincrement())
  publicId    String   @unique(map: "ux_erp_gl_posting_rules__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  factoryId   BigInt   @map("factory_id")
  key         String
  eventType   String   @map("event_type")
  name        String
  description String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  factory  Factory                   @relation("ErpGlPostingRuleFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_posting_rules__factory_id")
  versions ErpGlPostingRuleVersion[]
  entries  ErpGlJournalEntry[]

  @@unique([factoryId, key], map: "ux_erp_gl_posting_rules__factory_id__key")
  @@index([factoryId, eventType], map: "ix_erp_gl_posting_rules__factory_id__event_type")
  @@map("erp_gl_posting_rules")
}

model ErpGlPostingRuleVersion {
  id            BigInt              @id(map: "pk_erp_gl_posting_rule_versions") @default(autoincrement())
  publicId      String              @unique(map: "ux_erp_gl_posting_rule_versions__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  ruleId        BigInt              @map("rule_id")
  versionNo     Int                 @map("version_no")
  effectiveFrom DateTime            @map("effective_from") @db.Timestamptz(6)
  status        ConfigVersionStatus @default(draft)
  conditions    Json?
  template      Json
  reason        String
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById   BigInt?             @map("created_by")
  decidedAt     DateTime?           @map("decided_at") @db.Timestamptz(6)
  decidedById   BigInt?             @map("decided_by")

  rule      ErpGlPostingRule    @relation(fields: [ruleId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_posting_rule_versions__rule_id")
  createdBy User?               @relation("ErpGlPostingRuleVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_posting_rule_versions__created_by")
  decidedBy User?               @relation("ErpGlPostingRuleVersionDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_posting_rule_versions__decided_by")
  entries   ErpGlJournalEntry[]

  @@unique([ruleId, versionNo], map: "ux_erp_gl_posting_rule_versions__rule_id__version_no")
  @@index([ruleId, effectiveFrom(sort: Desc), versionNo(sort: Desc)], map: "ix_erp_gl_posting_rule_versions__resolution", where: raw("(status = 'approved'::config_version_status)"))
  @@index([createdById], map: "ix_erp_gl_posting_rule_versions__created_by")
  @@index([decidedById], map: "ix_erp_gl_posting_rule_versions__decided_by")
  @@map("erp_gl_posting_rule_versions")
}

/// D-390: a recurring journal (rent, insurance), run on its day of the month; optionally auto-reversed.
model ErpGlRecurringJournal {
  id           BigInt        @id(map: "pk_erp_gl_recurring_journals") @default(autoincrement())
  publicId     String        @unique(map: "ux_erp_gl_recurring_journals__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  factoryId    BigInt        @map("factory_id")
  name         String
  description  String
  dayOfMonth   Int           @map("day_of_month") @db.SmallInt
  startOn      DateTime      @map("start_on") @db.Date
  endOn        DateTime?     @map("end_on") @db.Date
  autoReverse  Boolean       @default(false) @map("auto_reverse")
  /// `[{ accountCode, side, amount, description }]`.
  lines        Json
  status       AccountStatus @default(active)
  lastRunMonth String?       @map("last_run_month")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById  BigInt        @map("created_by")
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById  BigInt?       @map("updated_by")
  rowVersion   Int           @default(1) @map("row_version")

  factory   Factory             @relation("ErpGlRecurringJournalFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_recurring_journals__factory_id")
  createdBy User                @relation("ErpGlRecurringJournalCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_recurring_journals__created_by")
  updatedBy User?               @relation("ErpGlRecurringJournalUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_recurring_journals__updated_by")
  entries   ErpGlJournalEntry[]

  @@index([factoryId, status], map: "ix_erp_gl_recurring_journals__factory_id__status")
  @@index([createdById], map: "ix_erp_gl_recurring_journals__created_by")
  @@index([updatedById], map: "ix_erp_gl_recurring_journals__updated_by")
  @@map("erp_gl_recurring_journals")
}

/// D-394: an asset class with its accounts and useful life.
