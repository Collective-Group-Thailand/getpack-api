  expenseAccountId     BigInt        @map("expense_account_id")
  gainLossAccountId    BigInt        @map("gain_loss_account_id")
  status               AccountStatus @default(active)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById          BigInt        @map("created_by")

  factory            Factory           @relation("ErpGlAssetCategoryFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_asset_categories__factory_id")
  assetAccount       ErpGlAccount      @relation("ErpGlAssetCategoryAsset", fields: [assetAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_asset_categories__asset_account_id")
  accumulatedAccount ErpGlAccount      @relation("ErpGlAssetCategoryAccumulated", fields: [accumulatedAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_asset_categories__accumulated_account_id")
  expenseAccount     ErpGlAccount      @relation("ErpGlAssetCategoryExpense", fields: [expenseAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_asset_categories__expense_account_id")
  gainLossAccount    ErpGlAccount      @relation("ErpGlAssetCategoryGainLoss", fields: [gainLossAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_asset_categories__gain_loss_account_id")
  createdBy          User              @relation("ErpGlAssetCategoryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_asset_categories__created_by")
  assets             ErpGlFixedAsset[]

  @@unique([factoryId, name], map: "ux_erp_gl_asset_categories__factory_id__name")
  @@index([assetAccountId], map: "ix_erp_gl_asset_categories__asset_account_id")
  @@index([accumulatedAccountId], map: "ix_erp_gl_asset_categories__accumulated_account_id")
  @@index([expenseAccountId], map: "ix_erp_gl_asset_categories__expense_account_id")
  @@index([gainLossAccountId], map: "ix_erp_gl_asset_categories__gain_loss_account_id")
  @@index([createdById], map: "ix_erp_gl_asset_categories__created_by")
  @@map("erp_gl_asset_categories")
}

/// D-394: a fixed asset, straight-line monthly depreciation; a machine may link to its asset.
model ErpGlFixedAsset {
  id                 BigInt           @id(map: "pk_erp_gl_fixed_assets") @default(autoincrement())
  publicId           String           @unique(map: "ux_erp_gl_fixed_assets__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  factoryId          BigInt           @map("factory_id")
  categoryId         BigInt           @map("category_id")
  machineId          BigInt?          @map("machine_id")
  assetNo            String           @map("asset_no")
  name               String
  acquiredOn         DateTime         @map("acquired_on") @db.Date
  cost               Decimal          @db.Decimal(14, 2)
  salvageValue       Decimal          @default(0) @map("salvage_value") @db.Decimal(14, 2)
  usefulLifeMonths   Int              @map("useful_life_months")
  depreciationStart  DateTime         @map("depreciation_start") @db.Date
  /// Depreciation already taken before the ledger started (opening balance).
  openingAccumulated Decimal          @default(0) @map("opening_accumulated") @db.Decimal(14, 2)
  accumulated        Decimal          @default(0) @db.Decimal(14, 2)
  monthsDepreciated  Int              @default(0) @map("months_depreciated")
  status             ErpGlAssetStatus @default(active)
  disposedOn         DateTime?        @map("disposed_on") @db.Date
  proceeds           Decimal?         @db.Decimal(14, 2)
  disposalEntryId    BigInt?          @map("disposal_entry_id")
  note               String?
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById        BigInt           @map("created_by")
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById        BigInt?          @map("updated_by")
  rowVersion         Int              @default(1) @map("row_version")

  factory   Factory                 @relation("ErpGlFixedAssetFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_fixed_assets__factory_id")
  category  ErpGlAssetCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_fixed_assets__category_id")
  machine   FactoryMachine?         @relation("ErpGlFixedAssetMachine", fields: [machineId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_fixed_assets__machine_id")
  createdBy User                    @relation("ErpGlFixedAssetCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_fixed_assets__created_by")
  updatedBy User?                   @relation("ErpGlFixedAssetUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_fixed_assets__updated_by")
  runLines  ErpGlDepreciationLine[]

  @@unique([factoryId, assetNo], map: "ux_erp_gl_fixed_assets__factory_id__asset_no")
  @@index([factoryId, status], map: "ix_erp_gl_fixed_assets__factory_id__status")
  @@index([categoryId], map: "ix_erp_gl_fixed_assets__category_id")
  @@index([machineId], map: "ix_erp_gl_fixed_assets__machine_id")
  @@index([createdById], map: "ix_erp_gl_fixed_assets__created_by")
  @@index([updatedById], map: "ix_erp_gl_fixed_assets__updated_by")
  @@map("erp_gl_fixed_assets")
}

/// D-394: one month's depreciation, posted as one journal.
model ErpGlDepreciationRun {
  id          BigInt   @id(map: "pk_erp_gl_depreciation_runs") @default(autoincrement())
  publicId    String   @unique(map: "ux_erp_gl_depreciation_runs__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  factoryId   BigInt   @map("factory_id")
  periodId    BigInt   @unique(map: "ux_erp_gl_depreciation_runs__period_id") @map("period_id")
  entryId     BigInt?  @unique(map: "ux_erp_gl_depreciation_runs__entry_id") @map("entry_id")
  total       Decimal  @db.Decimal(14, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById BigInt   @map("created_by")

  factory   Factory                 @relation("ErpGlDepreciationRunFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_depreciation_runs__factory_id")
  period    ErpGlPeriod             @relation(fields: [periodId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_depreciation_runs__period_id")
  entry     ErpGlJournalEntry?      @relation(fields: [entryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_depreciation_runs__entry_id")
  createdBy User                    @relation("ErpGlDepreciationRunCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_depreciation_runs__created_by")
  lines     ErpGlDepreciationLine[]

  @@index([factoryId], map: "ix_erp_gl_depreciation_runs__factory_id")
  @@index([createdById], map: "ix_erp_gl_depreciation_runs__created_by")
  @@map("erp_gl_depreciation_runs")
}

model ErpGlDepreciationLine {
  id      BigInt  @id(map: "pk_erp_gl_depreciation_lines") @default(autoincrement())
  runId   BigInt  @map("run_id")
  assetId BigInt  @map("asset_id")
  amount  Decimal @db.Decimal(14, 2)

  run   ErpGlDepreciationRun @relation(fields: [runId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_depreciation_lines__run_id")
  asset ErpGlFixedAsset      @relation(fields: [assetId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_depreciation_lines__asset_id")

  @@unique([runId, assetId], map: "ux_erp_gl_depreciation_lines__run_id__asset_id")
  @@index([assetId], map: "ix_erp_gl_depreciation_lines__asset_id")
  @@map("erp_gl_depreciation_lines")
}

/// D-395: a bank account of the factory and the GL account it books to.
model ErpGlBankAccount {
  id             BigInt        @id(map: "pk_erp_gl_bank_accounts") @default(autoincrement())
  publicId       String        @unique(map: "ux_erp_gl_bank_accounts__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  factoryId      BigInt        @map("factory_id")
  name           String
  bankName       String        @map("bank_name")
  /// Last 4 digits only.
  accountNoLast4 String        @map("account_no_last4")
  glAccountId    BigInt        @map("gl_account_id")
  /// The payment methods (D-338, D-365) that settle through this account.
  isDefault      Boolean       @default(false) @map("is_default")
  status         AccountStatus @default(active)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById    BigInt        @map("created_by")
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById    BigInt?       @map("updated_by")
  rowVersion     Int           @default(1) @map("row_version")

  factory   Factory                  @relation("ErpGlBankAccountFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_bank_accounts__factory_id")
  glAccount ErpGlAccount             @relation("ErpGlBankAccountGl", fields: [glAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_bank_accounts__gl_account_id")
  createdBy User                     @relation("ErpGlBankAccountCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_bank_accounts__created_by")
  updatedBy User?                    @relation("ErpGlBankAccountUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_bank_accounts__updated_by")
  lines     ErpGlJournalLine[]       @relation("ErpGlJournalLineBank")
  statement ErpGlBankStatementLine[]

  @@index([factoryId, status], map: "ix_erp_gl_bank_accounts__factory_id__status")
  @@index([glAccountId], map: "ix_erp_gl_bank_accounts__gl_account_id")
  @@index([createdById], map: "ix_erp_gl_bank_accounts__created_by")
  @@index([updatedById], map: "ix_erp_gl_bank_accounts__updated_by")
  @@map("erp_gl_bank_accounts")
}

/// D-395: a line of a bank statement the factory imported; matched to a payment, a receipt or an entry.
model ErpGlBankStatementLine {
  id            BigInt              @id(map: "pk_erp_gl_bank_statement_lines") @default(autoincrement())
  publicId      String              @unique(map: "ux_erp_gl_bank_statement_lines__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  factoryId     BigInt              @map("factory_id")
  bankAccountId BigInt              @map("bank_account_id")
  txnDate       DateTime            @map("txn_date") @db.Date
  /// Signed: money in positive, money out negative.
  amount        Decimal             @db.Decimal(14, 2)
  description   String
  reference     String?
  /// SHA-256 of (account, date, amount, description, reference): the same line is never imported twice.
  lineHash      Bytes               @map("line_hash")
  status        ErpGlBankLineStatus @default(open)
  ignoreReason  String?             @map("ignore_reason")
  importedAt    DateTime            @default(now()) @map("imported_at") @db.Timestamptz(6)
  importedById  BigInt              @map("imported_by")

  factory     Factory          @relation("ErpGlBankStatementLineFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_bank_statement_lines__factory_id")
  bankAccount ErpGlBankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_bank_statement_lines__bank_account_id")
  importedBy  User             @relation("ErpGlBankStatementLineImportedBy", fields: [importedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_bank_statement_lines__imported_by")
  matches     ErpGlBankMatch[]

  @@unique([bankAccountId, lineHash], map: "ux_erp_gl_bank_statement_lines__bank_account_id__line_hash")
  @@index([factoryId, status, txnDate], map: "ix_erp_gl_bank_statement_lines__factory_id__status__txn_date")
  @@index([importedById], map: "ix_erp_gl_bank_statement_lines__imported_by")
  @@map("erp_gl_bank_statement_lines")
}

/// D-395: what a statement line was matched to.
model ErpGlBankMatch {
  id             BigInt               @id(map: "pk_erp_gl_bank_matches") @default(autoincrement())
  lineId         BigInt               @map("line_id")
  targetType     ErpGlBankMatchTarget @map("target_type")
  targetPublicId String?              @map("target_public_id") @db.Uuid
  targetNo       String?              @map("target_no")
  entryId        BigInt?              @map("entry_id")
  amount         Decimal              @db.Decimal(14, 2)
  auto           Boolean              @default(false)
  matchedAt      DateTime             @default(now()) @map("matched_at") @db.Timestamptz(6)
  matchedById    BigInt?              @map("matched_by")

  line      ErpGlBankStatementLine @relation(fields: [lineId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_bank_matches__line_id")
  entry     ErpGlJournalEntry?     @relation(fields: [entryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_bank_matches__entry_id")
  matchedBy User?                  @relation("ErpGlBankMatchMatchedBy", fields: [matchedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_bank_matches__matched_by")

  @@index([lineId], map: "ix_erp_gl_bank_matches__line_id")
  @@index([targetType, targetPublicId], map: "ix_erp_gl_bank_matches__target")
  @@index([entryId], map: "ix_erp_gl_bank_matches__entry_id")
  @@index([matchedById], map: "ix_erp_gl_bank_matches__matched_by")
  @@map("erp_gl_bank_matches")
}

/// D-392: a tax return the factory marked as filed (ภ.พ.30, ภ.ง.ด.3, ภ.ง.ด.53) for a month.
model ErpGlTaxFiling {
  id          BigInt         @id(map: "pk_erp_gl_tax_filings") @default(autoincrement())
