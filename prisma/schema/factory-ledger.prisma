  factoryId   BigInt         @map("factory_id")
  form        ErpGlTaxReturn
  month       DateTime       @db.Date
  filedOn     DateTime       @map("filed_on") @db.Date
  reference   String?
  amount      Decimal        @db.Decimal(14, 2)
  note        String?
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById BigInt         @map("created_by")

  factory   Factory @relation("ErpGlTaxFilingFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_tax_filings__factory_id")
  createdBy User    @relation("ErpGlTaxFilingCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_gl_tax_filings__created_by")

  @@unique([factoryId, form, month], map: "ux_erp_gl_tax_filings__factory_id__form__month")
  @@index([createdById], map: "ix_erp_gl_tax_filings__created_by")
  @@map("erp_gl_tax_filings")
}
