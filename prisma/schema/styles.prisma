// U3 style library (schema-design A-86; D-184, D-211, D-212, D-241–D-246).

enum StyleStatus {
  active
  retired

  @@map("style_status")
}

enum StyleImportKind {
  master
  recipes

  @@map("style_import_kind")
}

enum StyleImportStatus {
  applied
  pending_approval
  rejected

  @@map("style_import_status")
}

enum StyleAssetKind {
  thumbnail_2d
  thumbnail_3d
  dieline_svg
  manifest

  @@map("style_asset_kind")
}

/// D-241: a base structure of the style library (`PK-<FAMILY>-<NN>`, D-184), imported from the master file.
model StyleBase {
  id                       BigInt      @id(map: "pk_style_bases") @default(autoincrement())
  publicId                 String      @unique(map: "ux_style_bases__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  code                     String      @unique(map: "ux_style_bases__code")
  family                   String
  category                 String
  /// The master file's product type (folding, corrugate, rigid, mailer …), kept as imported.
  sourceProductType        String      @map("source_product_type")
  /// The getpack product type it is sold as; null until mapped (no pricing path, D-243).
  productTypeId            BigInt?     @map("product_type_id")
  /// The configurator / pricing style with the same code (D-184); null when none exists yet.
  patternId                BigInt?     @unique(map: "ux_style_bases__pattern_id") @map("pattern_id")
  nameTh                   String      @map("name_th")
  nameEn                   String      @map("name_en")
  construction             String
  materialClass            String      @map("material_class")
  variantAxes              String[]    @default([]) @map("variant_axes")
  wave                     Int         @db.SmallInt
  complexity               String?
  /// Industry reference (FEFCO / ECMA) as imported — shown only once verified (D-211).
  referenceCode            String?     @map("reference_code")
  referenceVerifiedAt      DateTime?   @map("reference_verified_at") @db.Timestamptz(6)
  referenceVerifiedById    BigInt?     @map("reference_verified_by")
  pricingPathAtLaunch      String?     @map("pricing_path_at_launch")
  /// D-212 name approval: Marketing (wording) and Prepress (technical terms); cleared when a name changes.
  namesApprovedMarketingAt DateTime?   @map("names_approved_marketing_at") @db.Timestamptz(6)
  namesApprovedMarketingBy BigInt?     @map("names_approved_marketing_by")
  namesApprovedPrepressAt  DateTime?   @map("names_approved_prepress_at") @db.Timestamptz(6)
  namesApprovedPrepressBy  BigInt?     @map("names_approved_prepress_by")
  descriptionTh            String?     @map("description_th")
  descriptionEn            String?     @map("description_en")
  featured                 Boolean     @default(false)
  hidden                   Boolean     @default(false)
  sort                     Int         @default(0)
  status                   StyleStatus @default(active)
  /// D-426: the style's photo (a photograph or an AI render of the type), shown on its cards before the
  /// engine's thumbnails; `{ source, alt }` of it lives in `photoMeta`.
  photoFileId              BigInt?     @map("photo_file_id")
  photoMeta                Json?       @map("photo_meta")
  /// First time a variant became publishable (D-184: the code is frozen from then).
  publishedAt              DateTime?   @map("published_at") @db.Timestamptz(6)
  /// sha256 of the imported fields, so a re-import of the same data changes nothing.
  sourceSha256             Bytes       @map("source_sha256")
  /// D-245: names, codes, family, category, material class, synonyms, use cases and a verified reference, lower-cased —
  /// searched with the `simple` text-search configuration and trigram similarity (typo tolerance).
  searchDocument           String      @default("") @map("search_document")
  lastImportRunId          BigInt?     @map("last_import_run_id")
  createdAt                DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById              BigInt?     @map("updated_by")
  rowVersion               Int         @default(1) @map("row_version")

  productType         ProductType?              @relation("StyleBaseProductType", fields: [productTypeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_style_bases__product_type_id")
  pattern             Pattern?                  @relation("StyleBasePattern", fields: [patternId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_style_bases__pattern_id")
  referenceVerifiedBy User?                     @relation("StyleBaseReferenceVerifiedBy", fields: [referenceVerifiedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_style_bases__reference_verified_by")
  marketingApprover   User?                     @relation("StyleBaseNamesMarketing", fields: [namesApprovedMarketingBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_style_bases__names_approved_marketing_by")
  prepressApprover    User?                     @relation("StyleBaseNamesPrepress", fields: [namesApprovedPrepressBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_style_bases__names_approved_prepress_by")
  updatedBy           User?                     @relation("StyleBaseUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_style_bases__updated_by")
  lastImportRun       StyleImportRun?           @relation("StyleBaseLastImportRun", fields: [lastImportRunId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_style_bases__last_import_run_id")
  photoFile           FileObject?               @relation("StyleBasePhotoFile", fields: [photoFileId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_style_bases__photo_file_id")
  variants            StyleVariant[]
  recipes             StyleRecipe[]
  assets              StyleAsset[]
  intakesProposed     StyleIntake[]             @relation("StyleIntakeProposedBase")
  intakeTemplates     StyleIntake[]             @relation("StyleIntakeTemplateBase")
  structuralRequests  StructuralDesignRequest[] @relation("StructuralRequestPublishedBase")
  unmetDemand         UnmetDemandRecord[]       @relation("UnmetDemandStyleBase")
  synonyms            StyleSynonym[]
  useCases            StyleUseCase[]
  favourites          StyleFavourite[]

  @@index([category, status], map: "ix_style_bases__category__status")
  @@index([searchDocument(ops: raw("gin_trgm_ops"))], type: Gin, map: "ix_style_bases__search_document_trgm")
  @@index([productTypeId], map: "ix_style_bases__product_type_id")
  @@index([referenceVerifiedById], map: "ix_style_bases__reference_verified_by")
  @@index([namesApprovedMarketingBy], map: "ix_style_bases__names_approved_marketing_by")
  @@index([namesApprovedPrepressBy], map: "ix_style_bases__names_approved_prepress_by")
  @@index([updatedById], map: "ix_style_bases__updated_by")
  @@index([lastImportRunId], map: "ix_style_bases__last_import_run_id")
  @@index([photoFileId], map: "ix_style_bases__photo_file_id")
  @@map("style_bases")
}

/// D-241 / D-243: one structural variant (a combination of option values) with its publishability and reasons.
model StyleVariant {
  id           BigInt         @id(map: "pk_style_variants") @default(autoincrement())
  publicId     String         @unique(map: "ux_style_variants__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  baseId       BigInt         @map("base_id")
  code         String         @unique(map: "ux_style_variants__code")
  codeSuffix   String         @map("code_suffix")
  /// Normalised `axis=value;axis=value` in the base's axis order (a multi-select value joins with `+`).
  optionKey    String         @map("option_key")
  options      Json
  publishable  Boolean        @default(false)
  reasons      String[]       @default([])
  /// D-266: `instant` only with a signed calculator and every option priced; else `rfq` with `price_reasons`.
  pricePath    StylePricePath @default(rfq) @map("price_path")
  priceReasons String[]       @default([]) @map("price_reasons")
  evaluatedAt  DateTime?      @map("evaluated_at") @db.Timestamptz(6)
  publishedAt  DateTime?      @map("published_at") @db.Timestamptz(6)
  status       StyleStatus    @default(active)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  base           StyleBase        @relation(fields: [baseId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_style_variants__base_id")
  assets         StyleAsset[]
  rfqs           Rfq[]            @relation("RfqStyleVariant")
  dielineRenders DielineRender[]
  designs        DesignDocument[] @relation("DesignDocumentStyleVariant")

  @@unique([baseId, optionKey], map: "ux_style_variants__base_id__option_key")
  @@index([baseId, publishable], map: "ix_style_variants__base_id__publishable")
  @@map("style_variants")
}

/// D-241: a versioned `@getpack/dieline` recipe of a base; current = the latest version approved by Prepress.
model StyleRecipe {
  id            BigInt    @id(map: "pk_style_recipes") @default(autoincrement())
  publicId      String    @unique(map: "ux_style_recipes__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  baseId        BigInt    @map("base_id")
  version       Int
  schemaVersion String    @map("schema_version")
  recipe        Json
  checksum      Bytes
  /// Processes the recipe's modules declare (D-244); empty = use the process rules.
  processes     String[]  @default([])
  /// Size ranges per material class from the recipe's constraint solver (mm, internal basis).
  sizeRanges    Json?     @map("size_ranges")
  approvedAt    DateTime? @map("approved_at") @db.Timestamptz(6)
  approvedById  BigInt?   @map("approved_by")
  importRunId   BigInt?   @map("import_run_id")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  base           StyleBase       @relation(fields: [baseId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_style_recipes__base_id")
  approvedBy     User?           @relation("StyleRecipeApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_style_recipes__approved_by")
  importRun      StyleImportRun? @relation("StyleRecipeImportRun", fields: [importRunId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_style_recipes__import_run_id")
  dielineRenders DielineRender[]
  intakesMatched StyleIntake[]   @relation("StyleIntakeMatchedRecipe")
  intakesResult  StyleIntake[]   @relation("StyleIntakeResultRecipe")

  @@unique([baseId, version], map: "ux_style_recipes__base_id__version")
  @@index([approvedById], map: "ix_style_recipes__approved_by")
  @@index([importRunId], map: "ix_style_recipes__import_run_id")
  @@map("style_recipes")
}

/// D-241: generated assets of a base or variant (thumbnails, dieline SVG, manifest) — object-storage keys + hashes.
model StyleAsset {
  id            BigInt         @id(map: "pk_style_assets") @default(autoincrement())
  publicId      String         @unique(map: "ux_style_assets__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  baseId        BigInt         @map("base_id")
  variantId     BigInt?        @map("variant_id")
  kind          StyleAssetKind
  storageKey    String         @map("storage_key")
  sha256        Bytes
  contentType   String         @map("content_type")
  recipeVersion Int?           @map("recipe_version")
  /// D-270: the engine bundle that rendered it (a new bundle re-renders).
  engineVersion String?        @map("engine_version")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  base    StyleBase     @relation(fields: [baseId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_style_assets__base_id")
  variant StyleVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_style_assets__variant_id")

  @@index([baseId, kind], map: "ix_style_assets__base_id__kind")
  @@index([variantId], map: "ix_style_assets__variant_id")
  @@map("style_assets")
}

/// D-245: Thai / English search terms of a base.
model StyleSynonym {
  id        BigInt   @id(map: "pk_style_synonyms") @default(autoincrement())
  baseId    BigInt   @map("base_id")
  locale    String
  term      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  base StyleBase @relation(fields: [baseId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_style_synonyms__base_id")

  @@index([baseId], map: "ix_style_synonyms__base_id")
  @@map("style_synonyms")
}

/// D-245: use cases of a base (facet).
model StyleUseCase {
  id        BigInt   @id(map: "pk_style_use_cases") @default(autoincrement())
  baseId    BigInt   @map("base_id")
  code      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  base StyleBase @relation(fields: [baseId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_style_use_cases__base_id")

  @@unique([baseId, code], map: "ux_style_use_cases__base_id__code")
  @@map("style_use_cases")
}

/// D-242: one style import (master file or recipe bundle): checksum, diff, and the changes held for approval.
model StyleImportRun {
  id                BigInt            @id(map: "pk_style_import_runs") @default(autoincrement())
  publicId          String            @unique(map: "ux_style_import_runs__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  kind              StyleImportKind
  fileName          String            @map("file_name")
  checksum          Bytes
  status            StyleImportStatus
  /// Counts and the per-row changes applied.
  diff              Json
  /// Changes to published rows, applied only when the approval is granted (D-242).
  pendingChanges    Json?             @map("pending_changes")
  axes              Json?
  approvalRequestId BigInt?           @map("approval_request_id")
  createdById       BigInt?           @map("created_by")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  decidedAt         DateTime?         @map("decided_at") @db.Timestamptz(6)

  approvalRequest ApprovalRequest? @relation("StyleImportRunApproval", fields: [approvalRequestId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_style_import_runs__approval_request_id")
  createdBy       User?            @relation("StyleImportRunCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_style_import_runs__created_by")
  bases           StyleBase[]      @relation("StyleBaseLastImportRun")
  recipes         StyleRecipe[]    @relation("StyleRecipeImportRun")

  @@unique([kind, checksum], map: "ux_style_import_runs__kind__checksum__live", where: raw("(status <> 'rejected'::style_import_status)"))
  @@index([kind, checksum], map: "ix_style_import_runs__kind__checksum")
  @@index([approvalRequestId], map: "ix_style_import_runs__approval_request_id")
  @@index([createdById], map: "ix_style_import_runs__created_by")
  @@map("style_import_runs")
}

/// D-246: a customer's favourite style (private to them).
model StyleFavourite {
  id        BigInt   @id(map: "pk_style_favourites") @default(autoincrement())
  userId    BigInt   @map("user_id")
  baseId    BigInt   @map("base_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User      @relation("StyleFavouriteUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_style_favourites__user_id")
  base StyleBase @relation(fields: [baseId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_style_favourites__base_id")

  @@unique([userId, baseId], map: "ux_style_favourites__user_id__base_id")
  @@index([baseId], map: "ix_style_favourites__base_id")
  @@map("style_favourites")
}

enum ProcessCapabilityStatus {
  proposed
  verified
  rejected
  withdrawn
  superseded

  @@map("process_capability_status")
}

enum StyleProcessScope {
  source_product_type
  category
  family
  option

  @@map("style_process_scope")
}

/// D-244: the manufacturing process taxonomy (seeded reference data).
model ProcessType {
  id        BigInt   @id(map: "pk_process_types") @default(autoincrement())
  publicId  String   @unique(map: "ux_process_types__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  code      String   @unique(map: "ux_process_types__code")
  nameTh    String   @map("name_th")
  nameEn    String   @map("name_en")
  sort      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  capabilities FactoryProcessCapability[]
  rules        StyleProcessRule[]

  @@map("process_types")
}

/// D-244: what a factory can make per material class × process, proposed by the factory (Owner / Planner) or the
/// Partner team and verified by the Partner Manager against a passing site visit; only verified rows count.
model FactoryProcessCapability {
  id              BigInt                  @id(map: "pk_factory_process_capabilities") @default(autoincrement())
  publicId        String                  @unique(map: "ux_factory_process_capabilities__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  factoryId       BigInt                  @map("factory_id")
  processTypeId   BigInt                  @map("process_type_id")
  materialClass   String                  @map("material_class")
  minBlankWMm     Decimal?                @map("min_blank_w_mm") @db.Decimal(10, 2)
  minBlankLMm     Decimal?                @map("min_blank_l_mm") @db.Decimal(10, 2)
  maxBlankWMm     Decimal?                @map("max_blank_w_mm") @db.Decimal(10, 2)
  maxBlankLMm     Decimal?                @map("max_blank_l_mm") @db.Decimal(10, 2)
  maxCaliperMm    Decimal?                @map("max_caliper_mm") @db.Decimal(6, 3)
  minRun          Int?                    @map("min_run")
  leadTimeMinDays Int                     @map("lead_time_min_days") @db.SmallInt
  leadTimeMaxDays Int                     @map("lead_time_max_days") @db.SmallInt
  status          ProcessCapabilityStatus @default(proposed)
  note            String?
  proposedById    BigInt                  @map("proposed_by")
  proposedAt      DateTime                @default(now()) @map("proposed_at") @db.Timestamptz(6)
  verifiedById    BigInt?                 @map("verified_by")
  verifiedAt      DateTime?               @map("verified_at") @db.Timestamptz(6)
  siteVisitId     BigInt?                 @map("site_visit_id")
  decisionNote    String?                 @map("decision_note")
  decidedAt       DateTime?               @map("decided_at") @db.Timestamptz(6)
  rowVersion      Int                     @default(1) @map("row_version")

  factory     Factory     @relation("FactoryProcessCapabilityFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_factory_process_capabilities__factory_id")
  processType ProcessType @relation(fields: [processTypeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_factory_process_capabilities__process_type_id")
  proposedBy  User        @relation("FactoryProcessCapabilityProposedBy", fields: [proposedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_factory_process_capabilities__proposed_by")
  verifiedBy  User?       @relation("FactoryProcessCapabilityVerifiedBy", fields: [verifiedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_factory_process_capabilities__verified_by")
  siteVisit   SiteVisit?  @relation("FactoryProcessCapabilitySiteVisit", fields: [siteVisitId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_factory_process_capabilities__site_visit_id")

  @@unique([factoryId, processTypeId, materialClass], map: "ux_factory_process_capabilities__verified", where: raw("(status = 'verified'::process_capability_status)"))
  @@index([factoryId, status], map: "ix_factory_process_capabilities__factory_id__status")
  @@index([processTypeId, materialClass], map: "ix_factory_process_capabilities__process__material")
  @@index([proposedById], map: "ix_factory_process_capabilities__proposed_by")
  @@index([verifiedById], map: "ix_factory_process_capabilities__verified_by")
  @@index([siteVisitId], map: "ix_factory_process_capabilities__site_visit_id")
  @@map("factory_process_capabilities")
}

/// D-244: which processes a style needs when its recipe declares none — by master product type, category, family or
/// option value (`axis:value`). Seeded as a proposal that Prepress confirms.
model StyleProcessRule {
  id            BigInt            @id(map: "pk_style_process_rules") @default(autoincrement())
  publicId      String            @unique(map: "ux_style_process_rules__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  scope         StyleProcessScope
  scopeValue    String            @map("scope_value")
  processTypeId BigInt            @map("process_type_id")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById   BigInt?           @map("created_by")

  processType ProcessType @relation(fields: [processTypeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_style_process_rules__process_type_id")
  createdBy   User?       @relation("StyleProcessRuleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_style_process_rules__created_by")

  @@unique([scope, scopeValue, processTypeId], map: "ux_style_process_rules__scope__value__process")
  @@index([processTypeId], map: "ix_style_process_rules__process_type_id")
  @@index([createdById], map: "ix_style_process_rules__created_by")
  @@map("style_process_rules")
}

/// D-266: how a published variant is priced.
enum StylePricePath {
  instant
  rfq

  @@map("style_price_path")
}

/// D-268: what an option value does to a calculator's price.
enum StyleOptionPriceEffect {
  /// The option does not change the price (e.g. a tuck direction).
  neutral
  /// The option is priced through a configuration change (`patch`).
  configuration

  @@map("style_option_price_effect")
}

/// D-268 (A-92): an option value (`axis:value`) of a calculator mapped to its price — neutral or a configuration patch
/// the configurator applies; maintained by Prepress with the Pricing owner, audited; never edited (retire + new).
model StyleOptionPriceRule {
  id            BigInt                 @id(map: "pk_style_option_price_rules") @default(autoincrement())
  publicId      String                 @unique(map: "ux_style_option_price_rules__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  calculatorKey CalculatorKey          @map("calculator_key")
  axis          String
  value         String
  effect        StyleOptionPriceEffect
  /// `{ config?: {...}, part?: {...} }` merged into the configuration / each part; null for `neutral`.
  patch         Json?
  note          String
  status        StyleStatus            @default(active)
  createdById   BigInt?                @map("created_by")
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  retiredAt     DateTime?              @map("retired_at") @db.Timestamptz(6)
  retiredById   BigInt?                @map("retired_by")

  createdBy User? @relation("StyleOptionPriceRuleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_style_option_price_rules__created_by")
  retiredBy User? @relation("StyleOptionPriceRuleRetiredBy", fields: [retiredById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_style_option_price_rules__retired_by")

  @@unique([calculatorKey, axis, value], map: "ux_style_option_price_rules__active", where: raw("(status = 'active'::style_status)"))
  @@index([createdById], map: "ix_style_option_price_rules__created_by")
  @@index([retiredById], map: "ix_style_option_price_rules__retired_by")
  @@map("style_option_price_rules")
}

/// D-270: a dieline the engine drew for a variant at inside sizes, on a material class's reference material, in one
/// format — cached by sha256 of (engine version, recipe checksum, options, sizes, material, format); a new recipe
/// version or engine bundle gives a new key. Written once.
model DielineRender {
  id            BigInt        @id(map: "pk_dieline_renders") @default(autoincrement())
  publicId      String        @unique(map: "ux_dieline_renders__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  cacheKey      Bytes         @unique(map: "ux_dieline_renders__cache_key") @map("cache_key")
  variantId     BigInt        @map("variant_id")
  recipeId      BigInt        @map("recipe_id")
  engineVersion String        @map("engine_version")
  materialClass String        @map("material_class")
  /// Inside sizes drawn (D-182), mm.
  lengthMm      Decimal       @map("length_mm") @db.Decimal(10, 2)
  widthMm       Decimal       @map("width_mm") @db.Decimal(10, 2)
  heightMm      Decimal       @map("height_mm") @db.Decimal(10, 2)
  format        DrawingFormat
  fileId        BigInt        @map("file_id")
  /// D-267 quantities of the drawn dieline.
  quantities    Json
  /// Engine rule codes the size breaks (empty when it builds cleanly).
  violations    String[]      @default([])
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  variant   StyleVariant      @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_dieline_renders__variant_id")
  recipe    StyleRecipe       @relation(fields: [recipeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_dieline_renders__recipe_id")
  file      FileObject        @relation("DielineRenderFile", fields: [fileId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_dieline_renders__file_id")
  downloads DielineDownload[]

  @@index([variantId], map: "ix_dieline_renders__variant_id")
  @@index([recipeId], map: "ix_dieline_renders__recipe_id")
  @@index([fileId], map: "ix_dieline_renders__file_id")
  @@map("dieline_renders")
}

/// D-271: every dieline download (customers within the D-203 limits, staff unlimited). Append-only.
model DielineDownload {
  id               BigInt           @id(map: "pk_dieline_downloads") @default(autoincrement())
  publicId         String           @unique(map: "ux_dieline_downloads__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  userId           BigInt           @map("user_id")
  renderId         BigInt           @map("render_id")
  /// A staff download: not counted against the D-203 limits.
  staff            Boolean
  /// D-182: the basis and sizes as entered (the render holds the inside sizes drawn).
  measurementBasis MeasurementBasis @map("measurement_basis")
  enteredLengthMm  Decimal          @map("entered_length_mm") @db.Decimal(10, 2)
  enteredWidthMm   Decimal          @map("entered_width_mm") @db.Decimal(10, 2)
  enteredHeightMm  Decimal          @map("entered_height_mm") @db.Decimal(10, 2)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User          @relation("DielineDownloadUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_dieline_downloads__user_id")
  render DielineRender @relation(fields: [renderId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_dieline_downloads__render_id")

  @@index([userId, createdAt], map: "ix_dieline_downloads__user_id__created_at")
  @@index([renderId], map: "ix_dieline_downloads__render_id")
  @@map("dieline_downloads")
}

// --- Growth loops (U3.B6, D-272–D-274) ----------------------------------------------------------------

enum StyleIntakeStatus {
  submitted
  /// Prepress matched it to an existing recipe with a deviation report.
  matched
  approved_recipe
  approved_template
  rejected

  @@map("style_intake_status")
}

/// D-272: a structure a factory offers (DXF / PDF) under the intake terms in force; Prepress matches, approves or
/// rejects it. Provenance — factory, file sha256, terms version, reviewer — is kept for good.
model StyleIntake {
  id              BigInt            @id(map: "pk_style_intakes") @default(autoincrement())
  publicId        String            @unique(map: "ux_style_intakes__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  factoryId       BigInt            @map("factory_id")
  submittedById   BigInt            @map("submitted_by")
  title           String
  note            String?
  fileId          BigInt            @map("file_id")
  /// sha256 of the file as submitted (provenance).
  fileSha256      Bytes             @map("file_sha256")
  /// The `styles.intake_terms` version the factory accepted.
  termsVersionId  BigInt            @map("terms_version_id")
  /// The base the factory says it is, if any.
  proposedBaseId  BigInt?           @map("proposed_base_id")
  status          StyleIntakeStatus @default(submitted)
  matchedRecipeId BigInt?           @map("matched_recipe_id")
  /// Prepress's deviation report against the matched recipe: `[{ aspect, note }]`.
  deviations      Json?
  /// Approved as a recipe: the recipe imported from it (D-242).
  resultRecipeId  BigInt?           @map("result_recipe_id")
  /// Approved as a fixed template of a base.
  templateBaseId  BigInt?           @map("template_base_id")
  rejectReason    String?           @map("reject_reason")
  reviewedById    BigInt?           @map("reviewed_by")
  reviewedAt      DateTime?         @map("reviewed_at") @db.Timestamptz(6)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  factory       Factory        @relation("StyleIntakeFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_style_intakes__factory_id")
  submittedBy   User           @relation("StyleIntakeSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_style_intakes__submitted_by")
  file          FileObject     @relation("StyleIntakeFile", fields: [fileId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_style_intakes__file_id")
  termsVersion  SettingVersion @relation("StyleIntakeTermsVersion", fields: [termsVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_style_intakes__terms_version_id")
  proposedBase  StyleBase?     @relation("StyleIntakeProposedBase", fields: [proposedBaseId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_style_intakes__proposed_base_id")
  matchedRecipe StyleRecipe?   @relation("StyleIntakeMatchedRecipe", fields: [matchedRecipeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_style_intakes__matched_recipe_id")
  resultRecipe  StyleRecipe?   @relation("StyleIntakeResultRecipe", fields: [resultRecipeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_style_intakes__result_recipe_id")
  templateBase  StyleBase?     @relation("StyleIntakeTemplateBase", fields: [templateBaseId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_style_intakes__template_base_id")
  reviewedBy    User?          @relation("StyleIntakeReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_style_intakes__reviewed_by")

  @@index([factoryId, createdAt], map: "ix_style_intakes__factory_id__created_at")
  @@index([status], map: "ix_style_intakes__status")
  @@index([submittedById], map: "ix_style_intakes__submitted_by")
  @@index([fileId], map: "ix_style_intakes__file_id")
  @@index([termsVersionId], map: "ix_style_intakes__terms_version_id")
  @@index([proposedBaseId], map: "ix_style_intakes__proposed_base_id")
  @@index([matchedRecipeId], map: "ix_style_intakes__matched_recipe_id")
  @@index([resultRecipeId], map: "ix_style_intakes__result_recipe_id")
  @@index([templateBaseId], map: "ix_style_intakes__template_base_id")
  @@index([reviewedById], map: "ix_style_intakes__reviewed_by")
  @@map("style_intakes")
}

enum StructuralRequestStatus {
  submitted
  assigned
  /// A design fee is quoted through a service RFQ (D-194 / D-100).
  quoted
  delivered
  approved
  published
  declined
  cancelled

  @@map("structural_request_status")
}

/// D-273: a customer asks for a structure the library lacks; CS assigns a structural designer (Prepress), a fee is
/// quoted through a service RFQ when one applies, Prepress approves the delivered dieline and links it to its base
/// once published. The requester hears of every step.
model StructuralDesignRequest {
  id               BigInt                  @id(map: "pk_structural_design_requests") @default(autoincrement())
  publicId         String                  @unique(map: "ux_structural_design_requests__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  customerUserId   BigInt                  @map("customer_user_id")
  productTypeId    BigInt                  @map("product_type_id")
  description      String
  /// D-182: sizes and their basis as entered, mm (optional — a new structure may not have them yet).
  lengthMm         Decimal?                @map("length_mm") @db.Decimal(10, 2)
  widthMm          Decimal?                @map("width_mm") @db.Decimal(10, 2)
  heightMm         Decimal?                @map("height_mm") @db.Decimal(10, 2)
  measurementBasis MeasurementBasis?       @map("measurement_basis")
  quantity         Int?
  status           StructuralRequestStatus @default(submitted)
  assignedToId     BigInt?                 @map("assigned_to")
  assignedAt       DateTime?               @map("assigned_at") @db.Timestamptz(6)
  serviceRfqId     BigInt?                 @unique(map: "ux_structural_design_requests__service_rfq_id") @map("service_rfq_id")
  deliveredFileId  BigInt?                 @map("delivered_file_id")
  deliveredAt      DateTime?               @map("delivered_at") @db.Timestamptz(6)
  approvedById     BigInt?                 @map("approved_by")
  approvedAt       DateTime?               @map("approved_at") @db.Timestamptz(6)
  publishedBaseId  BigInt?                 @map("published_base_id")
  publishedAt      DateTime?               @map("published_at") @db.Timestamptz(6)
  closedReason     String?                 @map("closed_reason")
  closedAt         DateTime?               @map("closed_at") @db.Timestamptz(6)
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer      User                          @relation("StructuralRequestCustomer", fields: [customerUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_structural_design_requests__customer_user_id")
  productType   ProductType                   @relation("StructuralRequestProductType", fields: [productTypeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_structural_design_requests__product_type_id")
  assignedTo    User?                         @relation("StructuralRequestAssignedTo", fields: [assignedToId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_structural_design_requests__assigned_to")
  serviceRfq    Rfq?                          @relation("StructuralRequestServiceRfq", fields: [serviceRfqId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_structural_design_requests__service_rfq_id")
  deliveredFile FileObject?                   @relation("StructuralRequestDeliveredFile", fields: [deliveredFileId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_structural_design_requests__delivered_file_id")
  approvedBy    User?                         @relation("StructuralRequestApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_structural_design_requests__approved_by")
  publishedBase StyleBase?                    @relation("StructuralRequestPublishedBase", fields: [publishedBaseId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_structural_design_requests__published_base_id")
  files         StructuralDesignRequestFile[]

  @@index([customerUserId, createdAt], map: "ix_structural_design_requests__customer_user_id__created_at")
  @@index([status], map: "ix_structural_design_requests__status")
  @@index([productTypeId], map: "ix_structural_design_requests__product_type_id")
  @@index([assignedToId], map: "ix_structural_design_requests__assigned_to")
  @@index([deliveredFileId], map: "ix_structural_design_requests__delivered_file_id")
  @@index([approvedById], map: "ix_structural_design_requests__approved_by")
  @@index([publishedBaseId], map: "ix_structural_design_requests__published_base_id")
  @@map("structural_design_requests")
}

/// The customer's reference files of a structural design request.
model StructuralDesignRequestFile {
  requestId BigInt   @map("request_id")
  fileId    BigInt   @map("file_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  request StructuralDesignRequest @relation(fields: [requestId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_structural_design_request_files__request_id")
  file    FileObject              @relation("StructuralRequestFile", fields: [fileId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_structural_design_request_files__file_id")

  @@id([requestId, fileId], map: "pk_structural_design_request_files")
  @@index([fileId], map: "ix_structural_design_request_files__file_id")
  @@map("structural_design_request_files")
}
