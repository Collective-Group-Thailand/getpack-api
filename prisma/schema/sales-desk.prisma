// Company sales desk (D-469, PLAN A-07): the inbound pool of sales enquiries, its assignment to reps and the
// first-response SLA. Discount approval desk (D-470) follows in the same file.

/// D-469: where an inbound sales enquiry came from.
enum SalesInboundSource {
  /// A contact ticket routed to the sales queue (topics quote / business, D-458).
  contact_form
  /// An RFQ from a customer with no placed order yet.
  rfq
  /// A LINE OA chat tagged sales (deferred: chats carry no tags yet).
  line_chat
  /// Entered by staff.
  manual
  /// D-471: a signed-in customer saved a studio design and has not ordered it within `capture.studio_idle_days`.
  studio_idle
  /// D-471: a signed-in non-customer downloaded a free dieline.
  dieline_download

  @@map("sales_inbound_source")
}

enum SalesInboundStatus {
  new
  assigned
  contacted
  converted_to_lead
  disqualified

  @@map("sales_inbound_status")
}

/// D-469: why an enquiry was disqualified.
enum SalesInboundDisqualifyReason {
  not_a_buyer
  duplicate
  no_response
  out_of_scope
  spam
  other

  @@map("sales_inbound_disqualify_reason")
}

enum SalesInboundAssignmentMode {
  manual
  round_robin
  /// D-471: given to the rep the contact is already attributed to (precedence: agent > rep > pool).
  attribution

  @@map("sales_inbound_assignment_mode")
}

/// D-471: why getpack may contact the person of an inbound item (PDPA lawful basis kept with the item).
enum SalesInboundConsentBasis {
  /// The person asked to be contacted (contact form, RFQ).
  enquiry
  /// Staff entered the contact with the person's agreement.
  staff_entry
  /// A captured signal (studio idle, dieline download): the person's latest marketing consent was granted.
  marketing_consent

  @@map("sales_inbound_consent_basis")
}

/// D-469: one inbound sales enquiry in the pool, worked by a company rep. PDPA: the contact's name, phone, e-mail,
/// organisation and need — purpose = answering a sales enquiry the person sent (or a contact staff entered with the
/// person's agreement); retention = while open, then 2 years after it closes (converted / disqualified) unless the
/// person asks for erasure earlier; access = Sales (sales.pipeline.manage) and the assigned rep (sales.pipeline.self).
model SalesInboundLead {
  id                 BigInt                        @id(map: "pk_sales_inbound_leads") @default(autoincrement())
  publicId           String                        @unique(map: "ux_sales_inbound_leads__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  source             SalesInboundSource
  /// The ticket number or RFQ code it came from.
  sourceRef          String?                       @map("source_ref")
  supportTicketId    BigInt?                       @unique(map: "ux_sales_inbound_leads__support_ticket_id") @map("support_ticket_id")
  rfqId              BigInt?                       @unique(map: "ux_sales_inbound_leads__rfq_id") @map("rfq_id")
  contactName        String                        @map("contact_name")
  /// E.164.
  contactPhone       String?                       @map("contact_phone")
  contactEmail       String?                       @map("contact_email") @db.Citext
  organisationName   String?                       @map("organisation_name")
  need               String?
  status             SalesInboundStatus            @default(new)
  assigneeUserId     BigInt?                       @map("assignee_user_id")
  assignedAt         DateTime?                     @map("assigned_at") @db.Timestamptz(6)
  /// The lead registered for the assignee's employee agent (null: not yet, or refused — see `lead_refusal`).
  agentLeadId        BigInt?                       @map("agent_lead_id")
  /// `unavailable` when the contact cannot be a lead (one neutral reason, D-440).
  leadRefusal        String?                       @map("lead_refusal")
  firstResponseDueAt DateTime                      @map("first_response_due_at") @db.Timestamptz(6)
  firstRespondedAt   DateTime?                     @map("first_responded_at") @db.Timestamptz(6)
  slaBreachedAt      DateTime?                     @map("sla_breached_at") @db.Timestamptz(6)
  disqualifiedReason SalesInboundDisqualifyReason? @map("disqualified_reason")
  statusNote         String?                       @map("status_note")
  closedAt           DateTime?                     @map("closed_at") @db.Timestamptz(6)
  createdById        BigInt?                       @map("created_by")
  createdAt          DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion         Int                           @default(1) @map("row_version")
  /// D-471 capture. PDPA: `capture_user_id` (the signed-in customer the signal came from), `design_document_id`
  /// (the idle studio design), `signal_count` / `last_signal_at` (repeat downloads) — purpose = a sales follow-up the
  /// person consented to (marketing consent, `consent_record_id`); retention = as the item (while open, then 2 years);
  /// access = Sales (sales.pipeline.manage) and the assigned rep.
  captureUserId      BigInt?                       @map("capture_user_id")
  designDocumentId   BigInt?                       @unique(map: "ux_sales_inbound_leads__design_document_id") @map("design_document_id")
  signalCount        Int                           @default(1) @map("signal_count")
  lastSignalAt       DateTime?                     @map("last_signal_at") @db.Timestamptz(6)
  consentBasis       SalesInboundConsentBasis      @map("consent_basis")
  /// The marketing consent record relied on (captured signals only).
  consentRecordId    BigInt?                       @map("consent_record_id")

  supportTicket  SupportTicket?           @relation("SalesInboundLeadTicket", fields: [supportTicketId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_inbound_leads__support_ticket_id")
  rfq            Rfq?                     @relation("SalesInboundLeadRfq", fields: [rfqId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_inbound_leads__rfq_id")
  assignee       User?                    @relation("SalesInboundLeadAssignee", fields: [assigneeUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_inbound_leads__assignee_user_id") // client: keep
  agentLead      SalesAgentLead?          @relation("SalesInboundLeadAgentLead", fields: [agentLeadId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_inbound_leads__agent_lead_id")
  createdBy      User?                    @relation("SalesInboundLeadCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_inbound_leads__created_by")
  assignments    SalesInboundAssignment[]
  captureUser    User?                    @relation("SalesInboundLeadCaptureUser", fields: [captureUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_inbound_leads__capture_user_id") // client: keep
  designDocument DesignDocument?          @relation("SalesInboundLeadDesign", fields: [designDocumentId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_inbound_leads__design_document_id")
  consentRecord  ConsentRecord?           @relation("SalesInboundLeadConsent", fields: [consentRecordId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_inbound_leads__consent_record_id")

  @@index([status, createdAt], map: "ix_sales_inbound_leads__status__created_at")
  @@index([captureUserId, source], map: "ix_sales_inbound_leads__capture_user_id__source")
  @@index([consentRecordId], map: "ix_sales_inbound_leads__consent_record_id")
  @@index([assigneeUserId, status], map: "ix_sales_inbound_leads__assignee_user_id__status")
  @@index([agentLeadId], map: "ix_sales_inbound_leads__agent_lead_id")
  @@index([createdById], map: "ix_sales_inbound_leads__created_by")
  @@index([firstResponseDueAt], map: "ix_sales_inbound_leads__sla_due", where: raw("(first_responded_at IS NULL AND sla_breached_at IS NULL)"))
  @@map("sales_inbound_leads")
}

/// D-469: every (re)assignment of an enquiry — who, to whom, how and why. Append-only (trigger `forbid_mutation`).
model SalesInboundAssignment {
  id            BigInt                     @id(map: "pk_sales_inbound_assignments") @default(autoincrement())
  publicId      String                     @unique(map: "ux_sales_inbound_assignments__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  inboundLeadId BigInt                     @map("inbound_lead_id")
  fromUserId    BigInt?                    @map("from_user_id")
  toUserId      BigInt                     @map("to_user_id")
  mode          SalesInboundAssignmentMode
  reason        String?
  createdById   BigInt?                    @map("created_by")
  createdAt     DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)

  inboundLead SalesInboundLead @relation(fields: [inboundLeadId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_inbound_assignments__inbound_lead_id")
  fromUser    User?            @relation("SalesInboundAssignmentFrom", fields: [fromUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_inbound_assignments__from_user_id") // client: keep
  toUser      User             @relation("SalesInboundAssignmentTo", fields: [toUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_inbound_assignments__to_user_id") // client: keep
  createdBy   User?            @relation("SalesInboundAssignmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_inbound_assignments__created_by")

  @@index([inboundLeadId, createdAt], map: "ix_sales_inbound_assignments__inbound_lead_id__created_at")
  @@index([fromUserId], map: "ix_sales_inbound_assignments__from_user_id")
  @@index([toUserId, createdAt], map: "ix_sales_inbound_assignments__to_user_id__created_at")
  @@index([createdById], map: "ix_sales_inbound_assignments__created_by")
  @@map("sales_inbound_assignments")
}

// --- D-470: discount approval desk ----------------------------------------------------------------------------

/// D-470: who must decide a discount (PLAN A-12): within a rep's authority, a sales manager's, or C-Level's.
enum SalesDiscountApprovalLevel {
  rep
  sales_manager
  c_level

  @@map("sales_discount_approval_level")
}

enum SalesDiscountApprovalStatus {
  pending
  approved
  rejected
  /// Answered with give-get conditions instead (the agent may ask again with them).
  countered
  /// Lines, quantities, costs or terms changed since it was opened or approved (`discount_approval.stale`).
  stale
  /// The request closed without a decision (quote withdrawn / expired).
  withdrawn

  @@map("sales_discount_approval_status")
}

enum SalesFactoryPriceLockStatus {
  /// Recorded; the factory's confirmation through the partner zone is not built yet (deferred).
  requested
  confirmed
  expired
  released

  @@map("sales_factory_price_lock_status")
}

/// D-470: which serializer a viewer got (field-level visibility, docs/rbac.md).
enum SalesWaterfallTier {
  authority
  margin_pct
  full

  @@map("sales_waterfall_tier")
}

enum SalesWaterfallViewPurpose {
  view
  simulate
  export

  @@map("sales_waterfall_view_purpose")
}

/// D-470 (PLAN A-12, §7): the approval of one discount request round. Holds the waterfall computed when it opened
/// (staff only — served per viewer tier), the snapshot hash of lines, quantities, costs and terms (any change voids
/// it), the level and its SLA. No personal data of its own.
model SalesDiscountApproval {
  id                 BigInt                      @id(map: "pk_sales_discount_approvals") @default(autoincrement())
  publicId           String                      @unique(map: "ux_sales_discount_approvals__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  requestId          BigInt                      @unique(map: "ux_sales_discount_approvals__request_id") @map("request_id")
  agentQuoteId       BigInt                      @map("agent_quote_id")
  quoteId            BigInt                      @map("quote_id")
  /// The level in force (after escalation) and the one the matrix gave.
  level              SalesDiscountApprovalLevel
  baseLevel          SalesDiscountApprovalLevel  @map("base_level")
  negotiationHeavy   Boolean                     @default(false) @map("negotiation_heavy")
  status             SalesDiscountApprovalStatus @default(pending)
  requestedPct       Decimal                     @map("requested_pct") @db.Decimal(7, 4)
  grossMarginPct     Decimal                     @map("gross_margin_pct") @db.Decimal(9, 4)
  floorPct           Decimal                     @map("floor_pct") @db.Decimal(7, 4)
  belowFloor         Boolean                     @default(false) @map("below_floor")
  commissionBase     Decimal                     @map("commission_base") @db.Decimal(14, 2)
  /// The quote's waterfall at the requested discount (all lines, decimal strings).
  waterfall          Json
  /// Lines, quantities, costs and terms the decision is about, and their SHA-256.
  snapshot           Json
  snapshotSha256     Bytes                       @map("snapshot_sha256")
  dueAt              DateTime                    @map("due_at") @db.Timestamptz(6)
  escalatedAt        DateTime?                   @map("escalated_at") @db.Timestamptz(6)
  requestedById      BigInt                      @map("requested_by")
  decidedById        BigInt?                     @map("decided_by")
  decidedAt          DateTime?                   @map("decided_at") @db.Timestamptz(6)
  decisionNote       String?                     @map("decision_note")
  /// D-449: a Superadmin approving their own (staff) request under solo-owner mode, with the typed reason.
  selfApproved       Boolean                     @default(false) @map("self_approved")
  selfApprovalReason String?                     @map("self_approval_reason")
  /// Counter-offer: the give-get conditions asked for instead.
  counter            Json?
  /// The options approved (kind, discount %, rate %) and until when they are valid.
  approvedOptions    Json?                       @map("approved_options")
  validUntil         DateTime?                   @map("valid_until") @db.Timestamptz(6)
  staleAt            DateTime?                   @map("stale_at") @db.Timestamptz(6)
  staleReason        String?                     @map("stale_reason")
  createdAt          DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion         Int                         @default(1) @map("row_version")

  request     SalesAgentDiscountRequest @relation("SalesDiscountApprovalRequest", fields: [requestId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_discount_approvals__request_id")
  agentQuote  SalesAgentQuote           @relation("SalesDiscountApprovalAgentQuote", fields: [agentQuoteId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_discount_approvals__agent_quote_id")
  quote       Quote                     @relation("SalesDiscountApprovalQuote", fields: [quoteId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_discount_approvals__quote_id")
  requestedBy User                      @relation("SalesDiscountApprovalRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_discount_approvals__requested_by") // client: keep
  decidedBy   User?                     @relation("SalesDiscountApprovalDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_discount_approvals__decided_by") // client: keep
  priceLocks  SalesFactoryPriceLock[]
  views       SalesWaterfallView[]
  discounted  SalesDiscountedQuote[]

  @@index([status, level, dueAt], map: "ix_sales_discount_approvals__status__level__due_at")
  @@index([agentQuoteId], map: "ix_sales_discount_approvals__agent_quote_id")
  @@index([quoteId], map: "ix_sales_discount_approvals__quote_id")
  @@index([requestedById], map: "ix_sales_discount_approvals__requested_by")
  @@index([decidedById], map: "ix_sales_discount_approvals__decided_by")
  @@map("sales_discount_approvals")
}

/// D-470: an approved big deal also locks the factory buy price for the approval's validity. The partner zone's
/// confirmation is deferred (status `requested`); when it exists the validity is the shorter of the two. Staff only —
/// never in a store or agent response (factory confidentiality, D-044 / D-435).
model SalesFactoryPriceLock {
  id                 BigInt                      @id(map: "pk_sales_factory_price_locks") @default(autoincrement())
  publicId           String                      @unique(map: "ux_sales_factory_price_locks__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  approvalId         BigInt                      @map("approval_id")
  quoteOptionId      BigInt                      @map("quote_option_id")
  factoryId          BigInt?                     @map("factory_id")
  priceListVersionId BigInt?                     @map("price_list_version_id")
  buyPrice           Decimal                     @map("buy_price") @db.Decimal(14, 2)
  status             SalesFactoryPriceLockStatus @default(requested)
  validUntil         DateTime                    @map("valid_until") @db.Timestamptz(6)
  createdAt          DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  approval         SalesDiscountApproval @relation(fields: [approvalId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_factory_price_locks__approval_id")
  quoteOption      QuoteOption           @relation("SalesFactoryPriceLockQuoteOption", fields: [quoteOptionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_factory_price_locks__quote_option_id")
  factory          Factory?              @relation("SalesFactoryPriceLockFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_factory_price_locks__factory_id")
  priceListVersion PriceListVersion?     @relation("SalesFactoryPriceLockPriceListVersion", fields: [priceListVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_factory_price_locks__price_list_version_id")

  @@index([approvalId], map: "ix_sales_factory_price_locks__approval_id")
  @@index([quoteOptionId], map: "ix_sales_factory_price_locks__quote_option_id")
  @@index([factoryId, status], map: "ix_sales_factory_price_locks__factory_id__status")
  @@index([priceListVersionId], map: "ix_sales_factory_price_locks__price_list_version_id")
  @@map("sales_factory_price_locks")
}

/// D-470 (like D-444): every time someone is shown a deal's waterfall — who, when, which quote, which tier, why.
/// Append-only (trigger `forbid_mutation`). PDPA: the viewer's own staff id and request id only.
model SalesWaterfallView {
  id           BigInt                    @id(map: "pk_sales_waterfall_views") @default(autoincrement())
  publicId     String                    @unique(map: "ux_sales_waterfall_views__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  viewerUserId BigInt                    @map("viewer_user_id")
  quoteId      BigInt                    @map("quote_id")
  approvalId   BigInt?                   @map("approval_id")
  tier         SalesWaterfallTier
  purpose      SalesWaterfallViewPurpose
  requestId    String?                   @map("request_id")
  viewedAt     DateTime                  @default(now()) @map("viewed_at") @db.Timestamptz(6)

  viewer   User                   @relation("SalesWaterfallViewViewer", fields: [viewerUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_waterfall_views__viewer_user_id") // client: keep
  quote    Quote                  @relation("SalesWaterfallViewQuote", fields: [quoteId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_waterfall_views__quote_id")
  approval SalesDiscountApproval? @relation(fields: [approvalId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_waterfall_views__approval_id")

  @@index([viewedAt], map: "ix_sales_waterfall_views__viewed_at")
  @@index([viewerUserId, viewedAt], map: "ix_sales_waterfall_views__viewer_user_id__viewed_at")
  @@index([quoteId], map: "ix_sales_waterfall_views__quote_id")
  @@index([approvalId], map: "ix_sales_waterfall_views__approval_id")
  @@map("sales_waterfall_views")
}

/// D-470 (P3 deferral): a new quotation made at an accepted discount option — valid
/// `quotes.discounted_validity_days`, its conditions printed on the PDF, and the discount memo (scope `sales_quote`)
/// checkout applies to orders from it.
model SalesDiscountedQuote {
  id             BigInt   @id(map: "pk_sales_discounted_quotes") @default(autoincrement())
  publicId       String   @unique(map: "ux_sales_discounted_quotes__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  quoteId        BigInt   @unique(map: "ux_sales_discounted_quotes__quote_id") @map("quote_id")
  sourceQuoteId  BigInt   @map("source_quote_id")
  approvalId     BigInt?  @map("approval_id")
  optionId       BigInt   @unique(map: "ux_sales_discounted_quotes__option_id") @map("option_id")
  discountMemoId BigInt?  @unique(map: "ux_sales_discounted_quotes__discount_memo_id") @map("discount_memo_id")
  discountPct    Decimal  @map("discount_pct") @db.Decimal(7, 4)
  discountAmount Decimal  @map("discount_amount") @db.Decimal(14, 2)
  conditionsTh   String?  @map("conditions_th")
  conditionsEn   String?  @map("conditions_en")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  quote        Quote                    @relation("SalesDiscountedQuoteQuote", fields: [quoteId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_discounted_quotes__quote_id")
  sourceQuote  Quote                    @relation("SalesDiscountedQuoteSource", fields: [sourceQuoteId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_discounted_quotes__source_quote_id")
  approval     SalesDiscountApproval?   @relation(fields: [approvalId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_discounted_quotes__approval_id")
  option       SalesAgentDiscountOption @relation("SalesDiscountedQuoteOption", fields: [optionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_discounted_quotes__option_id")
  discountMemo DiscountMemo?            @relation("SalesDiscountedQuoteMemo", fields: [discountMemoId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_discounted_quotes__discount_memo_id")

  @@index([sourceQuoteId], map: "ix_sales_discounted_quotes__source_quote_id")
  @@index([approvalId], map: "ix_sales_discounted_quotes__approval_id")
  @@map("sales_discounted_quotes")
}
