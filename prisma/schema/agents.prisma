  @@index([idDocumentFileId], map: "ix_sales_agent_payout_profiles__id_document_file_id")
  @@index([bankBookFileId], map: "ix_sales_agent_payout_profiles__bank_book_file_id")
  @@index([verifiedById], map: "ix_sales_agent_payout_profiles__verified_by")
  @@map("sales_agent_payout_profiles")
}

/// D-467: an agent's channel choice per agent event (agent zone "การแจ้งเตือน"). Only changes are stored: no row =
/// enabled. The notification router drops a disabled route for the agent; e-mail of statement_ready, payout_paid and
