  @@index([status, periodStart], map: "ix_sales_agent_statements__status__period_start")
  @@index([entityId], map: "ix_sales_agent_statements__entity_id")
  @@index([approvedById], map: "ix_sales_agent_statements__approved_by")
  @@index([taxInvoiceFileId], map: "ix_sales_agent_statements__tax_invoice_file_id")
