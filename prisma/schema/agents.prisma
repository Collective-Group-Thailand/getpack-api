  orderId              BigInt?                    @map("order_id")
  orderGroupId         BigInt?                    @map("order_group_id")
  planVersionId        BigInt?                    @map("plan_version_id")
  isFirstOrder         Boolean                    @default(false) @map("is_first_order")
  baseAmount           Decimal                    @default(0) @map("base_amount") @db.Decimal(14, 2)
  ratePct              Decimal?                   @map("rate_pct") @db.Decimal(7, 4)
  marginAmount         Decimal?                   @map("margin_amount") @db.Decimal(14, 2)
  capAmount            Decimal?                   @map("cap_amount") @db.Decimal(14, 2)
  amount               Decimal                    @db.Decimal(14, 2)
  /// When it may become earned (the order's claim window end).
  availableAt          DateTime?                  @map("available_at") @db.Timestamptz(6)
  earnedAt             DateTime?                  @map("earned_at") @db.Timestamptz(6)
  statementId          BigInt?                    @map("statement_id")
  reversesCommissionId BigInt?                    @map("reverses_commission_id")
  holdFlags            String[]                   @default([]) @map("hold_flags")
  /// D-464: commission ÷ the order's gross margin exceeded `agent.margin_alert_pct` (internal alert only; the
  /// amount is never reduced). `cap_amount` / `margin_cap_pct` are history from before D-464.
  marginAlert          Boolean                    @default(false) @map("margin_alert")
  note                 String?
  createdAt            DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion           Int                        @default(1) @map("row_version")

  agent       SalesAgent             @relation(fields: [agentId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agent_commissions__agent_id")
  link        SalesAgentLink?        @relation(fields: [linkId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agent_commissions__link_id")
  factoryLink SalesAgentFactoryLink? @relation(fields: [factoryLinkId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agent_commissions__factory_link_id")
  order       Order?                 @relation("SalesAgentCommissionOrder", fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agent_commissions__order_id")
  orderGroup  OrderGroup?            @relation("SalesAgentCommissionOrderGroup", fields: [orderGroupId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agent_commissions__order_group_id")
  planVersion SalesAgentPlanVersion? @relation(fields: [planVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agent_commissions__plan_version_id")
  statement   SalesAgentStatement?   @relation(fields: [statementId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agent_commissions__statement_id")
  reverses    SalesAgentCommission?  @relation("SalesAgentCommissionReverses", fields: [reversesCommissionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agent_commissions__reverses_commission_id")
  reversals   SalesAgentCommission[] @relation("SalesAgentCommissionReverses")

  @@unique([factoryLinkId], map: "ux_sales_agent_commissions__factory_link_id__bounty", where: raw("(kind = 'factory_bounty'::sales_agent_commission_kind)"))
  @@unique([orderId], map: "ux_sales_agent_commissions__order_id__order", where: raw("(kind = 'order'::sales_agent_commission_kind)"))
  @@index([agentId, status], map: "ix_sales_agent_commissions__agent_id__status")
  @@index([status, availableAt], map: "ix_sales_agent_commissions__status__available_at")
  @@index([linkId], map: "ix_sales_agent_commissions__link_id")
  @@index([factoryLinkId], map: "ix_sales_agent_commissions__factory_link_id")
  @@index([orderId], map: "ix_sales_agent_commissions__order_id")
  @@index([orderGroupId], map: "ix_sales_agent_commissions__order_group_id")
  @@index([planVersionId], map: "ix_sales_agent_commissions__plan_version_id")
  @@index([statementId], map: "ix_sales_agent_commissions__statement_id")
  @@index([reversesCommissionId], map: "ix_sales_agent_commissions__reverses_commission_id")
  @@map("sales_agent_commissions")
}

