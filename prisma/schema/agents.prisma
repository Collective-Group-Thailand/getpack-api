  open
  /// 1–3 options were offered; the agent may accept one.
  offered
  /// The agent accepted an option.
  accepted
  /// Refused by Sales.
  rejected
  /// Closed without an answer (quote withdrawn / expired, or the agent withdrew).
  closed

  @@map("sales_agent_discount_request_status")
}

/// D-468: why a discount is asked.
