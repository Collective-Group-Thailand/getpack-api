  agent          SalesAgent             @relation(fields: [agentId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agent_statements__agent_id")
  vendorInvoice  VendorInvoice?         @relation("SalesAgentStatementVendorInvoice", fields: [vendorInvoiceId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agent_statements__vendor_invoice_id")
  approvedBy     User?                  @relation("SalesAgentStatementApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agent_statements__approved_by") // client: keep
  entries        SalesAgentCommission[]

