// Sales agent programme (D-416–D-423): Collective employees and freelancers who bring customers and
// factories to getpack, earn commission by versioned plan and are paid monthly.

enum SalesAgentKind {
  freelance
  employee

  @@map("sales_agent_kind")
}

enum SalesAgentStatus {
  active
  suspended
  ended

  @@map("sales_agent_status")
}

/// D-467: the agent events a person chooses channels for (agent zone "การแจ้งเตือน").
enum SalesAgentNotificationEvent {
  lead_converted
  lead_protection_expiring
  commission_earned
  statement_ready
  payout_paid
  payout_profile_needed
  /// D-468: a lead's follow-up time has come (outside the quiet hours).
  follow_up_due
  /// D-468: a customer opened a quote the agent sent.
  quote_opened

  @@map("sales_agent_notification_event")
}

enum SalesAgentApplicationStatus {
  submitted
  approved
  rejected
  withdrawn

  @@map("sales_agent_application_status")
}

enum SalesAgentLinkSource {
  /// The agent's link or code, claimed by the customer after sign-in.
  link
  /// A lead the agent registered that signed up or applied as a company.
  lead
  /// Assigned or transferred by staff, with a reason.
  staff
  /// A company inheriting the link of the user who applied for it.
  company

  @@map("sales_agent_link_source")
}

enum SalesAgentLinkStatus {
  active
  ended

  @@map("sales_agent_link_status")
}

enum SalesAgentLeadKind {
  customer
  factory

  @@map("sales_agent_lead_kind")
}

enum SalesAgentLeadStatus {
  registered
  converted
  expired
  rejected
  withdrawn

  @@map("sales_agent_lead_status")
}

/// D-468 (PLAN A-06): where a lead is in the agent's pipeline; `won` is set by the system only.
enum SalesAgentLeadStage {
  new
  contacted
  quoted
  negotiating
  won
  lost

  @@map("sales_agent_lead_stage")
}

/// D-468: why a lead was lost (lost-to-price analytics in Phase 4).
enum SalesAgentLeadLostReason {
  price
  lead_time
  no_need
  competitor
  no_response
  other

  @@map("sales_agent_lead_lost_reason")
}

/// D-468: how a lead entered the pipeline.
enum SalesAgentLeadSource {
  manual
  card_scan
  csv_import
  link
  staff

  @@map("sales_agent_lead_source")
}

/// D-468: what an entry of a lead's timeline records.
enum SalesAgentLeadActivityKind {
  call
  line
  visit
  email
  note
  quote_sent
  stage_change
  system

  @@map("sales_agent_lead_activity_kind")
}

/// D-468: a CSV import of leads — dry run, then commit.
enum SalesAgentLeadImportStatus {
  previewed
  committed
  expired

  @@map("sales_agent_lead_import_status")
}

/// D-468: a quote an agent sent on behalf of getpack (`/q/{token}`).
enum SalesAgentQuoteStatus {
  sent
  opened
  accepted
  expired
  withdrawn

  @@map("sales_agent_quote_status")
}

enum SalesAgentFactoryLinkStatus {
  /// Waiting for activation and the qualifying jobs.
  pending
  qualified
  expired
  ended

  @@map("sales_agent_factory_link_status")
}

enum SalesAgentCommissionKind {
  order
  factory_bounty
  adjustment
  reversal

  @@map("sales_agent_commission_kind")
}

enum SalesAgentCommissionStatus {
  /// Accrued; waits for the claim window and full payment.
  pending
  /// Waiting for staff review (shared identity between agent and customer, D-417).
  held
  earned
  statemented
  paid
  cancelled

  @@map("sales_agent_commission_status")
}

enum SalesAgentStatementStatus {
  draft
  approved
  exported
  paid
  voided

  @@map("sales_agent_statement_status")
}

enum AgreementParty {
  factory
  sales_agent

  @@map("agreement_party")
}

/// A commission plan (D-418); its terms live in dated, maker-checked versions.
model SalesAgentPlan {
  id          BigInt         @id(map: "pk_sales_agent_plans") @default(autoincrement())
  publicId    String         @unique(map: "ux_sales_agent_plans__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  code        String         @unique(map: "ux_sales_agent_plans__code")
  nameTh      String         @map("name_th")
  nameEn      String?        @map("name_en")
  description String?
  agentKind   SalesAgentKind @map("agent_kind")
  retiredAt   DateTime?      @map("retired_at") @db.Timestamptz(6)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion  Int            @default(1) @map("row_version")

  versions SalesAgentPlanVersion[]
  agents   SalesAgent[]

  @@map("sales_agent_plans")
}

/// Never edited once approved; the approved version with the latest `effective_from` ≤ t applies.
model SalesAgentPlanVersion {
  id                  BigInt              @id(map: "pk_sales_agent_plan_versions") @default(autoincrement())
  publicId            String              @unique(map: "ux_sales_agent_plan_versions__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  planId              BigInt              @map("plan_id")
  versionNo           Int                 @map("version_no")
  effectiveFrom       DateTime            @map("effective_from") @db.Timestamptz(6)
  status              ConfigVersionStatus @default(draft)
  firstOrderPct       Decimal             @map("first_order_pct") @db.Decimal(7, 4)
  repeatOrderPct      Decimal             @map("repeat_order_pct") @db.Decimal(7, 4)
  attributionMonths   Int                 @map("attribution_months") @db.SmallInt
  /// Commission ≤ this % of the order's margin (never below 0).
  marginCapPct        Decimal             @map("margin_cap_pct") @db.Decimal(7, 4)
  minBaseAmount       Decimal             @default(0) @map("min_base_amount") @db.Decimal(14, 2)
  factoryBountyAmount Decimal             @default(0) @map("factory_bounty_amount") @db.Decimal(14, 2)
  factoryQualifyJobs  Int                 @default(0) @map("factory_qualify_jobs") @db.SmallInt
  factoryQualifyDays  Int                 @default(0) @map("factory_qualify_days") @db.SmallInt
  reason              String
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  /// User ids (no FK): the maker-checker compares them; who did what is also in the audit log.
  createdById         BigInt?             @map("created_by")
  decidedAt           DateTime?           @map("decided_at") @db.Timestamptz(6)
  decidedById         BigInt?             @map("decided_by")
  decisionNote        String?             @map("decision_note")

  plan        SalesAgentPlan         @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agent_plan_versions__plan_id")
  commissions SalesAgentCommission[]

  dealRegistrations SalesAgentDealRegistration[] @relation("SalesAgentDealPlanVersion")

  @@unique([planId, versionNo], map: "ux_sales_agent_plan_versions__plan_id__version_no")
  @@index([planId, status, effectiveFrom], map: "ix_sales_agent_plan_versions__plan_id__status__effective_from")
  @@map("sales_agent_plan_versions")
}

/// A customer's application to become a freelance agent (D-416). PII: the bank account number is
/// stored encrypted with its last 4 digits, as vendor bank accounts are (§8).
model SalesAgentApplication {
  id                      BigInt                      @id(map: "pk_sales_agent_applications") @default(autoincrement())
  publicId                String                      @unique(map: "ux_sales_agent_applications__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  userId                  BigInt                      @map("user_id")
  status                  SalesAgentApplicationStatus @default(submitted)
  juristicType            JuristicType                @map("juristic_type")
  legalName               String                      @map("legal_name")
  taxId                   String?                     @map("tax_id") @db.Char(13)
  branchCode              String                      @default("00000") @map("branch_code") @db.Char(5)
  isVatRegistered         Boolean                     @default(false) @map("is_vat_registered")
  address                 String?
  postcode                String?                     @db.Char(5)
  /// How the applicant plans to sell (free text).
  pitch                   String?
  /// D-466 step 1. PDPA: contact data for Sales to reach the applicant; kept with the application.
  phone                   String?
  email                   String?                     @db.Citext
  lineId                  String?                     @map("line_id")
  salesChannels           SalesAgentSalesChannel[]    @default([]) @map("sales_channels")
  idDocumentFileId        BigInt?                     @map("id_document_file_id")
  bankCode                String?                     @map("bank_code")
  bankBranchName          String?                     @map("bank_branch_name")
  bankAccountName         String?                     @map("bank_account_name")
  bankAccountNoEnc        Bytes?                      @map("bank_account_no_enc")
  bankAccountNoLast4      String?                     @map("bank_account_no_last4") @db.Char(4)
  bankBookFileId          BigInt?                     @map("bank_book_file_id")
  agreementVersionId      BigInt                      @map("agreement_version_id")
  agreementAcceptedAt     DateTime                    @map("agreement_accepted_at") @db.Timestamptz(6)
  agreementEvidenceSha256 Bytes                       @map("agreement_evidence_sha256")
  ip                      String?                     @db.Inet
  userAgent               String?                     @map("user_agent")
  submittedAt             DateTime                    @default(now()) @map("submitted_at") @db.Timestamptz(6)
  decidedAt               DateTime?                   @map("decided_at") @db.Timestamptz(6)
  decidedById             BigInt?                     @map("decided_by")
  decisionReason          String?                     @map("decision_reason")
  createdAt               DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion              Int                         @default(1) @map("row_version")

  user             User                     @relation("SalesAgentApplicationUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agent_applications__user_id")
  idDocumentFile   FileObject?              @relation("SalesAgentApplicationIdDocument", fields: [idDocumentFileId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agent_applications__id_document_file_id")
  bankBookFile     FileObject?              @relation("SalesAgentApplicationBankBook", fields: [bankBookFileId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agent_applications__bank_book_file_id")
  agreementVersion AgreementTemplateVersion @relation("SalesAgentApplicationAgreement", fields: [agreementVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agent_applications__agreement_version_id")
  decidedBy        User?                    @relation("SalesAgentApplicationDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agent_applications__decided_by") // client: keep
  agent            SalesAgent?

  @@unique([userId], map: "ux_sales_agent_applications__user_id__submitted", where: raw("(status = 'submitted'::sales_agent_application_status)"))
  @@index([userId], map: "ix_sales_agent_applications__user_id")
  @@index([status, submittedAt], map: "ix_sales_agent_applications__status__submitted_at")
  @@index([idDocumentFileId], map: "ix_sales_agent_applications__id_document_file_id")
  @@index([bankBookFileId], map: "ix_sales_agent_applications__bank_book_file_id")
  @@index([agreementVersionId], map: "ix_sales_agent_applications__agreement_version_id")
  @@index([decidedById], map: "ix_sales_agent_applications__decided_by")
  @@map("sales_agent_applications")
}

/// An agent: a customer account with an approved agent profile (D-416).
model SalesAgent {
  id            BigInt           @id(map: "pk_sales_agents") @default(autoincrement())
  publicId      String           @unique(map: "ux_sales_agents__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  userId        BigInt           @unique(map: "ux_sales_agents__user_id") @map("user_id")
  kind          SalesAgentKind
  status        SalesAgentStatus @default(active)
  /// Shared in the agent's link (`/a/{code}`).
  code          String           @unique(map: "ux_sales_agents__code")
  planId        BigInt           @map("plan_id")
  legalName     String           @map("legal_name")
  juristicType  JuristicType     @default(individual) @map("juristic_type")
  taxId         String?          @map("tax_id") @db.Char(13)
  /// The vendor commission is paid to (freelance only).
  vendorId      BigInt?          @unique(map: "ux_sales_agents__vendor_id") @map("vendor_id")
  employeeCode  String?          @map("employee_code")
  /// The employee's back-office account, when they have one.
  staffUserId   BigInt?          @map("staff_user_id")
  applicationId BigInt?          @unique(map: "ux_sales_agents__application_id") @map("application_id")
  joinedAt      DateTime         @default(now()) @map("joined_at") @db.Timestamptz(6)
  suspendedAt   DateTime?        @map("suspended_at") @db.Timestamptz(6)
  endedAt       DateTime?        @map("ended_at") @db.Timestamptz(6)
  statusReason  String?          @map("status_reason")
  note          String?
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion    Int              @default(1) @map("row_version")

  user                    User                               @relation("SalesAgentUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agents__user_id")
  plan                    SalesAgentPlan                     @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agents__plan_id")
  vendor                  Vendor?                            @relation("SalesAgentVendor", fields: [vendorId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agents__vendor_id")
  staffUser               User?                              @relation("SalesAgentStaffUser", fields: [staffUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agents__staff_user_id")
  application             SalesAgentApplication?             @relation(fields: [applicationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agents__application_id")
  links                   SalesAgentLink[]
  leads                   SalesAgentLead[]
  factoryLinks            SalesAgentFactoryLink[]
  commissions             SalesAgentCommission[]
  statements              SalesAgentStatement[]
  taxDeclarations         SalesAgentTaxDeclaration[]
  payoutProfile           SalesAgentPayoutProfile?
  notificationPreferences SalesAgentNotificationPreference[]
  leadImports             SalesAgentLeadImport[]
  quotes                  SalesAgentQuote[]
  discountRequests        SalesAgentDiscountRequest[]
  dealRegistrations       SalesAgentDealRegistration[]

  @@index([status, kind], map: "ix_sales_agents__status__kind")
  @@index([planId], map: "ix_sales_agents__plan_id")
  @@index([staffUserId], map: "ix_sales_agents__staff_user_id")
  @@map("sales_agents")
}

/// Who a customer or company belongs to (D-417): one active link each (partial unique indexes).
model SalesAgentLink {
  id             BigInt               @id(map: "pk_sales_agent_links") @default(autoincrement())
  publicId       String               @unique(map: "ux_sales_agent_links__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  agentId        BigInt               @map("agent_id")
  customerUserId BigInt?              @map("customer_user_id")
  companyId      BigInt?              @map("company_id")
  source         SalesAgentLinkSource
  leadId         BigInt?              @map("lead_id")
  /// The user link a company link was inherited from.
  parentLinkId   BigInt?              @map("parent_link_id")
  status         SalesAgentLinkStatus @default(active)
  attributedAt   DateTime             @default(now()) @map("attributed_at") @db.Timestamptz(6)
  /// Orders placed from this instant on earn nothing (the plan's attribution months).
  endsAt         DateTime             @map("ends_at") @db.Timestamptz(6)
  endedAt        DateTime?            @map("ended_at") @db.Timestamptz(6)
  endedReason    String?              @map("ended_reason")
  reason         String?
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  agent        SalesAgent             @relation(fields: [agentId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agent_links__agent_id")
  customerUser User?                  @relation("SalesAgentLinkCustomer", fields: [customerUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agent_links__customer_user_id")
  company      Company?               @relation("SalesAgentLinkCompany", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agent_links__company_id")
  lead         SalesAgentLead?        @relation(fields: [leadId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agent_links__lead_id")
  parentLink   SalesAgentLink?        @relation("SalesAgentLinkParent", fields: [parentLinkId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agent_links__parent_link_id")
  childLinks   SalesAgentLink[]       @relation("SalesAgentLinkParent")
  commissions  SalesAgentCommission[]

  @@unique([customerUserId], map: "ux_sales_agent_links__customer_user_id__active", where: raw("(status = 'active'::sales_agent_link_status)"))
  @@unique([companyId], map: "ux_sales_agent_links__company_id__active", where: raw("(status = 'active'::sales_agent_link_status)"))
  @@index([agentId, status], map: "ix_sales_agent_links__agent_id__status")
  @@index([customerUserId], map: "ix_sales_agent_links__customer_user_id")
  @@index([companyId], map: "ix_sales_agent_links__company_id")
  @@index([leadId], map: "ix_sales_agent_links__lead_id")
  @@index([parentLinkId], map: "ix_sales_agent_links__parent_link_id")
  @@map("sales_agent_links")
}

/// A prospect an agent registered (D-417, D-419), protected from other agents for a while. PII.
model SalesAgentLead {
  id                     BigInt                    @id(map: "pk_sales_agent_leads") @default(autoincrement())
  publicId               String                    @unique(map: "ux_sales_agent_leads__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  agentId                BigInt                    @map("agent_id")
  kind                   SalesAgentLeadKind
  status                 SalesAgentLeadStatus      @default(registered)
  contactName            String                    @map("contact_name")
  organisationName       String?                   @map("organisation_name")
  /// E.164 (+66…).
  phone                  String?
  email                  String?                   @db.Citext
  taxId                  String?                   @map("tax_id") @db.Char(13)
  note                   String?
  protectedUntil         DateTime                  @map("protected_until") @db.Timestamptz(6)
  convertedAt            DateTime?                 @map("converted_at") @db.Timestamptz(6)
  convertedUserId        BigInt?                   @map("converted_user_id")
  convertedCompanyId     BigInt?                   @map("converted_company_id")
  convertedFactoryId     BigInt?                   @map("converted_factory_id")
  closedReason           String?                   @map("closed_reason")
  /// D-467: when the agent was told the protection ends in 7 days / 1 day (once each).
  protectionReminded7dAt DateTime?                 @map("protection_reminded_7d_at") @db.Timestamptz(6)
  protectionReminded1dAt DateTime?                 @map("protection_reminded_1d_at") @db.Timestamptz(6)
  /// D-468 pipeline (PLAN A-06). PDPA for the new personal fields (`line_id`, `industry`, `tags`, follow-up notes in
  /// the timeline): purpose = the agent's follow-up of a prospect who agreed to be contacted; retention = while the
  /// lead is open, then as long as the lead row (agent programme records); access = the agent who registered it and
  /// Sales (agents.read), never other agents.
  stage                  SalesAgentLeadStage       @default(new)
  stageChangedAt         DateTime?                 @map("stage_changed_at") @db.Timestamptz(6)
  expectedValue          Decimal?                  @map("expected_value") @db.Decimal(14, 2)
  nextFollowUpAt         DateTime?                 @map("next_follow_up_at") @db.Timestamptz(6)
  /// When the reminder for `next_follow_up_at` was sent (null = not yet; reset when the time changes).
  followUpRemindedAt     DateTime?                 @map("follow_up_reminded_at") @db.Timestamptz(6)
  lostReason             SalesAgentLeadLostReason? @map("lost_reason")
  lostNote               String?                   @map("lost_note")
  source                 SalesAgentLeadSource      @default(manual)
  industry               String?
  /// The prospect's LINE id (PDPA: see above).
  lineId                 String?                   @map("line_id")
  tags                   String[]                  @default([])
  wonAt                  DateTime?                 @map("won_at") @db.Timestamptz(6)
  createdAt              DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion             Int                       @default(1) @map("row_version")

  activities        SalesAgentLeadActivity[]
  agentQuotes       SalesAgentQuote[]
  dealRegistrations SalesAgentDealRegistration[]
  agent             SalesAgent                   @relation(fields: [agentId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agent_leads__agent_id")
  convertedUser     User?                        @relation("SalesAgentLeadConvertedUser", fields: [convertedUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agent_leads__converted_user_id")
  convertedCompany  Company?                     @relation("SalesAgentLeadConvertedCompany", fields: [convertedCompanyId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agent_leads__converted_company_id")
  convertedFactory  Factory?                     @relation("SalesAgentLeadConvertedFactory", fields: [convertedFactoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agent_leads__converted_factory_id")
  links             SalesAgentLink[]
  factoryLinks      SalesAgentFactoryLink[]
  inboundLeads      SalesInboundLead[]           @relation("SalesInboundLeadAgentLead")

  @@index([agentId, status], map: "ix_sales_agent_leads__agent_id__status")
  @@index([phone], map: "ix_sales_agent_leads__phone__registered", where: raw("(status = 'registered'::sales_agent_lead_status)"))
  @@index([email], map: "ix_sales_agent_leads__email__registered", where: raw("(status = 'registered'::sales_agent_lead_status)"))
  @@index([taxId], map: "ix_sales_agent_leads__tax_id__registered", where: raw("(status = 'registered'::sales_agent_lead_status)"))
  @@index([convertedUserId], map: "ix_sales_agent_leads__converted_user_id")
  @@index([convertedCompanyId], map: "ix_sales_agent_leads__converted_company_id")
  @@index([convertedFactoryId], map: "ix_sales_agent_leads__converted_factory_id")
  @@index([agentId, stage], map: "ix_sales_agent_leads__agent_id__stage")
  @@index([nextFollowUpAt], map: "ix_sales_agent_leads__next_follow_up_at__due", where: raw("(follow_up_reminded_at IS NULL AND next_follow_up_at IS NOT NULL)"))
  @@map("sales_agent_leads")
}

/// D-468: the timeline of a lead (calls, LINE, visits, notes, quotes sent, stage changes, system entries).
/// Append-only (trigger `forbid_mutation`). PDPA: notes about a prospect; same purpose, retention and access as the
/// lead.
model SalesAgentLeadActivity {
  id          BigInt                     @id(map: "pk_sales_agent_lead_activities") @default(autoincrement())
  publicId    String                     @unique(map: "ux_sales_agent_lead_activities__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  leadId      BigInt                     @map("lead_id")
  kind        SalesAgentLeadActivityKind
  body        String?
  /// Machine data of system entries (quote id, stage from / to …).
  data        Json                       @default("{}")
  occurredAt  DateTime                   @map("occurred_at") @db.Timestamptz(6)
  /// The person who wrote it; null for system entries.
  createdById BigInt?                    @map("created_by")
  createdAt   DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)

  lead      SalesAgentLead @relation(fields: [leadId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agent_lead_activities__lead_id")
  createdBy User?          @relation("SalesAgentLeadActivityCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agent_lead_activities__created_by")

  @@index([leadId, occurredAt(sort: Desc), id(sort: Desc)], map: "ix_sales_agent_lead_activities__lead_id__occurred_at")
  @@index([createdById], map: "ix_sales_agent_lead_activities__created_by")
  @@map("sales_agent_lead_activities")
}

/// D-468: a CSV import of leads (≤ 500 rows): the dry run keeps the parsed rows and their errors for 24 h; commit
/// re-checks every row. PDPA: prospects' contact data, purged (rows emptied) when it expires or 7 days after commit;
/// access = the agent only.
model SalesAgentLeadImport {
  id           BigInt                     @id(map: "pk_sales_agent_lead_imports") @default(autoincrement())
  publicId     String                     @unique(map: "ux_sales_agent_lead_imports__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  agentId      BigInt                     @map("agent_id")
  status       SalesAgentLeadImportStatus @default(previewed)
  rows         Json
  rowCount     Int                        @map("row_count")
  validCount   Int                        @map("valid_count")
