  updatedAt          DateTime                      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion         Int                           @default(1) @map("row_version")

  agent          SalesAgent  @relation(fields: [agentId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agent_payout_profiles__agent_id")
  idDocumentFile FileObject? @relation("SalesAgentPayoutProfileIdDocument", fields: [idDocumentFileId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agent_payout_profiles__id_document_file_id")
  bankBookFile   FileObject? @relation("SalesAgentPayoutProfileBankBook", fields: [bankBookFileId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agent_payout_profiles__bank_book_file_id")
  verifiedBy     User?       @relation("SalesAgentPayoutProfileVerifiedBy", fields: [verifiedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agent_payout_profiles__verified_by") // client: keep

