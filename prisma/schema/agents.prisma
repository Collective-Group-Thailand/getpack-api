  agent SalesAgent @relation(fields: [agentId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agent_notification_preferences__agent_id")

  @@unique([agentId, event, channel], map: "ux_sales_agent_notification_preferences__agent__event__channel")
  @@map("sales_agent_notification_preferences")
}

/// D-468: a quote an agent sent to a lead on behalf of getpack (the quote itself is the store's write-once snapshot,
/// owned by getpack — no customer until the lead signs up). The share token is kept encrypted so the agent can copy
/// the link again; only its hash is on the quote. PDPA: no personal data of its own (the lead's).
model SalesAgentQuote {
  id                 BigInt                @id(map: "pk_sales_agent_quotes") @default(autoincrement())
  publicId           String                @unique(map: "ux_sales_agent_quotes__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  agentId            BigInt                @map("agent_id")
  leadId             BigInt                @map("lead_id")
  quoteId            BigInt                @unique(map: "ux_sales_agent_quotes__quote_id") @map("quote_id")
  /// The store session the quote was saved under (anonymous owner, store rules — D-441).
  anonymousId        String                @map("anonymous_id") @db.Uuid
  status             SalesAgentQuoteStatus @default(sent)
  shareTokenEnc      Bytes?                @map("share_token_enc")
  sentAt             DateTime              @map("sent_at") @db.Timestamptz(6)
  sendCount          Int                   @default(1) @map("send_count")
  openedAt           DateTime?             @map("opened_at") @db.Timestamptz(6)
  acceptedAt         DateTime?             @map("accepted_at") @db.Timestamptz(6)
  withdrawnAt        DateTime?             @map("withdrawn_at") @db.Timestamptz(6)
  withdrawnReason    String?               @map("withdrawn_reason")
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion         Int                   @default(1) @map("row_version")
  /// D-468: the deal registration that protects and locks this quote.
  dealRegistrationId BigInt?               @map("deal_registration_id")

  dealRegistration SalesAgentDealRegistration? @relation(fields: [dealRegistrationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agent_quotes__deal_registration_id")
  agent            SalesAgent                  @relation(fields: [agentId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agent_quotes__agent_id")
  lead             SalesAgentLead              @relation(fields: [leadId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agent_quotes__lead_id")
  quote            Quote                       @relation("SalesAgentQuoteQuote", fields: [quoteId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agent_quotes__quote_id")

  discountRequests SalesAgentDiscountRequest[]

  approvals SalesDiscountApproval[] @relation("SalesDiscountApprovalAgentQuote")

  @@index([agentId, createdAt], map: "ix_sales_agent_quotes__agent_id__created_at")
  @@index([leadId], map: "ix_sales_agent_quotes__lead_id")
  @@index([dealRegistrationId], map: "ix_sales_agent_quotes__deal_registration_id")
  @@map("sales_agent_quotes")
}

/// D-468: where an agent's discount request stands (the approval itself is Phase 4).
