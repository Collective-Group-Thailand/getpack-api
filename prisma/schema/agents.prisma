/// D-468 (PLAN A-10, §7): one round of an agent's discount request on one quote version (a re-quote is a new
/// version). One open round per quote (partial unique index); a further round needs a changed give-get. Every round
/// is kept (negotiation history, Phase 4). PDPA: no personal data (competitor evidence is a document about prices).
model SalesAgentDiscountRequest {
  id               BigInt                          @id(map: "pk_sales_agent_discount_requests") @default(autoincrement())
  publicId         String                          @unique(map: "ux_sales_agent_discount_requests__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  agentId          BigInt                          @map("agent_id")
  agentQuoteId     BigInt                          @map("agent_quote_id")
  quoteId          BigInt                          @map("quote_id")
  /// The quantity the request is about.
  quoteOptionId    BigInt                          @map("quote_option_id")
  round            Int                             @db.SmallInt
  status           SalesAgentDiscountRequestStatus @default(open)
  requestedPct     Decimal                         @map("requested_pct") @db.Decimal(7, 4)
  reason           SalesAgentDiscountReason
  reasonNote       String?                         @map("reason_note")
  /// Give-get: the quantity the customer would order instead (null = unchanged).
  quantityChange   Int?                            @map("quantity_change")
  commitment       SalesAgentCommitment            @default(one_off)
  commitmentMonths Int?                            @map("commitment_months") @db.SmallInt
  depositPct       Decimal?                        @map("deposit_pct") @db.Decimal(7, 4)
  cashWithinDays   Int?                            @map("cash_within_days") @db.SmallInt
  leadTimeFlexDays Int?                            @map("lead_time_flex_days") @db.SmallInt
  specChange       String?                         @map("spec_change")
  /// SHA-256 of the give-get fields (a further round must change it).
  giveGetSha256    Bytes                           @map("give_get_sha256")
  competitorFileId BigInt?                         @map("competitor_file_id")
  /// Like-for-like spec of the competitor's offer (board grade, flute, print sides / colours, finish, quantity, lead
  /// time, shipping included, VAT included, price).
  competitorSpec   Json?                           @map("competitor_spec")
  createdById      BigInt                          @map("created_by")
  createdAt        DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)
  decidedAt        DateTime?                       @map("decided_at") @db.Timestamptz(6)
  decidedById      BigInt?                         @map("decided_by")
  decisionNote     String?                         @map("decision_note")
  updatedAt        DateTime                        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion       Int                             @default(1) @map("row_version")

  agent          SalesAgent                 @relation(fields: [agentId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agent_discount_requests__agent_id")
  agentQuote     SalesAgentQuote            @relation(fields: [agentQuoteId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agent_discount_requests__agent_quote_id")
  quote          Quote                      @relation("SalesAgentDiscountRequestQuote", fields: [quoteId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agent_discount_requests__quote_id")
  quoteOption    QuoteOption                @relation("SalesAgentDiscountRequestQuoteOption", fields: [quoteOptionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agent_discount_requests__quote_option_id")
  competitorFile FileObject?                @relation("SalesAgentDiscountRequestCompetitorFile", fields: [competitorFileId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agent_discount_requests__competitor_file_id")
  createdBy      User                       @relation("SalesAgentDiscountRequestCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agent_discount_requests__created_by")
  decidedBy      User?                      @relation("SalesAgentDiscountRequestDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agent_discount_requests__decided_by")
  options        SalesAgentDiscountOption[]

  approval SalesDiscountApproval? @relation("SalesDiscountApprovalRequest")

  @@unique([quoteId, round], map: "ux_sales_agent_discount_requests__quote_id__round")
  @@unique([quoteId], map: "ux_sales_agent_discount_requests__quote_id__open", where: raw("(status = 'open'::sales_agent_discount_request_status)"))
  @@index([agentId, createdAt], map: "ix_sales_agent_discount_requests__agent_id__created_at")
  @@index([agentQuoteId], map: "ix_sales_agent_discount_requests__agent_quote_id")
  @@index([quoteOptionId], map: "ix_sales_agent_discount_requests__quote_option_id")
  @@index([competitorFileId], map: "ix_sales_agent_discount_requests__competitor_file_id")
  @@index([createdById], map: "ix_sales_agent_discount_requests__created_by")
  @@index([decidedById], map: "ix_sales_agent_discount_requests__decided_by")
  @@index([status, createdAt], map: "ix_sales_agent_discount_requests__status__created_at")
  @@map("sales_agent_discount_requests")
}

/// D-468: an option offered for a discount request (1–3, Phase 4 creates them through
/// `AgentDiscountsService.offerOptions`). Amounts are computed by the API (decimal.js): the discounted net and the
/// agent's commission at that price. Accepting one is the agent's own act with its evidence (ip, user agent, time,
/// snapshot + SHA-256); a lower rate (co-fund) is never applied without it.
model SalesAgentDiscountOption {
  id                BigInt                         @id(map: "pk_sales_agent_discount_options") @default(autoincrement())
  publicId          String                         @unique(map: "ux_sales_agent_discount_options__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  requestId         BigInt                         @map("request_id")
  position          Int                            @db.SmallInt
  kind              SalesAgentDiscountOptionKind
  status            SalesAgentDiscountOptionStatus @default(offered)
  discountPct       Decimal                        @map("discount_pct") @db.Decimal(7, 4)
  /// The quantity's price before VAT, excluding shipping, before and after the discount.
  baseAmount        Decimal                        @map("base_amount") @db.Decimal(14, 2)
  netAmount         Decimal                        @map("net_amount") @db.Decimal(14, 2)
  /// The agent's rate on orders from this quote with this option, and the commission at `netAmount`.
  ratePct           Decimal                        @map("rate_pct") @db.Decimal(7, 4)
  standardRatePct   Decimal                        @map("standard_rate_pct") @db.Decimal(7, 4)
  commissionAmount  Decimal                        @map("commission_amount") @db.Decimal(14, 2)
  /// Conditions printed with the price (give-get), th / en.
  conditionsTh      String?                        @map("conditions_th")
  conditionsEn      String?                        @map("conditions_en")
  validUntil        DateTime                       @map("valid_until") @db.Timestamptz(6)
  offeredById       BigInt?                        @map("offered_by")
  offeredAt         DateTime                       @default(now()) @map("offered_at") @db.Timestamptz(6)
  acceptedAt        DateTime?                      @map("accepted_at") @db.Timestamptz(6)
  acceptedById      BigInt?                        @map("accepted_by")
  /// Acceptance evidence (PDPA: the agent's own ip and user agent, kept as long as the commission records).
  acceptedIp        String?                        @map("accepted_ip") @db.Inet
  acceptedUserAgent String?                        @map("accepted_user_agent")
  acceptedSnapshot  Json?                          @map("accepted_snapshot")
  acceptedSha256    Bytes?                         @map("accepted_sha256")
  rowVersion        Int                            @default(1) @map("row_version")

  request          SalesAgentDiscountRequest   @relation(fields: [requestId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agent_discount_options__request_id")
  offeredBy        User?                       @relation("SalesAgentDiscountOptionOfferedBy", fields: [offeredById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agent_discount_options__offered_by")
  dealRegistration SalesAgentDealRegistration? @relation("SalesAgentDealApprovedOption")
  acceptedBy       User?                       @relation("SalesAgentDiscountOptionAcceptedBy", fields: [acceptedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agent_discount_options__accepted_by")

  discountedQuote SalesDiscountedQuote? @relation("SalesDiscountedQuoteOption")

  @@unique([requestId, position], map: "ux_sales_agent_discount_options__request_id__position")
  @@unique([requestId], map: "ux_sales_agent_discount_options__request_id__accepted", where: raw("(status = 'accepted'::sales_agent_discount_option_status)"))
  @@index([offeredById], map: "ix_sales_agent_discount_options__offered_by")
  @@index([acceptedById], map: "ix_sales_agent_discount_options__accepted_by")
  @@map("sales_agent_discount_options")
}

/// D-468 (PLAN A-11): what a deal registration protects and locks.
enum SalesAgentDealScope {
  quote
  call_off_agreement

  @@map("sales_agent_deal_scope")
}

enum SalesAgentDealStatus {
  registered
  won
  lost
  expired

  @@map("sales_agent_deal_status")
}

enum SalesAgentDealOrigin {
  /// The quote's commission base reached `agent.deal_registration_threshold`, or a call-off agreement was accepted.
  automatic
  /// The agent asked for it (smaller quotes); no approval.
  requested

  @@map("sales_agent_deal_origin")
}

/// D-468 (PLAN A-11): deal registration = protection + rate lock, never a rate cut. Locks the standard rates in force
/// (or the rate of the option the agent accepted) for orders from its quotes; later plan versions never change it; a
/// call-off agreement keeps the lock for every call-off. While `registered` and protected, other agents and staff
/// assignment cannot take the lead / its customer (neutral refusal). One active registration per lead. No personal
/// data of its own.
model SalesAgentDealRegistration {
  id                  BigInt               @id(map: "pk_sales_agent_deal_registrations") @default(autoincrement())
  publicId            String               @unique(map: "ux_sales_agent_deal_registrations__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  agentId             BigInt               @map("agent_id")
  leadId              BigInt               @map("lead_id")
  scope               SalesAgentDealScope  @default(quote)
  callOffAgreementId  BigInt?              @map("call_off_agreement_id")
  origin              SalesAgentDealOrigin
  status              SalesAgentDealStatus @default(registered)
  lockedFirstRatePct  Decimal              @map("locked_first_rate_pct") @db.Decimal(7, 4)
  lockedRepeatRatePct Decimal              @map("locked_repeat_rate_pct") @db.Decimal(7, 4)
  planVersionId       BigInt               @map("plan_version_id")
  approvedOptionId    BigInt?              @unique(map: "ux_sales_agent_deal_registrations__approved_option_id") @map("approved_option_id")
  protectedUntil      DateTime             @map("protected_until") @db.Timestamptz(6)
  /// The threshold, protection days and commission base in force when registered.
  thresholdSnapshot   Json                 @map("threshold_snapshot")
  registeredAt        DateTime             @default(now()) @map("registered_at") @db.Timestamptz(6)
  endedAt             DateTime?            @map("ended_at") @db.Timestamptz(6)
  endedReason         String?              @map("ended_reason")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion          Int                  @default(1) @map("row_version")

  agent            SalesAgent                @relation(fields: [agentId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agent_deal_registrations__agent_id")
  lead             SalesAgentLead            @relation(fields: [leadId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agent_deal_registrations__lead_id")
  callOffAgreement CallOffAgreement?         @relation("SalesAgentDealCallOff", fields: [callOffAgreementId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agent_deal_registrations__call_off_agreement_id")
  planVersion      SalesAgentPlanVersion     @relation("SalesAgentDealPlanVersion", fields: [planVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agent_deal_registrations__plan_version_id")
  approvedOption   SalesAgentDiscountOption? @relation("SalesAgentDealApprovedOption", fields: [approvedOptionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_agent_deal_registrations__approved_option_id")
  quotes           SalesAgentQuote[]

  @@unique([leadId], map: "ux_sales_agent_deal_registrations__lead_id__registered", where: raw("(status = 'registered'::sales_agent_deal_status)"))
  @@index([agentId, status], map: "ix_sales_agent_deal_registrations__agent_id__status")
  @@index([status, protectedUntil], map: "ix_sales_agent_deal_registrations__status__protected_until")
  @@index([callOffAgreementId], map: "ix_sales_agent_deal_registrations__call_off_agreement_id")
  @@index([planVersionId], map: "ix_sales_agent_deal_registrations__plan_version_id")
  @@map("sales_agent_deal_registrations")
}

/// D-468 (PLAN A-13): who a playbook card is written for.
enum SalesPlaybookAudience {
  agent
  rep
  manager

  @@map("sales_playbook_audience")
}

enum SalesPlaybookCardStatus {
  draft
  published
  retired

  @@map("sales_playbook_card_status")
}

/// D-468 (PLAN A-13): the sales playbook as versioned cards — guidance shown in context (lead lost to price,
/// competitor cheaper, discount request, big deal, follow-up, first contact). One published version per key (partial
/// unique index); Phase 4 adds the maker-checker admin (D-470) on the same rows. Customer-safe copy only for cards an
/// agent sees (no cost, margin, factory or %-of-profit wording). No personal data.
model SalesPlaybookCard {
  id               BigInt                  @id(map: "pk_sales_playbook_cards") @default(autoincrement())
  publicId         String                  @unique(map: "ux_sales_playbook_cards__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  key              String                  @db.VarChar(64)
  version          Int                     @db.SmallInt
  /// Context keys (`all` = every context).
  contexts         String[]                @default([])
  audiences        SalesPlaybookAudience[] @default([])
  titleTh          String                  @map("title_th")
  titleEn          String?                 @map("title_en")
  /// Markdown.
  bodyTh           String                  @map("body_th")
  bodyEn           String?                 @map("body_en")
  /// `[{ th, en }]` — replies an agent copies to LINE.
  suggestedReplies Json                    @default("[]") @map("suggested_replies")
  sort             Int                     @default(0) @db.SmallInt
  status           SalesPlaybookCardStatus @default(draft)
  publishedAt      DateTime?               @map("published_at") @db.Timestamptz(6)
  /// Where the content came from (e.g. `docs/design/agent-portal/PLAYBOOK.md v1`).
  source           String?
  /// D-470: who owns the content (`marketing` or `sales_manager`); only that role (or Superadmin) edits it.
  ownerRole        String                  @default("marketing") @map("owner_role") @db.VarChar(32)
  /// D-470 maker-checker: a draft is submitted for review, then published by someone else.
  submittedById    BigInt?                 @map("submitted_by")
  submittedAt      DateTime?               @map("submitted_at") @db.Timestamptz(6)
  publishedById    BigInt?                 @map("published_by")
  changeNote       String?                 @map("change_note")
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById      BigInt?                 @map("created_by")
  updatedAt        DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion       Int                     @default(1) @map("row_version")

  @@unique([key, version], map: "ux_sales_playbook_cards__key__version")
  @@unique([key], map: "ux_sales_playbook_cards__key__published", where: raw("(status = 'published'::sales_playbook_card_status)"))
  @@index([status, sort], map: "ix_sales_playbook_cards__status__sort")
  @@index([contexts], type: Gin, map: "ix_sales_playbook_cards__contexts")
  @@map("sales_playbook_cards")
}
