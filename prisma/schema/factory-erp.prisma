// Packio Factory ERP (E1, docs/prompts/E1-factory-erp.md; D-316 – D-332).
// Factory-private data (D-317): every table carries `factory_id` and is read only through
// `/v1/partner/factories/{factoryId}/erp/*`. Ledgers are append-only (triggers in the migration).

enum ErpPartnerKind {
  supplier
  customer
  both

  @@map("erp_partner_kind")
}

enum ErpRecordStatus {
  active
  archived

  @@map("erp_record_status")
}

/// D-320.
enum ErpItemKind {
  raw_material
  consumable
  spare_part
  semi_finished
  finished_good
  packing

  @@map("erp_item_kind")
}

/// D-320: the closed list of units.
enum ErpUnit {
  kg
  g
  ton
  sheet
  ream
  roll
  m
  m2
  pcs
  box
  pack
  set
  l
  ml

  @@map("erp_unit")
}

/// D-324.
enum ErpMovementKind {
  opening
  receipt
  issue
  return
  adjustment
  count
  transfer_out
  transfer_in
  production_issue
  production_return
  production_receipt
  landed_cost
  maintenance_issue
  sales_issue
  sales_return

  @@map("erp_movement_kind")
}

enum ErpVatMode {
  exclusive
  inclusive
  none

  @@map("erp_vat_mode")
}

/// D-325.
enum ErpPurchaseOrderStatus {
  draft
  issued
  partially_received
  received
  closed
  cancelled

  @@map("erp_purchase_order_status")
}

/// D-323: the factory's own numbered document types.
enum ErpDocumentType {
  po
  gr
  adj
  trf
  iss
  pr
  ap
  pv
  mo
  rfq
  mt
  qt
  so
  do
  iv
  cn
  dr
  rc
  bn
  wht

  @@map("erp_document_type")
}

/// D-318, D-322, D-323, D-325: one row per factory, created on first use.
model ErpFactorySettings {
  id                     BigInt                    @id(map: "pk_erp_factory_settings") @default(autoincrement())
  factoryId              BigInt                    @unique(map: "ux_erp_factory_settings__factory_id") @map("factory_id")
  /// Switched-off module keys (D-318); everything else is on.
  disabledModules        String[]                  @default([]) @map("disabled_modules")
  allowNegativeStock     Boolean                   @default(false) @map("allow_negative_stock")
  overReceiptPct         Decimal                   @default(10) @map("over_receipt_pct") @db.Decimal(7, 4)
  /// D-337: a supplier invoice priced within this % of the order matches (3-way match).
  priceTolerancePct      Decimal                   @default(2) @map("price_tolerance_pct") @db.Decimal(7, 4)
  /// D-336: purchase requests need an approver (`factory_procurement.approve`) when on.
  requireRequestApproval Boolean                   @default(true) @map("require_request_approval")
  /// D-347: a price more than this % above the last one paid raises an alert.
  priceAlertPct          Decimal                   @default(5) @map("price_alert_pct") @db.Decimal(7, 4)
  /// D-347, D-351: quotations and supplier reviews ending within this many days raise an alert.
  quoteExpiryDays        Int                       @default(7) @map("quote_expiry_days")
  /// D-351: what a supplier not approved for an item means on a purchase order.
  supplierApproval       ErpSupplierApprovalPolicy @default(warn) @map("supplier_approval")
  /// Document prefixes by `ErpDocumentType` (D-323); a missing key uses the default (`PO`, `GR`, ...).
  prefixes               Json                      @default("{}")
  /// D-368: the factory's logo, footer, bank details and signatory on its documents.
  documentLogoFileId     BigInt?                   @map("document_logo_file_id")
  documentFooter         String?                   @map("document_footer")
  bankDetails            String?                   @map("bank_details")
  signatoryName          String?                   @map("signatory_name")
  /// D-360: days a new quotation holds.
  quoteValidDays         Int                       @default(30) @map("quote_valid_days")
  createdAt              DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById            BigInt?                   @map("updated_by")
  rowVersion             Int                       @default(1) @map("row_version")

  factory   Factory @relation("ErpFactorySettingsFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_factory_settings__factory_id")
  updatedBy User?   @relation("ErpFactorySettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_factory_settings__updated_by")

  documentLogo FileObject? @relation("ErpFactorySettingsLogo", fields: [documentLogoFileId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_factory_settings__document_logo_file_id")

  @@index([updatedById], map: "ix_erp_factory_settings__updated_by")
  @@index([documentLogoFileId], map: "ix_erp_factory_settings__document_logo_file_id")
  @@map("erp_factory_settings")
}

/// D-323: gapless numbering per factory × type × month (`YYMM`), row-locked on use.
model ErpDocumentSeries {
  id        BigInt          @id(map: "pk_erp_document_series") @default(autoincrement())
  factoryId BigInt          @map("factory_id")
  docType   ErpDocumentType @map("doc_type")
  period    String          @db.Char(4)
  nextNo    Int             @default(1) @map("next_no")

  factory Factory @relation("ErpDocumentSeriesFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_document_series__factory_id")

  @@unique([factoryId, docType, period], map: "ux_erp_document_series__factory_id__doc_type__period")
  @@map("erp_document_series")
}

/// M1: the factory's own suppliers and customers (D-317).
model ErpTradingPartner {
  id              BigInt          @id(map: "pk_erp_trading_partners") @default(autoincrement())
  publicId        String          @unique(map: "ux_erp_trading_partners__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  factoryId       BigInt          @map("factory_id")
  code            String
  kind            ErpPartnerKind
  name            String
  taxId           String?         @map("tax_id") @db.Char(13)
  branchCode      String?         @map("branch_code") @db.Char(5)
  contactName     String?         @map("contact_name")
  phone           String?
  email           String?
  address         String?
  paymentTermDays Int             @default(0) @map("payment_term_days")
  creditLimit     Decimal?        @map("credit_limit") @db.Decimal(14, 2)
  /// D-366: who the 50 ทวิ is for (ภ.ง.ด.3 individual, ภ.ง.ด.53 juristic).
  entityType      ErpEntityType   @default(juristic) @map("entity_type")
  /// D-359: the customer's salesperson.
  salespersonId   BigInt?         @map("salesperson_id")
  note            String?
  status          ErpRecordStatus @default(active)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById     BigInt          @map("created_by")
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById     BigInt?         @map("updated_by")
  rowVersion      Int             @default(1) @map("row_version")

  factory                    Factory                  @relation("ErpTradingPartnerFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_trading_partners__factory_id")
  createdBy                  User                     @relation("ErpTradingPartnerCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_trading_partners__created_by")
  updatedBy                  User?                    @relation("ErpTradingPartnerUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_trading_partners__updated_by")
  suppliedItems              ErpItem[]                @relation("ErpItemDefaultSupplier")
  purchaseOrders             ErpPurchaseOrder[]       @relation("ErpPurchaseOrderSupplier")
  goodsReceipts              ErpGoodsReceipt[]        @relation("ErpGoodsReceiptSupplier")
  itemLinks                  ErpItemSupplier[]        @relation("ErpItemSupplierSupplier")
  priceRecords               ErpPriceRecord[]         @relation("ErpPriceRecordSupplier")
  requestLines               ErpPurchaseRequestLine[] @relation("ErpPurchaseRequestLineSupplier")
  supplierInvoices           ErpSupplierInvoice[]     @relation("ErpSupplierInvoiceSupplier")
  supplierPayments           ErpSupplierPayment[]     @relation("ErpSupplierPaymentSupplier")
  erpRfqSuppliers            ErpRfqSupplier[]         @relation("ErpRfqSupplierSupplier")
  erpLandedCharges           ErpLandedCharge[]        @relation("ErpLandedChargePartner")
  erpLeadCustomer            ErpLead[]                @relation("ErpLeadCustomer")
  erpOpportunityCustomer     ErpOpportunity[]         @relation("ErpOpportunityCustomer")
  erpActivityCustomer        ErpActivity[]            @relation("ErpActivityCustomer")
  erpQuotationCustomer       ErpQuotation[]           @relation("ErpQuotationCustomer")
  erpSalesOrderCustomer      ErpSalesOrder[]          @relation("ErpSalesOrderCustomer")
  erpDeliveryNoteCustomer    ErpDeliveryNote[]        @relation("ErpDeliveryNoteCustomer")
  erpSalesInvoiceCustomer    ErpSalesInvoice[]        @relation("ErpSalesInvoiceCustomer")
  erpSalesNoteCustomer       ErpSalesNote[]           @relation("ErpSalesNoteCustomer")
  erpCustomerReceiptCustomer ErpCustomerReceipt[]     @relation("ErpCustomerReceiptCustomer")
  erpBillingNoteCustomer     ErpBillingNote[]         @relation("ErpBillingNoteCustomer")
  erpWhtCertificateSupplier  ErpWhtCertificate[]      @relation("ErpWhtCertificateSupplier")

  salesperson User? @relation("ErpTradingPartnerSalesperson", fields: [salespersonId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_trading_partners__salesperson_id")

  @@unique([factoryId, code], map: "ux_erp_trading_partners__factory_id__code")
  @@index([factoryId, kind, status], map: "ix_erp_trading_partners__factory_id__kind__status")
  @@index([createdById], map: "ix_erp_trading_partners__created_by")
  @@index([updatedById], map: "ix_erp_trading_partners__updated_by")
  @@index([salespersonId], map: "ix_erp_trading_partners__salesperson_id")
  @@map("erp_trading_partners")
}

model ErpWarehouse {
  id          BigInt          @id(map: "pk_erp_warehouses") @default(autoincrement())
  publicId    String          @unique(map: "ux_erp_warehouses__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  factoryId   BigInt          @map("factory_id")
  code        String
  name        String
  isDefault   Boolean         @default(false) @map("is_default")
  status      ErpRecordStatus @default(active)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById BigInt?         @map("created_by")
  updatedAt   DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById BigInt?         @map("updated_by")
  rowVersion  Int             @default(1) @map("row_version")

  factory                  Factory              @relation("ErpWarehouseFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_warehouses__factory_id")
  createdBy                User?                @relation("ErpWarehouseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_warehouses__created_by")
  updatedBy                User?                @relation("ErpWarehouseUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_warehouses__updated_by")
  balances                 ErpStockBalance[]
  movements                ErpStockMovement[]
  goodsReceipts            ErpGoodsReceipt[]
  productionOrders         ErpProductionOrder[]
  erpMaintenanceParts      ErpMaintenancePart[]
  erpSalesOrderWarehouse   ErpSalesOrder[]      @relation("ErpSalesOrderWarehouse")
  erpDeliveryNoteWarehouse ErpDeliveryNote[]    @relation("ErpDeliveryNoteWarehouse")
  erpSalesNoteWarehouse    ErpSalesNote[]       @relation("ErpSalesNoteWarehouse")

  @@unique([factoryId, code], map: "ux_erp_warehouses__factory_id__code")
  @@index([createdById], map: "ix_erp_warehouses__created_by")
  @@index([updatedById], map: "ix_erp_warehouses__updated_by")
  @@map("erp_warehouses")
}

/// M2 item master (D-320).
model ErpItem {
  id                BigInt          @id(map: "pk_erp_items") @default(autoincrement())
  publicId          String          @unique(map: "ux_erp_items__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  factoryId         BigInt          @map("factory_id")
  sku               String
  name              String
  kind              ErpItemKind
  /// Optional link to the platform material so Packio job specs map to stock.
  materialId        BigInt?         @map("material_id")
  baseUnit          ErpUnit         @map("base_unit")
  purchaseUnit      ErpUnit?        @map("purchase_unit")
  /// Base units per purchase unit (e.g. 500 sheets per ream).
  purchaseFactor    Decimal         @default(1) @map("purchase_factor") @db.Decimal(18, 6)
  reorderPoint      Decimal?        @map("reorder_point") @db.Decimal(14, 3)
  reorderQty        Decimal?        @map("reorder_qty") @db.Decimal(14, 3)
  leadTimeDays      Int?            @map("lead_time_days")
  defaultSupplierId BigInt?         @map("default_supplier_id")
  trackLots         Boolean         @default(false) @map("track_lots")
  /// Last purchase price per purchase unit, excluding VAT.
  lastPurchasePrice Decimal?        @map("last_purchase_price") @db.Decimal(18, 6)
  note              String?
  status            ErpRecordStatus @default(active)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById       BigInt          @map("created_by")
  updatedAt         DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById       BigInt?         @map("updated_by")
  rowVersion        Int             @default(1) @map("row_version")

  factory                 Factory                  @relation("ErpItemFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_items__factory_id")
  material                Material?                @relation("ErpItemMaterial", fields: [materialId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_items__material_id")
  defaultSupplier         ErpTradingPartner?       @relation("ErpItemDefaultSupplier", fields: [defaultSupplierId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_items__default_supplier_id")
  createdBy               User                     @relation("ErpItemCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_items__created_by")
  updatedBy               User?                    @relation("ErpItemUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_items__updated_by")
  balances                ErpStockBalance[]
  movements               ErpStockMovement[]
  poLines                 ErpPurchaseOrderLine[]
  grLines                 ErpGoodsReceiptLine[]
  suppliers               ErpItemSupplier[]
  priceRecords            ErpPriceRecord[]
  requestLines            ErpPurchaseRequestLine[]
  invoiceLines            ErpSupplierInvoiceLine[]
  recipes                 ErpRecipe[]              @relation("ErpRecipeItem")
  recipeUses              ErpRecipeMaterial[]      @relation("ErpRecipeMaterialItem")
  productionOrders        ErpProductionOrder[]     @relation("ErpProductionOrderItem")
  productionUses          ErpProductionMaterial[]  @relation("ErpProductionMaterialItem")
  erpRfqLines             ErpRfqLine[]
  erpMaintenancePlanParts ErpMaintenancePlanPart[]
  erpMaintenanceParts     ErpMaintenancePart[]
  erpQuotationLineItem    ErpQuotationLine[]       @relation("ErpQuotationLineItem")
  erpSalesOrderLineItem   ErpSalesOrderLine[]      @relation("ErpSalesOrderLineItem")
  erpDeliveryNoteLineItem ErpDeliveryNoteLine[]    @relation("ErpDeliveryNoteLineItem")
  erpSalesInvoiceLineItem ErpSalesInvoiceLine[]    @relation("ErpSalesInvoiceLineItem")
  erpSalesNoteLineItem    ErpSalesNoteLine[]       @relation("ErpSalesNoteLineItem")

  @@unique([factoryId, sku], map: "ux_erp_items__factory_id__sku")
  @@index([factoryId, kind, status], map: "ix_erp_items__factory_id__kind__status")
  @@index([materialId], map: "ix_erp_items__material_id")
  @@index([defaultSupplierId], map: "ix_erp_items__default_supplier_id")
  @@index([createdById], map: "ix_erp_items__created_by")
  @@index([updatedById], map: "ix_erp_items__updated_by")
  @@map("erp_items")
}

/// Item × warehouse balance, written only by the stock service with its movement (D-321, D-324).
model ErpStockBalance {
  id          BigInt   @id(map: "pk_erp_stock_balances") @default(autoincrement())
  factoryId   BigInt   @map("factory_id")
  itemId      BigInt   @map("item_id")
  warehouseId BigInt   @map("warehouse_id")
  onHand      Decimal  @default(0) @map("on_hand") @db.Decimal(14, 3)
  reserved    Decimal  @default(0) @db.Decimal(14, 3)
  avgCost     Decimal  @default(0) @map("avg_cost") @db.Decimal(18, 6)
  value       Decimal  @default(0) @db.Decimal(14, 2)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  factory   Factory      @relation("ErpStockBalanceFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_stock_balances__factory_id")
  item      ErpItem      @relation(fields: [itemId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_stock_balances__item_id")
  warehouse ErpWarehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_stock_balances__warehouse_id")

  @@unique([itemId, warehouseId], map: "ux_erp_stock_balances__item_id__warehouse_id")
  @@index([factoryId], map: "ix_erp_stock_balances__factory_id")
  @@index([warehouseId], map: "ix_erp_stock_balances__warehouse_id")
  @@map("erp_stock_balances")
}

/// Append-only stock ledger (D-324).
model ErpStockMovement {
  id             BigInt          @id(map: "pk_erp_stock_movements") @default(autoincrement())
  publicId       String          @unique(map: "ux_erp_stock_movements__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  factoryId      BigInt          @map("factory_id")
  itemId         BigInt          @map("item_id")
  warehouseId    BigInt          @map("warehouse_id")
  kind           ErpMovementKind
  /// Signed, in the item's base unit.
  quantity       Decimal         @db.Decimal(14, 3)
  unitCost       Decimal         @map("unit_cost") @db.Decimal(18, 6)
  /// Signed value of the movement.
  value          Decimal         @db.Decimal(14, 2)
  balanceAfter   Decimal         @map("balance_after") @db.Decimal(14, 3)
  avgCostAfter   Decimal         @map("avg_cost_after") @db.Decimal(18, 6)
  lotNo          String?         @map("lot_no")
  /// The document that caused it: a goods receipt, or an adjustment / issue / transfer batch.
  sourceType     String          @map("source_type")
  sourcePublicId String          @map("source_public_id") @db.Uuid
  documentNo     String          @map("document_no")
  reason         String?
  occurredAt     DateTime        @default(now()) @map("occurred_at") @db.Timestamptz(6)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById    BigInt          @map("created_by")

  factory   Factory      @relation("ErpStockMovementFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_stock_movements__factory_id")
  item      ErpItem      @relation(fields: [itemId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_stock_movements__item_id")
  warehouse ErpWarehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_stock_movements__warehouse_id")
  createdBy User         @relation("ErpStockMovementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_stock_movements__created_by")

  @@index([factoryId, occurredAt(sort: Desc)], map: "ix_erp_stock_movements__factory_id__occurred_at")
  @@index([itemId, occurredAt(sort: Desc)], map: "ix_erp_stock_movements__item_id__occurred_at")
  @@index([warehouseId], map: "ix_erp_stock_movements__warehouse_id")
  @@index([sourcePublicId], map: "ix_erp_stock_movements__source_public_id")
  @@index([createdById], map: "ix_erp_stock_movements__created_by")
  @@map("erp_stock_movements")
}

/// M3 purchase order (D-325).
model ErpPurchaseOrder {
  id           BigInt                 @id(map: "pk_erp_purchase_orders") @default(autoincrement())
  publicId     String                 @unique(map: "ux_erp_purchase_orders__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  factoryId    BigInt                 @map("factory_id")
  /// Null while a draft; numbered when issued (D-323).
  poNo         String?                @map("po_no")
  supplierId   BigInt                 @map("supplier_id")
  status       ErpPurchaseOrderStatus @default(draft)
  orderedOn    DateTime               @map("ordered_on") @db.Date
  expectedOn   DateTime?              @map("expected_on") @db.Date
  vatMode      ErpVatMode             @default(exclusive) @map("vat_mode")
  vatRatePct   Decimal                @default(7) @map("vat_rate_pct") @db.Decimal(7, 4)
  subtotal     Decimal                @default(0) @db.Decimal(14, 2)
  vatAmount    Decimal                @default(0) @map("vat_amount") @db.Decimal(14, 2)
  total        Decimal                @default(0) @db.Decimal(14, 2)
  supplierRef  String?                @map("supplier_ref")
  deliverTo    String?                @map("deliver_to")
  note         String?
  issuedAt     DateTime?              @map("issued_at") @db.Timestamptz(6)
  issuedById   BigInt?                @map("issued_by")
  closedAt     DateTime?              @map("closed_at") @db.Timestamptz(6)
  cancelReason String?                @map("cancel_reason")
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById  BigInt                 @map("created_by")
  updatedAt    DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById  BigInt?                @map("updated_by")
  rowVersion   Int                    @default(1) @map("row_version")

  factory          Factory                @relation("ErpPurchaseOrderFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_purchase_orders__factory_id")
  supplier         ErpTradingPartner      @relation("ErpPurchaseOrderSupplier", fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_purchase_orders__supplier_id")
  issuedBy         User?                  @relation("ErpPurchaseOrderIssuedBy", fields: [issuedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_purchase_orders__issued_by")
  createdBy        User                   @relation("ErpPurchaseOrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_purchase_orders__created_by")
  updatedBy        User?                  @relation("ErpPurchaseOrderUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_purchase_orders__updated_by")
  lines            ErpPurchaseOrderLine[]
  goodsReceipts    ErpGoodsReceipt[]
  supplierInvoices ErpSupplierInvoice[]

  @@unique([factoryId, poNo], map: "ux_erp_purchase_orders__factory_id__po_no")
  @@index([factoryId, status], map: "ix_erp_purchase_orders__factory_id__status")
  @@index([supplierId], map: "ix_erp_purchase_orders__supplier_id")
  @@index([issuedById], map: "ix_erp_purchase_orders__issued_by")
  @@index([createdById], map: "ix_erp_purchase_orders__created_by")
  @@index([updatedById], map: "ix_erp_purchase_orders__updated_by")
  @@map("erp_purchase_orders")
}

model ErpPurchaseOrderLine {
  id              BigInt  @id(map: "pk_erp_purchase_order_lines") @default(autoincrement())
  publicId        String  @unique(map: "ux_erp_purchase_order_lines__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  purchaseOrderId BigInt  @map("purchase_order_id")
  lineNo          Int     @map("line_no")
  itemId          BigInt  @map("item_id")
  description     String?
  /// In `unit`; `factor` base units per `unit`, frozen from the item.
  quantity        Decimal @db.Decimal(14, 3)
  unit            ErpUnit
  factor          Decimal @db.Decimal(18, 6)
  unitPrice       Decimal @map("unit_price") @db.Decimal(18, 6)
  discountPct     Decimal @default(0) @map("discount_pct") @db.Decimal(7, 4)
  amount          Decimal @db.Decimal(14, 2)
  /// In `unit`.
  receivedQty     Decimal @default(0) @map("received_qty") @db.Decimal(14, 3)

  purchaseOrder ErpPurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_purchase_order_lines__purchase_order_id")
  item          ErpItem                  @relation(fields: [itemId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_purchase_order_lines__item_id")
  receiptLines  ErpGoodsReceiptLine[]
  requestLines  ErpPurchaseRequestLine[]
  invoiceLines  ErpSupplierInvoiceLine[]
  rfqQuote      ErpRfqQuote?

  @@unique([purchaseOrderId, lineNo], map: "ux_erp_purchase_order_lines__purchase_order_id__line_no")
  @@index([itemId], map: "ix_erp_purchase_order_lines__item_id")
  @@map("erp_purchase_order_lines")
}

/// Posting is final (D-325): no update, no delete.
model ErpGoodsReceipt {
  id              BigInt   @id(map: "pk_erp_goods_receipts") @default(autoincrement())
  publicId        String   @unique(map: "ux_erp_goods_receipts__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  factoryId       BigInt   @map("factory_id")
  grNo            String   @map("gr_no")
  purchaseOrderId BigInt?  @map("purchase_order_id")
  supplierId      BigInt   @map("supplier_id")
  warehouseId     BigInt   @map("warehouse_id")
  receivedOn      DateTime @map("received_on") @db.Date
  deliveryNoteNo  String?  @map("delivery_note_no")
  note            String?
  total           Decimal  @db.Decimal(14, 2)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById     BigInt   @map("created_by")

  factory       Factory               @relation("ErpGoodsReceiptFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_goods_receipts__factory_id")
  purchaseOrder ErpPurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_goods_receipts__purchase_order_id")
  supplier      ErpTradingPartner     @relation("ErpGoodsReceiptSupplier", fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_goods_receipts__supplier_id")
  warehouse     ErpWarehouse          @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_goods_receipts__warehouse_id")
  createdBy     User                  @relation("ErpGoodsReceiptCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_goods_receipts__created_by")
  lines         ErpGoodsReceiptLine[]
  /// D-350: landed charges entered with the receipt (later ones are in `landedCharges`).
  chargesTotal  Decimal               @default(0) @map("charges_total") @db.Decimal(14, 2)
  landedCharges ErpLandedCharge[]

  @@unique([factoryId, grNo], map: "ux_erp_goods_receipts__factory_id__gr_no")
  @@index([factoryId, receivedOn(sort: Desc)], map: "ix_erp_goods_receipts__factory_id__received_on")
  @@index([purchaseOrderId], map: "ix_erp_goods_receipts__purchase_order_id")
  @@index([supplierId], map: "ix_erp_goods_receipts__supplier_id")
  @@index([warehouseId], map: "ix_erp_goods_receipts__warehouse_id")
  @@index([createdById], map: "ix_erp_goods_receipts__created_by")
  @@map("erp_goods_receipts")
}

model ErpGoodsReceiptLine {
  id                  BigInt  @id(map: "pk_erp_goods_receipt_lines") @default(autoincrement())
  goodsReceiptId      BigInt  @map("goods_receipt_id")
  lineNo              Int     @map("line_no")
  purchaseOrderLineId BigInt? @map("purchase_order_line_id")
  itemId              BigInt  @map("item_id")
  quantity            Decimal @db.Decimal(14, 3)
  unit                ErpUnit
  factor              Decimal @db.Decimal(18, 6)
  baseQuantity        Decimal @map("base_quantity") @db.Decimal(14, 3)
  /// Per base unit, excluding VAT for a VAT-registered factory (D-321).
  unitCost            Decimal @map("unit_cost") @db.Decimal(18, 6)
  amount              Decimal @db.Decimal(14, 2)
  lotNo               String? @map("lot_no")

  goodsReceipt      ErpGoodsReceipt       @relation(fields: [goodsReceiptId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_goods_receipt_lines__goods_receipt_id")
  purchaseOrderLine ErpPurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_goods_receipt_lines__purchase_order_line_id")
  item              ErpItem               @relation(fields: [itemId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_goods_receipt_lines__item_id")
  /// D-349: delivered but refused at inspection, in `unit`; not in stock nor received on the order.
  rejectedQuantity  Decimal               @default(0) @map("rejected_quantity") @db.Decimal(14, 3)
  rejectReason      String?               @map("reject_reason")
  /// D-350: landed charges allocated to this line when it was received (later ones are in the charges' lines).
  landedAmount      Decimal               @default(0) @map("landed_amount") @db.Decimal(14, 2)
  chargeLines       ErpLandedChargeLine[]

  @@unique([goodsReceiptId, lineNo], map: "ux_erp_goods_receipt_lines__goods_receipt_id__line_no")
  @@index([purchaseOrderLineId], map: "ix_erp_goods_receipt_lines__purchase_order_line_id")
  @@index([itemId], map: "ix_erp_goods_receipt_lines__item_id")
  @@map("erp_goods_receipt_lines")
}

// ============================================================================ E1.1 and E2
// Supplier prices (D-333 – D-335), purchase requests (D-336), supplier invoices and payments (D-337, D-338),
// production recipes (D-339), production orders with reservations (D-340, D-341), MRP (D-342).

enum ErpPriceSource {
  goods_receipt
  purchase_order
  quotation
  manual

  @@map("erp_price_source")
}

enum ErpPurchaseRequestStatus {
  draft
  submitted
  approved
  rejected
  ordered
  cancelled

  @@map("erp_purchase_request_status")
}

enum ErpRequestSource {
  manual
  reorder
  mrp

  @@map("erp_request_source")
}

enum ErpSupplierInvoiceStatus {
  matched
  variance
  approved
  partially_paid
  paid
  cancelled

  @@map("erp_supplier_invoice_status")
}

enum ErpPaymentMethod {
  transfer
  cash
  cheque
  other

  @@map("erp_payment_method")
}

enum ErpProductionSource {
  packio_job
  stock
  sales_order

  @@map("erp_production_source")
}

enum ErpProductionStatus {
  planned
  released
  in_progress
  completed
  closed
  cancelled

  @@map("erp_production_status")
}

enum ErpOperationStatus {
  pending
  in_progress
  done
  skipped
  paused

  @@map("erp_operation_status")
}

/// D-333: what the factory buys from whom — the supplier's code, unit and terms, and the latest price.
model ErpItemSupplier {
  id              BigInt          @id(map: "pk_erp_item_suppliers") @default(autoincrement())
  publicId        String          @unique(map: "ux_erp_item_suppliers__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  factoryId       BigInt          @map("factory_id")
  itemId          BigInt          @map("item_id")
  supplierId      BigInt          @map("supplier_id")
  supplierSku     String?         @map("supplier_sku")
  supplierName    String?         @map("supplier_name")
  /// The unit this supplier sells in, and base units per it.
  purchaseUnit    ErpUnit         @map("purchase_unit")
  purchaseFactor  Decimal         @default(1) @map("purchase_factor") @db.Decimal(18, 6)
  minOrderQty     Decimal?        @map("min_order_qty") @db.Decimal(14, 3)
  leadTimeDays    Int?            @map("lead_time_days")
  /// Per `purchaseUnit`, net of discount, without VAT (D-334).
  lastPrice       Decimal?        @map("last_price") @db.Decimal(18, 6)
  lastPricedOn    DateTime?       @map("last_priced_on") @db.Date
  lastPurchasedOn DateTime?       @map("last_purchased_on") @db.Date
  preferred       Boolean         @default(false)
  note            String?
  status          ErpRecordStatus @default(active)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById     BigInt?         @map("created_by")
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById     BigInt?         @map("updated_by")
  rowVersion      Int             @default(1) @map("row_version")

  factory          Factory             @relation("ErpItemSupplierFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_item_suppliers__factory_id")
  item             ErpItem             @relation(fields: [itemId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_item_suppliers__item_id")
  supplier         ErpTradingPartner   @relation("ErpItemSupplierSupplier", fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_item_suppliers__supplier_id")
  createdBy        User?               @relation("ErpItemSupplierCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_item_suppliers__created_by")
  updatedBy        User?               @relation("ErpItemSupplierUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_item_suppliers__updated_by")
  /// D-351: approved supplier list.
  approval         ErpSupplierApproval @default(pending)
  approvalNote     String?             @map("approval_note")
  approvedAt       DateTime?           @map("approved_at") @db.Timestamptz(6)
  approvedById     BigInt?             @map("approved_by")
  /// When the approval should be looked at again.
  reviewOn         DateTime?           @map("review_on") @db.Date
  /// D-346: until when the price breaks hold.
  breaksValidUntil DateTime?           @map("breaks_valid_until") @db.Date
  approvedBy       User?               @relation("ErpItemSupplierApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_item_suppliers__approved_by")
  priceBreaks      ErpPriceBreak[]

  @@unique([itemId, supplierId], map: "ux_erp_item_suppliers__item_id__supplier_id")
  @@index([factoryId], map: "ix_erp_item_suppliers__factory_id")
  @@index([supplierId], map: "ix_erp_item_suppliers__supplier_id")
  @@index([createdById], map: "ix_erp_item_suppliers__created_by")
  @@index([updatedById], map: "ix_erp_item_suppliers__updated_by")
  @@index([approvedById], map: "ix_erp_item_suppliers__approved_by")
  @@map("erp_item_suppliers")
}

/// D-334: every price the factory met — paid on a receipt, ordered, quoted, or noted — append-only.
model ErpPriceRecord {
  id             BigInt         @id(map: "pk_erp_price_records") @default(autoincrement())
  publicId       String         @unique(map: "ux_erp_price_records__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  factoryId      BigInt         @map("factory_id")
  itemId         BigInt         @map("item_id")
  supplierId     BigInt         @map("supplier_id")
  source         ErpPriceSource
  unit           ErpUnit
  factor         Decimal        @db.Decimal(18, 6)
  /// Per `unit`, net of discount, without VAT.
  unitPrice      Decimal        @map("unit_price") @db.Decimal(18, 6)
  /// Per base unit (`unitPrice / factor`), to compare suppliers selling in different units.
  baseUnitPrice  Decimal        @map("base_unit_price") @db.Decimal(18, 6)
  quantity       Decimal?       @db.Decimal(14, 3)
  pricedOn       DateTime       @map("priced_on") @db.Date
  validUntil     DateTime?      @map("valid_until") @db.Date
  sourcePublicId String?        @map("source_public_id") @db.Uuid
  documentNo     String?        @map("document_no")
  note           String?
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById    BigInt         @map("created_by")

  factory   Factory           @relation("ErpPriceRecordFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_price_records__factory_id")
  item      ErpItem           @relation(fields: [itemId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_price_records__item_id")
  supplier  ErpTradingPartner @relation("ErpPriceRecordSupplier", fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_price_records__supplier_id")
  createdBy User              @relation("ErpPriceRecordCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_price_records__created_by")

  @@index([itemId, pricedOn(sort: Desc)], map: "ix_erp_price_records__item_id__priced_on")
  @@index([supplierId, pricedOn(sort: Desc)], map: "ix_erp_price_records__supplier_id__priced_on")
  @@index([factoryId], map: "ix_erp_price_records__factory_id")
  @@index([createdById], map: "ix_erp_price_records__created_by")
  @@map("erp_price_records")
}

/// D-336: a request to buy, approved before it becomes a purchase order.
model ErpPurchaseRequest {
  id             BigInt                   @id(map: "pk_erp_purchase_requests") @default(autoincrement())
  publicId       String                   @unique(map: "ux_erp_purchase_requests__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  factoryId      BigInt                   @map("factory_id")
  prNo           String                   @map("pr_no")
  status         ErpPurchaseRequestStatus @default(draft)
  source         ErpRequestSource         @default(manual)
  neededBy       DateTime?                @map("needed_by") @db.Date
  note           String?
  /// Estimated at the suppliers' latest prices, without VAT.
  estimatedTotal Decimal                  @default(0) @map("estimated_total") @db.Decimal(14, 2)
  submittedAt    DateTime?                @map("submitted_at") @db.Timestamptz(6)
  decidedAt      DateTime?                @map("decided_at") @db.Timestamptz(6)
  decidedById    BigInt?                  @map("decided_by")
  decisionNote   String?                  @map("decision_note")
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById    BigInt                   @map("created_by")
  updatedAt      DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById    BigInt?                  @map("updated_by")
  rowVersion     Int                      @default(1) @map("row_version")

  factory   Factory                  @relation("ErpPurchaseRequestFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_purchase_requests__factory_id")
  decidedBy User?                    @relation("ErpPurchaseRequestDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_purchase_requests__decided_by")
  createdBy User                     @relation("ErpPurchaseRequestCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_purchase_requests__created_by")
  updatedBy User?                    @relation("ErpPurchaseRequestUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_purchase_requests__updated_by")
  lines     ErpPurchaseRequestLine[]
  rfqs      ErpRfq[]

  @@unique([factoryId, prNo], map: "ux_erp_purchase_requests__factory_id__pr_no")
  @@index([factoryId, status], map: "ix_erp_purchase_requests__factory_id__status")
  @@index([decidedById], map: "ix_erp_purchase_requests__decided_by")
  @@index([createdById], map: "ix_erp_purchase_requests__created_by")
  @@index([updatedById], map: "ix_erp_purchase_requests__updated_by")
  @@map("erp_purchase_requests")
}

model ErpPurchaseRequestLine {
  id                  BigInt    @id(map: "pk_erp_purchase_request_lines") @default(autoincrement())
  publicId            String    @unique(map: "ux_erp_purchase_request_lines__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  purchaseRequestId   BigInt    @map("purchase_request_id")
  lineNo              Int       @map("line_no")
  itemId              BigInt    @map("item_id")
  /// In the item's base unit.
  quantity            Decimal   @db.Decimal(14, 3)
  supplierId          BigInt?   @map("supplier_id")
  /// Per base unit, without VAT.
  estimatedUnitCost   Decimal?  @map("estimated_unit_cost") @db.Decimal(18, 6)
  neededBy            DateTime? @map("needed_by") @db.Date
  note                String?
  purchaseOrderLineId BigInt?   @map("purchase_order_line_id")

  purchaseRequest   ErpPurchaseRequest    @relation(fields: [purchaseRequestId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_purchase_request_lines__purchase_request_id")
  item              ErpItem               @relation(fields: [itemId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_purchase_request_lines__item_id")
  supplier          ErpTradingPartner?    @relation("ErpPurchaseRequestLineSupplier", fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_purchase_request_lines__supplier_id")
  purchaseOrderLine ErpPurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_purchase_request_lines__purchase_order_line_id")

  @@unique([purchaseRequestId, lineNo], map: "ux_erp_purchase_request_lines__purchase_request_id__line_no")
  @@index([itemId], map: "ix_erp_purchase_request_lines__item_id")
  @@index([supplierId], map: "ix_erp_purchase_request_lines__supplier_id")
  @@index([purchaseOrderLineId], map: "ix_erp_purchase_request_lines__purchase_order_line_id")
  @@map("erp_purchase_request_lines")
}

/// D-337: a supplier's invoice, matched against what was ordered and received (3-way).
model ErpSupplierInvoice {
  id              BigInt                   @id(map: "pk_erp_supplier_invoices") @default(autoincrement())
  publicId        String                   @unique(map: "ux_erp_supplier_invoices__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  factoryId       BigInt                   @map("factory_id")
  docNo           String                   @map("doc_no")
  supplierId      BigInt                   @map("supplier_id")
  purchaseOrderId BigInt?                  @map("purchase_order_id")
  invoiceNo       String                   @map("invoice_no")
  /// The supplier's tax invoice (input VAT), when it is one.
  taxInvoiceNo    String?                  @map("tax_invoice_no")
  invoiceDate     DateTime                 @map("invoice_date") @db.Date
  dueDate         DateTime                 @map("due_date") @db.Date
  vatMode         ErpVatMode               @default(exclusive) @map("vat_mode")
  vatRatePct      Decimal                  @default(7) @map("vat_rate_pct") @db.Decimal(7, 4)
  subtotal        Decimal                  @db.Decimal(14, 2)
  vatAmount       Decimal                  @map("vat_amount") @db.Decimal(14, 2)
  total           Decimal                  @db.Decimal(14, 2)
  whtRatePct      Decimal                  @default(0) @map("wht_rate_pct") @db.Decimal(7, 4)
  whtAmount       Decimal                  @default(0) @map("wht_amount") @db.Decimal(14, 2)
  /// total − WHT: what is paid to the supplier.
  payableAmount   Decimal                  @map("payable_amount") @db.Decimal(14, 2)
  paidAmount      Decimal                  @default(0) @map("paid_amount") @db.Decimal(14, 2)
  status          ErpSupplierInvoiceStatus
  matchNote       String?                  @map("match_note")
  note            String?
  fileId          BigInt?                  @map("file_id")
  approvedAt      DateTime?                @map("approved_at") @db.Timestamptz(6)
  approvedById    BigInt?                  @map("approved_by")
  cancelReason    String?                  @map("cancel_reason")
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById     BigInt                   @map("created_by")
  updatedAt       DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion      Int                      @default(1) @map("row_version")

  factory       Factory                  @relation("ErpSupplierInvoiceFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_supplier_invoices__factory_id")
  supplier      ErpTradingPartner        @relation("ErpSupplierInvoiceSupplier", fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_supplier_invoices__supplier_id")
  purchaseOrder ErpPurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_supplier_invoices__purchase_order_id")
  file          FileObject?              @relation("ErpSupplierInvoiceFile", fields: [fileId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_supplier_invoices__file_id")
  approvedBy    User?                    @relation("ErpSupplierInvoiceApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_supplier_invoices__approved_by")
  createdBy     User                     @relation("ErpSupplierInvoiceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_supplier_invoices__created_by")
  lines         ErpSupplierInvoiceLine[]
  allocations   ErpPaymentAllocation[]

  @@unique([factoryId, docNo], map: "ux_erp_supplier_invoices__factory_id__doc_no")
  @@unique([supplierId, invoiceNo], map: "ux_erp_supplier_invoices__supplier_id__invoice_no")
  @@index([factoryId, status, dueDate], map: "ix_erp_supplier_invoices__factory_id__status__due_date")
  @@index([purchaseOrderId], map: "ix_erp_supplier_invoices__purchase_order_id")
  @@index([fileId], map: "ix_erp_supplier_invoices__file_id")
  @@index([approvedById], map: "ix_erp_supplier_invoices__approved_by")
  @@index([createdById], map: "ix_erp_supplier_invoices__created_by")
  @@map("erp_supplier_invoices")
}

model ErpSupplierInvoiceLine {
  id                  BigInt   @id(map: "pk_erp_supplier_invoice_lines") @default(autoincrement())
  supplierInvoiceId   BigInt   @map("supplier_invoice_id")
  lineNo              Int      @map("line_no")
  purchaseOrderLineId BigInt?  @map("purchase_order_line_id")
  itemId              BigInt?  @map("item_id")
  description         String
  /// In the purchase-order line's unit (or the item's purchase unit).
  quantity            Decimal  @db.Decimal(14, 3)
  unitPrice           Decimal  @map("unit_price") @db.Decimal(18, 6)
  amount              Decimal  @db.Decimal(14, 2)
  /// Received but not yet invoiced at matching time.
  receivedQty         Decimal? @map("received_qty") @db.Decimal(14, 3)
  orderedPrice        Decimal? @map("ordered_price") @db.Decimal(18, 6)
  variance            String?

  supplierInvoice   ErpSupplierInvoice    @relation(fields: [supplierInvoiceId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_supplier_invoice_lines__supplier_invoice_id")
  purchaseOrderLine ErpPurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_supplier_invoice_lines__purchase_order_line_id")
  item              ErpItem?              @relation(fields: [itemId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_supplier_invoice_lines__item_id")

  @@unique([supplierInvoiceId, lineNo], map: "ux_erp_supplier_invoice_lines__supplier_invoice_id__line_no")
  @@index([purchaseOrderLineId], map: "ix_erp_supplier_invoice_lines__purchase_order_line_id")
  @@index([itemId], map: "ix_erp_supplier_invoice_lines__item_id")
  @@map("erp_supplier_invoice_lines")
}

/// D-338: money paid to a supplier, allocated to its invoices; append-only.
model ErpSupplierPayment {
  id          BigInt           @id(map: "pk_erp_supplier_payments") @default(autoincrement())
  publicId    String           @unique(map: "ux_erp_supplier_payments__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  factoryId   BigInt           @map("factory_id")
  paymentNo   String           @map("payment_no")
  supplierId  BigInt           @map("supplier_id")
  paidOn      DateTime         @map("paid_on") @db.Date
  method      ErpPaymentMethod
  reference   String?
  /// Negative on a reversal (D-338): a payment is never edited, a wrong one is reversed.
  amount      Decimal          @db.Decimal(14, 2)
  reversesId  BigInt?          @unique(map: "ux_erp_supplier_payments__reverses_id") @map("reverses_id")
  note        String?
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById BigInt           @map("created_by")

  factory         Factory                @relation("ErpSupplierPaymentFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_supplier_payments__factory_id")
  supplier        ErpTradingPartner      @relation("ErpSupplierPaymentSupplier", fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_supplier_payments__supplier_id")
  createdBy       User                   @relation("ErpSupplierPaymentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_supplier_payments__created_by")
  allocations     ErpPaymentAllocation[]
  reverses        ErpSupplierPayment?    @relation("ErpSupplierPaymentReversal", fields: [reversesId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_supplier_payments__reverses_id")
  reversedBy      ErpSupplierPayment?    @relation("ErpSupplierPaymentReversal")
  whtCertificates ErpWhtCertificate[]    @relation("ErpWhtCertificatePayment")

  @@unique([factoryId, paymentNo], map: "ux_erp_supplier_payments__factory_id__payment_no")
  @@index([supplierId], map: "ix_erp_supplier_payments__supplier_id")
  @@index([createdById], map: "ix_erp_supplier_payments__created_by")
  @@map("erp_supplier_payments")
}

model ErpPaymentAllocation {
  id                BigInt  @id(map: "pk_erp_payment_allocations") @default(autoincrement())
  paymentId         BigInt  @map("payment_id")
  supplierInvoiceId BigInt  @map("supplier_invoice_id")
  amount            Decimal @db.Decimal(14, 2)

  payment         ErpSupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_payment_allocations__payment_id")
  supplierInvoice ErpSupplierInvoice @relation(fields: [supplierInvoiceId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_payment_allocations__supplier_invoice_id")

  @@unique([paymentId, supplierInvoiceId], map: "ux_erp_payment_allocations__payment_id__supplier_invoice_id")
  @@index([supplierInvoiceId], map: "ix_erp_payment_allocations__supplier_invoice_id")
  @@map("erp_payment_allocations")
}

/// D-339: how a product is made — materials per batch and the steps on the factory's machines.
model ErpRecipe {
  id          BigInt          @id(map: "pk_erp_recipes") @default(autoincrement())
  publicId    String          @unique(map: "ux_erp_recipes__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  factoryId   BigInt          @map("factory_id")
  itemId      BigInt          @map("item_id")
  name        String
  /// Base units of the product one batch of the recipe makes.
  batchQty    Decimal         @default(1) @map("batch_qty") @db.Decimal(14, 3)
  note        String?
  status      ErpRecordStatus @default(active)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById BigInt          @map("created_by")
  updatedAt   DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById BigInt?         @map("updated_by")
  rowVersion  Int             @default(1) @map("row_version")

  factory             Factory              @relation("ErpRecipeFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_recipes__factory_id")
  item                ErpItem              @relation("ErpRecipeItem", fields: [itemId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_recipes__item_id")
  createdBy           User                 @relation("ErpRecipeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_recipes__created_by")
  updatedBy           User?                @relation("ErpRecipeUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_recipes__updated_by")
  materials           ErpRecipeMaterial[]
  operations          ErpRecipeOperation[]
  erpProductionOrders ErpProductionOrder[]

  @@index([factoryId, status], map: "ix_erp_recipes__factory_id__status")
  @@index([itemId], map: "ix_erp_recipes__item_id")
  @@index([createdById], map: "ix_erp_recipes__created_by")
  @@index([updatedById], map: "ix_erp_recipes__updated_by")
  @@map("erp_recipes")
}

model ErpRecipeMaterial {
  id       BigInt  @id(map: "pk_erp_recipe_materials") @default(autoincrement())
  recipeId BigInt  @map("recipe_id")
  lineNo   Int     @map("line_no")
  itemId   BigInt  @map("item_id")
  /// Base units of the material per batch.
  quantity Decimal @db.Decimal(14, 6)
  scrapPct Decimal @default(0) @map("scrap_pct") @db.Decimal(7, 4)

  recipe ErpRecipe @relation(fields: [recipeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_recipe_materials__recipe_id")
  item   ErpItem   @relation("ErpRecipeMaterialItem", fields: [itemId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_recipe_materials__item_id")

  @@unique([recipeId, lineNo], map: "ux_erp_recipe_materials__recipe_id__line_no")
  @@index([itemId], map: "ix_erp_recipe_materials__item_id")
  @@map("erp_recipe_materials")
}

model ErpRecipeOperation {
  id             BigInt   @id(map: "pk_erp_recipe_operations") @default(autoincrement())
  recipeId       BigInt   @map("recipe_id")
  seq            Int
  name           String
  machineId      BigInt?  @map("machine_id")
  setupMinutes   Int      @default(0) @map("setup_minutes")
  /// Base units of the product per hour on this step.
  runRatePerHour Decimal? @map("run_rate_per_hour") @db.Decimal(14, 3)

  recipe  ErpRecipe       @relation(fields: [recipeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_recipe_operations__recipe_id")
  machine FactoryMachine? @relation("ErpRecipeOperationMachine", fields: [machineId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_recipe_operations__machine_id")

  @@unique([recipeId, seq], map: "ux_erp_recipe_operations__recipe_id__seq")
  @@index([machineId], map: "ix_erp_recipe_operations__machine_id")
  @@map("erp_recipe_operations")
}

/// D-340: a production order — a Packio job, or the factory's own (for stock or a sales order).
model ErpProductionOrder {
  id              BigInt              @id(map: "pk_erp_production_orders") @default(autoincrement())
  publicId        String              @unique(map: "ux_erp_production_orders__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  factoryId       BigInt              @map("factory_id")
  moNo            String              @map("mo_no")
  source          ErpProductionSource
  productionJobId BigInt?             @map("production_job_id")
  itemId          BigInt?             @map("item_id")
  recipeId        BigInt?             @map("recipe_id")
  title           String
  quantity        Decimal             @db.Decimal(14, 3)
  unit            String
  dueOn           DateTime?           @map("due_on") @db.Date
  plannedStartOn  DateTime?           @map("planned_start_on") @db.Date
  priority        Int                 @default(0)
  warehouseId     BigInt              @map("warehouse_id")
  status          ErpProductionStatus @default(planned)
  goodQty         Decimal             @default(0) @map("good_qty") @db.Decimal(14, 3)
  scrapQty        Decimal             @default(0) @map("scrap_qty") @db.Decimal(14, 3)
  note            String?
  releasedAt      DateTime?           @map("released_at") @db.Timestamptz(6)
  completedAt     DateTime?           @map("completed_at") @db.Timestamptz(6)
  cancelReason    String?             @map("cancel_reason")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById     BigInt?             @map("created_by")
  updatedAt       DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById     BigInt?             @map("updated_by")
  rowVersion      Int                 @default(1) @map("row_version")

  factory        Factory                  @relation("ErpProductionOrderFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_production_orders__factory_id")
  productionJob  ProductionJob?           @relation("ErpProductionOrderJob", fields: [productionJobId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_production_orders__production_job_id")
  item           ErpItem?                 @relation("ErpProductionOrderItem", fields: [itemId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_production_orders__item_id")
  recipe         ErpRecipe?               @relation(fields: [recipeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_production_orders__recipe_id")
  warehouse      ErpWarehouse             @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_production_orders__warehouse_id")
  createdBy      User?                    @relation("ErpProductionOrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_production_orders__created_by")
  updatedBy      User?                    @relation("ErpProductionOrderUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_production_orders__updated_by")
  materials      ErpProductionMaterial[]
  operations     ErpProductionOperation[]
  salesOrderLine ErpSalesOrderLine?       @relation("ErpSalesOrderLineProduction")

  @@unique([factoryId, moNo], map: "ux_erp_production_orders__factory_id__mo_no")
  @@unique([productionJobId], map: "ux_erp_production_orders__production_job_id")
  @@index([factoryId, status, dueOn], map: "ix_erp_production_orders__factory_id__status__due_on")
  @@index([itemId], map: "ix_erp_production_orders__item_id")
  @@index([recipeId], map: "ix_erp_production_orders__recipe_id")
  @@index([warehouseId], map: "ix_erp_production_orders__warehouse_id")
  @@index([createdById], map: "ix_erp_production_orders__created_by")
  @@index([updatedById], map: "ix_erp_production_orders__updated_by")
  @@map("erp_production_orders")
}

model ErpProductionMaterial {
  id                BigInt  @id(map: "pk_erp_production_materials") @default(autoincrement())
  publicId          String  @unique(map: "ux_erp_production_materials__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  productionOrderId BigInt  @map("production_order_id")
  lineNo            Int     @map("line_no")
  itemId            BigInt  @map("item_id")
  /// Base units.
  requiredQty       Decimal @map("required_qty") @db.Decimal(14, 3)
  reservedQty       Decimal @default(0) @map("reserved_qty") @db.Decimal(14, 3)
  issuedQty         Decimal @default(0) @map("issued_qty") @db.Decimal(14, 3)
  /// `recipe`, `packio_spec` or `manual`.
  origin            String
  note              String?

  productionOrder ErpProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_production_materials__production_order_id")
  item            ErpItem            @relation("ErpProductionMaterialItem", fields: [itemId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_production_materials__item_id")

  @@unique([productionOrderId, lineNo], map: "ux_erp_production_materials__production_order_id__line_no")
  @@index([itemId], map: "ix_erp_production_materials__item_id")
  @@map("erp_production_materials")
}

model ErpProductionOperation {
  id                BigInt             @id(map: "pk_erp_production_operations") @default(autoincrement())
  publicId          String             @unique(map: "ux_erp_production_operations__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  productionOrderId BigInt             @map("production_order_id")
  seq               Int
  name              String
  machineId         BigInt?            @map("machine_id")
  plannedMinutes    Int                @default(0) @map("planned_minutes")
  status            ErpOperationStatus @default(pending)
  goodQty           Decimal            @default(0) @map("good_qty") @db.Decimal(14, 3)
  scrapQty          Decimal            @default(0) @map("scrap_qty") @db.Decimal(14, 3)

  productionOrder    ErpProductionOrder  @relation(fields: [productionOrderId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_production_operations__production_order_id")
  machine            FactoryMachine?     @relation("ErpProductionOperationMachine", fields: [machineId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_production_operations__machine_id")
  /// D-352: the planned slot on its machine; `locked` keeps auto-planning off it.
  scheduledStart     DateTime?           @map("scheduled_start") @db.Timestamptz(6)
  scheduledEnd       DateTime?           @map("scheduled_end") @db.Timestamptz(6)
  locked             Boolean             @default(false)
  /// D-353: actual times; paused minutes add up across pauses.
  startedAt          DateTime?           @map("started_at") @db.Timestamptz(6)
  finishedAt         DateTime?           @map("finished_at") @db.Timestamptz(6)
  pausedAt           DateTime?           @map("paused_at") @db.Timestamptz(6)
  pausedMinutes      Int                 @default(0) @map("paused_minutes")
  /// D-354: the Packio job milestone it stands for.
  jobMilestoneId     BigInt?             @unique(map: "ux_erp_production_operations__job_milestone_id") @map("job_milestone_id")
  milestoneSync      ErpMilestoneSync    @default(none) @map("milestone_sync")
  milestoneSyncError String?             @map("milestone_sync_error")
  jobMilestone       JobMilestone?       @relation("ErpProductionOperationMilestone", fields: [jobMilestoneId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_production_operations__job_milestone_id")
  events             ErpOperationEvent[]

  @@unique([productionOrderId, seq], map: "ux_erp_production_operations__production_order_id__seq")
  @@index([machineId, scheduledStart], map: "ix_erp_production_operations__machine_id__scheduled_start")
  @@map("erp_production_operations")
}
