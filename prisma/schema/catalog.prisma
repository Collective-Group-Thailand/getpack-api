// Catalogue & CMS context (docs/schema-design.md §3.3, B2.1). The platform catalogue is what a
// customer can choose: no prices and no factory_id (D-044, D-050). Factory buy prices reference these
// rows from the partners context (§3.4). Check constraints, the option-kind trigger and the append-only
// stock ledger are hand-written in the migration SQL.

// ------------------------------------------------------------------------------------------------
// Enums
// ------------------------------------------------------------------------------------------------

enum CatalogStatus {
  draft
  active
  inactive
  archived

  @@map("catalog_status")
}

enum QuoteMode {
  instant
  rfq

  @@map("quote_mode")
}

enum CalculatorKey {
  folding
  corrugate
  label
  tag_sleeve
  pouch
  standard_product
  service

  @@map("calculator_key")
}

enum TemplateAvailability {
  none
  online_template
  drawing

  @@map("template_availability")
}

enum CatalogOptionKind {
  material
  finish
  coating
  ink_colour
  diecut
  assembly
  print_type
  print_side
  pattern
  process

  @@map("catalog_option_kind")
}

enum MaterialKind {
  paper
  board
  corrugated_board
  film
  foil
  label_stock
  other

  @@map("material_kind")
}

enum FinishKind {
  coating
  lamination
  foil
  emboss
  deboss
  spot_uv
  window
  other

  @@map("finish_kind")
}

/// Not in the §4 catalogue; named in §3.3 `ink_colours.colour_kind` (schema-design §7 A-19).
enum InkColourKind {
  process
  spot
  white
  metallic

  @@map("ink_colour_kind")
}

enum StockAttribute {
  material
  type
  sub_type
  shape
  shoulder
  neck
  colour
  size_text
  cap_type

  @@map("stock_attribute")
}

enum ProductUnit {
  piece
  box
  pouch
  tube
  set
  job
  round
  trip

  @@map("product_unit")
}

enum StockMovementKind {
  receipt
  reservation
  release
  shipment
  adjustment

  @@map("stock_movement_kind")
}

enum BannerPosition {
  home_hero
  home_strip
  category
  popup

  @@map("banner_position")
}

enum HomeSectionKind {
  product_types
  catalog_products
  showcase
  articles
  banner
  custom

  @@map("home_section_kind")
}

enum ContentStatus {
  draft
  published
  archived

  @@map("content_status")
}

enum VideoProvider {
  youtube
  vimeo
  file

  @@map("video_provider")
}

/// What a video belongs to (`videos.subject_type`, schema-design §7 A-19).
enum VideoSubject {
  catalog_product
  showcase_product
  stock_product
  article

  @@map("video_subject")
}

// ------------------------------------------------------------------------------------------------
// Product structure
// ------------------------------------------------------------------------------------------------

/// Packio reporting categories (replace legacy PH1–PH6, D-030).
model ProductCategory {
  id          BigInt        @id(map: "pk_product_categories") @default(autoincrement())
  publicId    String        @unique(map: "ux_product_categories__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  code        String        @unique(map: "ux_product_categories__code")
  nameTh      String        @map("name_th")
  nameEn      String        @map("name_en")
  parentId    BigInt?       @map("parent_id")
  sort        Int           @default(0)
  status      CatalogStatus @default(draft)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById BigInt?       @map("created_by")
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById BigInt?       @map("updated_by")
  rowVersion  Int           @default(1) @map("row_version")

  parent       ProductCategory?  @relation("ProductCategoryParent", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_product_categories__parent_id")
  children     ProductCategory[] @relation("ProductCategoryParent")
  productTypes ProductType[]
  createdBy    User?             @relation("ProductCategoryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_product_categories__created_by")
  updatedBy    User?             @relation("ProductCategoryUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_product_categories__updated_by")

  @@index([parentId], map: "ix_product_categories__parent_id")
  @@map("product_categories")
}

/// D-100: the 7 instant types + RFQ categories. Whether a configuration is actually instant is
/// resolved at runtime from factory participations (D-043), not stored.
model ProductType {
  id                   BigInt         @id(map: "pk_product_types") @default(autoincrement())
  publicId             String         @unique(map: "ux_product_types__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  code                 String         @unique(map: "ux_product_types__code")
  categoryId           BigInt         @map("category_id")
  nameTh               String         @map("name_th")
  nameEn               String         @map("name_en")
  quoteMode            QuoteMode      @default(rfq) @map("quote_mode")
  calculatorKey        CalculatorKey? @map("calculator_key")
  isFoodContactDefault Boolean        @default(false) @map("is_food_contact_default")
  rfqSpecSchema        Json?          @map("rfq_spec_schema")
  sort                 Int            @default(0)
  status               CatalogStatus  @default(draft)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById          BigInt?        @map("created_by")
  updatedAt            DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById          BigInt?        @map("updated_by")
  rowVersion           Int            @default(1) @map("row_version")

  category        ProductCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_product_types__category_id")
  printTypes      PrintType[]
  catalogProducts CatalogProduct[]
  patterns        Pattern[]
  specTitles      SpecTitle[]
  stockProducts   StockProduct[]
  createdBy       User?            @relation("ProductTypeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_product_types__created_by")
  updatedBy       User?            @relation("ProductTypeUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_product_types__updated_by")

  // --- Partners (generated back-relations)
  factoryCapabilities      FactoryCapability[]       @relation("FactoryCapabilityProductType")
  factoryCapabilityItems   FactoryCapabilityItem[]   @relation("FactoryCapabilityItemProductType")
  factoryParticipations    FactoryParticipation[]    @relation("FactoryParticipationProductType")
  factoryCapacities        FactoryCapacity[]         @relation("FactoryCapacityProductType")
  factoryCapacityOverrides FactoryCapacityOverride[] @relation("FactoryCapacityOverrideProductType")
  capacityBookings         CapacityBooking[]         @relation("CapacityBookingProductType")
  factoryTolerancePolicies FactoryTolerancePolicy[]  @relation("FactoryTolerancePolicyProductType")
  priceLists               PriceList[]               @relation("PriceListProductType")
  // --- end Partners
  // --- Pricing (generated back-relations)
  sellMarginTables         SellMarginTable[]         @relation("SellMarginTableProductType")
  calculateLogs            CalculateLog[]            @relation("CalculateLogProductType")
  // --- end Pricing

  // --- Quotes & RFQ (generated back-relations)
  quotes             Quote[]             @relation("QuoteProductType")
  rfqs               Rfq[]               @relation("RfqProductType")
  unmetDemandRecords UnmetDemandRecord[] @relation("UnmetDemandProductType")

  // --- end Quotes & RFQ
  orders Order[] @relation("OrderProductType")

  // --- Fulfilment B4.2 (generated back-relations)
  milestoneRoutes MilestoneRoute[] @relation("MilestoneRouteProductType")
  // --- end Fulfilment B4.2

  @@index([categoryId], map: "ix_product_types__category_id")
  @@map("product_types")
}

model PrintType {
  id                   BigInt        @id(map: "pk_print_types") @default(autoincrement())
  publicId             String        @unique(map: "ux_print_types__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  code                 String        @unique(map: "ux_print_types__code")
  productTypeId        BigInt        @map("product_type_id")
  nameTh               String        @map("name_th")
  nameEn               String        @map("name_en")
  /// Legacy "print types that can charge plate + diecut".
  canChargePlateAndDie Boolean       @default(false) @map("can_charge_plate_and_die")
  sort                 Int           @default(0)
  status               CatalogStatus @default(draft)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById          BigInt?       @map("created_by")
  updatedAt            DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById          BigInt?       @map("updated_by")
  rowVersion           Int           @default(1) @map("row_version")

  productType ProductType @relation(fields: [productTypeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_print_types__product_type_id")
  createdBy   User?       @relation("PrintTypeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_print_types__created_by")
  updatedBy   User?       @relation("PrintTypeUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_print_types__updated_by")

  // --- Partners (generated back-relations)
  factoryCapabilities          FactoryCapability[]  @relation("FactoryCapabilityPrintType")
  factoryMachines              FactoryMachine[]     @relation("FactoryMachinePrintType")
  // --- end Partners
  // --- Pricing (generated back-relations)
  sellMarginTables             SellMarginTable[]    @relation("SellMarginTablePrintType")
  // --- end Pricing
  // --- Folding price components (B2.3)
  plPrintTypeTerms             PlPrintTypeTerm[]    @relation("PlPrintTypeTermPrintType")
  plPaperTrims                 PlPaperTrim[]        @relation("PlPaperTrimPrintType")
  plMaterialPrices             PlMaterialPrice[]    @relation("PlMaterialPricePrintType")
  plPaperSizes                 PlPaperSize[]        @relation("PlPaperSizePrintType")
  plInkColoursPrintType        PlInkColour[]        @relation("PlInkColourPrintType")
  plPrintWastesPrintType       PlPrintWaste[]       @relation("PlPrintWastePrintType")
  plFinishWastesPrintType      PlFinishWaste[]      @relation("PlFinishWastePrintType")
  plDiecutWastesPrintType      PlDiecutWaste[]      @relation("PlDiecutWastePrintType")
  plAssemblyWastesPrintType    PlAssemblyWaste[]    @relation("PlAssemblyWastePrintType")
  plPrintPlatesPrintType       PlPrintPlate[]       @relation("PlPrintPlatePrintType")
  plPrintPricesPrintType       PlPrintPrice[]       @relation("PlPrintPricePrintType")
  plFinishPricesPrintType      PlFinishPrice[]      @relation("PlFinishPricePrintType")
  plFinishPlatesPrintType      PlFinishPlate[]      @relation("PlFinishPlatePrintType")
  plDiecutPricesPrintType      PlDiecutPrice[]      @relation("PlDiecutPricePrintType")
  plDiecutBlockPricesPrintType PlDiecutBlockPrice[] @relation("PlDiecutBlockPricePrintType")
  plAssemblyPricesPrintType    PlAssemblyPrice[]    @relation("PlAssemblyPricePrintType")
  // --- end Folding price components

  // --- Fulfilment B4.2 (generated back-relations)
  milestoneRoutes MilestoneRoute[] @relation("MilestoneRoutePrintType")
  // --- end Fulfilment B4.2

  @@index([productTypeId], map: "ix_print_types__product_type_id")
  @@map("print_types")
}

/// The customer-facing product (legacy `mapping_inputs`, e.g. "กล่องฝาเสียบ").
model CatalogProduct {
  id                   BigInt               @id(map: "pk_catalog_products") @default(autoincrement())
  publicId             String               @unique(map: "ux_catalog_products__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  productTypeId        BigInt               @map("product_type_id")
  slug                 String               @unique(map: "ux_catalog_products__slug")
  nameTh               String               @map("name_th")
  nameEn               String               @map("name_en")
  descriptionTh        String?              @map("description_th")
  descriptionEn        String?              @map("description_en")
  isCombination        Boolean              @default(false) @map("is_combination")
  templateAvailability TemplateAvailability @default(none) @map("template_availability")
  videoUrl             String?              @map("video_url")
  seoPageId            BigInt?              @map("seo_page_id")
  sort                 Int                  @default(0)
  status               CatalogStatus        @default(draft)
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById          BigInt?              @map("created_by")
  updatedAt            DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById          BigInt?              @map("updated_by")
  rowVersion           Int                  @default(1) @map("row_version")

  productType       ProductType             @relation(fields: [productTypeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_catalog_products__product_type_id")
  seoPage           SeoPage?                @relation(fields: [seoPageId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_catalog_products__seo_page_id")
  patterns          CatalogProductPattern[]
  options           CatalogProductOption[]
  images            CatalogProductImage[]
  standardSizes     StandardSize[]
  showcaseProducts  ShowcaseProduct[]
  semiDesigns       SemiDesign[]
  productEmbeddings ProductEmbedding[]
  createdBy         User?                   @relation("CatalogProductCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_catalog_products__created_by")
  updatedBy         User?                   @relation("CatalogProductUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_catalog_products__updated_by")
  // --- Pricing (generated back-relations)
  calculateLogs     CalculateLog[]          @relation("CalculateLogCatalogProduct")
  // --- end Pricing

  // --- Quotes & RFQ (generated back-relations)
  quotes Quote[] @relation("QuoteCatalogProduct")

  // --- end Quotes & RFQ
  orders Order[] @relation("OrderCatalogProduct")

  // --- Fulfilment B4.1 (generated back-relations)
  designDocuments DesignDocument[] @relation("DesignDocumentCatalogProduct")
  // --- end Fulfilment B4.1

  @@index([productTypeId], map: "ix_catalog_products__product_type_id")
  @@index([seoPageId], map: "ix_catalog_products__seo_page_id")
  @@index([nameTh(ops: raw("gin_trgm_ops"))], type: Gin, map: "ix_catalog_products__name_th_trgm")
  @@index([nameEn(ops: raw("gin_trgm_ops"))], type: Gin, map: "ix_catalog_products__name_en_trgm")
  @@map("catalog_products")
}

/// Legacy `mapping_input_rel_patterns` (factors indicative, fixed by the calculator ports, B2.3).
model CatalogProductPattern {
  id               BigInt   @id(map: "pk_catalog_product_patterns") @default(autoincrement())
  catalogProductId BigInt   @map("catalog_product_id")
  patternId        BigInt   @map("pattern_id")
  factorNw         Decimal? @map("factor_nw") @db.Decimal(10, 4)
  factorNl         Decimal? @map("factor_nl") @db.Decimal(10, 4)
  factorNd         Decimal? @map("factor_nd") @db.Decimal(10, 4)
  sort             Int      @default(0)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById      BigInt?  @map("created_by")

  catalogProduct CatalogProduct @relation(fields: [catalogProductId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_catalog_product_patterns__catalog_product_id")
  pattern        Pattern        @relation(fields: [patternId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_catalog_product_patterns__pattern_id")
  createdBy      User?          @relation("CatalogProductPatternCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_catalog_product_patterns__created_by")

  @@unique([catalogProductId, patternId], map: "ux_catalog_product_patterns__catalog_product_id__pattern_id")
  @@index([patternId], map: "ix_catalog_product_patterns__pattern_id")
  @@map("catalog_product_patterns")
}

/// Which catalogue items a product offers. `option_id` points at the table named by `option_kind`
/// (checked by trigger `tg_catalog_product_options__option_fk`).
model CatalogProductOption {
  id               BigInt            @id(map: "pk_catalog_product_options") @default(autoincrement())
  catalogProductId BigInt            @map("catalog_product_id")
  optionKind       CatalogOptionKind @map("option_kind")
  optionId         BigInt            @map("option_id")
  isDefault        Boolean           @default(false) @map("is_default")
  sort             Int               @default(0)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById      BigInt?           @map("created_by")

  catalogProduct CatalogProduct @relation(fields: [catalogProductId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_catalog_product_options__catalog_product_id")
  createdBy      User?          @relation("CatalogProductOptionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_catalog_product_options__created_by")

  @@unique([catalogProductId, optionKind, optionId], map: "ux_catalog_product_options__product__kind__option")
  @@index([optionKind, optionId], map: "ix_catalog_product_options__kind__option")
  @@map("catalog_product_options")
}

/// Image galleries (legacy imagesets); `variant` says which material/colour/combination the image shows.
model CatalogProductImage {
  id               BigInt   @id(map: "pk_catalog_product_images") @default(autoincrement())
  publicId         String   @unique(map: "ux_catalog_product_images__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  catalogProductId BigInt   @map("catalog_product_id")
  fileObjectId     BigInt   @map("file_object_id")
  variant          Json?
  sort             Int      @default(0)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById      BigInt?  @map("created_by")

  catalogProduct CatalogProduct @relation(fields: [catalogProductId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_catalog_product_images__catalog_product_id")
  fileObject     FileObject     @relation("CatalogProductImageFile", fields: [fileObjectId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_catalog_product_images__file_object_id")
  createdBy      User?          @relation("CatalogProductImageCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_catalog_product_images__created_by")

  @@index([catalogProductId, sort], map: "ix_catalog_product_images__catalog_product_id__sort")
  @@index([fileObjectId], map: "ix_catalog_product_images__file_object_id")
  @@map("catalog_product_images")
}

model StandardSize {
  id               BigInt        @id(map: "pk_standard_sizes") @default(autoincrement())
  publicId         String        @unique(map: "ux_standard_sizes__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  catalogProductId BigInt        @map("catalog_product_id")
  code             String
  name             String
  lengthMm         Decimal       @map("length_mm") @db.Decimal(10, 2)
  widthMm          Decimal       @map("width_mm") @db.Decimal(10, 2)
  heightMm         Decimal       @map("height_mm") @db.Decimal(10, 2)
  /// Legacy `*_for_calculate`.
  calcLengthMm     Decimal?      @map("calc_length_mm") @db.Decimal(10, 2)
  calcWidthMm      Decimal?      @map("calc_width_mm") @db.Decimal(10, 2)
  calcHeightMm     Decimal?      @map("calc_height_mm") @db.Decimal(10, 2)
  sort             Int           @default(0)
  status           CatalogStatus @default(draft)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById      BigInt?       @map("created_by")
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById      BigInt?       @map("updated_by")
  rowVersion       Int           @default(1) @map("row_version")

  catalogProduct      CatalogProduct         @relation(fields: [catalogProductId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_standard_sizes__catalog_product_id")
  semiDesignTemplates SemiDesignTemplate[]
  createdBy           User?                  @relation("StandardSizeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_standard_sizes__created_by")
  updatedBy           User?                  @relation("StandardSizeUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_standard_sizes__updated_by")
  standardBlanks      PatternStandardBlank[]

  @@unique([catalogProductId, code], map: "ux_standard_sizes__catalog_product_id__code")
  @@map("standard_sizes")
}

/// `pattern_kind` and `constraints` are indicative (schema-design §0): validated by the calculator ports.
model Pattern {
  id              BigInt           @id(map: "pk_patterns") @default(autoincrement())
  publicId        String           @unique(map: "ux_patterns__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  productTypeId   BigInt           @map("product_type_id")
  code            String           @unique(map: "ux_patterns__code")
  name            String
  technicalName   String?          @map("technical_name")
  patternKind     Int?             @map("pattern_kind") @db.SmallInt
  /// min/max w/l/h/b/s/cs/dl/dw, required_x/c (legacy `pattern` size constraints).
  constraints     Json             @default("{}")
  /// Key understood by `@packio/dieline`.
  dielineKey      String?          @map("dieline_key")
  /// Blank formula of the folding calculator (B2.3, schema-design A-25); null = not priceable.
  geometryFormula GeometryFormula? @map("geometry_formula")
  status          CatalogStatus    @default(draft)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById     BigInt?          @map("created_by")
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById     BigInt?          @map("updated_by")
  rowVersion      Int              @default(1) @map("row_version")

  productType         ProductType                @relation(fields: [productTypeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_patterns__product_type_id")
  subPatterns         SubPattern[]
  fluteTypes          PatternFluteType[]
  catalogProducts     CatalogProductPattern[]
  geometryConditions  PatternGeometryCondition[]
  standardBlanks      PatternStandardBlank[]
  createdBy           User?                      @relation("PatternCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_patterns__created_by")
  updatedBy           User?                      @relation("PatternUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_patterns__updated_by")
  // --- Folding price components (B2.3)
  plPatternConditions PlPatternCondition[]       @relation("PlPatternConditionPattern")
  // --- end Folding price components

  // --- Fulfilment B4.1 (generated back-relations)
  designDocuments DesignDocument[] @relation("DesignDocumentPattern")
  drawingJobs     DrawingJob[]     @relation("DrawingJobPattern")
  // --- end Fulfilment B4.1

  @@index([productTypeId], map: "ix_patterns__product_type_id")
  @@map("patterns")
}

/// Geometry factors and conditions are indicative (fixed by the calculator ports, B2.3).
model SubPattern {
  id              BigInt           @id(map: "pk_sub_patterns") @default(autoincrement())
  publicId        String           @unique(map: "ux_sub_patterns__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  patternId       BigInt           @map("pattern_id")
  seq             Int              @db.SmallInt
  name            String
  dl              Decimal?         @db.Decimal(10, 4)
  dw              Decimal?         @db.Decimal(10, 4)
  dh              Decimal?         @db.Decimal(10, 4)
  nl              Decimal?         @db.Decimal(10, 4)
  nw              Decimal?         @db.Decimal(10, 4)
  nh              Decimal?         @db.Decimal(10, 4)
  conditions      Json?
  /// Multi-part patterns: the part's own blank formula (legacy cases 31/32 by sub-pattern).
  geometryFormula GeometryFormula? @map("geometry_formula")
  /// The part is laid with its box turned (legacy sub-pattern 6: l ← w, w ← d, d ← l).
  swapDimensions  Boolean          @default(false) @map("swap_dimensions")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById     BigInt?          @map("created_by")
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById     BigInt?          @map("updated_by")
  rowVersion      Int              @default(1) @map("row_version")

  pattern             Pattern                    @relation(fields: [patternId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sub_patterns__pattern_id")
  geometryConditions  PatternGeometryCondition[]
  createdBy           User?                      @relation("SubPatternCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sub_patterns__created_by")
  updatedBy           User?                      @relation("SubPatternUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sub_patterns__updated_by")
  // --- Folding price components (B2.3)
  plPatternConditions PlPatternCondition[]       @relation("PlPatternConditionSubPattern")
  // --- end Folding price components

