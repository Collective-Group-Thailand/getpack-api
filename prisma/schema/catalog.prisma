  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById    BigInt?           @map("created_by")

  stockProduct StockProduct @relation(fields: [stockProductId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_stock_movements__stock_product_id")
