/// Grouping used by the material price index (D-040 group 1).
model MaterialFamily {
  id          BigInt        @id(map: "pk_material_families") @default(autoincrement())
  publicId    String        @unique(map: "ux_material_families__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  code        String        @unique(map: "ux_material_families__code")
  nameTh      String        @map("name_th")
  nameEn      String        @map("name_en")
  /// e.g. `THB/kg`, `THB/m2`.
  indexUnit   String        @map("index_unit")
  status      CatalogStatus @default(draft)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById BigInt?       @map("created_by")
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById BigInt?       @map("updated_by")
  rowVersion  Int           @default(1) @map("row_version")

  materials Material[]
  createdBy User?      @relation("MaterialFamilyCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_material_families__created_by")
  updatedBy User?      @relation("MaterialFamilyUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_material_families__updated_by")

  // --- Partners (generated back-relations)
  indexSerieses IndexSeries[] @relation("IndexSeriesMaterialFamily")
  // --- end Partners

  @@map("material_families")
}

/// Take-up factors are indicative (legacy `flute_type`, fixed by the corrugate port, B2.3).
model FluteType {
  id          BigInt        @id(map: "pk_flute_types") @default(autoincrement())
  publicId    String        @unique(map: "ux_flute_types__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  code        String        @unique(map: "ux_flute_types__code")
  name        String
  layers      Int           @db.SmallInt
  colA        Decimal?      @map("col_a") @db.Decimal(10, 4)
  colC        Decimal?      @map("col_c") @db.Decimal(10, 4)
  colDd       Decimal?      @map("col_dd") @db.Decimal(10, 4)
  colG        Decimal?      @map("col_g") @db.Decimal(10, 4)
  colFh       Decimal?      @map("col_fh") @db.Decimal(10, 4)
  z           Decimal?      @db.Decimal(10, 4)
  /// Board caliper allowance of a telescope lid (legacy `flute_type.ct`, corrugate port).
  ct          Decimal?      @db.Decimal(10, 4)
  status      CatalogStatus @default(draft)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById BigInt?       @map("created_by")
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById BigInt?       @map("updated_by")
  rowVersion  Int           @default(1) @map("row_version")

  materials                    Material[]
  patterns                     PatternFluteType[]
  standardSizesCalc            StandardSize[]                @relation("StandardSizeCalcFluteType")
  createdBy                    User?                         @relation("FluteTypeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_flute_types__created_by")
  updatedBy                    User?                         @relation("FluteTypeUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_flute_types__updated_by")
  // --- Corrugate price components (U-B6)
  plCorrugateProcessTerms      PlCorrugateProcessTerm[]      @relation("PlCorrugateProcessTermFluteType")
  plCorrugatePatternConditions PlCorrugatePatternCondition[] @relation("PlCorrugatePatternConditionFluteType")
  plCorrugateDieBlocks         PlCorrugateDieBlock[]         @relation("PlCorrugateDieBlockFluteType")
  // --- end Corrugate price components

  @@map("flute_types")
}

/// What the customer picks. `code` is the natural key for Excel import (schema-design §7 A-19).
model Material {
  id            BigInt        @id(map: "pk_materials") @default(autoincrement())
  publicId      String        @unique(map: "ux_materials__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  code          String        @unique(map: "ux_materials__code")
  kind          MaterialKind
  familyId      BigInt?       @map("family_id")
  nameTh        String        @map("name_th")
  nameEn        String        @map("name_en")
  gsm           Decimal?      @db.Decimal(8, 2)
  micron        Decimal?      @db.Decimal(8, 2)
  /// D-182: board thickness in mm (paperboard, corrugated board) for measurement-basis conversion; empty = unknown.
  caliperMm     Decimal?      @map("caliper_mm") @db.Decimal(6, 3)
  fluteTypeId   BigInt?       @map("flute_type_id")
  paperGroup    String?       @map("paper_group")
  insideColour  String?       @map("inside_colour")
  outsideColour String?       @map("outside_colour")
  strength      String?
  isFoodGrade   Boolean       @default(false) @map("is_food_grade")
  /// The board takes a coating (legacy `paper_grade.can_finish`, corrugate port).
  coatable      Boolean       @default(false)
  status        CatalogStatus @default(draft)
  descriptionTh String?       @map("description_th")
  descriptionEn String?       @map("description_en")
  imageFileId   BigInt?       @map("image_file_id")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById   BigInt?       @map("created_by")
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById   BigInt?       @map("updated_by")
  rowVersion    Int           @default(1) @map("row_version")

  family                      MaterialFamily?        @relation(fields: [familyId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_materials__family_id")
  fluteType                   FluteType?             @relation(fields: [fluteTypeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_materials__flute_type_id")
  createdBy                   User?                  @relation("MaterialCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_materials__created_by")
  updatedBy                   User?                  @relation("MaterialUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_materials__updated_by")
  imageFile                   FileObject?            @relation("MaterialImageFile", fields: [imageFileId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_materials__image_file_id")
  // --- Folding price components (B2.3)
  plMaterialPrices            PlMaterialPrice[]      @relation("PlMaterialPriceMaterial")
  plPouchMaterialPrices       PlPouchMaterialPrice[] @relation("PlPouchMaterialPriceMaterial")
  plPouchOptionRules          PlPouchOptionRule[]    @relation("PlPouchOptionRuleMaterial")
  plPaperSizes                PlPaperSize[]          @relation("PlPaperSizeMaterial")
  plProcessExclusionsMaterial PlProcessExclusion[]   @relation("PlProcessExclusionMaterial")
  plPrintPricesMaterial       PlPrintPrice[]         @relation("PlPrintPriceMaterial")
  // --- end Folding price components

  // --- Fulfilment B4.1 (generated back-relations)
  designDocuments        DesignDocument[]        @relation("DesignDocumentMaterial")
  // --- end Fulfilment B4.1
  // --- Corrugate price components (U-B6)
  plBoardPrices          PlBoardPrice[]          @relation("PlBoardPriceMaterial")
  plCorrugatePrintPrices PlCorrugatePrintPrice[] @relation("PlCorrugatePrintPriceMaterial")
  // --- end Corrugate price components

  boardStrengthSheets     BoardStrengthSheet[]     @relation("BoardStrengthSheetMaterial")
  advisoryRecommendations AdvisoryRecommendation[] @relation("AdvisoryRecommendationMaterial")
  advisoryChoices         AdvisoryChoice[]         @relation("AdvisoryChoiceMaterial")
  erpItems                ErpItem[]                @relation("ErpItemMaterial")

  @@index([familyId], map: "ix_materials__family_id")
  @@index([fluteTypeId], map: "ix_materials__flute_type_id")
  @@index([nameTh(ops: raw("gin_trgm_ops"))], type: Gin, map: "ix_materials__name_th_trgm")
  @@index([nameEn(ops: raw("gin_trgm_ops"))], type: Gin, map: "ix_materials__name_en_trgm")
  @@index([imageFileId], map: "ix_materials__image_file_id")
  @@map("materials")
}

