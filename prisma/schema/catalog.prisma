model GeometryCondition {
  id          BigInt              @id(map: "pk_geometry_conditions") @default(autoincrement())
  publicId    String              @unique(map: "ux_geometry_conditions__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  code        String              @unique(map: "ux_geometry_conditions__code")
  bandTableId BigInt              @map("band_table_id")
  /// Legacy variable name; only the lock-bottom formula reads it (`b`).
  variable    String
  determinant GeometryDeterminant
  status      CatalogStatus       @default(draft)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById BigInt?             @map("created_by")
  updatedAt   DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById BigInt?             @map("updated_by")
  rowVersion  Int                 @default(1) @map("row_version")

  bandTable GeometryBandTable          @relation(fields: [bandTableId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_geometry_conditions__band_table_id")
  patterns  PatternGeometryCondition[]
  createdBy User?                      @relation("GeometryConditionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_geometry_conditions__created_by")
  updatedBy User?                      @relation("GeometryConditionUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_geometry_conditions__updated_by")

  @@index([bandTableId], map: "ix_geometry_conditions__band_table_id")
  @@map("geometry_conditions")
}

/// Which conditions a pattern (or one of its parts) reads in each slot (legacy `pattern.condition_*`).
/// ux `(pattern_id, coalesce(sub_pattern_id, 0), slot, seq)` is an expression index (migration SQL).
model PatternGeometryCondition {
  id           BigInt       @id(map: "pk_pattern_geometry_conditions") @default(autoincrement())
  patternId    BigInt       @map("pattern_id")
  subPatternId BigInt?      @map("sub_pattern_id")
  slot         GeometrySlot
  seq          Int          @default(1) @db.SmallInt
  conditionId  BigInt       @map("condition_id")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById  BigInt?      @map("created_by")

  pattern    Pattern           @relation(fields: [patternId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_pattern_geometry_conditions__pattern_id")
  subPattern SubPattern?       @relation(fields: [subPatternId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_pattern_geometry_conditions__sub_pattern_id")
  condition  GeometryCondition @relation(fields: [conditionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_pattern_geometry_conditions__condition_id")
  createdBy  User?             @relation("PatternGeometryConditionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_pattern_geometry_conditions__created_by")

  @@index([patternId], map: "ix_pattern_geometry_conditions__pattern_id")
  @@index([subPatternId], map: "ix_pattern_geometry_conditions__sub_pattern_id")
  @@index([conditionId], map: "ix_pattern_geometry_conditions__condition_id")
  @@map("pattern_geometry_conditions")
}

/// The die-cut blank of a pattern at one standard size (legacy `pattern_rel_standard_sizes.dl/dw`).
model PatternStandardBlank {
  id             BigInt   @id(map: "pk_pattern_standard_blanks") @default(autoincrement())
  patternId      BigInt   @map("pattern_id")
  standardSizeId BigInt   @map("standard_size_id")
  dwMm           Decimal  @map("dw_mm") @db.Decimal(10, 2)
  dlMm           Decimal  @map("dl_mm") @db.Decimal(10, 2)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById    BigInt?  @map("created_by")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById    BigInt?  @map("updated_by")

  pattern      Pattern      @relation(fields: [patternId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_pattern_standard_blanks__pattern_id")
  standardSize StandardSize @relation(fields: [standardSizeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_pattern_standard_blanks__standard_size_id")
  createdBy    User?        @relation("PatternStandardBlankCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_pattern_standard_blanks__created_by")
  updatedBy    User?        @relation("PatternStandardBlankUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_pattern_standard_blanks__updated_by")

  @@unique([patternId, standardSizeId], map: "ux_pattern_standard_blanks__pattern_id__standard_size_id")
  @@index([standardSizeId], map: "ix_pattern_standard_blanks__standard_size_id")
  @@map("pattern_standard_blanks")
}
