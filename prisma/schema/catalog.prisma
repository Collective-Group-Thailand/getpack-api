  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById BigInt?  @map("created_by")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById BigInt?  @map("updated_by")
  rowVersion  Int      @default(1) @map("row_version")

  table     GeometryBandTable @relation(fields: [tableId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_geometry_bands__table_id")
  createdBy User?             @relation("GeometryBandCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_geometry_bands__created_by")
  updatedBy User?             @relation("GeometryBandUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_geometry_bands__updated_by")

  @@index([tableId], map: "ix_geometry_bands__table_id")
  @@map("geometry_bands")
}

