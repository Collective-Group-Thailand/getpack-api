  createdBy    User?        @relation("StockMovementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_stock_movements__created_by")
  order        Order?       @relation("StockMovementOrder", fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_stock_movements__order_id")

  @@index([stockProductId, factoryId, createdAt], map: "ix_stock_movements__product__factory__created_at")
  @@index([factoryId], map: "ix_stock_movements__factory_id")
  @@index([orderId], map: "ix_stock_movements__order_id")
  @@map("stock_movements")
}

/// Derived read model of the legacy nightly "min price per piece with delivery" (§3.3). Filled by the
/// standard-product calculator job (B2.3); read by the Merchant feed. `zone_code` null = nationwide.
model StockProductPriceSummary {
  id                       BigInt   @id(map: "pk_stock_product_price_summaries") @default(autoincrement())
  stockProductId           BigInt   @map("stock_product_id")
  zoneCode                 String?  @map("zone_code")
  minUnitPriceWithDelivery Decimal  @map("min_unit_price_with_delivery") @db.Decimal(18, 6)
  computedAt               DateTime @map("computed_at") @db.Timestamptz(6)

  stockProduct StockProduct @relation(fields: [stockProductId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_stock_product_price_summaries__stock_product_id")

  // ux (stock_product_id, coalesce(zone_code, '')) is an expression index in the migration SQL.
  @@index([stockProductId], map: "ix_stock_product_price_summaries__stock_product_id")
  @@map("stock_product_price_summaries")
}

