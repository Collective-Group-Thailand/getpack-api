model StockProduct {
  id            BigInt        @id(map: "pk_stock_products") @default(autoincrement())
  publicId      String        @unique(map: "ux_stock_products__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  productTypeId BigInt        @map("product_type_id")
  /// Packio code.
  sku           String        @unique(map: "ux_stock_products__sku")
  nameTh        String        @map("name_th")
  nameEn        String        @map("name_en")
  description   String?
  unit          ProductUnit
  capacityMl    Decimal?      @map("capacity_ml") @db.Decimal(10, 2)
  lengthMm      Decimal?      @map("length_mm") @db.Decimal(10, 2)
  widthMm       Decimal?      @map("width_mm") @db.Decimal(10, 2)
  heightMm      Decimal?      @map("height_mm") @db.Decimal(10, 2)
  weightG       Decimal?      @map("weight_g") @db.Decimal(12, 2)
  minOrderQty   Int           @default(1) @map("min_order_qty")
  isFoodGrade   Boolean       @default(false) @map("is_food_grade")
  seoPageId     BigInt?       @map("seo_page_id")
  status        CatalogStatus @default(draft)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById   BigInt?       @map("created_by")
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById   BigInt?       @map("updated_by")
  rowVersion    Int           @default(1) @map("row_version")

  productType   ProductType                @relation(fields: [productTypeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_stock_products__product_type_id")
  seoPage       SeoPage?                   @relation(fields: [seoPageId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_stock_products__seo_page_id")
  attributes    StockProductAttribute[]
  images        StockProductImage[]
  levels        StockLevel[]
  movements     StockMovement[]
  priceSummary  StockProductPriceSummary[]
  createdBy     User?                      @relation("StockProductCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_stock_products__created_by")
  updatedBy     User?                      @relation("StockProductUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_stock_products__updated_by")
  // --- Pricing (generated back-relations)
  calculateLogs CalculateLog[]             @relation("CalculateLogStockProduct")
  // --- end Pricing

  // --- Quotes & RFQ (generated back-relations)
  quotes Quote[] @relation("QuoteStockProduct")

  // --- end Quotes & RFQ
  orders Order[] @relation("OrderStockProduct")

  @@index([productTypeId], map: "ix_stock_products__product_type_id")
  @@index([seoPageId], map: "ix_stock_products__seo_page_id")
  @@index([nameTh(ops: raw("gin_trgm_ops"))], type: Gin, map: "ix_stock_products__name_th_trgm")
  @@index([nameEn(ops: raw("gin_trgm_ops"))], type: Gin, map: "ix_stock_products__name_en_trgm")
  @@index([sku(ops: raw("gin_trgm_ops"))], type: Gin, map: "ix_stock_products__sku_trgm")
  @@map("stock_products")
}

model StockProductAttribute {
