// Pricing, shipping rate cards, quotes & RFQ context (docs/schema-design.md §3.5, B2.3–B2.5). Zones
// migrate early with the partners context (B2.2) because factory delivery zones reference them
// (schema-design §7 A-12); rate cards stay in B2.4.

model ZoneScheme {
  id          BigInt   @id(map: "pk_zone_schemes") @default(autoincrement())
  publicId    String   @unique(map: "ux_zone_schemes__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  /// e.g. `customer_default`, `carrier:flash_express`.
  code        String   @unique(map: "ux_zone_schemes__code")
  name        String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById BigInt?  @map("created_by")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById BigInt?  @map("updated_by")
  rowVersion  Int      @default(1) @map("row_version")

  zones                            Zone[]
  postcodes                        ZonePostcode[]
  customerShippingRateCardVersions CustomerShippingRateCardVersion[] @relation("CustomerShippingRateCardVersionScheme")
  factoryShippingRateCardVersions  FactoryShippingRateCardVersion[]  @relation("FactoryShippingRateCardVersionScheme")
  createdBy                        User?                             @relation("ZoneSchemeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_zone_schemes__created_by")
  updatedBy                        User?                             @relation("ZoneSchemeUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_zone_schemes__updated_by")

  @@map("zone_schemes")
}

model Zone {
  id          BigInt   @id(map: "pk_zones") @default(autoincrement())
  publicId    String   @unique(map: "ux_zones__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  schemeId    BigInt   @map("scheme_id")
  code        String
  nameTh      String   @map("name_th")
  nameEn      String   @map("name_en")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById BigInt?  @map("created_by")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById BigInt?  @map("updated_by")
  rowVersion  Int      @default(1) @map("row_version")

  scheme    ZoneScheme     @relation(fields: [schemeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_zones__scheme_id")
  postcodes ZonePostcode[]
  createdBy User?          @relation("ZoneCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_zones__created_by")
  updatedBy User?          @relation("ZoneUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_zones__updated_by")

  // --- Partners (generated back-relations)
  factoryDeliveryZones  FactoryDeliveryZone[]  @relation("FactoryDeliveryZoneZone")
  // --- end Partners
  customerShippingRates CustomerShippingRate[] @relation("CustomerShippingRateZone")
  factoryShippingRates  FactoryShippingRate[]  @relation("FactoryShippingRateZone")

  @@unique([schemeId, code], map: "ux_zones__scheme_id__code")
  /// Target of the composite FK from zone_postcodes (the denormalised scheme must match).
  @@unique([id, schemeId], map: "ux_zones__id__scheme_id")
  @@map("zones")
}

/// A postcode maps to one zone per scheme; `scheme_id` is denormalised for that unique key.
model ZonePostcode {
  id          BigInt   @id(map: "pk_zone_postcodes") @default(autoincrement())
  zoneId      BigInt   @map("zone_id")
  schemeId    BigInt   @map("scheme_id")
  postcode    String   @db.Char(5)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById BigInt?  @map("created_by")

  zone      Zone       @relation(fields: [zoneId, schemeId], references: [id, schemeId], onDelete: Restrict, onUpdate: Restrict, map: "fk_zone_postcodes__zone_id__scheme_id")
  scheme    ZoneScheme @relation(fields: [schemeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_zone_postcodes__scheme_id")
  createdBy User?      @relation("ZonePostcodeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_zone_postcodes__created_by")

  @@unique([schemeId, postcode], map: "ux_zone_postcodes__scheme_id__postcode")
  @@index([zoneId, schemeId], map: "ix_zone_postcodes__zone_id__scheme_id")
  @@index([postcode], map: "ix_zone_postcodes__postcode")
  @@map("zone_postcodes")
}

// --- Sell margins & logs (B2.3) --------------------------------------------------------------

enum SellMarginKind {
  margin
  design_fee
  structure_design_fee
  fix_cost
  target_margin

  @@map("sell_margin_kind")
}

enum SalesChannel {
  web
  cs
  line
  b2b

  @@map("sales_channel")
}

/// Packio's own sell-side pricing (legacy `locopack_margins`, `factory_match_print_type.locopack_*`,
/// `SALE_MARGIN_*`), never a factory buy price. Editable by Superadmin / C-Level (D-063).
/// ux `(product_type_id, coalesce(print_type_id, 0), kind)` is an expression index (migration SQL).
model SellMarginTable {
  id            BigInt         @id(map: "pk_sell_margin_tables") @default(autoincrement())
  publicId      String         @unique(map: "ux_sell_margin_tables__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  productTypeId BigInt         @map("product_type_id")
  /// Null = every print type of the product type.
  printTypeId   BigInt?        @map("print_type_id")
  kind          SellMarginKind
  description   String
  decisionRefs  String[]       @map("decision_refs")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById   BigInt?        @map("created_by")

  productType ProductType              @relation("SellMarginTableProductType", fields: [productTypeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sell_margin_tables__product_type_id")
  printType   PrintType?               @relation("SellMarginTablePrintType", fields: [printTypeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sell_margin_tables__print_type_id")
  versions    SellMarginTableVersion[]
  createdBy   User?                    @relation("SellMarginTableCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sell_margin_tables__created_by")

  @@index([productTypeId], map: "ix_sell_margin_tables__product_type_id")
  @@index([printTypeId], map: "ix_sell_margin_tables__print_type_id")
  @@map("sell_margin_tables")
}

/// Versioned (schema-design §2.1). The fallback applies when no line's bands match (legacy
/// `factory_match_print_type.locopack_margin` / `locopack_fix_cost`).
model SellMarginTableVersion {
  id                BigInt              @id(map: "pk_sell_margin_table_versions") @default(autoincrement())
  publicId          String              @unique(map: "ux_sell_margin_table_versions__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  tableId           BigInt              @map("table_id")
  versionNo         Int                 @map("version_no")
  effectiveFrom     DateTime            @map("effective_from") @db.Timestamptz(6)
  status            ConfigVersionStatus @default(draft)
  fallbackPct       Decimal?            @map("fallback_pct") @db.Decimal(7, 4)
  fallbackAmount    Decimal?            @map("fallback_amount") @db.Decimal(18, 6)
  reason            String
  approvalRequestId BigInt?             @map("approval_request_id")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById       BigInt?             @map("created_by")
  decidedAt         DateTime?           @map("decided_at") @db.Timestamptz(6)
  decidedById       BigInt?             @map("decided_by")

  table           SellMarginTable  @relation(fields: [tableId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sell_margin_table_versions__table_id")
  lines           SellMarginLine[]
  approvalRequest ApprovalRequest? @relation("SellMarginTableVersionApprovalRequest", fields: [approvalRequestId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sell_margin_table_versions__approval_request_id")
  createdBy       User?            @relation("SellMarginTableVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sell_margin_table_versions__created_by")
  decidedBy       User?            @relation("SellMarginTableVersionDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sell_margin_table_versions__decided_by")

  @@unique([tableId, versionNo], map: "ux_sell_margin_table_versions__table_id__version_no")
  @@index([tableId, effectiveFrom(sort: Desc), versionNo(sort: Desc)], map: "ix_sell_margin_table_versions__resolution", where: raw("(status = 'approved'::config_version_status)"))
  @@index([approvalRequestId], map: "ix_sell_margin_table_versions__approval_request_id")
  @@map("sell_margin_table_versions")
}

/// One band of a sell-margin version. Quantity bands are inclusive (`qty_min ≤ q ≤ qty_max`), price
/// bands half-open (`price_min ≤ p < price_max`) as in legacy `FoldingCalculator.php:1419-1427`; null
/// bounds are open. Overlaps are refused by an exclusion constraint (migration SQL). Rows are
/// frozen once their version is decided (trigger).
model SellMarginLine {
  id                BigInt   @id(map: "pk_sell_margin_lines") @default(autoincrement())
  versionId         BigInt   @map("version_id")
  qtyMin            Int?     @map("qty_min")
  qtyMax            Int?     @map("qty_max")
  priceMin          Decimal? @map("price_min") @db.Decimal(18, 6)
  priceMax          Decimal? @map("price_max") @db.Decimal(18, 6)
  colourCount       Int?     @map("colour_count") @db.SmallInt
  difficultyLevelId BigInt?  @map("difficulty_level_id")
  valuePct          Decimal? @map("value_pct") @db.Decimal(7, 4)
  valueAmount       Decimal? @map("value_amount") @db.Decimal(18, 6)
  minAmount         Decimal? @map("min_amount") @db.Decimal(18, 6)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  version         SellMarginTableVersion @relation(fields: [versionId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_sell_margin_lines__version_id")
  difficultyLevel DifficultyLevel?       @relation("SellMarginLineDifficultyLevel", fields: [difficultyLevelId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sell_margin_lines__difficulty_level_id")

  @@index([versionId], map: "ix_sell_margin_lines__version_id")
  @@index([difficultyLevelId], map: "ix_sell_margin_lines__difficulty_level_id")
  @@map("sell_margin_lines")
}

/// Every calculation, for analytics (B6) and RFQ routing (D-102). Partitioned monthly on
/// `occurred_at` (schema-design §1.7); IPs are truncated (§2.11). `quote_id` gets its FK in B2.5.
model CalculateLog {
  id                 BigInt       @default(autoincrement())
  /// Opaque reference returned to the client (`calculationId`), e.g. to link an RFQ routed from this calculation (U-B0.1).
  publicId           String       @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  occurredAt         DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(6)
  channel            SalesChannel
  productTypeId      BigInt       @map("product_type_id")
  catalogProductId   BigInt?      @map("catalog_product_id")
  stockProductId     BigInt?      @map("stock_product_id")
  actorUserId        BigInt?      @map("actor_user_id")
  anonymousId        String?      @map("anonymous_id")
  quantities         Int[]
  lengthMm           Decimal?     @map("length_mm") @db.Decimal(10, 2)
  widthMm            Decimal?     @map("width_mm") @db.Decimal(10, 2)
  heightMm           Decimal?     @map("height_mm") @db.Decimal(10, 2)
  deliveryPostcode   String?      @map("delivery_postcode") @db.Char(5)
  promotionCode      String?      @map("promotion_code")
  input              Json
  inputSchemaVersion Int          @map("input_schema_version") @db.SmallInt
  resultSummary      Json         @map("result_summary")
  calculatorVersion  String?      @map("calculator_version")
  instantPath        Boolean      @map("instant_path")
  routedToRfq        Boolean      @map("routed_to_rfq")
  quoteId            BigInt?      @map("quote_id")
  durationMs         Int          @map("duration_ms")
  ipPrefix           String?      @map("ip_prefix") @db.Inet

  productType    ProductType     @relation("CalculateLogProductType", fields: [productTypeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_calculate_logs__product_type_id")
  catalogProduct CatalogProduct? @relation("CalculateLogCatalogProduct", fields: [catalogProductId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_calculate_logs__catalog_product_id")
  stockProduct   StockProduct?   @relation("CalculateLogStockProduct", fields: [stockProductId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_calculate_logs__stock_product_id")
  actorUser      User?           @relation("CalculateLogActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_calculate_logs__actor_user_id")
  quote          Quote?          @relation("CalculateLogQuote", fields: [quoteId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_calculate_logs__quote_id")

  @@id([id, occurredAt], map: "pk_calculate_logs")
  @@index([publicId], map: "ix_calculate_logs__public_id")
  @@index([productTypeId, occurredAt], map: "ix_calculate_logs__product_type_id__occurred_at")
  @@index([catalogProductId], map: "ix_calculate_logs__catalog_product_id")
  @@index([stockProductId], map: "ix_calculate_logs__stock_product_id")
  @@index([quoteId], map: "ix_calculate_logs__quote_id")
  @@index([actorUserId, occurredAt], map: "ix_calculate_logs__actor_user_id__occurred_at")
  @@map("calculate_logs")
}

/// Store searches, for analytics (B6). Partitioned monthly on `occurred_at` (schema-design §1.7).
enum SearchSurface {
  catalog
  styles

  @@map("search_surface")
}

model SearchLog {
  id           BigInt        @default(autoincrement())
  occurredAt   DateTime      @default(now()) @map("occurred_at") @db.Timestamptz(6)
  keyword      String
  resultsCount Int           @map("results_count")
  channel      SalesChannel
  actorUserId  BigInt?       @map("actor_user_id")
  anonymousId  String?       @map("anonymous_id")
  /// D-274: which search it was (the catalogue or the style library).
  surface      SearchSurface @default(catalog)

  actorUser User? @relation("SearchLogActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_search_logs__actor_user_id")

  @@id([id, occurredAt], map: "pk_search_logs")
  @@index([actorUserId, occurredAt], map: "ix_search_logs__actor_user_id__occurred_at")
  @@map("search_logs")
}

// --- Shipping rate cards & carriers (B2.4, D-013, D-114) --------------------------------------

enum CarrierCode {
  factory_fleet
  flash_express
  deliveree

  @@map("carrier_code")
}

enum CarrierCapability {
  quote
  book
  label
  track
  cancel
  webhook

  @@map("carrier_capability")
}

enum CarrierAccountStatus {
  active
  inactive

  @@map("carrier_account_status")
}

/// Factory answer to one line of a factory shipping payout card drafted by Packio (D-013, D-042).
enum RateLineAcceptance {
  pending
  accepted
  countered

  @@map("rate_line_acceptance")
}

/// What Packio charges the customer for delivery (D-013), normally one card (`default`).
model CustomerShippingRateCard {
  id           BigInt   @id(map: "pk_customer_shipping_rate_cards") @default(autoincrement())
  publicId     String   @unique(map: "ux_customer_shipping_rate_cards__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  key          String   @unique(map: "ux_customer_shipping_rate_cards__key")
  description  String
  decisionRefs String[] @map("decision_refs")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById  BigInt?  @map("created_by")

  versions  CustomerShippingRateCardVersion[]
  createdBy User?                             @relation("CustomerShippingRateCardCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_customer_shipping_rate_cards__created_by")

  @@map("customer_shipping_rate_cards")
}

/// Versioned (schema-design §2.1); `proposed` while its approval request is open. Every rate of a
/// version uses zones of the version's scheme (composite FK).
model CustomerShippingRateCardVersion {
  id                BigInt              @id(map: "pk_customer_shipping_rate_card_versions") @default(autoincrement())
  publicId          String              @unique(map: "ux_customer_shipping_rate_card_versions__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  cardId            BigInt              @map("card_id")
  versionNo         Int                 @map("version_no")
  schemeId          BigInt              @map("scheme_id")
  effectiveFrom     DateTime            @map("effective_from") @db.Timestamptz(6)
  status            ConfigVersionStatus @default(draft)
  reason            String
  approvalRequestId BigInt?             @map("approval_request_id")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById       BigInt?             @map("created_by")
  decidedAt         DateTime?           @map("decided_at") @db.Timestamptz(6)
  decidedById       BigInt?             @map("decided_by")

  card            CustomerShippingRateCard @relation(fields: [cardId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_customer_shipping_rate_card_versions__card_id")
  scheme          ZoneScheme               @relation("CustomerShippingRateCardVersionScheme", fields: [schemeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_customer_shipping_rate_card_versions__scheme_id")
  rates           CustomerShippingRate[]
  approvalRequest ApprovalRequest?         @relation("CustomerShippingRateCardVersionApprovalRequest", fields: [approvalRequestId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_customer_shipping_rate_card_versions__approval_request_id")
  createdBy       User?                    @relation("CustomerShippingRateCardVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_customer_shipping_rate_card_versions__created_by")
  decidedBy       User?                    @relation("CustomerShippingRateCardVersionDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_customer_shipping_rate_card_versions__decided_by")

  // --- Fulfilment B4.3 (generated back-relations)
  shipments Shipment[] @relation("ShipmentCustomerRateVersion")
  // --- end Fulfilment B4.3

  @@unique([cardId, versionNo], map: "ux_customer_shipping_rate_card_versions__card_id__version_no")
  /// Target of the composite FK from customer_shipping_rates.
  @@unique([id, schemeId], map: "ux_customer_shipping_rate_card_versions__id__scheme_id")
  /// One version in approval at a time, so each approval decides against the card it was based on.
  @@unique([cardId], map: "ux_customer_shipping_rate_card_versions__one_proposed", where: raw("(status = 'proposed'::config_version_status)"))
  @@index([cardId, effectiveFrom(sort: Desc), versionNo(sort: Desc)], map: "ix_customer_shipping_rate_card_versions__resolution", where: raw("(status = 'approved'::config_version_status)"))
  @@index([schemeId], map: "ix_customer_shipping_rate_card_versions__scheme_id")
  @@index([approvalRequestId], map: "ix_customer_shipping_rate_card_versions__approval_request_id")
  @@map("customer_shipping_rate_card_versions")
}

/// One band: weight `[weight_min_g, weight_max_g)` and volume `[volume_min_cm3, volume_max_cm3)`
/// (null max = open, null volume = any). A postcode row overrides its zone's rows. Price is
/// VAT-exclusive; `per_extra_kg` is charged per started kg above `weight_min_g`. Overlaps refused by
/// an exclusion constraint; rows frozen with their version (migration SQL).
model CustomerShippingRate {
  id           BigInt   @id(map: "pk_customer_shipping_rates") @default(autoincrement())
  versionId    BigInt   @map("version_id")
  schemeId     BigInt   @map("scheme_id")
  zoneId       BigInt   @map("zone_id")
  postcode     String?  @db.Char(5)
  weightMinG   Int      @map("weight_min_g")
  weightMaxG   Int?     @map("weight_max_g")
  volumeMinCm3 BigInt?  @map("volume_min_cm3")
  volumeMaxCm3 BigInt?  @map("volume_max_cm3")
  priceAmount  Decimal  @map("price_amount") @db.Decimal(14, 2)
  perExtraKg   Decimal? @map("per_extra_kg") @db.Decimal(18, 6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  version CustomerShippingRateCardVersion @relation(fields: [versionId, schemeId], references: [id, schemeId], onDelete: Cascade, onUpdate: Restrict, map: "fk_customer_shipping_rates__version_id__scheme_id")
  zone    Zone                            @relation("CustomerShippingRateZone", fields: [zoneId, schemeId], references: [id, schemeId], onDelete: Restrict, onUpdate: Restrict, map: "fk_customer_shipping_rates__zone_id__scheme_id")

  @@index([versionId, schemeId], map: "ix_customer_shipping_rates__version_id__scheme_id")
  @@index([zoneId, schemeId], map: "ix_customer_shipping_rates__zone_id__scheme_id")
  @@map("customer_shipping_rates")
}

/// What Packio pays a factory for delivering with its own fleet (D-013); one card per factory.
model FactoryShippingRateCard {
  id          BigInt   @id(map: "pk_factory_shipping_rate_cards") @default(autoincrement())
  publicId    String   @unique(map: "ux_factory_shipping_rate_cards__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  factoryId   BigInt   @unique(map: "ux_factory_shipping_rate_cards__factory_id") @map("factory_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById BigInt?  @map("created_by")

  factory   Factory                          @relation("FactoryShippingRateCardFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_factory_shipping_rate_cards__factory_id")
  versions  FactoryShippingRateCardVersion[]
  createdBy User?                            @relation("FactoryShippingRateCardCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_factory_shipping_rate_cards__created_by")

  @@map("factory_shipping_rate_cards")
}

/// Packio drafts (`draft`), sends it to the factory (`pending_acceptance`), the factory accepts or
/// counters per line, and the version is `approved` once every line is accepted (D-013, D-042).
model FactoryShippingRateCardVersion {
  id                  BigInt              @id(map: "pk_factory_shipping_rate_card_versions") @default(autoincrement())
  publicId            String              @unique(map: "ux_factory_shipping_rate_card_versions__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  cardId              BigInt              @map("card_id")
  versionNo           Int                 @map("version_no")
  schemeId            BigInt              @map("scheme_id")
  effectiveFrom       DateTime            @map("effective_from") @db.Timestamptz(6)
  status              ConfigVersionStatus @default(draft)
  reason              String
  sentAt              DateTime?           @map("sent_at") @db.Timestamptz(6)
  sentById            BigInt?             @map("sent_by")
  factoryAcceptedAt   DateTime?           @map("factory_accepted_at") @db.Timestamptz(6)
  factoryAcceptedById BigInt?             @map("factory_accepted_by")
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById         BigInt?             @map("created_by")
  decidedAt           DateTime?           @map("decided_at") @db.Timestamptz(6)
  decidedById         BigInt?             @map("decided_by")

  card              FactoryShippingRateCard @relation(fields: [cardId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_factory_shipping_rate_card_versions__card_id")
  scheme            ZoneScheme              @relation("FactoryShippingRateCardVersionScheme", fields: [schemeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_factory_shipping_rate_card_versions__scheme_id")
  rates             FactoryShippingRate[]
  sentBy            User?                   @relation("FactoryShippingRateCardVersionSentBy", fields: [sentById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_factory_shipping_rate_card_versions__sent_by")
  factoryAcceptedBy User?                   @relation("FactoryShippingRateCardVersionAcceptedBy", fields: [factoryAcceptedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_factory_shipping_rate_card_versions__factory_accepted_by")
  createdBy         User?                   @relation("FactoryShippingRateCardVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_factory_shipping_rate_card_versions__created_by")
  decidedBy         User?                   @relation("FactoryShippingRateCardVersionDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_factory_shipping_rate_card_versions__decided_by")

  // --- Fulfilment B4.3 (generated back-relations)
  shipments Shipment[] @relation("ShipmentFactoryPayoutVersion")
  // --- end Fulfilment B4.3

  @@unique([cardId, versionNo], map: "ux_factory_shipping_rate_card_versions__card_id__version_no")
  @@unique([id, schemeId], map: "ux_factory_shipping_rate_card_versions__id__scheme_id")
  /// One open version (draft or awaiting the factory) per card.
  @@unique([cardId], map: "ux_factory_shipping_rate_card_versions__one_open", where: raw("(status = ANY (ARRAY['draft'::config_version_status, 'pending_acceptance'::config_version_status]))"))
  @@index([cardId, effectiveFrom(sort: Desc), versionNo(sort: Desc)], map: "ix_factory_shipping_rate_card_versions__resolution", where: raw("(status = 'approved'::config_version_status)"))
  @@index([schemeId], map: "ix_factory_shipping_rate_card_versions__scheme_id")
  @@map("factory_shipping_rate_card_versions")
}

/// Same band shape as the customer rates; `payout_amount` is VAT-exclusive. The factory's answer is
/// kept per line (`acceptance`, counter amount and note) while the version is pending acceptance.
model FactoryShippingRate {
  id                BigInt             @id(map: "pk_factory_shipping_rates") @default(autoincrement())
  publicId          String             @unique(map: "ux_factory_shipping_rates__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  versionId         BigInt             @map("version_id")
  schemeId          BigInt             @map("scheme_id")
  zoneId            BigInt             @map("zone_id")
  postcode          String?            @db.Char(5)
  weightMinG        Int                @map("weight_min_g")
  weightMaxG        Int?               @map("weight_max_g")
  volumeMinCm3      BigInt?            @map("volume_min_cm3")
  volumeMaxCm3      BigInt?            @map("volume_max_cm3")
  payoutAmount      Decimal            @map("payout_amount") @db.Decimal(14, 2)
  perExtraKg        Decimal?           @map("per_extra_kg") @db.Decimal(18, 6)
  acceptance        RateLineAcceptance @default(pending)
  counterAmount     Decimal?           @map("counter_amount") @db.Decimal(14, 2)
  counterPerExtraKg Decimal?           @map("counter_per_extra_kg") @db.Decimal(18, 6)
  counterNote       String?            @map("counter_note")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  version FactoryShippingRateCardVersion @relation(fields: [versionId, schemeId], references: [id, schemeId], onDelete: Cascade, onUpdate: Restrict, map: "fk_factory_shipping_rates__version_id__scheme_id")
  zone    Zone                           @relation("FactoryShippingRateZone", fields: [zoneId, schemeId], references: [id, schemeId], onDelete: Restrict, onUpdate: Restrict, map: "fk_factory_shipping_rates__zone_id__scheme_id")

  @@index([versionId, schemeId], map: "ix_factory_shipping_rates__version_id__scheme_id")
  @@index([zoneId, schemeId], map: "ix_factory_shipping_rates__zone_id__scheme_id")
  @@map("factory_shipping_rates")
}

/// Delivery methods: the factory's own fleet (default, D-013) and Packio-booked carriers used only
/// as fallback where a factory cannot serve a zone (D-114). Carriers are added as adapters.
model Carrier {
  id          BigInt              @id(map: "pk_carriers") @default(autoincrement())
  publicId    String              @unique(map: "ux_carriers__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  code        CarrierCode         @unique(map: "ux_carriers__code")
  name        String
  adapterKey  String              @map("adapter_key")
  enabled     Boolean             @default(false)
  supports    CarrierCapability[]
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById BigInt?             @map("updated_by")
  rowVersion  Int                 @default(1) @map("row_version")

  accounts  CarrierAccount[]
  updatedBy User?            @relation("CarrierUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_carriers__updated_by")

  // --- Fulfilment B4.3 (generated back-relations)
  shipments Shipment[] @relation("ShipmentCarrier")
  // --- end Fulfilment B4.3

  @@map("carriers")
}

/// Packio's own account with a carrier, per entity (D-005); credentials live in Secrets Manager and
/// only their reference is stored.
model CarrierAccount {
  id                   BigInt               @id(map: "pk_carrier_accounts") @default(autoincrement())
  publicId             String               @unique(map: "ux_carrier_accounts__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  entityId             BigInt               @map("entity_id")
  carrierId            BigInt               @map("carrier_id")
  label                String
  credentialsSecretRef String               @map("credentials_secret_ref")
  sandbox              Boolean
  status               CarrierAccountStatus @default(active)
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById          BigInt?              @map("created_by")
  updatedAt            DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById          BigInt?              @map("updated_by")
  rowVersion           Int                  @default(1) @map("row_version")

  entity    Entity  @relation("CarrierAccountEntity", fields: [entityId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_carrier_accounts__entity_id")
  carrier   Carrier @relation(fields: [carrierId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_carrier_accounts__carrier_id")
  createdBy User?   @relation("CarrierAccountCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_carrier_accounts__created_by")
  updatedBy User?   @relation("CarrierAccountUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_carrier_accounts__updated_by")

  /// One active account per entity, carrier and environment.
  @@unique([entityId, carrierId, sandbox], map: "ux_carrier_accounts__one_active", where: raw("(status = 'active'::carrier_account_status)"))
  @@index([entityId, carrierId], map: "ix_carrier_accounts__entity_id__carrier_id")
  @@index([carrierId], map: "ix_carrier_accounts__carrier_id")
  @@map("carrier_accounts")
}

// --- Quotes (B2.5, D-051) -------------------------------------------------------------------------

enum QuoteSource {
  instant
  rfq
  /// D-254: a standalone sample quotation priced by CS (one option).
  sample

  @@map("quote_source")
}

enum QuoteStatus {
  calculated
  saved
  shared
  converted
  expired
  superseded
  /// D-250: the customer declined the quotation (outcome `lost`).
  declined
  /// D-251: the customer sent the quotation to CS as a pre-filled RFQ (outcome `converted_to_rfq`).
  routed_to_rfq

  @@map("quote_status")
}

/**
 * A saved quotation (D-051): the input and the priced result are a write-once snapshot with the
 * version ids of everything used (`config_refs`, schema-design §2.2) and `snapshot_sha256`; only the
 * lifecycle columns change (trigger). Valid for `quotes.validity_days` with the price locked.
 */
model Quote {
  id                       BigInt       @id(map: "pk_quotes") @default(autoincrement())
  publicId                 String       @unique(map: "ux_quotes__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  quoteCode                String?      @unique(map: "ux_quotes__quote_code") @map("quote_code")
  entityId                 BigInt       @map("entity_id")
  channel                  SalesChannel
  source                   QuoteSource
  rfqQuoteId               BigInt?      @unique(map: "ux_quotes__rfq_quote_id") @map("rfq_quote_id")
  customerUserId           BigInt?      @map("customer_user_id")
  createdById              BigInt?      @map("created_by")
  anonymousId              String?      @map("anonymous_id")
  productTypeId            BigInt       @map("product_type_id")
  catalogProductId         BigInt?      @map("catalog_product_id")
  stockProductId           BigInt?      @map("stock_product_id")
  input                    Json
  inputSchemaVersion       Int          @map("input_schema_version") @db.SmallInt
  /// Human-readable spec lines resolved when the quote was made (U-B0.1, schema-design A-51): catalogue names frozen like the price.
  specSummary              Json?        @map("spec_summary")
  calculatorVersion        String       @map("calculator_version")
  configRefs               Json         @map("config_refs")
  status                   QuoteStatus
  validUntil               DateTime     @map("valid_until") @db.Timestamptz(6)
  shareTokenHash           Bytes?       @unique(map: "ux_quotes__share_token_hash") @map("share_token_hash")
  sharedAt                 DateTime?    @map("shared_at") @db.Timestamptz(6)
  /// D-185 / F5: the share link stops resolving after this (configurations.share_link_days); null = not shared.
  shareExpiresAt           DateTime?    @map("share_expires_at") @db.Timestamptz(6)
  /// CS's internal note on a quotation (U-B0.2); never shown to the customer or on the PDF.
  staffNote                String?      @map("staff_note")
  pdfFileId                BigInt?      @map("pdf_file_id")
  pdfRequestedAt           DateTime?    @map("pdf_requested_at") @db.Timestamptz(6)
  deliveryPostcode         String?      @map("delivery_postcode") @db.Char(5)
  promotionCode            String?      @map("promotion_code")
  snapshotSha256           Bytes        @map("snapshot_sha256")
  supersededById           BigInt?      @map("superseded_by_id")
  convertedAt              DateTime?    @map("converted_at") @db.Timestamptz(6)
  createdAt                DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion               Int          @default(1) @map("row_version")
  companyId                BigInt?      @map("company_id")
  /// D-240: the Structure Advisor recommendation and choice the customer saved this quotation from; set once.
  advisoryRecommendationId BigInt?      @map("advisory_recommendation_id")
  advisoryChoiceId         BigInt?      @map("advisory_choice_id")
  /// D-247: the customer's target per unit (THB incl. VAT, excl. shipping); set once at save, never shown to a partner.
  targetPricePerUnit       Decimal?     @map("target_price_per_unit") @db.Decimal(14, 2)
  /// D-249: the lever of an earlier quotation this one was saved from; set once.
  fromLeverId              BigInt?      @unique(map: "ux_quotes__from_lever_id") @map("from_lever_id")
  /// D-267: the dieline-derived quantities of the style variant priced (engine version), frozen; no price effect yet.
  dielineQuantities        Json?        @map("dieline_quantities")
  /// D-248: when the levers were computed (once; none found is still computed).
  leversComputedAt         DateTime?    @map("levers_computed_at") @db.Timestamptz(6)

  entity         Entity          @relation("QuoteEntity", fields: [entityId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_quotes__entity_id")
  rfqQuote       RfqQuote?       @relation("QuoteRfqQuote", fields: [rfqQuoteId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_quotes__rfq_quote_id")
  customer       User?           @relation("QuoteCustomer", fields: [customerUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_quotes__customer_user_id")
  createdBy      User?           @relation("QuoteCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_quotes__created_by")
  productType    ProductType     @relation("QuoteProductType", fields: [productTypeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_quotes__product_type_id")
  catalogProduct CatalogProduct? @relation("QuoteCatalogProduct", fields: [catalogProductId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_quotes__catalog_product_id")
  stockProduct   StockProduct?   @relation("QuoteStockProduct", fields: [stockProductId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_quotes__stock_product_id")
  pdfFile        FileObject?     @relation("QuotePdfFile", fields: [pdfFileId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_quotes__pdf_file_id")
  supersededBy   Quote?          @relation("QuoteSupersededBy", fields: [supersededById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_quotes__superseded_by_id")
  supersedes     Quote[]         @relation("QuoteSupersededBy")
  options        QuoteOption[]
  acceptedRfq    Rfq?            @relation("RfqAcceptedQuote")
  calculateLogs  CalculateLog[]  @relation("CalculateLogQuote")

  cartItems        CartItem[] @relation("CartItemQuote")
  cartItemsPending CartItem[] @relation("CartItemPendingQuote")
  orders           Order[]    @relation("OrderQuote")

  advisoryRecommendation AdvisoryRecommendation? @relation("QuoteAdvisoryRecommendation", fields: [advisoryRecommendationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_quotes__advisory_recommendation_id")
  advisoryChoice         AdvisoryChoice?         @relation("QuoteAdvisoryChoice", fields: [advisoryChoiceId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_quotes__advisory_choice_id")
  company                Company?                @relation("QuoteCompany", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_quotes__company_id")
  discountMemos          DiscountMemo[]          @relation("DiscountMemoQuote")

  configurationDrafts ConfigurationDraft[] @relation("ConfigurationDraftQuote")

  fromLever   QuoteLever?         @relation("QuoteFromLever", fields: [fromLeverId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_quotes__from_lever_id")
  levers      QuoteLever[]        @relation("QuoteLevers")
  outcome     QuoteOutcome?       @relation("QuoteOutcomeQuote")
  routedRfq   Rfq?                @relation("RfqRoutedFromQuote")
  unmetDemand UnmetDemandRecord[] @relation("UnmetDemandQuote")

  samplesSourced Sample[] @relation("SampleSourceQuote")
  sample         Sample?  @relation("SampleQuote")
  sampleForBulk  Sample?  @relation("SampleBulkQuote")

  @@index([advisoryRecommendationId], map: "ix_quotes__advisory_recommendation_id")
  @@index([advisoryChoiceId], map: "ix_quotes__advisory_choice_id")
  @@index([companyId], map: "ix_quotes__company_id")
  @@index([customerUserId, createdAt(sort: Desc)], map: "ix_quotes__customer_user_id__created_at")
  @@index([status, validUntil], map: "ix_quotes__status__valid_until")
  @@index([anonymousId], map: "ix_quotes__anonymous_id")
  @@index([entityId], map: "ix_quotes__entity_id")
  @@index([productTypeId], map: "ix_quotes__product_type_id")
  @@index([catalogProductId], map: "ix_quotes__catalog_product_id")
  @@index([stockProductId], map: "ix_quotes__stock_product_id")
  @@index([createdById], map: "ix_quotes__created_by")
  @@index([pdfFileId], map: "ix_quotes__pdf_file_id")
  @@index([supersededById], map: "ix_quotes__superseded_by_id")
  @@index([createdAt], map: "ix_quotes__created_at")
  @@index([convertedAt], map: "ix_quotes__converted_at", where: raw("(converted_at IS NOT NULL)"))
  @@index([quoteCode(ops: raw("gin_trgm_ops"))], type: Gin, map: "ix_quotes__quote_code_trgm")
  @@map("quotes")
}

/**
 * One priced quantity of a quote; immutable. Staff-only columns never reach the customer (D-050).
 */
model QuoteOption {
  id                     BigInt      @id(map: "pk_quote_options") @default(autoincrement())
  publicId               String      @unique(map: "ux_quote_options__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  quoteId                BigInt      @map("quote_id")
  quantity               Int
  unit                   ProductUnit
  result                 Json
  netAmount              Decimal     @map("net_amount") @db.Decimal(14, 2)
  discountAmount         Decimal     @default(0) @map("discount_amount") @db.Decimal(14, 2)
  vatAmount              Decimal     @map("vat_amount") @db.Decimal(14, 2)
  grossAmount            Decimal     @map("gross_amount") @db.Decimal(14, 2)
  shippingAmount         Decimal?    @map("shipping_amount") @db.Decimal(14, 2)
  unitPrice              Decimal     @map("unit_price") @db.Decimal(18, 6)
  leadTimeDays           Int?        @map("lead_time_days") @db.SmallInt
  earliestShipDate       DateTime?   @map("earliest_ship_date") @db.Date
  toleranceShortagePct   Decimal?    @map("tolerance_shortage_pct") @db.Decimal(7, 4)
  toleranceOveragePct    Decimal?    @map("tolerance_overage_pct") @db.Decimal(7, 4)
  /// D-186: published dimensional (± mm) and colour (ΔE2000 vs the approved proof) tolerances, frozen; null = none.
  toleranceDimensionalMm Decimal?    @map("tolerance_dimensional_mm") @db.Decimal(6, 2)
  toleranceColourDeltaE  Decimal?    @map("tolerance_colour_delta_e") @db.Decimal(5, 2)
  selectedFactoryId      BigInt?     @map("selected_factory_id")
  priceListVersionId     BigInt?     @map("price_list_version_id")
  internalBreakdown      Json?       @map("internal_breakdown")
  buyCostNet             Decimal?    @map("buy_cost_net") @db.Decimal(14, 2)
  marginPct              Decimal?    @map("margin_pct") @db.Decimal(9, 4)
  belowMarginFloor       Boolean     @default(false) @map("below_margin_floor")
  createdAt              DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  quote            Quote             @relation(fields: [quoteId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_quote_options__quote_id")
  selectedFactory  Factory?          @relation("QuoteOptionFactory", fields: [selectedFactoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_quote_options__selected_factory_id")
  priceListVersion PriceListVersion? @relation("QuoteOptionPriceListVersion", fields: [priceListVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_quote_options__price_list_version_id")

  cartItems        CartItem[] @relation("CartItemQuoteOption")
  cartItemsPending CartItem[] @relation("CartItemPendingQuoteOption")
  orders           Order[]    @relation("OrderQuoteOption")

  @@unique([quoteId, quantity], map: "ux_quote_options__quote_id__quantity")
  @@index([selectedFactoryId], map: "ix_quote_options__selected_factory_id")
  @@index([priceListVersionId], map: "ix_quote_options__price_list_version_id")
  @@map("quote_options")
}

// --- RFQ (B2.5, D-100, D-043, D-102) --------------------------------------------------------------

enum RfqStatus {
  submitted
  in_review
  need_info
  quoted
  accepted
  declined
  expired

  @@map("rfq_status")
}

enum MessageVisibility {
  customer
  internal

  @@map("message_visibility")
}

enum ConsultationStatus {
  requested
  responded
  declined
  expired

  @@map("consultation_status")
}

enum RfqQuoteStatus {
  draft
  sent
  accepted
  superseded
  expired

  @@map("rfq_quote_status")
}

enum UnmetDemandSource {
  rfq_declined
  rfq_expired
  no_price_path
  capability_missing
  capacity_limited
  /// D-252: a quotation with a target ended lost / expired / sent to CS above its target.
  price_above_target
  /// D-274: a calculation refused because its style variant is not publishable.
  style_not_publishable

  @@map("unmet_demand_source")
}

/**
 * A request for quote (D-100): the customer's spec, quoted by CS with factory consultation.
 */
model Rfq {
  id                       BigInt           @id(map: "pk_rfqs") @default(autoincrement())
  publicId                 String           @unique(map: "ux_rfqs__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  rfqCode                  String           @unique(map: "ux_rfqs__rfq_code") @map("rfq_code")
  entityId                 BigInt           @map("entity_id")
  channel                  SalesChannel
  customerUserId           BigInt           @map("customer_user_id")
  createdById              BigInt?          @map("created_by")
  productTypeId            BigInt           @map("product_type_id")
  spec                     Json
  specSchemaVersion        Int              @map("spec_schema_version") @db.SmallInt
  lengthMm                 Decimal?         @map("length_mm") @db.Decimal(10, 2)
  widthMm                  Decimal?         @map("width_mm") @db.Decimal(10, 2)
  heightMm                 Decimal?         @map("height_mm") @db.Decimal(10, 2)
  /// D-182: the basis of length / width / height (existing rows: internal, A-80).
  measurementBasis         MeasurementBasis @default(internal) @map("measurement_basis")
  targetDate               DateTime?        @map("target_date") @db.Date
  deliveryPostcode         String           @map("delivery_postcode") @db.Char(5)
  provinceId               BigInt?          @map("province_id")
  notes                    String           @default("")
  status                   RfqStatus        @default(submitted)
  declineReasonId          BigInt?          @map("decline_reason_id")
  declineNote              String?          @map("decline_note")
  assignedToUserId         BigInt?          @map("assigned_to_user_id")
  slaDueAt                 DateTime?        @map("sla_due_at") @db.Timestamptz(6)
  firstResponseAt          DateTime?        @map("first_response_at") @db.Timestamptz(6)
  routedFromCalculateLogId BigInt?          @map("routed_from_calculate_log_id")
  /// D-251: the saved quotation the customer sent to CS (store.quotes.sendToCs).
  routedFromQuoteId        BigInt?          @unique(map: "ux_rfqs__routed_from_quote_id") @map("routed_from_quote_id")
  /// D-269: the published style variant the request is for (style code and options travel with it).
  styleVariantId           BigInt?          @map("style_variant_id")
  /// D-247: the customer's target per unit (THB incl. VAT, excl. shipping); staff only, never shown to a partner (D-190).
  targetPricePerUnit       Decimal?         @map("target_price_per_unit") @db.Decimal(14, 2)
  acceptedQuoteId          BigInt?          @unique(map: "ux_rfqs__accepted_quote_id") @map("accepted_quote_id")
  submittedAt              DateTime         @default(now()) @map("submitted_at") @db.Timestamptz(6)
  closedAt                 DateTime?        @map("closed_at") @db.Timestamptz(6)
  createdAt                DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion               Int              @default(1) @map("row_version")

  entity          Entity                   @relation("RfqEntity", fields: [entityId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_rfqs__entity_id")
  customer        User                     @relation("RfqCustomer", fields: [customerUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_rfqs__customer_user_id")
  createdBy       User?                    @relation("RfqCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_rfqs__created_by")
  assignedTo      User?                    @relation("RfqAssignedTo", fields: [assignedToUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_rfqs__assigned_to_user_id")
  productType     ProductType              @relation("RfqProductType", fields: [productTypeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_rfqs__product_type_id")
  province        GeoProvince?             @relation("RfqProvince", fields: [provinceId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_rfqs__province_id")
  declineReason   UnmetDemandReason?       @relation(fields: [declineReasonId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_rfqs__decline_reason_id")
  acceptedQuote   Quote?                   @relation("RfqAcceptedQuote", fields: [acceptedQuoteId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_rfqs__accepted_quote_id")
  routedFromQuote Quote?                   @relation("RfqRoutedFromQuote", fields: [routedFromQuoteId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_rfqs__routed_from_quote_id")
  styleVariant    StyleVariant?            @relation("RfqStyleVariant", fields: [styleVariantId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_rfqs__style_variant_id")
  tiers           RfqQuantityTier[]
  messages        RfqMessage[]
  consultations   RfqFactoryConsultation[]
  quotes          RfqQuote[]
  unmetDemand     UnmetDemandRecord[]

  configurationDrafts ConfigurationDraft[] @relation("ConfigurationDraftRfq")
  quoteOutcomes       QuoteOutcome[]       @relation("QuoteOutcomeRfq")

  structuralRequest StructuralDesignRequest? @relation("StructuralRequestServiceRfq")

  @@index([customerUserId, submittedAt(sort: Desc)], map: "ix_rfqs__customer_user_id__submitted_at")
  @@index([status, slaDueAt], map: "ix_rfqs__status__sla_due_at")
  @@index([assignedToUserId], map: "ix_rfqs__assigned_to_user_id")
  @@index([entityId], map: "ix_rfqs__entity_id")
  @@index([productTypeId], map: "ix_rfqs__product_type_id")
  @@index([provinceId], map: "ix_rfqs__province_id")
  @@index([declineReasonId], map: "ix_rfqs__decline_reason_id")
  @@index([createdById], map: "ix_rfqs__created_by")
  @@index([submittedAt], map: "ix_rfqs__submitted_at")
  @@index([closedAt], map: "ix_rfqs__closed_at", where: raw("(closed_at IS NOT NULL)"))
  @@index([rfqCode(ops: raw("gin_trgm_ops"))], type: Gin, map: "ix_rfqs__rfq_code_trgm")
  @@index([styleVariantId], map: "ix_rfqs__style_variant_id")
  @@map("rfqs")
}

model RfqQuantityTier {
  id       BigInt @id(map: "pk_rfq_quantity_tiers") @default(autoincrement())
  rfqId    BigInt @map("rfq_id")
  quantity Int

  rfq Rfq @relation(fields: [rfqId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_rfq_quantity_tiers__rfq_id")

  @@unique([rfqId, quantity], map: "ux_rfq_quantity_tiers__rfq_id__quantity")
  @@map("rfq_quantity_tiers")
}

/**
 * Conversation on an RFQ; `internal` messages are never shown to the customer. Append-only.
 */
model RfqMessage {
  id           BigInt            @id(map: "pk_rfq_messages") @default(autoincrement())
  publicId     String            @unique(map: "ux_rfq_messages__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  rfqId        BigInt            @map("rfq_id")
  authorUserId BigInt            @map("author_user_id")
  visibility   MessageVisibility
  body         String
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  rfq    Rfq  @relation(fields: [rfqId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_rfq_messages__rfq_id")
  author User @relation("RfqMessageAuthor", fields: [authorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_rfq_messages__author_user_id")

  @@index([rfqId, createdAt], map: "ix_rfq_messages__rfq_id__created_at")
  @@index([authorUserId], map: "ix_rfq_messages__author_user_id")
  @@map("rfq_messages")
}

/**
 * Packio asks a factory for its buy price per tier; the factory never sees the sell price (D-044).
 */
model RfqFactoryConsultation {
  id            BigInt             @id(map: "pk_rfq_factory_consultations") @default(autoincrement())
  publicId      String             @unique(map: "ux_rfq_factory_consultations__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  rfqId         BigInt             @map("rfq_id")
  factoryId     BigInt             @map("factory_id")
  requestedById BigInt             @map("requested_by")
  note          String             @default("")
  dueAt         DateTime           @map("due_at") @db.Timestamptz(6)
  status        ConsultationStatus @default(requested)
  response      Json?
  respondedById BigInt?            @map("responded_by")
  respondedAt   DateTime?          @map("responded_at") @db.Timestamptz(6)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  rfq         Rfq     @relation(fields: [rfqId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_rfq_factory_consultations__rfq_id")
  factory     Factory @relation("RfqConsultationFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_rfq_factory_consultations__factory_id")
  requestedBy User    @relation("RfqConsultationRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_rfq_factory_consultations__requested_by")
  respondedBy User?   @relation("RfqConsultationRespondedBy", fields: [respondedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_rfq_factory_consultations__responded_by")

  /// One open consultation per factory and RFQ.
  @@unique([rfqId, factoryId], map: "ux_rfq_factory_consultations__one_open", where: raw("(status = 'requested'::consultation_status)"))
  @@index([factoryId, status], map: "ix_rfq_factory_consultations__factory_id__status")
  @@index([rfqId], map: "ix_rfq_factory_consultations__rfq_id")
  @@index([requestedById], map: "ix_rfq_factory_consultations__requested_by")
  @@index([respondedById], map: "ix_rfq_factory_consultations__responded_by")
  @@map("rfq_factory_consultations")
}

/**
 * A versioned manual quotation for an RFQ; the accepted one becomes a `quotes` row (`source = rfq`).
 */
model RfqQuote {
  id          BigInt         @id(map: "pk_rfq_quotes") @default(autoincrement())
  publicId    String         @unique(map: "ux_rfq_quotes__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  rfqId       BigInt         @map("rfq_id")
  versionNo   Int            @map("version_no")
  status      RfqQuoteStatus @default(draft)
  validUntil  DateTime?      @map("valid_until") @db.Timestamptz(6)
  note        String         @default("")
  createdById BigInt         @map("created_by")
  sentAt      DateTime?      @map("sent_at") @db.Timestamptz(6)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  rfq       Rfq            @relation(fields: [rfqId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_rfq_quotes__rfq_id")
  createdBy User           @relation("RfqQuoteCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_rfq_quotes__created_by")
  lines     RfqQuoteLine[]
  quote     Quote?         @relation("QuoteRfqQuote")

  @@unique([rfqId, versionNo], map: "ux_rfq_quotes__rfq_id__version_no")
  /// One draft per RFQ; sending it supersedes the quotation the customer holds.
  @@unique([rfqId], map: "ux_rfq_quotes__one_draft", where: raw("(status = 'draft'::rfq_quote_status)"))
  /// One quotation in the customer's hands per RFQ.
  @@unique([rfqId], map: "ux_rfq_quotes__one_sent", where: raw("(status = 'sent'::rfq_quote_status)"))
  @@index([createdById], map: "ix_rfq_quotes__created_by")
  @@map("rfq_quotes")
}

/**
 * A quantity tier of an RFQ quotation; staff-only columns are never shown to the customer.
 */
model RfqQuoteLine {
  id                BigInt   @id(map: "pk_rfq_quote_lines") @default(autoincrement())
  rfqQuoteId        BigInt   @map("rfq_quote_id")
  quantity          Int
  unitPrice         Decimal  @map("unit_price") @db.Decimal(18, 6)
  netAmount         Decimal  @map("net_amount") @db.Decimal(14, 2)
  vatAmount         Decimal  @map("vat_amount") @db.Decimal(14, 2)
  grossAmount       Decimal  @map("gross_amount") @db.Decimal(14, 2)
  shippingNetAmount Decimal  @default(0) @map("shipping_net_amount") @db.Decimal(14, 2)
  leadTimeDays      Int      @map("lead_time_days") @db.SmallInt
  factoryId         BigInt?  @map("factory_id")
  buyUnitPrice      Decimal? @map("buy_unit_price") @db.Decimal(18, 6)
  marginPct         Decimal? @map("margin_pct") @db.Decimal(9, 4)
  belowMarginFloor  Boolean  @default(false) @map("below_margin_floor")

  rfqQuote RfqQuote @relation(fields: [rfqQuoteId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_rfq_quote_lines__rfq_quote_id")
  factory  Factory? @relation("RfqQuoteLineFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_rfq_quote_lines__factory_id")

  @@unique([rfqQuoteId, quantity], map: "ux_rfq_quote_lines__rfq_quote_id__quantity")
  @@index([factoryId], map: "ix_rfq_quote_lines__factory_id")
  @@map("rfq_quote_lines")
}

/**
 * Reason codes for declined / expired RFQs and unmet demand (D-102).
 */
model UnmetDemandReason {
  id        BigInt   @id(map: "pk_unmet_demand_reasons") @default(autoincrement())
  code      String   @unique(map: "ux_unmet_demand_reasons__code")
  nameTh    String   @map("name_th")
  nameEn    String   @map("name_en")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rfqs    Rfq[]
  records UnmetDemandRecord[]

  @@map("unmet_demand_reasons")
}

/**
 * Demand Packio could not serve (D-102): banded, no PII; source of the partner prospectus (B6).
 */
model UnmetDemandRecord {
  id             BigInt            @id(map: "pk_unmet_demand_records") @default(autoincrement())
  occurredAt     DateTime          @default(now()) @map("occurred_at") @db.Timestamptz(6)
  source         UnmetDemandSource
  reasonId       BigInt?           @map("reason_id")
  productTypeId  BigInt            @map("product_type_id")
  specBand       Json              @map("spec_band")
  quantityBand   String            @map("quantity_band")
  provinceId     BigInt?           @map("province_id")
  rfqId          BigInt?           @map("rfq_id")
  calculateLogId BigInt?           @map("calculate_log_id")
  domainEventId  String?           @unique(map: "ux_unmet_demand_records__domain_event_id") @map("domain_event_id") @db.Uuid
  /// D-252: the quotation that ended above its target (source price_above_target).
  quoteId        BigInt?           @map("quote_id")
  /// D-252: gap band in % of the target (`0-10`, `10-25`, `25-50`, `50+` from analytics.price_gap_bands_pct).
  priceGapBand   String?           @map("price_gap_band")
  /// Distinct-customer key for k-anonymity (`c<company>`, `u<user>`, `a<anonymous id>`, as the prospectus); never exported.
  customerKey    String?           @map("customer_key")
  /// D-274: the style base wanted (source style_not_publishable).
  styleBaseId    BigInt?           @map("style_base_id")

  reason      UnmetDemandReason? @relation(fields: [reasonId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_unmet_demand_records__reason_id")
  productType ProductType        @relation("UnmetDemandProductType", fields: [productTypeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_unmet_demand_records__product_type_id")
  province    GeoProvince?       @relation("UnmetDemandProvince", fields: [provinceId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_unmet_demand_records__province_id")
  rfq         Rfq?               @relation(fields: [rfqId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_unmet_demand_records__rfq_id")
  styleBase   StyleBase?         @relation("UnmetDemandStyleBase", fields: [styleBaseId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_unmet_demand_records__style_base_id")
  quote       Quote?             @relation("UnmetDemandQuote", fields: [quoteId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_unmet_demand_records__quote_id")

  @@index([productTypeId, occurredAt], map: "ix_unmet_demand_records__product_type_id__occurred_at")
  @@index([reasonId], map: "ix_unmet_demand_records__reason_id")
  @@index([provinceId], map: "ix_unmet_demand_records__province_id")
  @@index([rfqId], map: "ix_unmet_demand_records__rfq_id")
  @@index([quoteId], map: "ix_unmet_demand_records__quote_id")
  @@index([occurredAt], map: "ix_unmet_demand_records__occurred_at")
  @@index([styleBaseId], map: "ix_unmet_demand_records__style_base_id")
  @@map("unmet_demand_records")
}

/// D-185: a draft is `open` until it becomes a quote or an RFQ (`converted`).
enum ConfigurationDraftStatus {
  open
  converted

  @@map("configuration_draft_status")
}

/// D-185 (U2.1, A-83): an incomplete configuration a signed-in customer keeps, resumes, shares and converts to a quote
/// or an RFQ; deleted `configurations.draft_retention_days` after its last change.
model ConfigurationDraft {
  id                 BigInt                   @id(map: "pk_configuration_drafts") @default(autoincrement())
  publicId           String                   @unique(map: "ux_configuration_drafts__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  ownerUserId        BigInt                   @map("owner_user_id")
  productTypeId      BigInt                   @map("product_type_id")
  catalogProductId   BigInt?                  @map("catalog_product_id")
  title              String?
  configuration      Json                     @default("{}")
  /// 0–100: the share of the calculator's required fields given (D-185).
  completenessPct    Decimal                  @default(0) @map("completeness_pct") @db.Decimal(5, 2)
  missingFields      String[]                 @default([]) @map("missing_fields")
  /// D-247: the customer's target per unit (THB incl. VAT, excl. shipping), carried to the quote or RFQ.
  targetPricePerUnit Decimal?                 @map("target_price_per_unit") @db.Decimal(14, 2)
  status             ConfigurationDraftStatus @default(open)
  convertedQuoteId   BigInt?                  @map("converted_quote_id")
  convertedRfqId     BigInt?                  @map("converted_rfq_id")
  shareTokenHash     Bytes?                   @unique(map: "ux_configuration_drafts__share_token_hash") @map("share_token_hash")
  sharedAt           DateTime?                @map("shared_at") @db.Timestamptz(6)
  shareExpiresAt     DateTime?                @map("share_expires_at") @db.Timestamptz(6)
  lastChangedAt      DateTime                 @default(now()) @map("last_changed_at") @db.Timestamptz(6)
  expiresAt          DateTime                 @map("expires_at") @db.Timestamptz(6)
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion         Int                      @default(1) @map("row_version")

  owner          User            @relation("ConfigurationDraftOwner", fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_configuration_drafts__owner_user_id")
  productType    ProductType     @relation("ConfigurationDraftProductType", fields: [productTypeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_configuration_drafts__product_type_id")
  catalogProduct CatalogProduct? @relation("ConfigurationDraftCatalogProduct", fields: [catalogProductId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_configuration_drafts__catalog_product_id")
  convertedQuote Quote?          @relation("ConfigurationDraftQuote", fields: [convertedQuoteId], references: [id], onDelete: SetNull, onUpdate: Restrict, map: "fk_configuration_drafts__converted_quote_id")
  convertedRfq   Rfq?            @relation("ConfigurationDraftRfq", fields: [convertedRfqId], references: [id], onDelete: SetNull, onUpdate: Restrict, map: "fk_configuration_drafts__converted_rfq_id")

  samples Sample[] @relation("SampleSourceDraft")

  @@index([ownerUserId, status, lastChangedAt], map: "ix_configuration_drafts__owner_user_id__status__last_changed_at")
  @@index([expiresAt], map: "ix_configuration_drafts__expires_at")
  @@index([productTypeId], map: "ix_configuration_drafts__product_type_id")
  @@index([catalogProductId], map: "ix_configuration_drafts__catalog_product_id")
  @@index([convertedQuoteId], map: "ix_configuration_drafts__converted_quote_id")
  @@index([convertedRfqId], map: "ix_configuration_drafts__converted_rfq_id")
  @@map("configuration_drafts")
}

// --- Target price, levers, outcomes (U2.3, D-247–D-252, schema-design A-89) ---------------------------

/// D-248: what a lever changes.
enum QuoteLeverKind {
  quantity
  material
  back_print
  special_finish
  coating
  assembly

  @@map("quote_lever_kind")
}

/// D-248 (A-89): one alternative to a saved quotation above its target, re-priced by the real engine; write-once,
/// computed on the first request and valid until the quotation's `valid_until`.
model QuoteLever {
  id            BigInt         @id(map: "pk_quote_levers") @default(autoincrement())
  publicId      String         @unique(map: "ux_quote_levers__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  quoteId       BigInt         @map("quote_id")
  rank          Int            @db.SmallInt
  kind          QuoteLeverKind
  /// The fields changed against the quotation's configuration (path → { from, to }).
  changes       Json
  /// The full configuration the lever was priced with (saved as a new quotation when taken, D-249).
  configuration Json
  /// Re-priced instant steps: quantity, unitPrice, grossAmount, leadTimeDays, gap, gapPct, meetsTarget.
  steps         Json
  reasonCodes   String[]       @map("reason_codes")
  /// Largest unit-price saving against the quotation at a quoted quantity, % (quantity levers: against the largest).
  bestSavingPct Decimal        @map("best_saving_pct") @db.Decimal(9, 4)
  validUntil    DateTime       @map("valid_until") @db.Timestamptz(6)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  quote    Quote          @relation("QuoteLevers", fields: [quoteId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_quote_levers__quote_id")
  takenBy  Quote?         @relation("QuoteFromLever")
  outcomes QuoteOutcome[] @relation("QuoteOutcomeLever")

  @@unique([quoteId, rank], map: "ux_quote_levers__quote_id__rank")
  @@map("quote_levers")
}

/// D-250: how a saved quotation ended.
enum QuoteOutcomeKind {
  won
  lost
  expired
  converted_to_rfq
  revised

  @@map("quote_outcome_kind")
}

/// D-250: why a customer declined a quotation (optional for the customer).
model QuoteLossReason {
  id        BigInt   @id(map: "pk_quote_loss_reasons") @default(autoincrement())
  code      String   @unique(map: "ux_quote_loss_reasons__code")
  nameTh    String   @map("name_th")
  nameEn    String   @map("name_en")
  active    Boolean  @default(true)
  sort      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  outcomes QuoteOutcome[]

  @@map("quote_loss_reasons")
}

/// D-250 (A-89): one write-once outcome per saved quotation, with the target, the gap and the levers.
model QuoteOutcome {
  id                 BigInt           @id(map: "pk_quote_outcomes") @default(autoincrement())
  quoteId            BigInt           @unique(map: "ux_quote_outcomes__quote_id") @map("quote_id")
  outcome            QuoteOutcomeKind
  occurredAt         DateTime         @default(now()) @map("occurred_at") @db.Timestamptz(6)
  targetPricePerUnit Decimal?         @map("target_price_per_unit") @db.Decimal(14, 2)
  /// The quantity the gap is measured at: the ordered one when won, else the one with the smallest gap.
  quantity           Int?
  unitPrice          Decimal?         @map("unit_price") @db.Decimal(18, 6)
  gapPerUnit         Decimal?         @map("gap_per_unit") @db.Decimal(18, 6)
  gapPct             Decimal?         @map("gap_pct") @db.Decimal(9, 4)
  leversShown        Int              @default(0) @map("levers_shown") @db.SmallInt
  leverTakenId       BigInt?          @map("lever_taken_id")
  lossReasonId       BigInt?          @map("loss_reason_id")
  lossNote           String?          @map("loss_note")
  orderId            BigInt?          @map("order_id")
  rfqId              BigInt?          @map("rfq_id")

  quote      Quote            @relation("QuoteOutcomeQuote", fields: [quoteId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_quote_outcomes__quote_id")
  leverTaken QuoteLever?      @relation("QuoteOutcomeLever", fields: [leverTakenId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_quote_outcomes__lever_taken_id")
  lossReason QuoteLossReason? @relation(fields: [lossReasonId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_quote_outcomes__loss_reason_id")
  order      Order?           @relation("QuoteOutcomeOrder", fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_quote_outcomes__order_id")
  rfq        Rfq?             @relation("QuoteOutcomeRfq", fields: [rfqId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_quote_outcomes__rfq_id")

  @@index([outcome, occurredAt], map: "ix_quote_outcomes__outcome__occurred_at")
  @@index([leverTakenId], map: "ix_quote_outcomes__lever_taken_id")
  @@index([lossReasonId], map: "ix_quote_outcomes__loss_reason_id")
  @@index([orderId], map: "ix_quote_outcomes__order_id")
  @@index([rfqId], map: "ix_quote_outcomes__rfq_id")
  @@map("quote_outcomes")
}
