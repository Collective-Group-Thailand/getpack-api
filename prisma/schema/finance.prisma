// Finance context (docs/schema-design.md §3.8, B5). Only `vendors` and `vendor_bank_accounts` exist
// before B5: they migrate early with the partners context (B2.2) because every factory is a vendor
// (the AP identity) and its bank account is verified during onboarding (accounting-design.md §8).

enum VendorKind {
  factory
  carrier
  freelancer
  service
  other

  @@map("vendor_kind")
}

/// Not in the §4 catalogue (schema-design §7 A-20).
enum VendorStatus {
  active
  inactive

  @@map("vendor_status")
}

enum WhtCategory {
  hire_of_work
  transport
  service
  none

  @@map("wht_category")
}

enum BankAccountStatus {
  pending_approval
  active
  superseded
  rejected

  @@map("bank_account_status")
}

model Vendor {
  id                 BigInt       @id(map: "pk_vendors") @default(autoincrement())
  publicId           String       @unique(map: "ux_vendors__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  kind               VendorKind
  legalName          String       @map("legal_name")
  /// → ภ.ง.ด.3 (individual) vs ภ.ง.ด.53 (juristic).
  juristicType       JuristicType @map("juristic_type")
  taxId              String       @map("tax_id") @db.Char(13)
  branchCode         String       @default("00000") @map("branch_code") @db.Char(5)
  isVatRegistered    Boolean      @default(false) @map("is_vat_registered")
  addressLine1       String?      @map("address_line1")
  addressLine2       String?      @map("address_line2")
  subdistrictId      BigInt?      @map("subdistrict_id")
  postcode           String?      @db.Char(5)
  defaultWhtCategory WhtCategory  @default(none) @map("default_wht_category")
  paymentTermsDays   Int          @default(0) @map("payment_terms_days") @db.SmallInt
  status             VendorStatus @default(active)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById        BigInt?      @map("created_by")
  updatedAt          DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById        BigInt?      @map("updated_by")
  rowVersion         Int          @default(1) @map("row_version")

  subdistrict  GeoSubdistrict?     @relation("VendorSubdistrict", fields: [subdistrictId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_vendors__subdistrict_id")
  factory      Factory?
  bankAccounts VendorBankAccount[]
  createdBy    User?               @relation("VendorCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_vendors__created_by")
  updatedBy    User?               @relation("VendorUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_vendors__updated_by")

  // --- Fulfilment B4.1 (generated back-relations)
  designServiceRequests DesignServiceRequest[] @relation("DesignServiceRequestVendor")
  // --- end Fulfilment B4.1

  // --- Finance B5.1 (generated back-relations)
  journalLines JournalLine[] @relation("JournalLineVendor")
  // --- end Finance B5.1

  @@index([taxId, branchCode], map: "ix_vendors__tax_id__branch_code")
  @@index([subdistrictId], map: "ix_vendors__subdistrict_id")
  @@map("vendors")
}

/// Never updated in place (trigger): a change is a new row with dual approval; the approved row
/// supersedes the previous active one. The number is stored encrypted, with its last 4 digits and a
/// keyed hash for duplicate detection (accounting-design.md §8; PDPA: never logged).
model VendorBankAccount {
  id                BigInt            @id(map: "pk_vendor_bank_accounts") @default(autoincrement())
  publicId          String            @unique(map: "ux_vendor_bank_accounts__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  vendorId          BigInt            @map("vendor_id")
  bankCode          String            @map("bank_code")
  branchName        String?           @map("branch_name")
  accountName       String            @map("account_name")
  accountNoEnc      Bytes             @map("account_no_enc")
  accountNoLast4    String            @map("account_no_last4") @db.Char(4)
  accountNoHash     Bytes             @map("account_no_hash")
  status            BankAccountStatus @default(pending_approval)
  approvalRequestId BigInt?           @map("approval_request_id")
  /// Who called, the number called (masked), when, outcome — recorded on the Finance step (§8).
  verificationCall  Json?             @map("verification_call")
  effectiveFrom     DateTime?         @map("effective_from") @db.Timestamptz(6)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById       BigInt?           @map("created_by")
  decidedAt         DateTime?         @map("decided_at") @db.Timestamptz(6)

  vendor          Vendor           @relation(fields: [vendorId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_vendor_bank_accounts__vendor_id")
  approvalRequest ApprovalRequest? @relation("VendorBankAccountApprovalRequest", fields: [approvalRequestId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_vendor_bank_accounts__approval_request_id")
  createdBy       User?            @relation("VendorBankAccountCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_vendor_bank_accounts__created_by")

  @@unique([vendorId], map: "ux_vendor_bank_accounts__one_active", where: raw("(status = 'active'::bank_account_status)"))
  @@index([vendorId, createdAt(sort: Desc)], map: "ix_vendor_bank_accounts__vendor_id__created_at")
  @@index([accountNoHash], map: "ix_vendor_bank_accounts__account_no_hash")
  @@index([approvalRequestId], map: "ix_vendor_bank_accounts__approval_request_id")
  @@map("vendor_bank_accounts")
}

/// Statutory rates (schema-design §3.8), migrated early in B2.3 so quotes snapshot the VAT rate
/// version they used (schema-design §7 A-22). Changes go through `tax_setting_change` (D-169).
model TaxRate {
  id           BigInt   @id(map: "pk_tax_rates") @default(autoincrement())
  publicId     String   @unique(map: "ux_tax_rates__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  /// `vat_standard`, `wht_hire_of_work`, `wht_transport`, …
  code         String   @unique(map: "ux_tax_rates__code")
  nameTh       String   @map("name_th")
  nameEn       String   @map("name_en")
  description  String
  decisionRefs String[] @map("decision_refs")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById  BigInt?  @map("created_by")

  versions  TaxRateVersion[]
  createdBy User?            @relation("TaxRateCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_tax_rates__created_by")

  @@map("tax_rates")
}

/// Versioned (schema-design §2.1): rate changes are dated, never edited in place (accounting §2).
model TaxRateVersion {
  id                BigInt              @id(map: "pk_tax_rate_versions") @default(autoincrement())
  publicId          String              @unique(map: "ux_tax_rate_versions__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  taxRateId         BigInt              @map("tax_rate_id")
  versionNo         Int                 @map("version_no")
  effectiveFrom     DateTime            @map("effective_from") @db.Timestamptz(6)
  status            ConfigVersionStatus @default(draft)
  ratePct           Decimal             @map("rate_pct") @db.Decimal(7, 4)
  reason            String
  approvalRequestId BigInt?             @map("approval_request_id")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById       BigInt?             @map("created_by")
  decidedAt         DateTime?           @map("decided_at") @db.Timestamptz(6)
  decidedById       BigInt?             @map("decided_by")

  taxRate         TaxRate          @relation(fields: [taxRateId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_tax_rate_versions__tax_rate_id")
  approvalRequest ApprovalRequest? @relation("TaxRateVersionApprovalRequest", fields: [approvalRequestId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_tax_rate_versions__approval_request_id")
  createdBy       User?            @relation("TaxRateVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_tax_rate_versions__created_by")
  decidedBy       User?            @relation("TaxRateVersionDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_tax_rate_versions__decided_by")

  @@unique([taxRateId, versionNo], map: "ux_tax_rate_versions__tax_rate_id__version_no")
  @@index([taxRateId, effectiveFrom(sort: Desc), versionNo(sort: Desc)], map: "ix_tax_rate_versions__resolution", where: raw("(status = 'approved'::config_version_status)"))
  @@index([approvalRequestId], map: "ix_tax_rate_versions__approval_request_id")
  @@map("tax_rate_versions")
}

// ================================================================================================
// Ledger core (B5.1, accounting-design.md §1, §3, §5; schema-design §3.8). The ledger is the single
// financial truth: sub-ledgers post to it only through the posting engine (ADR-0007). Balance, period,
// control-account and immutability rules are enforced by hand-written triggers in the migration SQL.
// ================================================================================================

enum PeriodStatus {
  open
  soft_closed
  closed
  locked

  @@map("period_status")
}

enum AccountType {
  asset
  liability
  equity
  revenue
  cost_of_sales
  expense

  @@map("account_type")
}

enum LedgerSide {
  debit
  credit

  @@map("ledger_side")
}

/// Dimensions a journal line may carry (accounting-design §3).
enum LedgerDimension {
  order
  order_group
  customer
  company
  factory
  vendor
  product_type
  channel
  campaign
  promotion
  cost_centre

  @@map("ledger_dimension")
}

/// Not in the §4 catalogue (schema-design §7 A-41): accounts are deactivated, never deleted.
enum AccountStatus {
  active
  inactive

  @@map("account_status")
}

/// Indirect cash-flow classification of an account (B5.6, schema-design §7 A-41).
enum CashFlowClass {
  cash
  operating
  investing
  financing
  equity
  non_cash

  @@map("cash_flow_class")
}

enum JournalKind {
  auto
  manual
  reversal
  recurring
  closing

  @@map("journal_kind")
}

/// `rejected` added to the §4 catalogue (schema-design §7 A-41): a manual journal the checker refused.
enum JournalStatus {
  draft
  pending_approval
  posted
  rejected

  @@map("journal_status")
}

enum TaxCode {
  output_vat
  output_vat_not_due
  input_vat
  input_vat_pending
  wht_receivable
  wht_pnd3
  wht_pnd53

  @@map("tax_code")
}

enum AccountChangeKind {
  create
  update
  deactivate
  reactivate

  @@map("account_change_kind")
}

enum RecurringJournalStatus {
  pending_approval
  active
  paused
  ended
  rejected

  @@map("recurring_journal_status")
}

model FiscalYear {
  id          BigInt       @id(map: "pk_fiscal_years") @default(autoincrement())
  publicId    String       @unique(map: "ux_fiscal_years__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  entityId    BigInt       @map("entity_id")
  label       String
  startDate   DateTime     @map("start_date") @db.Date
  endDate     DateTime     @map("end_date") @db.Date
  status      PeriodStatus @default(open)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById BigInt?      @map("created_by")
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  entity    Entity         @relation("FiscalYearEntity", fields: [entityId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_fiscal_years__entity_id")
  createdBy User?          @relation("FiscalYearCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_fiscal_years__created_by")
  periods   FiscalPeriod[]

  @@unique([entityId, startDate], map: "ux_fiscal_years__entity_id__start_date")
  @@index([createdById], map: "ix_fiscal_years__created_by")
  @@map("fiscal_years")
}

/// Monthly periods `open → soft_closed → closed → locked` (accounting-design §1.4). Postings into a
/// period that is not open are rejected by trigger (soft-closed: only with `ledger.post_soft_closed`).
model FiscalPeriod {
  id                BigInt       @id(map: "pk_fiscal_periods") @default(autoincrement())
  publicId          String       @unique(map: "ux_fiscal_periods__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  entityId          BigInt       @map("entity_id")
  fiscalYearId      BigInt       @map("fiscal_year_id")
  periodNo          Int          @map("period_no") @db.SmallInt
  startDate         DateTime     @map("start_date") @db.Date
  endDate           DateTime     @map("end_date") @db.Date
  status            PeriodStatus @default(open)
  statusChangedAt   DateTime?    @map("status_changed_at") @db.Timestamptz(6)
  statusChangedById BigInt?      @map("status_changed_by")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  entity          Entity         @relation("FiscalPeriodEntity", fields: [entityId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_fiscal_periods__entity_id")
  fiscalYear      FiscalYear     @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_fiscal_periods__fiscal_year_id")
  statusChangedBy User?          @relation("FiscalPeriodStatusChangedBy", fields: [statusChangedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_fiscal_periods__status_changed_by")
  journalEntries  JournalEntry[]
  journalLines    JournalLine[]

  // --- Finance B5.2 (generated back-relations)
  badDebtProvisions BadDebtProvision[]
  // --- end Finance B5.2

  @@unique([entityId, startDate], map: "ux_fiscal_periods__entity_id__start_date")
  @@unique([fiscalYearId, periodNo], map: "ux_fiscal_periods__fiscal_year_id__period_no")
  @@index([statusChangedById], map: "ix_fiscal_periods__status_changed_by")
  @@map("fiscal_periods")
}

/// Chart of accounts (accounting-design §3; codes are defaults ⚖). Changes go through
/// `account_changes` and the `coa_change` approval (§8, D-169).
model Account {
  id                 BigInt            @id(map: "pk_accounts") @default(autoincrement())
  publicId           String            @unique(map: "ux_accounts__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  entityId           BigInt            @map("entity_id")
  code               String
  nameTh             String            @map("name_th")
  nameEn             String            @map("name_en")
  accountType        AccountType       @map("account_type")
  normalSide         LedgerSide        @map("normal_side")
  parentId           BigInt?           @map("parent_id")
  /// 1210, 2110, 2120, 1250: only sub-ledger (automatic) postings (§3).
  isControl          Boolean           @default(false) @map("is_control")
  isPostable         Boolean           @default(true) @map("is_postable")
  allowedDimensions  LedgerDimension[] @map("allowed_dimensions")
  requiredDimensions LedgerDimension[] @map("required_dimensions")
  cashFlowClass      CashFlowClass     @map("cash_flow_class")
  status             AccountStatus     @default(active)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById        BigInt?           @map("created_by")
  updatedAt          DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById        BigInt?           @map("updated_by")
  rowVersion         Int               @default(1) @map("row_version")

  entity       Entity          @relation("AccountEntity", fields: [entityId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_accounts__entity_id")
  parent       Account?        @relation("AccountParent", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_accounts__parent_id")
  children     Account[]       @relation("AccountParent")
  createdBy    User?           @relation("AccountCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_accounts__created_by")
  updatedBy    User?           @relation("AccountUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_accounts__updated_by")
  journalLines JournalLine[]
  changes      AccountChange[]

  @@unique([entityId, code], map: "ux_accounts__entity_id__code")
  @@index([parentId], map: "ix_accounts__parent_id")
  @@index([createdById], map: "ix_accounts__created_by")
  @@index([updatedById], map: "ix_accounts__updated_by")
  @@map("accounts")
}

/// A proposed chart-of-accounts change awaiting the `coa_change` approval (maker-checker, §8);
/// applied to `accounts` only when approved (schema-design §7 A-41).
model AccountChange {
  id                BigInt              @id(map: "pk_account_changes") @default(autoincrement())
  publicId          String              @unique(map: "ux_account_changes__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  entityId          BigInt              @map("entity_id")
  accountId         BigInt?             @map("account_id")
  kind              AccountChangeKind
  proposed          Json
  reason            String
  status            ConfigVersionStatus @default(proposed)
  approvalRequestId BigInt?             @map("approval_request_id")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById       BigInt              @map("created_by")
  decidedAt         DateTime?           @map("decided_at") @db.Timestamptz(6)

  entity          Entity           @relation("AccountChangeEntity", fields: [entityId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_account_changes__entity_id")
  account         Account?         @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_account_changes__account_id")
  approvalRequest ApprovalRequest? @relation("AccountChangeApprovalRequest", fields: [approvalRequestId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_account_changes__approval_request_id")
  createdBy       User             @relation("AccountChangeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_account_changes__created_by")

  @@index([entityId], map: "ix_account_changes__entity_id")
  @@index([accountId], map: "ix_account_changes__account_id")
  @@index([approvalRequestId], map: "ix_account_changes__approval_request_id")
  @@index([createdById], map: "ix_account_changes__created_by")
  @@map("account_changes")
}

model CostCentre {
  id          BigInt        @id(map: "pk_cost_centres") @default(autoincrement())
  publicId    String        @unique(map: "ux_cost_centres__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  entityId    BigInt        @map("entity_id")
  code        String
  name        String
  status      AccountStatus @default(active)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById BigInt?       @map("created_by")

  entity       Entity        @relation("CostCentreEntity", fields: [entityId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_cost_centres__entity_id")
  createdBy    User?         @relation("CostCentreCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_cost_centres__created_by")
  journalLines JournalLine[]

  @@unique([entityId, code], map: "ux_cost_centres__entity_id__code")
  @@index([createdById], map: "ix_cost_centres__created_by")
  @@map("cost_centres")
}

/// Immutable once posted; corrections are reversing entries linked to the original (§1.2). The posting
/// engine is idempotent per (domain event, rule).
model JournalEntry {
  id                     BigInt        @id(map: "pk_journal_entries") @default(autoincrement())
  publicId               String        @unique(map: "ux_journal_entries__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  entityId               BigInt        @map("entity_id")
  /// Per entity / month running number, assigned at posting.
  entryNo                String?       @map("entry_no")
  /// JV document number of a manual journal (§4).
  jvNumber               String?       @map("jv_number")
  fiscalPeriodId         BigInt        @map("fiscal_period_id")
  /// Posting date.
  entryDate              DateTime      @map("entry_date") @db.Date
  /// Original document date, kept for tax when posted late (§1.4).
  documentDate           DateTime      @map("document_date") @db.Date
  kind                   JournalKind
  status                 JournalStatus @default(draft)
  sourceDocumentType     String?       @map("source_document_type")
  sourceDocumentPublicId String?       @map("source_document_public_id") @db.Uuid
  sourceDocumentNo       String?       @map("source_document_no")
  domainEventId          String?       @map("domain_event_id") @db.Uuid
  postingRuleId          BigInt?       @map("posting_rule_id")
  postingRuleVersionId   BigInt?       @map("posting_rule_version_id")
  reversesEntryId        BigInt?       @unique(map: "ux_journal_entries__reverses_entry_id") @map("reverses_entry_id")
  recurringJournalId     BigInt?       @map("recurring_journal_id")
  /// Auto-reversing journal: its reversal is posted on this date (B5.1).
  autoReverseOn          DateTime?     @map("auto_reverse_on") @db.Date
  description            String
  totalDebit             Decimal       @default(0) @map("total_debit") @db.Decimal(14, 2)
  totalCredit            Decimal       @default(0) @map("total_credit") @db.Decimal(14, 2)
  approvalRequestId      BigInt?       @map("approval_request_id")
  rejectionReason        String?       @map("rejection_reason")
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById            BigInt?       @map("created_by")
  approvedAt             DateTime?     @map("approved_at") @db.Timestamptz(6)
  approvedById           BigInt?       @map("approved_by")
  postedAt               DateTime?     @map("posted_at") @db.Timestamptz(6)
  postedById             BigInt?       @map("posted_by")
  updatedAt              DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion             Int           @default(1) @map("row_version")

  entity             Entity              @relation("JournalEntryEntity", fields: [entityId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_journal_entries__entity_id")
  fiscalPeriod       FiscalPeriod        @relation(fields: [fiscalPeriodId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_journal_entries__fiscal_period_id")
  domainEvent        DomainEvent?        @relation("JournalEntryDomainEvent", fields: [domainEventId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_journal_entries__domain_event_id")
  postingRule        PostingRule?        @relation(fields: [postingRuleId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_journal_entries__posting_rule_id")
  postingRuleVersion PostingRuleVersion? @relation(fields: [postingRuleVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_journal_entries__posting_rule_version_id")
  reverses           JournalEntry?       @relation("JournalEntryReversal", fields: [reversesEntryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_journal_entries__reverses_entry_id")
  reversedBy         JournalEntry?       @relation("JournalEntryReversal")
  recurringJournal   RecurringJournal?   @relation(fields: [recurringJournalId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_journal_entries__recurring_journal_id")
  approvalRequest    ApprovalRequest?    @relation("JournalEntryApprovalRequest", fields: [approvalRequestId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_journal_entries__approval_request_id")
  createdBy          User?               @relation("JournalEntryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_journal_entries__created_by")
  approvedBy         User?               @relation("JournalEntryApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_journal_entries__approved_by")
  postedBy           User?               @relation("JournalEntryPostedBy", fields: [postedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_journal_entries__posted_by")
  lines              JournalLine[]

  @@unique([entityId, entryNo], map: "ux_journal_entries__entity_id__entry_no")
  @@unique([domainEventId, postingRuleId], map: "ux_journal_entries__domain_event_id__posting_rule_id", where: raw("(domain_event_id IS NOT NULL)"))
  @@index([fiscalPeriodId, status], map: "ix_journal_entries__fiscal_period_id__status")
  @@index([entityId, entryDate], map: "ix_journal_entries__entity_id__entry_date")
  @@index([sourceDocumentType, sourceDocumentPublicId], map: "ix_journal_entries__source_document")
  @@index([postingRuleId], map: "ix_journal_entries__posting_rule_id")
  @@index([postingRuleVersionId], map: "ix_journal_entries__posting_rule_version_id")
  @@index([recurringJournalId], map: "ix_journal_entries__recurring_journal_id")
  @@index([approvalRequestId], map: "ix_journal_entries__approval_request_id")
  @@index([createdById], map: "ix_journal_entries__created_by")
  @@index([approvedById], map: "ix_journal_entries__approved_by")
  @@index([postedById], map: "ix_journal_entries__posted_by")
  @@index([autoReverseOn], map: "ix_journal_entries__auto_reverse_on", where: raw("(auto_reverse_on IS NOT NULL)"))
  @@map("journal_entries")
}

/// One side of a journal (debit xor credit) with the dimensions of accounting-design §3 and the tax
/// tagging the tax reports reconcile to (B5.4). `entity_id`, `fiscal_period_id`, `entry_date` are copied
/// from the entry (trigger) for reporting.
model JournalLine {
  id             BigInt        @id(map: "pk_journal_lines") @default(autoincrement())
  journalEntryId BigInt        @map("journal_entry_id")
  lineNo         Int           @map("line_no") @db.SmallInt
  accountId      BigInt        @map("account_id")
  debit          Decimal       @default(0) @db.Decimal(14, 2)
  credit         Decimal       @default(0) @db.Decimal(14, 2)
  description    String?
  orderId        BigInt?       @map("order_id")
  orderGroupId   BigInt?       @map("order_group_id")
  customerUserId BigInt?       @map("customer_user_id")
  companyId      BigInt?       @map("company_id")
  factoryId      BigInt?       @map("factory_id")
  vendorId       BigInt?       @map("vendor_id")
  productTypeId  BigInt?       @map("product_type_id")
  channel        SalesChannel?
  campaignId     BigInt?       @map("campaign_id")
  promotionId    BigInt?       @map("promotion_id")
  costCentreId   BigInt?       @map("cost_centre_id")
  taxCode        TaxCode?      @map("tax_code")
  taxBaseAmount  Decimal?      @map("tax_base_amount") @db.Decimal(14, 2)
  entityId       BigInt        @map("entity_id")
  fiscalPeriodId BigInt        @map("fiscal_period_id")
  entryDate      DateTime      @map("entry_date") @db.Date
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_journal_lines__journal_entry_id")
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_journal_lines__account_id")
  order        Order?       @relation("JournalLineOrder", fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_journal_lines__order_id")
  orderGroup   OrderGroup?  @relation("JournalLineOrderGroup", fields: [orderGroupId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_journal_lines__order_group_id")
  customer     User?        @relation("JournalLineCustomer", fields: [customerUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_journal_lines__customer_user_id")
  company      Company?     @relation("JournalLineCompany", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_journal_lines__company_id")
  factory      Factory?     @relation("JournalLineFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_journal_lines__factory_id")
  vendor       Vendor?      @relation("JournalLineVendor", fields: [vendorId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_journal_lines__vendor_id")
  productType  ProductType? @relation("JournalLineProductType", fields: [productTypeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_journal_lines__product_type_id")
  campaign     Campaign?    @relation("JournalLineCampaign", fields: [campaignId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_journal_lines__campaign_id")
  promotion    Promotion?   @relation("JournalLinePromotion", fields: [promotionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_journal_lines__promotion_id")
  costCentre   CostCentre?  @relation(fields: [costCentreId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_journal_lines__cost_centre_id")
  entity       Entity       @relation("JournalLineEntity", fields: [entityId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_journal_lines__entity_id")
  fiscalPeriod FiscalPeriod @relation(fields: [fiscalPeriodId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_journal_lines__fiscal_period_id")

  @@unique([journalEntryId, lineNo], map: "ux_journal_lines__journal_entry_id__line_no")
  @@index([accountId, entryDate], map: "ix_journal_lines__account_id__entry_date")
  @@index([entityId, fiscalPeriodId, accountId], map: "ix_journal_lines__entity_id__fiscal_period_id__account_id")
  @@index([fiscalPeriodId], map: "ix_journal_lines__fiscal_period_id")
  @@index([orderId], map: "ix_journal_lines__order_id", where: raw("(order_id IS NOT NULL)"))
  @@index([orderGroupId], map: "ix_journal_lines__order_group_id", where: raw("(order_group_id IS NOT NULL)"))
  @@index([customerUserId], map: "ix_journal_lines__customer_user_id", where: raw("(customer_user_id IS NOT NULL)"))
  @@index([companyId], map: "ix_journal_lines__company_id", where: raw("(company_id IS NOT NULL)"))
  @@index([factoryId], map: "ix_journal_lines__factory_id", where: raw("(factory_id IS NOT NULL)"))
  @@index([vendorId], map: "ix_journal_lines__vendor_id", where: raw("(vendor_id IS NOT NULL)"))
  @@index([productTypeId], map: "ix_journal_lines__product_type_id", where: raw("(product_type_id IS NOT NULL)"))
  @@index([campaignId], map: "ix_journal_lines__campaign_id", where: raw("(campaign_id IS NOT NULL)"))
  @@index([promotionId], map: "ix_journal_lines__promotion_id", where: raw("(promotion_id IS NOT NULL)"))
  @@index([costCentreId], map: "ix_journal_lines__cost_centre_id", where: raw("(cost_centre_id IS NOT NULL)"))
  @@index([taxCode, entryDate], map: "ix_journal_lines__tax_code__entry_date", where: raw("(tax_code IS NOT NULL)"))
  @@map("journal_lines")
}

/// Posting rules as data (ADR-0007): the identity names the event it listens to; versions hold the
/// conditions and the journal template. Changes go through `posting_rule_change` (§8, D-169).
model PostingRule {
  id           BigInt   @id(map: "pk_posting_rules") @default(autoincrement())
  publicId     String   @unique(map: "ux_posting_rules__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  /// `P01` … `P30` (accounting-design §5) and the supplementary rules of ADR-0007.
  key          String   @unique(map: "ux_posting_rules__key")
  eventType    String   @map("event_type")
  name         String
  description  String
  decisionRefs String[] @map("decision_refs")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById  BigInt?  @map("created_by")

  createdBy      User?                @relation("PostingRuleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_posting_rules__created_by")
  versions       PostingRuleVersion[]
  journalEntries JournalEntry[]

  @@index([eventType], map: "ix_posting_rules__event_type")
  @@index([createdById], map: "ix_posting_rules__created_by")
  @@map("posting_rules")
}

/// Versioned (schema-design §2.1).
model PostingRuleVersion {
  id                BigInt              @id(map: "pk_posting_rule_versions") @default(autoincrement())
  publicId          String              @unique(map: "ux_posting_rule_versions__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  postingRuleId     BigInt              @map("posting_rule_id")
  versionNo         Int                 @map("version_no")
  effectiveFrom     DateTime            @map("effective_from") @db.Timestamptz(6)
  status            ConfigVersionStatus @default(draft)
  /// Approval-engine condition shape over `payload.<path>` of the event (null = always).
  conditions        Json?
  /// Journal template: description, date, source, dimensions and lines (ADR-0007).
  template          Json
  reason            String
  approvalRequestId BigInt?             @map("approval_request_id")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById       BigInt?             @map("created_by")
  decidedAt         DateTime?           @map("decided_at") @db.Timestamptz(6)
  decidedById       BigInt?             @map("decided_by")

  postingRule     PostingRule      @relation(fields: [postingRuleId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_posting_rule_versions__posting_rule_id")
  approvalRequest ApprovalRequest? @relation("PostingRuleVersionApprovalRequest", fields: [approvalRequestId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_posting_rule_versions__approval_request_id")
  createdBy       User?            @relation("PostingRuleVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_posting_rule_versions__created_by")
  decidedBy       User?            @relation("PostingRuleVersionDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_posting_rule_versions__decided_by")
  journalEntries  JournalEntry[]

  @@unique([postingRuleId, versionNo], map: "ux_posting_rule_versions__posting_rule_id__version_no")
  @@index([postingRuleId, effectiveFrom(sort: Desc), versionNo(sort: Desc)], map: "ix_posting_rule_versions__resolution", where: raw("(status = 'approved'::config_version_status)"))
  @@index([approvalRequestId], map: "ix_posting_rule_versions__approval_request_id")
  @@index([createdById], map: "ix_posting_rule_versions__created_by")
  @@index([decidedById], map: "ix_posting_rule_versions__decided_by")
  @@map("posting_rule_versions")
}

/// A recurring journal definition, approved once like a manual journal; each run posts a
/// `recurring` entry (optionally auto-reversed next period).
model RecurringJournal {
  id                BigInt                 @id(map: "pk_recurring_journals") @default(autoincrement())
  publicId          String                 @unique(map: "ux_recurring_journals__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  entityId          BigInt                 @map("entity_id")
  name              String
  description       String
  dayOfMonth        Int                    @map("day_of_month") @db.SmallInt
  /// Lines: account code, side, amount, description, dimensions.
  template          Json
  autoReverse       Boolean                @default(false) @map("auto_reverse")
  startOn           DateTime               @map("start_on") @db.Date
  endOn             DateTime?              @map("end_on") @db.Date
  nextRunOn         DateTime               @map("next_run_on") @db.Date
  status            RecurringJournalStatus @default(pending_approval)
  approvalRequestId BigInt?                @map("approval_request_id")
  approvedAt        DateTime?              @map("approved_at") @db.Timestamptz(6)
  approvedById      BigInt?                @map("approved_by")
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById       BigInt                 @map("created_by")
  updatedAt         DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion        Int                    @default(1) @map("row_version")

  entity          Entity           @relation("RecurringJournalEntity", fields: [entityId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_recurring_journals__entity_id")
  approvalRequest ApprovalRequest? @relation("RecurringJournalApprovalRequest", fields: [approvalRequestId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_recurring_journals__approval_request_id")
  approvedBy      User?            @relation("RecurringJournalApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_recurring_journals__approved_by")
  createdBy       User             @relation("RecurringJournalCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_recurring_journals__created_by")
  entries         JournalEntry[]

  @@index([status, nextRunOn], map: "ix_recurring_journals__status__next_run_on")
  @@index([entityId], map: "ix_recurring_journals__entity_id")
  @@index([approvalRequestId], map: "ix_recurring_journals__approval_request_id")
  @@index([approvedById], map: "ix_recurring_journals__approved_by")
  @@index([createdById], map: "ix_recurring_journals__created_by")
  @@map("recurring_journals")
}

/// Running entry numbers per entity and month (not a statutory series; schema-design §7 A-41).
model JournalEntryCounter {
  entityId  BigInt   @map("entity_id")
  periodKey String   @map("period_key")
  nextValue BigInt   @map("next_value")
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  entity Entity @relation("JournalEntryCounterEntity", fields: [entityId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_journal_entry_counters__entity_id")

  @@id([entityId, periodKey], map: "pk_journal_entry_counters")
  @@map("journal_entry_counters")
}

// ================================================================================================
// Receivables & customer documents (B5.2, accounting-design §2, §4, §6; D-091, D-092, D-125)
// ================================================================================================

enum CustomerDocumentStatus {
  issued
  void

  @@map("customer_document_status")
}

/// What the document is for (schema-design §7 A-42): an instalment TR, the final TR at delivery, an invoice
/// at delivery, a receipt for an invoice, a credit or a debit note.
enum CustomerDocumentKind {
  instalment
  final
  delivery
  collection
  credit_note
  debit_note

  @@map("customer_document_kind")
}

/// How the money of a receipt arrived (the posting rules pick the cash / clearing account from it).
enum ReceiptVia {
  scb
  twoc2p
  slip
  bank
  unidentified
  store_credit

  @@map("receipt_via")
}

enum ETaxStatus {
  not_applicable
  pending
  submitted
  accepted
  rejected

  @@map("etax_status")
}

enum DocumentLinkKind {
  deducts_instalment
  credits
  debits
  replaces
  receipt_for

  @@map("document_link_kind")
}

enum CnStatutoryCategory {
  price_reduction
  defective_or_short
  returns
  cancellation
  post_sale_discount
  other

  @@map("cn_statutory_category")
}

enum CnAppliesTo {
  item
  service
  both

  @@map("cn_applies_to")
}

/// Business reason of a credit note, mapped to its statutory category through `credit_note_reasons`.
enum CreditNoteKind {
  shortage
  claim
  cancellation
  price_reduction
  return
  discount

  @@map("credit_note_kind")
}

enum CreditSettlement {
  store_credit
  receivable

  @@map("credit_settlement")
}

enum CreditNoteRequestStatus {
  pending_approval
  issued
  rejected
  withdrawn

  @@map("credit_note_request_status")
}

enum WhtCertStatus {
  pending
  received
  waived

  @@map("wht_cert_status")
}

enum ArItemStatus {
  open
  partially_paid
  paid
  written_off
  cancelled

  @@map("ar_item_status")
}

enum DunningStage {
  before_due
  on_due
  overdue

  @@map("dunning_stage")
}

enum StoreCreditSource {
  shortage_credit
  cancellation
  claim
  refund_alternative
  applied_to_order
  manual
  refunded

  @@map("store_credit_source")
}

/// IV, TR, RC, CN, DN issued by the entity under the Packio brand (D-010, D-092). Numbers are gapless per
/// (entity, type, period) and taken in the issuing transaction; a void keeps its number with a reason. Money
/// columns never change after issue (trigger).
model CustomerDocument {
  id                  BigInt                 @id(map: "pk_customer_documents") @default(autoincrement())
  publicId            String                 @unique(map: "ux_customer_documents__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  entityId            BigInt                 @map("entity_id")
  docType             DocumentType           @map("doc_type")
  docKind             CustomerDocumentKind   @map("doc_kind")
  docNumber           String                 @map("doc_number")
  status              CustomerDocumentStatus @default(issued)
  issuedAt            DateTime               @default(now()) @map("issued_at") @db.Timestamptz(6)
  documentDate        DateTime               @map("document_date") @db.Date
  taxPointDate        DateTime?              @map("tax_point_date") @db.Date
  /// A tax invoice (ใบกำกับภาษี): TR, CN, DN, and an IV / RC that carries the tax point (§2).
  isTaxInvoice        Boolean                @map("is_tax_invoice")
  /// Full-form tax invoice for a juristic / government buyer (buyer tax id and branch printed).
  isFullForm          Boolean                @default(false) @map("is_full_form")
  customerUserId      BigInt                 @map("customer_user_id")
  companyId           BigInt?                @map("company_id")
  companyBranchId     BigInt?                @map("company_branch_id")
  buyerSnapshot       Json                   @map("buyer_snapshot")
  sellerSnapshot      Json                   @map("seller_snapshot")
  orderGroupId        BigInt?                @map("order_group_id")
  orderId             BigInt?                @map("order_id")
  paymentId           BigInt?                @map("payment_id")
  originalDocumentId  BigInt?                @map("original_document_id")
  creditNoteReasonId  BigInt?                @map("credit_note_reason_id")
  cnKind              CreditNoteKind?        @map("cn_kind")
  receiptVia          ReceiptVia?            @map("receipt_via")
  taxNature           TaxNature?             @map("tax_nature")
  netAmount           Decimal                @map("net_amount") @db.Decimal(14, 2)
  discountAmount      Decimal                @default(0) @map("discount_amount") @db.Decimal(14, 2)
  vatRatePct          Decimal                @map("vat_rate_pct") @db.Decimal(7, 4)
  vatAmount           Decimal                @map("vat_amount") @db.Decimal(14, 2)
  grossAmount         Decimal                @map("gross_amount") @db.Decimal(14, 2)
  whtAmount           Decimal                @default(0) @map("wht_amount") @db.Decimal(14, 2)
  cashAmount          Decimal                @default(0) @map("cash_amount") @db.Decimal(14, 2)
  /// Final TR: instalments already taxed and deducted (§2 deposits & instalments).
  deductedPriorAmount Decimal                @default(0) @map("deducted_prior_amount") @db.Decimal(14, 2)
  roundingAmount      Decimal                @default(0) @map("rounding_amount") @db.Decimal(14, 2)
  /// Amount the customer still owes on this document (an IV or a final TR with a remainder).
  amountDue           Decimal                @default(0) @map("amount_due") @db.Decimal(14, 2)
  dueDate             DateTime?              @map("due_date") @db.Date
  voidReason          String?                @map("void_reason")
  voidedAt            DateTime?              @map("voided_at") @db.Timestamptz(6)
  voidedById          BigInt?                @map("voided_by")
  pdfFileId           BigInt?                @map("pdf_file_id")
  pdfSha256           Bytes?                 @map("pdf_sha256")
  eTaxStatus          ETaxStatus             @default(not_applicable) @map("e_tax_status")
  eTaxXmlFileId       BigInt?                @map("e_tax_xml_file_id")
  approvalRequestId   BigInt?                @map("approval_request_id")
  legalHold           Boolean                @default(false) @map("legal_hold")
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById         BigInt?                @map("created_by")

  entity           Entity                   @relation("CustomerDocumentEntity", fields: [entityId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_customer_documents__entity_id")
  customer         User                     @relation("CustomerDocumentCustomer", fields: [customerUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_customer_documents__customer_user_id")
  company          Company?                 @relation("CustomerDocumentCompany", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_customer_documents__company_id")
  companyBranch    CompanyBranch?           @relation("CustomerDocumentCompanyBranch", fields: [companyBranchId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_customer_documents__company_branch_id")
  orderGroup       OrderGroup?              @relation("CustomerDocumentOrderGroup", fields: [orderGroupId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_customer_documents__order_group_id")
  order            Order?                   @relation("CustomerDocumentOrder", fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_customer_documents__order_id")
  payment          Payment?                 @relation("CustomerDocumentPayment", fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_customer_documents__payment_id")
  originalDocument CustomerDocument?        @relation("CustomerDocumentOriginal", fields: [originalDocumentId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_customer_documents__original_document_id")
  derived          CustomerDocument[]       @relation("CustomerDocumentOriginal")
  creditNoteReason CreditNoteReason?        @relation(fields: [creditNoteReasonId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_customer_documents__credit_note_reason_id")
  voidedBy         User?                    @relation("CustomerDocumentVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_customer_documents__voided_by")
  pdfFile          FileObject?              @relation("CustomerDocumentPdf", fields: [pdfFileId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_customer_documents__pdf_file_id")
  eTaxXmlFile      FileObject?              @relation("CustomerDocumentETaxXml", fields: [eTaxXmlFileId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_customer_documents__e_tax_xml_file_id")
  approvalRequest  ApprovalRequest?         @relation("CustomerDocumentApprovalRequest", fields: [approvalRequestId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_customer_documents__approval_request_id")
  createdBy        User?                    @relation("CustomerDocumentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_customer_documents__created_by")
  lines            CustomerDocumentLine[]
  links            CustomerDocumentLink[]   @relation("CustomerDocumentLinkFrom")
  linkedBy         CustomerDocumentLink[]   @relation("CustomerDocumentLinkTo")
  receivableItem   ReceivableItem?
  whtCertificates  CustomerWhtCertificate[]
  creditRequests   CreditNoteRequest[]      @relation("CreditNoteRequestDocument")
  creditedBy       CreditNoteRequest[]      @relation("CreditNoteRequestOriginal")
  storeCredits     StoreCreditEntry[]
  applications     ReceivableApplication[]  @relation("ReceivableApplicationDocument")
  claimResolutions ClaimResolution[]        @relation("ClaimResolutionCustomerDocument")

  @@unique([entityId, docType, docNumber], map: "ux_customer_documents__entity_id__doc_type__doc_number")
  @@index([customerUserId, documentDate(sort: Desc)], map: "ix_customer_documents__customer_user_id__document_date")
  @@index([companyId, documentDate], map: "ix_customer_documents__company_id__document_date", where: raw("(company_id IS NOT NULL)"))
  @@index([orderId], map: "ix_customer_documents__order_id")
  @@index([orderGroupId], map: "ix_customer_documents__order_group_id")
  @@index([paymentId], map: "ix_customer_documents__payment_id")
  @@index([originalDocumentId], map: "ix_customer_documents__original_document_id")
  @@index([entityId, docType, documentDate], map: "ix_customer_documents__entity_id__doc_type__document_date")
  @@index([companyBranchId], map: "ix_customer_documents__company_branch_id")
  @@index([creditNoteReasonId], map: "ix_customer_documents__credit_note_reason_id")
  @@index([voidedById], map: "ix_customer_documents__voided_by")
  @@index([pdfFileId], map: "ix_customer_documents__pdf_file_id")
  @@index([eTaxXmlFileId], map: "ix_customer_documents__e_tax_xml_file_id")
  @@index([approvalRequestId], map: "ix_customer_documents__approval_request_id")
  @@index([createdById], map: "ix_customer_documents__created_by")
  @@index([issuedAt], map: "ix_customer_documents__pdf_pending", where: raw("(pdf_file_id IS NULL)"))
  @@map("customer_documents")
}

model CustomerDocumentLine {
  id              BigInt           @id(map: "pk_customer_document_lines") @default(autoincrement())
  documentId      BigInt           @map("document_id")
  lineNo          Int              @map("line_no") @db.SmallInt
  orderId         BigInt?          @map("order_id")
  orderLineId     BigInt?          @map("order_line_id")
  description     String
  quantity        Decimal          @db.Decimal(14, 3)
