/// A requested credit note waiting for its checker (maker-checker `credit_note`, §8, D-169); the approval
/// issues the CN. Rule-driven credit notes (tolerance shortage D-021, cancellation) are issued directly.
model CreditNoteRequest {
  id                 BigInt                  @id(map: "pk_credit_note_requests") @default(autoincrement())
  publicId           String                  @unique(map: "ux_credit_note_requests__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  entityId           BigInt                  @map("entity_id")
  orderId            BigInt                  @map("order_id")
  originalDocumentId BigInt?                 @map("original_document_id")
  reasonId           BigInt                  @map("reason_id")
  cnKind             CreditNoteKind          @map("cn_kind")
  /// Gross amount credited (incl. VAT).
  amount             Decimal                 @db.Decimal(14, 2)
  settleTo           CreditSettlement?       @map("settle_to")
  note               String
  claimId            BigInt?                 @map("claim_id")
  status             CreditNoteRequestStatus @default(pending_approval)
  approvalRequestId  BigInt?                 @map("approval_request_id")
  customerDocumentId BigInt?                 @unique(map: "ux_credit_note_requests__customer_document_id") @map("customer_document_id")
  requestedById      BigInt?                 @map("requested_by")
  decidedAt          DateTime?               @map("decided_at") @db.Timestamptz(6)
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  entity           Entity            @relation("CreditNoteRequestEntity", fields: [entityId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_credit_note_requests__entity_id")
  order            Order             @relation("CreditNoteRequestOrder", fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_credit_note_requests__order_id")
  originalDocument CustomerDocument? @relation("CreditNoteRequestOriginal", fields: [originalDocumentId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_credit_note_requests__original_document_id")
  reason           CreditNoteReason  @relation(fields: [reasonId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_credit_note_requests__reason_id")
  claim            Claim?            @relation("CreditNoteRequestClaim", fields: [claimId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_credit_note_requests__claim_id")
  approvalRequest  ApprovalRequest?  @relation("CreditNoteRequestApprovalRequest", fields: [approvalRequestId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_credit_note_requests__approval_request_id")
  customerDocument CustomerDocument? @relation("CreditNoteRequestDocument", fields: [customerDocumentId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_credit_note_requests__customer_document_id")
  requestedBy      User?             @relation("CreditNoteRequestRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_credit_note_requests__requested_by")

  @@index([orderId], map: "ix_credit_note_requests__order_id")
  @@index([originalDocumentId], map: "ix_credit_note_requests__original_document_id")
  @@index([reasonId], map: "ix_credit_note_requests__reason_id")
  @@index([claimId], map: "ix_credit_note_requests__claim_id")
  @@index([approvalRequestId], map: "ix_credit_note_requests__approval_request_id")
  @@index([requestedById], map: "ix_credit_note_requests__requested_by")
  @@index([entityId, status], map: "ix_credit_note_requests__entity_id__status")
  @@map("credit_note_requests")
}

