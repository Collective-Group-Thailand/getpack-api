  orderId                   BigInt?      @map("order_id")
  dueDate                   DateTime     @map("due_date") @db.Date
  amount                    Decimal      @db.Decimal(14, 2)
  openAmount                Decimal      @map("open_amount") @db.Decimal(14, 2)
