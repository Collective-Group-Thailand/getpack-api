  lines                Json
  lineCount            Int             @map("line_count")
  /// What the report says (VAT / WHT); the GL movement of the control accounts (setting `tax.gl_accounts`).
  reportAmount         Decimal         @map("report_amount") @db.Decimal(14, 2)
  glAmount             Decimal         @map("gl_amount") @db.Decimal(14, 2)
  glDifference         Decimal         @map("gl_difference") @db.Decimal(14, 2)
  fileObjectIds        BigInt[]        @default([]) @map("file_object_ids")
  finalisedAt          DateTime?       @map("finalised_at") @db.Timestamptz(6)
  finalisedById        BigInt?         @map("finalised_by")
  filedAt              DateTime?       @map("filed_at") @db.Timestamptz(6)
  filingRef            String?         @map("filing_ref")
  paidOn               DateTime?       @map("paid_on") @db.Date
  paidAmount           Decimal?        @map("paid_amount") @db.Decimal(14, 2)
  companyBankAccountId BigInt?         @map("company_bank_account_id")
  rowVersion           Int             @default(1) @map("row_version")

  entity             Entity              @relation("TaxReportEntity", fields: [entityId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_tax_reports__entity_id")
  fiscalPeriod       FiscalPeriod        @relation(fields: [fiscalPeriodId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_tax_reports__fiscal_period_id")
  generatedBy        User?               @relation("TaxReportGeneratedBy", fields: [generatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_tax_reports__generated_by")
  finalisedBy        User?               @relation("TaxReportFinalisedBy", fields: [finalisedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_tax_reports__finalised_by")
  companyBankAccount CompanyBankAccount? @relation(fields: [companyBankAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_tax_reports__company_bank_account_id")
  calendarItems      TaxCalendarItem[]

  @@unique([entityId, kind, fiscalPeriodId], map: "ux_tax_reports__entity_id__kind__fiscal_period_id")
  @@index([fiscalPeriodId], map: "ix_tax_reports__fiscal_period_id")
  @@index([generatedById], map: "ix_tax_reports__generated_by")
  @@index([finalisedById], map: "ix_tax_reports__finalised_by")
  @@index([companyBankAccountId], map: "ix_tax_reports__company_bank_account_id")
  @@map("tax_reports")
}

/// Filing / payment due dates per form and period (setting `tax.calendar`), reminded before they fall due.
model TaxCalendarItem {
  id             BigInt            @id(map: "pk_tax_calendar_items") @default(autoincrement())
  publicId       String            @unique(map: "ux_tax_calendar_items__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  entityId       BigInt            @map("entity_id")
  kind           TaxReportKind
  fiscalPeriodId BigInt            @map("fiscal_period_id")
  dueOn          DateTime          @map("due_on") @db.Date
  status         TaxCalendarStatus @default(open)
  remindedAt     DateTime?         @map("reminded_at") @db.Timestamptz(6)
  doneAt         DateTime?         @map("done_at") @db.Timestamptz(6)
  taxReportId    BigInt?           @map("tax_report_id")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  entity       Entity       @relation("TaxCalendarItemEntity", fields: [entityId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_tax_calendar_items__entity_id")
  fiscalPeriod FiscalPeriod @relation(fields: [fiscalPeriodId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_tax_calendar_items__fiscal_period_id")
  taxReport    TaxReport?   @relation(fields: [taxReportId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_tax_calendar_items__tax_report_id")

  @@unique([entityId, kind, fiscalPeriodId], map: "ux_tax_calendar_items__entity_id__kind__fiscal_period_id")
  @@index([status, dueOn], map: "ix_tax_calendar_items__status__due_on")
  @@index([fiscalPeriodId], map: "ix_tax_calendar_items__fiscal_period_id")
  @@index([taxReportId], map: "ix_tax_calendar_items__tax_report_id")
  @@map("tax_calendar_items")
}
