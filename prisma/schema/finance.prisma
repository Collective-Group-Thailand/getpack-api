/// AR open item of an invoice (or of a final TR with a remainder); `vat_not_due_*` is the VAT still in
/// 2211 that each collection moves to 2210 pro rata (P08).
model ReceivableItem {
  id                        BigInt       @id(map: "pk_receivable_items") @default(autoincrement())
  publicId                  String       @unique(map: "ux_receivable_items__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  entityId                  BigInt       @map("entity_id")
  customerUserId            BigInt       @map("customer_user_id")
  companyId                 BigInt?      @map("company_id")
  customerDocumentId        BigInt       @unique(map: "ux_receivable_items__customer_document_id") @map("customer_document_id")
  orderId                   BigInt?      @map("order_id")
  dueDate                   DateTime     @map("due_date") @db.Date
  amount                    Decimal      @db.Decimal(14, 2)
  openAmount                Decimal      @map("open_amount") @db.Decimal(14, 2)
  vatNotDueAmount           Decimal      @default(0) @map("vat_not_due_amount") @db.Decimal(14, 2)
  vatNotDueBase             Decimal      @default(0) @map("vat_not_due_base") @db.Decimal(14, 2)
  status                    ArItemStatus @default(open)
  writeOffReason            String?      @map("write_off_reason")
  writeOffApprovalRequestId BigInt?      @map("write_off_approval_request_id")
  writtenOffAt              DateTime?    @map("written_off_at") @db.Timestamptz(6)
  createdAt                 DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion                Int          @default(1) @map("row_version")

  entity            Entity                  @relation("ReceivableItemEntity", fields: [entityId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_receivable_items__entity_id")
  customer          User                    @relation("ReceivableItemCustomer", fields: [customerUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_receivable_items__customer_user_id")
  company           Company?                @relation("ReceivableItemCompany", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_receivable_items__company_id")
  customerDocument  CustomerDocument        @relation(fields: [customerDocumentId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_receivable_items__customer_document_id")
  order             Order?                  @relation("ReceivableItemOrder", fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_receivable_items__order_id")
  writeOffApproval  ApprovalRequest?        @relation("ReceivableItemWriteOffApproval", fields: [writeOffApprovalRequestId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_receivable_items__write_off_approval_request_id")
  applications      ReceivableApplication[]
  dunningNotices    DunningNotice[]
  badDebtProvisions BadDebtProvision[]

  @@index([companyId, status, dueDate], map: "ix_receivable_items__company_id__status__due_date")
  @@index([customerUserId, status, dueDate], map: "ix_receivable_items__customer_user_id__status__due_date")
  @@index([orderId], map: "ix_receivable_items__order_id")
  @@index([writeOffApprovalRequestId], map: "ix_receivable_items__write_off_approval_request_id")
  @@index([entityId, status], map: "ix_receivable_items__entity_id__status")
  @@map("receivable_items")
}

