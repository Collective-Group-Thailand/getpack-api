  customer          User                    @relation("ReceivableItemCustomer", fields: [customerUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_receivable_items__customer_user_id")
  company           Company?                @relation("ReceivableItemCompany", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_receivable_items__company_id")
