  user      User           @relation("ErpOperatorSkillUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_operator_skills__user_id")
  machine   FactoryMachine @relation("ErpOperatorSkillMachine", fields: [machineId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_operator_skills__machine_id")

  @@unique([factoryId, userId, machineId], map: "ux_erp_operator_skills__factory_id__user_id__machine_id")
  @@index([userId], map: "ix_erp_operator_skills__user_id")
  @@index([machineId], map: "ix_erp_operator_skills__machine_id")
  @@index([createdById], map: "ix_erp_operator_skills__created_by_id")
  @@index([updatedById], map: "ix_erp_operator_skills__updated_by_id")
  @@map("erp_operator_skills")
}

/// D-381: the owner’s time-boxed permission for Packio support to read the dashboard and settings.
model ErpSupportGrant {
  id           BigInt    @id(map: "pk_erp_support_grants") @default(autoincrement())
  publicId     String    @unique(map: "ux_erp_support_grants__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  factoryId    BigInt    @map("factory_id")
  revokedById  BigInt?   @map("revoked_by_id")
  reason       String
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokeReason String?   @map("revoke_reason")
  viewCount    Int       @default(0) @map("view_count")
  lastViewedAt DateTime? @map("last_viewed_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById  BigInt    @map("created_by")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById  BigInt?   @map("updated_by")
  rowVersion   Int       @default(1) @map("row_version")

  factory   Factory          @relation("ErpSupportGrantFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_support_grants__factory_id")
  createdBy User             @relation("ErpSupportGrantCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_support_grants__created_by")
  updatedBy User?            @relation("ErpSupportGrantUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_support_grants__updated_by")
  revokedBy User?            @relation("ErpSupportGrantRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_support_grants__revoked_by_id")
  views     ErpSupportView[] @relation("ErpSupportGrantViews")

  @@index([factoryId, expiresAt(sort: Desc)], map: "ix_erp_support_grants__factory_id__expires_at")
  @@index([revokedById], map: "ix_erp_support_grants__revoked_by_id")
  @@index([createdById], map: "ix_erp_support_grants__created_by_id")
  @@index([updatedById], map: "ix_erp_support_grants__updated_by_id")
  @@map("erp_support_grants")
}

/// D-381: one read by staff under a grant.
model ErpSupportView {
  id       BigInt   @id(map: "pk_erp_support_views") @default(autoincrement())
  grantId  BigInt   @map("grant_id")
  staffId  BigInt   @map("staff_id")
  viewedAt DateTime @default(now()) @map("viewed_at") @db.Timestamptz(6)
  what     String

  grant ErpSupportGrant @relation("ErpSupportGrantViews", fields: [grantId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_support_views__grant_id")
  staff User            @relation("ErpSupportViewStaff", fields: [staffId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_support_views__staff_id")

  @@index([grantId, viewedAt(sort: Desc)], map: "ix_erp_support_views__grant_id__viewed_at")
  @@index([staffId], map: "ix_erp_support_views__staff_id")
  @@map("erp_support_views")
}
