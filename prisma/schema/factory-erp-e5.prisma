  updatedById BigInt?       @map("updated_by")
  rowVersion  Int           @default(1) @map("row_version")

  factory   Factory        @relation("ErpOperatorSkillFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_operator_skills__factory_id")
  createdBy User           @relation("ErpOperatorSkillCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_erp_operator_skills__created_by")
