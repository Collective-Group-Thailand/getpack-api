// ------------------------------------------------------------------------------------------------
// Factory & onboarding
// ------------------------------------------------------------------------------------------------

model Factory {
  id                 BigInt         @id(map: "pk_factories") @default(autoincrement())
  publicId           String         @unique(map: "ux_factories__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  /// Staff-facing code, e.g. `F0001` (never shown to customers, D-050).
  code               String         @unique(map: "ux_factories__code")
  vendorId           BigInt         @unique(map: "ux_factories__vendor_id") @map("vendor_id")
  legalName          String         @map("legal_name")
  tradeName          String?        @map("trade_name")
  juristicType       JuristicType   @map("juristic_type")
  taxId              String         @map("tax_id") @db.Char(13)
  branchCode         String         @default("00000") @map("branch_code") @db.Char(5)
  /// Drives the effective cost to Collective Group (accounting-design.md §11).
  isVatRegistered    Boolean        @default(false) @map("is_vat_registered")
  vatRegisteredOn    DateTime?      @map("vat_registered_on") @db.Date
  status             FactoryStatus  @default(applied)
  statusChangedAt    DateTime       @default(now()) @map("status_changed_at") @db.Timestamptz(6)
  onboardingMode     OnboardingMode @default(self_service) @map("onboarding_mode")
  calendarId         BigInt?        @map("calendar_id")
  lineGroupId        String?        @map("line_group_id")
  /// Cache for D-076 "first 3 jobs of a new factory".
  trialJobsCompleted Int            @default(0) @map("trial_jobs_completed")
  activatedAt        DateTime?      @map("activated_at") @db.Timestamptz(6)
  offboardedAt       DateTime?      @map("offboarded_at") @db.Timestamptz(6)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById        BigInt?        @map("created_by")
  updatedAt          DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById        BigInt?        @map("updated_by")
  rowVersion         Int            @default(1) @map("row_version")

  vendor               Vendor                     @relation(fields: [vendorId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_factories__vendor_id")
  calendar             BusinessCalendar?          @relation("FactoryCalendar", fields: [calendarId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_factories__calendar_id")
  statusHistory        FactoryStatusHistory[]
  addresses            FactoryAddress[]
  contacts             FactoryContact[]
  onboardingSteps      FactoryOnboardingStep[]
  kycDocuments         FactoryKycDocument[]
  siteVisits           SiteVisit[]
  changeRequests       FactoryChangeRequest[]
  agreementAcceptances AgreementAcceptance[]
  capabilities         FactoryCapability[]
  capabilityItems      FactoryCapabilityItem[]
  machines             FactoryMachine[]
  deliveryZones        FactoryDeliveryZone[]
  shippingRateCard     FactoryShippingRateCard?   @relation("FactoryShippingRateCardFactory")
  participations       FactoryParticipation[]
  pricingArrangement   FactoryPricingArrangement?
  capacities           FactoryCapacity[]
  capacityOverrides    FactoryCapacityOverride[]
  capacityBookings     CapacityBooking[]
  tolerancePolicies    FactoryTolerancePolicy[]
  payoutPolicy         FactoryPayoutPolicy?
  priceLists           PriceList[]
  apiClients           ApiClient[]                @relation("ApiClientFactory")
  ownedFiles           FileObject[]               @relation("FileObjectOwnerFactory")
  calendars            BusinessCalendar[]         @relation("BusinessCalendarFactory")
  stockLevels          StockLevel[]               @relation("StockLevelFactory")
  stockMovements       StockMovement[]            @relation("StockMovementFactory")
  createdBy            User?                      @relation("FactoryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_factories__created_by")
  updatedBy            User?                      @relation("FactoryUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_factories__updated_by")

  // --- Quotes & RFQ (generated back-relations)
  quoteOptions     QuoteOption[]            @relation("QuoteOptionFactory")
  rfqConsultations RfqFactoryConsultation[] @relation("RfqConsultationFactory")
  rfqQuoteLines    RfqQuoteLine[]           @relation("RfqQuoteLineFactory")

  // --- end Quotes & RFQ
  ordersSelected Order[] @relation("OrderSelectedFactory")

  // --- Fulfilment B4.2 (generated back-relations)
  productionJobs     ProductionJob[]    @relation("ProductionJobFactory")
  jobAssignmentsFrom JobAssignment[]    @relation("JobAssignmentFrom")
  jobAssignmentsTo   JobAssignment[]    @relation("JobAssignmentTo")
  jobMilestones      JobMilestone[]     @relation("JobMilestoneFactory")
  qcChecks           QcCheck[]          @relation("QcCheckFactory")
  jobIssues          JobIssue[]         @relation("JobIssueFactory")
  scorecards         FactoryScorecard[] @relation("FactoryScorecardFactory")
  // --- end Fulfilment B4.2

  // --- Fulfilment B4.3 (generated back-relations)
  shipments Shipment[] @relation("ShipmentFactory")
  // --- end Fulfilment B4.3

  // --- Fulfilment B4.5 (generated back-relations)
  claims Claim[] @relation("ClaimFactory")
  // --- end Fulfilment B4.5

  // --- Finance B5.1 (generated back-relations)
  journalLines JournalLine[] @relation("JournalLineFactory")
  // --- end Finance B5.1

  // --- Finance B5.3 (generated back-relations)
  purchaseOrders    PurchaseOrder[]    @relation("PurchaseOrderFactory")
  goodsReceipts     GoodsReceipt[]     @relation("GoodsReceiptFactory")
  billingStatements BillingStatement[] @relation("BillingStatementFactory")
  vendorDeductions  VendorDeduction[]  @relation("VendorDeductionFactory")
  // --- end Finance B5.3

  @@unique([taxId, branchCode], map: "ux_factories__tax_id__branch_code")
  @@index([status], map: "ix_factories__status")
  @@index([calendarId], map: "ix_factories__calendar_id")
  @@index([legalName(ops: raw("gin_trgm_ops"))], type: Gin, map: "ix_factories__legal_name_trgm")
  @@map("factories")
}

/// Append-only (trigger).
model FactoryStatusHistory {
  id                BigInt         @id(map: "pk_factory_status_history") @default(autoincrement())
  factoryId         BigInt         @map("factory_id")
  fromStatus        FactoryStatus? @map("from_status")
  toStatus          FactoryStatus  @map("to_status")
  reason            String
  approvalRequestId BigInt?        @map("approval_request_id")
  changedById       BigInt?        @map("changed_by")
  changedAt         DateTime       @default(now()) @map("changed_at") @db.Timestamptz(6)

  factory         Factory          @relation(fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_factory_status_history__factory_id")
  approvalRequest ApprovalRequest? @relation("FactoryStatusHistoryApprovalRequest", fields: [approvalRequestId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_factory_status_history__approval_request_id")
  changedBy       User?            @relation("FactoryStatusHistoryChangedBy", fields: [changedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_factory_status_history__changed_by")

  @@index([factoryId, changedAt], map: "ix_factory_status_history__factory_id__changed_at")
  @@index([approvalRequestId], map: "ix_factory_status_history__approval_request_id")
  @@map("factory_status_history")
}

model FactoryAddress {
  id            BigInt             @id(map: "pk_factory_addresses") @default(autoincrement())
  publicId      String             @unique(map: "ux_factory_addresses__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  factoryId     BigInt             @map("factory_id")
  kind          FactoryAddressKind
  line1         String
  line2         String?
  subdistrictId BigInt?            @map("subdistrict_id")
  postcode      String?            @db.Char(5)
  lat           Decimal?           @db.Decimal(9, 6)
  lng           Decimal?           @db.Decimal(9, 6)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById   BigInt?            @map("created_by")
  updatedAt     DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById   BigInt?            @map("updated_by")
  rowVersion    Int                @default(1) @map("row_version")

  factory     Factory         @relation(fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_factory_addresses__factory_id")
  subdistrict GeoSubdistrict? @relation("FactoryAddressSubdistrict", fields: [subdistrictId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_factory_addresses__subdistrict_id")
  createdBy   User?           @relation("FactoryAddressCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_factory_addresses__created_by")
  updatedBy   User?           @relation("FactoryAddressUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_factory_addresses__updated_by")

  @@index([factoryId], map: "ix_factory_addresses__factory_id")
  @@index([subdistrictId], map: "ix_factory_addresses__subdistrict_id")
  @@map("factory_addresses")
}

/// PII (name, phone, email): excluded from logs and analytics (§2.11).
model FactoryContact {
  id          BigInt   @id(map: "pk_factory_contacts") @default(autoincrement())
  publicId    String   @unique(map: "ux_factory_contacts__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  factoryId   BigInt   @map("factory_id")
  name        String
  roleTitle   String?  @map("role_title")
  /// E.164.
  phone       String?
  email       String?  @db.Citext
  isPrimary   Boolean  @default(false) @map("is_primary")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById BigInt?  @map("created_by")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById BigInt?  @map("updated_by")
  rowVersion  Int      @default(1) @map("row_version")

  factory   Factory @relation(fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_factory_contacts__factory_id")
  createdBy User?   @relation("FactoryContactCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_factory_contacts__created_by")
  updatedBy User?   @relation("FactoryContactUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_factory_contacts__updated_by")

  @@unique([factoryId], map: "ux_factory_contacts__one_primary", where: raw("is_primary"))
  @@index([factoryId], map: "ix_factory_contacts__factory_id")
  @@map("factory_contacts")
}

model FactoryOnboardingStep {
  id                   BigInt               @id(map: "pk_factory_onboarding_steps") @default(autoincrement())
  factoryId            BigInt               @map("factory_id")
  step                 OnboardingStep
  status               OnboardingStepStatus @default(pending)
  completedAt          DateTime?            @map("completed_at") @db.Timestamptz(6)
  completedById        BigInt?              @map("completed_by")
  /// Assisted onboarding: Packio staff entered the data on the factory's behalf (D-100 note).
  enteredByStaff       Boolean              @default(false) @map("entered_by_staff")
  factorySignedOffById BigInt?              @map("factory_signed_off_by")
  factorySignedOffAt   DateTime?            @map("factory_signed_off_at") @db.Timestamptz(6)
  notes                String?
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById          BigInt?              @map("updated_by")
  rowVersion           Int                  @default(1) @map("row_version")

  factory          Factory @relation(fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_factory_onboarding_steps__factory_id")
  completedBy      User?   @relation("FactoryOnboardingStepCompletedBy", fields: [completedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_factory_onboarding_steps__completed_by")
  factorySignedOff User?   @relation("FactoryOnboardingStepSignedOffBy", fields: [factorySignedOffById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_factory_onboarding_steps__factory_signed_off_by")
  updatedBy        User?   @relation("FactoryOnboardingStepUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_factory_onboarding_steps__updated_by")

  @@unique([factoryId, step], map: "ux_factory_onboarding_steps__factory_id__step")
  @@map("factory_onboarding_steps")
}

model FactoryKycDocument {
  id           BigInt     @id(map: "pk_factory_kyc_documents") @default(autoincrement())
  publicId     String     @unique(map: "ux_factory_kyc_documents__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  factoryId    BigInt     @map("factory_id")
  docType      KycDocType @map("doc_type")
  fileObjectId BigInt     @map("file_object_id")
  issuedOn     DateTime?  @map("issued_on") @db.Date
  expiresOn    DateTime?  @map("expires_on") @db.Date
  status       KycStatus  @default(pending)
  verifiedById BigInt?    @map("verified_by")
  verifiedAt   DateTime?  @map("verified_at") @db.Timestamptz(6)
  note         String?
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById  BigInt?    @map("created_by")
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion   Int        @default(1) @map("row_version")

  factory    Factory    @relation(fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_factory_kyc_documents__factory_id")
  fileObject FileObject @relation("FactoryKycDocumentFile", fields: [fileObjectId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_factory_kyc_documents__file_object_id")
  verifiedBy User?      @relation("FactoryKycDocumentVerifiedBy", fields: [verifiedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_factory_kyc_documents__verified_by")
  createdBy  User?      @relation("FactoryKycDocumentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_factory_kyc_documents__created_by")

  @@index([factoryId, docType], map: "ix_factory_kyc_documents__factory_id__doc_type")
  @@index([fileObjectId], map: "ix_factory_kyc_documents__file_object_id")
  @@map("factory_kyc_documents")
}

/// D-041: at least one `pass` visit is required before `trial → active` (trigger on factories).
model SiteVisit {
  id               BigInt          @id(map: "pk_site_visits") @default(autoincrement())
  publicId         String          @unique(map: "ux_site_visits__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  factoryId        BigInt          @map("factory_id")
  visitedOn        DateTime        @map("visited_on") @db.Date
  checklistVersion String          @map("checklist_version")
  checklist        Json
  result           SiteVisitResult
  notes            String?
  recordedById     BigInt          @map("recorded_by")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  factory    Factory              @relation(fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_site_visits__factory_id")
  recordedBy User                 @relation("SiteVisitRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_site_visits__recorded_by")
  inspectors SiteVisitInspector[]

  @@index([factoryId, visitedOn], map: "ix_site_visits__factory_id__visited_on")
  @@index([recordedById], map: "ix_site_visits__recorded_by")
  @@map("site_visits")
}

model SiteVisitInspector {
  siteVisitId BigInt @map("site_visit_id")
  userId      BigInt @map("user_id")

  siteVisit SiteVisit @relation(fields: [siteVisitId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_site_visit_inspectors__site_visit_id")
  user      User      @relation("SiteVisitInspectorUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_site_visit_inspectors__user_id")

  @@id([siteVisitId, userId], map: "pk_site_visit_inspectors")
  @@index([userId], map: "ix_site_visit_inspectors__user_id")
  @@map("site_visit_inspectors")
}

// ------------------------------------------------------------------------------------------------
// Agreements (D-011, D-044 confidentiality clause both directions)
// ------------------------------------------------------------------------------------------------

model AgreementTemplate {
  id          BigInt   @id(map: "pk_agreement_templates") @default(autoincrement())
  publicId    String   @unique(map: "ux_agreement_templates__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  /// e.g. `partner_agreement`, `price_data_confidentiality`.
  key         String   @unique(map: "ux_agreement_templates__key")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById BigInt?  @map("created_by")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById BigInt?  @map("updated_by")
  rowVersion  Int      @default(1) @map("row_version")

  versions  AgreementTemplateVersion[]
  createdBy User?                      @relation("AgreementTemplateCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_agreement_templates__created_by")
  updatedBy User?                      @relation("AgreementTemplateUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_agreement_templates__updated_by")

  @@map("agreement_templates")
}

/// Versioned (§2.1). `text_sha256` is the evidence an e-acceptance refers to.
model AgreementTemplateVersion {
  id                BigInt              @id(map: "pk_agreement_template_versions") @default(autoincrement())
  publicId          String              @unique(map: "ux_agreement_template_versions__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  templateId        BigInt              @map("template_id")
  versionNo         Int                 @map("version_no")
  effectiveFrom     DateTime            @map("effective_from") @db.Timestamptz(6)
  status            ConfigVersionStatus @default(draft)
  textTh            String              @map("text_th")
  textEn            String?             @map("text_en")
  textSha256        Bytes               @map("text_sha256")
  pdfFileId         BigInt?             @map("pdf_file_id")
  reason            String
  approvalRequestId BigInt?             @map("approval_request_id")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById       BigInt?             @map("created_by")
  decidedAt         DateTime?           @map("decided_at") @db.Timestamptz(6)
  decidedById       BigInt?             @map("decided_by")

  template        AgreementTemplate     @relation(fields: [templateId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_agreement_template_versions__template_id")
  pdfFile         FileObject?           @relation("AgreementTemplateVersionPdfFile", fields: [pdfFileId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_agreement_template_versions__pdf_file_id")
  approvalRequest ApprovalRequest?      @relation("AgreementTemplateVersionApprovalRequest", fields: [approvalRequestId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_agreement_template_versions__approval_request_id")
  acceptances     AgreementAcceptance[]
