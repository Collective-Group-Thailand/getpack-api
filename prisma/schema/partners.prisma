/// Corrugate terms per print type (legacy `factory_match_print_type` + the corrugate flags of `factory`, and the terms that replace legacy's hard-coded factories); commercial terms (D-040 group 4).
model PlCorrugatePrintTypeTerm {
  id                         BigInt   @id(map: "pk_pl_corrugate_print_type_terms") @default(autoincrement())
  priceListVersionId         BigInt   @map("price_list_version_id")
  lineKey                    String   @map("line_key")
  printTypeId                BigInt   @map("print_type_id")
  /// `flexo` (legacy "Flexography": RSC roll or die-cut) or `digital` (legacy "Digital").
  engineVariant              String   @map("engine_variant")
  factoryMarginPct           Decimal  @map("factory_margin_pct") @db.Decimal(7, 4)
  minOrderAmount             Int?     @map("min_order_amount")
  leadTimeDays               Decimal? @map("lead_time_days") @db.Decimal(6, 2)
  /// From this quantity the lead time is `bulk_lead_time_days` (legacy `getCustomLeadTime`, factory 9).
  bulkLeadTimeMinQty         Int?     @map("bulk_lead_time_min_qty")
  bulkLeadTimeDays           Decimal? @map("bulk_lead_time_days") @db.Decimal(6, 2)
  /// Most colours per side (legacy `factory.max_amount_color`); null = no limit.
  maxColours                 Int?     @map("max_colours") @db.SmallInt
  /// Legacy `factory.paper_cut` (LOC-426): RSC blanks laid several to a cut sheet.
  paperCut                   Boolean  @default(false) @map("paper_cut")
  /// Legacy `corrugate_cal_pattern_area_percent_type` (0, 1, 2): the side-area formulas.
  patternAreaPercentMethod   Int      @default(0) @map("pattern_area_percent_method") @db.SmallInt
  /// Legacy factory 4: its own top + side area formulas.
  topSideCombined            Boolean  @default(false) @map("top_side_combined")
  trimDlMm                   Decimal  @default(0) @map("trim_dl_mm") @db.Decimal(10, 2)
  trimDwMm                   Decimal  @default(0) @map("trim_dw_mm") @db.Decimal(10, 2)
  printFixCostPerSqm         Decimal? @map("print_fix_cost_per_sqm") @db.Decimal(18, 6)
  nonPrintFixCostPerSqm      Decimal? @map("non_print_fix_cost_per_sqm") @db.Decimal(18, 6)
  /// Legacy `corrugate_use_amount_find_paper_price`: digital board band read at the order quantity.
  paperPriceByOrderAmount    Boolean  @default(false) @map("paper_price_by_order_amount")
  /// Legacy `corrugate_cal_diecut_block_price`: digital die block per m² (quirk C10).
  digitalDieBlock            Boolean  @default(false) @map("digital_die_block")
