// ------------------------------------------------------------------------------------------------
// Price lists, proposals, suggestions, simulations (D-040, D-042, D-043, D-044)
// ------------------------------------------------------------------------------------------------

/// One price list per factory × product type; each approved version is a complete, immutable set of
/// component rows (copy-on-write, schema-design §7 A-7).
model PriceList {
  id            BigInt   @id(map: "pk_price_lists") @default(autoincrement())
  publicId      String   @unique(map: "ux_price_lists__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  factoryId     BigInt   @map("factory_id")
  productTypeId BigInt   @map("product_type_id")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById   BigInt?  @map("created_by")

  factory     Factory            @relation(fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_price_lists__factory_id")
  productType ProductType        @relation("PriceListProductType", fields: [productTypeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_price_lists__product_type_id")
  versions    PriceListVersion[]
  proposals   PriceProposal[]
  createdBy   User?              @relation("PriceListCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_price_lists__created_by")

  @@unique([factoryId, productTypeId], map: "ux_price_lists__factory_id__product_type_id")
  @@index([productTypeId], map: "ix_price_lists__product_type_id")
  @@map("price_lists")
}

/// Versioned (§2.1); `pending_acceptance` = a platform rate card awaiting the factory (D-042).
model PriceListVersion {
  id                   BigInt              @id(map: "pk_price_list_versions") @default(autoincrement())
  publicId             String              @unique(map: "ux_price_list_versions__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  priceListId          BigInt              @map("price_list_id")
  versionNo            Int                 @map("version_no")
  status               ConfigVersionStatus @default(draft)
  origin               PriceVersionOrigin
  basedOnVersionId     BigInt?             @map("based_on_version_id")
  effectiveFrom        DateTime            @map("effective_from") @db.Timestamptz(6)
  proposalId           BigInt?             @map("proposal_id")
  approvalRequestId    BigInt?             @map("approval_request_id")
  factoryAcceptedById  BigInt?             @map("factory_accepted_by")
  factoryAcceptedAt    DateTime?           @map("factory_accepted_at") @db.Timestamptz(6)
  factorySignedOffById BigInt?             @map("factory_signed_off_by")
  factorySignedOffAt   DateTime?           @map("factory_signed_off_at") @db.Timestamptz(6)
  lineCount            Int                 @default(0) @map("line_count")
  contentSha256        Bytes?              @map("content_sha256")
  reason               String
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById          BigInt?             @map("created_by")
  decidedAt            DateTime?           @map("decided_at") @db.Timestamptz(6)
  decidedById          BigInt?             @map("decided_by")

  priceList         PriceList            @relation(fields: [priceListId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_price_list_versions__price_list_id")
  basedOn           PriceListVersion?    @relation("PriceListVersionBasedOn", fields: [basedOnVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_price_list_versions__based_on_version_id")
  derived           PriceListVersion[]   @relation("PriceListVersionBasedOn")
  proposal          PriceProposal?       @relation("PriceListVersionProposal", fields: [proposalId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_price_list_versions__proposal_id")
  proposalsBasedOn  PriceProposal[]      @relation("PriceProposalBaseVersion")
  proposalsResult   PriceProposal[]      @relation("PriceProposalResultingVersion")
  approvalRequest   ApprovalRequest?     @relation("PriceListVersionApprovalRequest", fields: [approvalRequestId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_price_list_versions__approval_request_id")
  factoryAccepted   User?                @relation("PriceListVersionFactoryAcceptedBy", fields: [factoryAcceptedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_price_list_versions__factory_accepted_by")
  factorySignedOff  User?                @relation("PriceListVersionFactorySignedOffBy", fields: [factorySignedOffById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_price_list_versions__factory_signed_off_by")
  createdBy         User?                @relation("PriceListVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_price_list_versions__created_by")
  decidedBy         User?                @relation("PriceListVersionDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_price_list_versions__decided_by")
  // --- Folding price components (B2.3)
  printTypeTerms    PlPrintTypeTerm[]    @relation("PlPrintTypeTermVersion")
  paperTrims        PlPaperTrim[]        @relation("PlPaperTrimVersion")
  patternConditions PlPatternCondition[] @relation("PlPatternConditionVersion")
  materialPrices    PlMaterialPrice[]    @relation("PlMaterialPriceVersion")
  paperSizes        PlPaperSize[]        @relation("PlPaperSizeVersion")
  paperSheets       PlPaperSheet[]       @relation("PlPaperSheetVersion")
  inkColours        PlInkColour[]        @relation("PlInkColourVersion")
  processExclusions PlProcessExclusion[] @relation("PlProcessExclusionVersion")
  printWastes       PlPrintWaste[]       @relation("PlPrintWasteVersion")
  finishWastes      PlFinishWaste[]      @relation("PlFinishWasteVersion")
  diecutWastes      PlDiecutWaste[]      @relation("PlDiecutWasteVersion")
  assemblyWastes    PlAssemblyWaste[]    @relation("PlAssemblyWasteVersion")
  printPlates       PlPrintPlate[]       @relation("PlPrintPlateVersion")
  printPrices       PlPrintPrice[]       @relation("PlPrintPriceVersion")
  finishPrices      PlFinishPrice[]      @relation("PlFinishPriceVersion")
  finishPlates      PlFinishPlate[]      @relation("PlFinishPlateVersion")
  diecutPrices      PlDiecutPrice[]      @relation("PlDiecutPriceVersion")
  diecutBlockPrices PlDiecutBlockPrice[] @relation("PlDiecutBlockPriceVersion")
  assemblyPrices    PlAssemblyPrice[]    @relation("PlAssemblyPriceVersion")
  assemblySheets    PlAssemblySheet[]    @relation("PlAssemblySheetVersion")
  // --- end Folding price components

  // --- Quotes & RFQ (generated back-relations)
  quoteOptions QuoteOption[] @relation("QuoteOptionPriceListVersion")

  // --- end Quotes & RFQ

  // --- Fulfilment B4.2 (generated back-relations)
  productionJobs ProductionJob[] @relation("ProductionJobPriceListVersion")
  // --- end Fulfilment B4.2

  @@unique([priceListId, versionNo], map: "ux_price_list_versions__price_list_id__version_no")
  @@index([priceListId, effectiveFrom(sort: Desc), versionNo(sort: Desc)], map: "ix_price_list_versions__resolution", where: raw("(status = 'approved'::config_version_status)"))
  @@index([basedOnVersionId], map: "ix_price_list_versions__based_on_version_id")
  @@index([proposalId], map: "ix_price_list_versions__proposal_id")
  @@index([approvalRequestId], map: "ix_price_list_versions__approval_request_id")
  @@map("price_list_versions")
}

model PriceProposal {
  id                    BigInt            @id(map: "pk_price_proposals") @default(autoincrement())
  publicId              String            @unique(map: "ux_price_proposals__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  priceListId           BigInt            @map("price_list_id")
  baseVersionId         BigInt?           @map("base_version_id")
  direction             ProposalDirection
  status                ProposalStatus    @default(draft)
  proposedEffectiveFrom DateTime          @map("proposed_effective_from") @db.Timestamptz(6)
  submittedById         BigInt?           @map("submitted_by")
  submittedAt           DateTime?         @map("submitted_at") @db.Timestamptz(6)
  approvalRequestId     BigInt?           @map("approval_request_id")
  resultingVersionId    BigInt?           @map("resulting_version_id")
  comment               String?
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById           BigInt?           @map("created_by")
  updatedAt             DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById           BigInt?           @map("updated_by")
  rowVersion            Int               @default(1) @map("row_version")

  priceList        PriceList               @relation(fields: [priceListId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_price_proposals__price_list_id")
  baseVersion      PriceListVersion?       @relation("PriceProposalBaseVersion", fields: [baseVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_price_proposals__base_version_id")
  resultingVersion PriceListVersion?       @relation("PriceProposalResultingVersion", fields: [resultingVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_price_proposals__resulting_version_id")
  versions         PriceListVersion[]      @relation("PriceListVersionProposal")
  approvalRequest  ApprovalRequest?        @relation("PriceProposalApprovalRequest", fields: [approvalRequestId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_price_proposals__approval_request_id")
  lines            PriceProposalLine[]
  simulations      PriceImpactSimulation[]
  submittedBy      User?                   @relation("PriceProposalSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_price_proposals__submitted_by")
  createdBy        User?                   @relation("PriceProposalCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_price_proposals__created_by")
  updatedBy        User?                   @relation("PriceProposalUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_price_proposals__updated_by")

  /// One open proposal per price list at a time, so every proposal applies to the version it was based on.
  @@unique([priceListId], map: "ux_price_proposals__one_open", where: raw("(status = ANY (ARRAY['draft'::proposal_status, 'submitted'::proposal_status, 'under_review'::proposal_status, 'countered'::proposal_status]))"))
  @@index([priceListId, status], map: "ix_price_proposals__price_list_id__status")
  @@index([status, submittedAt], map: "ix_price_proposals__status__submitted_at")
  @@index([baseVersionId], map: "ix_price_proposals__base_version_id")
  @@index([resultingVersionId], map: "ix_price_proposals__resulting_version_id")
  @@index([approvalRequestId], map: "ix_price_proposals__approval_request_id")
  @@map("price_proposals")
}

/// A line's final value once accepted = `counter_values` when the counterparty countered and the
/// proposer accepted the counter, otherwise `proposed_values`.
model PriceProposalLine {
  id             BigInt               @id(map: "pk_price_proposal_lines") @default(autoincrement())
  publicId       String               @unique(map: "ux_price_proposal_lines__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  proposalId     BigInt               @map("proposal_id")
  component      PriceComponent
  /// Stable across versions: canonical hash of the row's dimension columns.
  lineKey        String               @map("line_key")
  action         ProposalLineAction
  currentValues  Json?                @map("current_values")
  proposedValues Json?                @map("proposed_values")
  decision       ProposalLineDecision @default(pending)
  counterValues  Json?                @map("counter_values")
  decidedById    BigInt?              @map("decided_by")
  decidedAt      DateTime?            @map("decided_at") @db.Timestamptz(6)
  comment        String?
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  proposal   PriceProposal        @relation(fields: [proposalId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_price_proposal_lines__proposal_id")
  decidedBy  User?                @relation("PriceProposalLineDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_price_proposal_lines__decided_by")
  suggestion PriceLineSuggestion?

  @@unique([proposalId, component, lineKey], map: "ux_price_proposal_lines__proposal__component__line_key")
  @@map("price_proposal_lines")
}

/// Staff-only, physically separate so no partner query can join it (D-040 note, D-044).
model PriceLineSuggestion {
  id              BigInt           @id(map: "pk_price_line_suggestions") @default(autoincrement())
  proposalLineId  BigInt           @unique(map: "ux_price_line_suggestions__proposal_line_id") @map("proposal_line_id")
  method          SuggestionMethod
  suggestedValues Json?            @map("suggested_values")
  /// Index series and points used, peer count, percentiles — never other factories' identities.
  basis           Json
  deviationPct    Decimal?         @map("deviation_pct") @db.Decimal(9, 4)
  flags           String[]         @default([])
  computedAt      DateTime         @default(now()) @map("computed_at") @db.Timestamptz(6)

  proposalLine PriceProposalLine @relation(fields: [proposalLineId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_price_line_suggestions__proposal_line_id")

  @@map("price_line_suggestions")
}

/// Staff-only: re-price the factory's quotes of the window with the proposed values (D-040 note).
model PriceImpactSimulation {
  id            BigInt    @id(map: "pk_price_impact_simulations") @default(autoincrement())
  publicId      String    @unique(map: "ux_price_impact_simulations__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  proposalId    BigInt    @map("proposal_id")
  requestedById BigInt    @map("requested_by")
  windowFrom    DateTime  @map("window_from") @db.Timestamptz(6)
  windowTo      DateTime  @map("window_to") @db.Timestamptz(6)
  status        JobStatus @default(queued)
  result        Json?
  error         String?
  attempts      Int       @default(0) @db.SmallInt
  lockedUntil   DateTime? @map("locked_until") @db.Timestamptz(6)
  startedAt     DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt   DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  proposal    PriceProposal @relation(fields: [proposalId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_price_impact_simulations__proposal_id")
  requestedBy User          @relation("PriceImpactSimulationRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_price_impact_simulations__requested_by")

  @@index([proposalId, createdAt(sort: Desc)], map: "ix_price_impact_simulations__proposal_id__created_at")
  @@index([status, lockedUntil], map: "ix_price_impact_simulations__due", where: raw("(status = ANY (ARRAY['queued'::job_status, 'running'::job_status]))"))
  @@index([requestedById], map: "ix_price_impact_simulations__requested_by")
  @@map("price_impact_simulations")
}

// ------------------------------------------------------------------------------------------------
// Index series (D-040 groups 1–2)
// ------------------------------------------------------------------------------------------------

model IndexSeries {
  id               BigInt      @id(map: "pk_index_series") @default(autoincrement())
  publicId         String      @unique(map: "ux_index_series__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  code             String      @unique(map: "ux_index_series__code")
  kind             IndexKind
  materialFamilyId BigInt?     @map("material_family_id")
  nameTh           String      @map("name_th")
  nameEn           String      @map("name_en")
  unit             String
  source           IndexSource @default(manual)
  adapterKey       String?     @map("adapter_key")
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById      BigInt?     @map("created_by")
  updatedAt        DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById      BigInt?     @map("updated_by")
  rowVersion       Int         @default(1) @map("row_version")

  materialFamily MaterialFamily? @relation("IndexSeriesMaterialFamily", fields: [materialFamilyId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_index_series__material_family_id")
  points         IndexPoint[]
  createdBy      User?           @relation("IndexSeriesCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_index_series__created_by")
  updatedBy      User?           @relation("IndexSeriesUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_index_series__updated_by")

  @@index([materialFamilyId], map: "ix_index_series__material_family_id")
  @@map("index_series")
}

/// `period` is the first day of a month.
model IndexPoint {
  id          BigInt   @id(map: "pk_index_points") @default(autoincrement())
  seriesId    BigInt   @map("series_id")
  period      DateTime @db.Date
  value       Decimal  @db.Decimal(18, 6)
  sourceRef   String?  @map("source_ref")
  enteredById BigInt?  @map("entered_by")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  series    IndexSeries @relation(fields: [seriesId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_index_points__series_id")
  enteredBy User?       @relation("IndexPointEnteredBy", fields: [enteredById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_index_points__entered_by")

  @@unique([seriesId, period], map: "ux_index_points__series_id__period")
  @@map("index_points")
}

// ------------------------------------------------------------------------------------------------
// Folding price components (B2.3, schema-design §3.4, A-24): created by the engine slices that read them
// ------------------------------------------------------------------------------------------------

/// Folding terms per print type (legacy `factory_match_print_type` + the folding flags of `factory`); commercial terms (D-040 group 4).
model PlPrintTypeTerm {
  id                          BigInt   @id(map: "pk_pl_print_type_terms") @default(autoincrement())
  priceListVersionId          BigInt   @map("price_list_version_id")
  lineKey                     String   @map("line_key")
  printTypeId                 BigInt   @map("print_type_id")
  engineVariant               String   @map("engine_variant")
  wasteMethod                 Int      @map("waste_method") @db.SmallInt
  finish2StepDownWaste        Boolean  @map("finish2_step_down_waste")
  canFlipPaperSize            Boolean  @map("can_flip_paper_size")
  disableOverlapLayout        Boolean  @map("disable_overlap_layout")
  factoryMarginPct            Decimal  @map("factory_margin_pct") @db.Decimal(7, 4)
  minOrderAmount              Int?     @map("min_order_amount")
  minOrderForProduction       Int?     @map("min_order_for_production")
  leadTimeDays                Decimal? @map("lead_time_days") @db.Decimal(6, 2)
  /// Legacy factory `PFO`: the 4-colour flat price is read at the highest ink coverage.
  fourColourPriceByMaxPercent Boolean  @default(false) @map("four_colour_price_by_max_percent")
  /// Legacy factory `PFO`: assembly waste is read per assembly instead of the factory's first band.
  assemblyWasteByAssembly     Boolean  @default(false) @map("assembly_waste_by_assembly")
  /// Legacy factory 23: die-cut waste also matches the box-amount band.
  diecutWasteByBoxAmount      Boolean  @default(false) @map("diecut_waste_by_box_amount")
  /// Digital paper cost (legacy factories 9 `per_piece_band`, 23 `per_sheet`; `auto` = blank area when trimmed, else sheet area).
  digitalPaperMethod          String   @default("auto") @map("digital_paper_method")
  /// Digital blank trims (legacy `factory_match_print_type.trim_dl/dw`).
  trimDlMm                    Decimal  @default(0) @map("trim_dl_mm") @db.Decimal(10, 2)
  trimDwMm                    Decimal  @default(0) @map("trim_dw_mm") @db.Decimal(10, 2)
  /// Legacy `use_paper_amount_for_cal`: digital die-cut priced on the die-cut sheets.
  usePaperAmountForCal        Boolean  @default(false) @map("use_paper_amount_for_cal")
  /// Digital print cost basis (legacy 9/16 `blank_area`, 23 `per_sheet`, else `sheet_area`).
  digitalPrintMethod          String   @default("sheet_area") @map("digital_print_method")
  /// Digital print price band: press sheets, or the run (`box`, legacy factory 9).
  digitalPrintBand            String   @default("sheets") @map("digital_print_band")
  /// Digital print prices per material, with the two-sided add-on (legacy factory 16).
