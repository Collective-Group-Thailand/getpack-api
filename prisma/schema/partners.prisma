// Partners & price governance context (docs/schema-design.md §3.4, B2.2): factories and their
// onboarding (D-011, D-041, D-171), capability, participation tiers (D-043), capacity (D-101),
// tolerance (D-021) and payout (D-022) policies, pricing arrangements (D-042), agreements, site visits,
// price lists with versions and proposals (D-040), staff-only suggestions and simulations (D-044),
// index series. The `pl_*` component tables are created by each calculator port (B2.3; A-13).
// Versioned tables follow ADR-0005 (schema-design §2.1); hand-written triggers and checks are in the
// migration SQL.

// ------------------------------------------------------------------------------------------------
// Enums
// ------------------------------------------------------------------------------------------------

enum JuristicType {
  company
  partnership
  individual

  @@map("juristic_type")
}

enum FactoryStatus {
  applied
  under_review
  trial
  active
  suspended
  offboarded

  @@map("factory_status")
}

enum OnboardingMode {
  self_service
  assisted

  @@map("onboarding_mode")
}

enum FactoryAddressKind {
  registered
  plant
  pickup

  @@map("factory_address_kind")
}

