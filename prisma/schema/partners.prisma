  application
  kyc
  bank_account
  capability
  capacity
  delivery_zones
  pricing_arrangement
  tolerance
  payout_policy
  agreement
  site_visit
  trial
  activation

  @@map("onboarding_step")
}

enum OnboardingStepStatus {
  pending
  in_progress
  submitted
  approved
  rejected
  waived

  @@map("onboarding_step_status")
}

enum KycDocType {
  company_certificate
  vat_registration_pp20
