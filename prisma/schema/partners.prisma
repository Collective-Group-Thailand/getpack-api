  unitCost           Decimal  @map("unit_cost") @db.Decimal(18, 6)
  leadTimeDays       Decimal? @map("lead_time_days") @db.Decimal(6, 2)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  priceListVersion PriceListVersion @relation("PlServicePricePriceListVersion", fields: [priceListVersionId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_pl_service_prices__price_list_version_id")
  printType        PrintType        @relation("PlServicePricePrintType", fields: [printTypeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_pl_service_prices__print_type_id")
  catalogProduct   CatalogProduct   @relation("PlServicePriceCatalogProduct", fields: [catalogProductId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_pl_service_prices__catalog_product_id")

  @@unique([priceListVersionId, lineKey], map: "ux_pl_service_prices__version__line_key")
  @@index([printTypeId], map: "ix_pl_service_prices__print_type_id")
  @@index([catalogProductId], map: "ix_pl_service_prices__catalog_product_id")
  @@map("pl_service_prices")
}

