  approvalRequest ApprovalRequest?       @relation("FactoryTolerancePolicyVersionApprovalRequest", fields: [approvalRequestId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_factory_tolerance_policy_versions__approval_request_id")
  createdBy       User?                  @relation("FactoryTolerancePolicyVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_factory_tolerance_policy_versions__created_by")
  decidedBy       User?                  @relation("FactoryTolerancePolicyVersionDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_factory_tolerance_policy_versions__decided_by")

  @@unique([policyId, versionNo], map: "ux_factory_tolerance_policy_versions__policy_id__version_no")
  @@index([policyId, effectiveFrom(sort: Desc), versionNo(sort: Desc)], map: "ix_factory_tolerance_policy_versions__resolution", where: raw("(status = 'approved'::config_version_status)"))
  @@index([approvalRequestId], map: "ix_factory_tolerance_policy_versions__approval_request_id")
  @@map("factory_tolerance_policy_versions")
}

model FactoryPayoutPolicy {
  id          BigInt   @id(map: "pk_factory_payout_policies") @default(autoincrement())
  publicId    String   @unique(map: "ux_factory_payout_policies__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  factoryId   BigInt   @unique(map: "ux_factory_payout_policies__factory_id") @map("factory_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById BigInt?  @map("created_by")

  factory   Factory                      @relation(fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_factory_payout_policies__factory_id")
  versions  FactoryPayoutPolicyVersion[]
  createdBy User?                        @relation("FactoryPayoutPolicyCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_factory_payout_policies__created_by")

  @@map("factory_payout_policies")
}

/// D-022 / D-164; a factory override needs the `factory_payout_policy_change` approval (D-173).
model FactoryPayoutPolicyVersion {
  id                   BigInt              @id(map: "pk_factory_payout_policy_versions") @default(autoincrement())
  policyId             BigInt              @map("policy_id")
  versionNo            Int                 @map("version_no")
  effectiveFrom        DateTime            @map("effective_from") @db.Timestamptz(6)
  status               ConfigVersionStatus @default(draft)
  advancePct           Decimal             @map("advance_pct") @db.Decimal(7, 4)
  advanceTrigger       PayoutTrigger       @map("advance_trigger")
  balanceTrigger       PayoutTrigger       @map("balance_trigger")
  claimWindowDays      Int                 @map("claim_window_days") @db.SmallInt
  retentionPct         Decimal             @map("retention_pct") @db.Decimal(7, 4)
  retentionReleaseDays Int                 @map("retention_release_days") @db.SmallInt
  paymentTermsDays     Int                 @default(0) @map("payment_terms_days") @db.SmallInt
  reason               String
  approvalRequestId    BigInt?             @map("approval_request_id")
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById          BigInt?             @map("created_by")
  decidedAt            DateTime?           @map("decided_at") @db.Timestamptz(6)
  decidedById          BigInt?             @map("decided_by")

  policy          FactoryPayoutPolicy @relation(fields: [policyId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_factory_payout_policy_versions__policy_id")
  approvalRequest ApprovalRequest?    @relation("FactoryPayoutPolicyVersionApprovalRequest", fields: [approvalRequestId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_factory_payout_policy_versions__approval_request_id")
  createdBy       User?               @relation("FactoryPayoutPolicyVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_factory_payout_policy_versions__created_by")
  decidedBy       User?               @relation("FactoryPayoutPolicyVersionDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_factory_payout_policy_versions__decided_by")

  @@unique([policyId, versionNo], map: "ux_factory_payout_policy_versions__policy_id__version_no")
  @@index([policyId, effectiveFrom(sort: Desc), versionNo(sort: Desc)], map: "ix_factory_payout_policy_versions__resolution", where: raw("(status = 'approved'::config_version_status)"))
  @@index([approvalRequestId], map: "ix_factory_payout_policy_versions__approval_request_id")
