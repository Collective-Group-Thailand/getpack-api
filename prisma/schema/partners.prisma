  pouchMaterialPrices        PlPouchMaterialPrice[]        @relation("PlPouchMaterialPricePriceListVersion")
  pouchPrintPrices           PlPouchPrintPrice[]           @relation("PlPouchPrintPricePriceListVersion")
  pouchOptionPrices          PlPouchOptionPrice[]          @relation("PlPouchOptionPricePriceListVersion")
  pouchProcessPrices         PlPouchProcessPrice[]         @relation("PlPouchProcessPricePriceListVersion")
  pouchMinQuantities         PlPouchMinQuantity[]          @relation("PlPouchMinQuantityPriceListVersion")
  pouchFactoryMargins        PlPouchFactoryMargin[]        @relation("PlPouchFactoryMarginPriceListVersion")
  pouchOptionRules           PlPouchOptionRule[]           @relation("PlPouchOptionRulePriceListVersion")
