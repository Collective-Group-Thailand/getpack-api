// U-B6 standard product (schema-design A-74, port map docs/legacy/05-standard-product-port-map.md §9): the factory's buy
// price per piece of a stock product by quantity band (legacy `standard_product_prices`).
model PlStockProductPrice {
  id                 BigInt   @id(map: "pk_pl_stock_product_prices") @default(autoincrement())
  priceListVersionId BigInt   @map("price_list_version_id")
  lineKey            String   @map("line_key")
