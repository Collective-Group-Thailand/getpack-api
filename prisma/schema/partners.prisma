  @@map("pl_stock_product_prices")
}

// U-B6 service (schema-design A-75, port map docs/legacy/05-service-port-map.md §9): a factory's net buy cost per unit of a
// service item (a `service` catalogue product). Legacy kept no service price table (CS typed the cost, D-194); a line
// here is what makes a service instant (D-100, D-043).
model PlServicePrice {
  id                 BigInt   @id(map: "pk_pl_service_prices") @default(autoincrement())
  priceListVersionId BigInt   @map("price_list_version_id")
  lineKey            String   @map("line_key")
