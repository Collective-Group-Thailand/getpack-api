}

enum PayoutTrigger {
  job_accepted
  immediate
  none
  after_pod
  after_pod_and_claim_window

  @@map("payout_trigger")
}

enum PriceVersionOrigin {
  factory_proposal
  platform_rate_card
  assisted_entry
  import

  @@map("price_version_origin")
}

