/// Legal entities (schema-design §2.3). Legal name, tax id, branch and logo are entity-scoped settings (D-092).
model Entity {
  id                   BigInt       @id(map: "pk_entities") @default(autoincrement())
  publicId             String       @unique(map: "ux_entities__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  code                 String       @unique(map: "ux_entities__code")
  displayName          String       @map("display_name")
  status               EntityStatus @default(active)
  isDefault            Boolean      @default(false) @map("is_default")
  baseCurrency         String       @default("THB") @map("base_currency") @db.Char(3)
  timezone             String       @default("Asia/Bangkok")
  fiscalYearStartMonth Int          @default(1) @map("fiscal_year_start_month") @db.SmallInt
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById          BigInt?      @map("created_by")
  updatedAt            DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById          BigInt?      @map("updated_by")
  rowVersion           Int          @default(1) @map("row_version")

  createdBy        User?             @relation("EntityCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_entities__created_by")
  updatedBy        User?             @relation("EntityUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_entities__updated_by")
  approvalRequests ApprovalRequest[]
  auditLogs        AuditLog[]
  activityLogs     ActivityLog[]
  domainEvents     DomainEvent[]

  // --- Pricing (generated back-relations)
  carrierAccounts CarrierAccount[] @relation("CarrierAccountEntity")
  // --- end Pricing

  // --- Quotes & RFQ (generated back-relations)
  quotes         Quote[]          @relation("QuoteEntity")
  rfqs           Rfq[]            @relation("RfqEntity")
  documentSeries DocumentSeries[] @relation("DocumentSeriesEntity")

  // --- end Quotes & RFQ
  // --- Commerce (generated back-relations)
  carts         Cart[]         @relation("CartEntity")
  orderGroups   OrderGroup[]   @relation("OrderGroupEntity")
  orders        Order[]        @relation("OrderEntity")
  payments      Payment[]      @relation("PaymentEntity")
  refunds       Refund[]       @relation("RefundEntity")
  campaigns     Campaign[]     @relation("CampaignEntity")
  promotions    Promotion[]    @relation("PromotionEntity")
  companies     Company[]      @relation("CompanyEntity")
  discountMemos DiscountMemo[] @relation("DiscountMemoEntity")
  // --- end Commerce

  // --- Fulfilment B4.2 (generated back-relations)
  productionJobs ProductionJob[] @relation("ProductionJobEntity")
  // --- end Fulfilment B4.2

  // --- Fulfilment B4.3 (generated back-relations)
  shipments Shipment[] @relation("ShipmentEntity")
  // --- end Fulfilment B4.3

  // --- Fulfilment B4.5 (generated back-relations)
  claims Claim[] @relation("ClaimEntity")
  // --- end Fulfilment B4.5

  // --- Finance B5.1 (generated back-relations)
  fiscalYears          FiscalYear[]          @relation("FiscalYearEntity")
  fiscalPeriods        FiscalPeriod[]        @relation("FiscalPeriodEntity")
  accounts             Account[]             @relation("AccountEntity")
  accountChanges       AccountChange[]       @relation("AccountChangeEntity")
  costCentres          CostCentre[]          @relation("CostCentreEntity")
  journalEntries       JournalEntry[]        @relation("JournalEntryEntity")
  journalLines         JournalLine[]         @relation("JournalLineEntity")
  recurringJournals    RecurringJournal[]    @relation("RecurringJournalEntity")
  journalEntryCounters JournalEntryCounter[] @relation("JournalEntryCounterEntity")
  // --- end Finance B5.1

  // --- Finance B5.2 (generated back-relations)
  customerDocuments       CustomerDocument[]       @relation("CustomerDocumentEntity")
  creditNoteRequests      CreditNoteRequest[]      @relation("CreditNoteRequestEntity")
  customerWhtCertificates CustomerWhtCertificate[] @relation("CustomerWhtCertificateEntity")
  receivableItems         ReceivableItem[]         @relation("ReceivableItemEntity")
  storeCreditAccounts     StoreCreditAccount[]     @relation("StoreCreditAccountEntity")
  badDebtProvisions       BadDebtProvision[]       @relation("BadDebtProvisionEntity")
  companyStatements       CompanyStatement[]       @relation("CompanyStatementEntity")
  // --- end Finance B5.2

  // --- Finance B5.3 (generated back-relations)
  companyBankAccounts  CompanyBankAccount[]  @relation("CompanyBankAccountEntity")
  purchaseOrders       PurchaseOrder[]       @relation("PurchaseOrderEntity")
  goodsReceipts        GoodsReceipt[]        @relation("GoodsReceiptEntity")
  billingStatements    BillingStatement[]    @relation("BillingStatementEntity")
  vendorInvoices       VendorInvoice[]       @relation("VendorInvoiceEntity")
  payableItems         PayableItem[]         @relation("PayableItemEntity")
  vendorDeductions     VendorDeduction[]     @relation("VendorDeductionEntity")
  payoutRuns           PayoutRun[]           @relation("PayoutRunEntity")
  whtCertificates      WhtCertificate[]      @relation("WhtCertificateEntity")
  bankStatementImports BankStatementImport[] @relation("BankStatementImportEntity")
  gatewaySettlements   GatewaySettlement[]   @relation("GatewaySettlementEntity")
  unidentifiedReceipts UnidentifiedReceipt[] @relation("UnidentifiedReceiptEntity")
  // --- end Finance B5.3

  // --- Finance B5.4
  taxReports       TaxReport[]       @relation("TaxReportEntity")
  taxCalendarItems TaxCalendarItem[] @relation("TaxCalendarItemEntity")
  // --- end Finance B5.4

  // --- Finance B5.5
  assetCategories  AssetCategory[]   @relation("AssetCategoryEntity")
  fixedAssets      FixedAsset[]      @relation("FixedAssetEntity")
  depreciationRuns DepreciationRun[] @relation("DepreciationRunEntity")
  // --- end Finance B5.5

  // --- Finance B5.6
  closeChecklists CloseChecklist[] @relation("CloseChecklistEntity")
  auditSamples    AuditSample[]    @relation("AuditSampleEntity")
  pbcExports      PbcExport[]      @relation("PbcExportEntity")
  // --- end Finance B5.6

  samples Sample[] @relation("SampleEntity")

  @@unique([isDefault], map: "ux_entities__is_default", where: raw("is_default"))
  @@map("entities")
}

/// Identity of a configurable value; values live in versions (ADR-0005, schema-design §2.1).
model Setting {
  id                 BigInt              @id(map: "pk_settings") @default(autoincrement())
  publicId           String              @unique(map: "ux_settings__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  key                String
  scopeType          SettingScope        @default(platform) @map("scope_type")
  scopeId            BigInt?             @map("scope_id")
  valueType          SettingValueType    @map("value_type")
  valueSchema        Json?               @map("value_schema")
  description        String
  decisionRefs       String[]            @default([]) @map("decision_refs")
  ownerRoleKey       String              @map("owner_role_key")
  approvalPolicyKey  String?             @map("approval_policy_key")
  confirmationStatus SettingConfirmation @default(confirmed) @map("confirmation_status")
  isSensitive        Boolean             @default(false) @map("is_sensitive")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById        BigInt?             @map("created_by")
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById        BigInt?             @map("updated_by")
  rowVersion         Int                 @default(1) @map("row_version")

  createdBy User?            @relation("SettingCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_settings__created_by")
  updatedBy User?            @relation("SettingUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_settings__updated_by")
  versions  SettingVersion[]

  // ux (key, scope_type, coalesce(scope_id, 0)) is an expression index in the migration SQL.
  @@index([key], map: "ix_settings__key")
  @@map("settings")
}

model SettingVersion {
  id                BigInt              @id(map: "pk_setting_versions") @default(autoincrement())
  settingId         BigInt              @map("setting_id")
  versionNo         Int                 @map("version_no")
  effectiveFrom     DateTime            @map("effective_from") @db.Timestamptz(6)
  status            ConfigVersionStatus @default(draft)
  value             Json
  reason            String
  approvalRequestId BigInt?             @map("approval_request_id")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById       BigInt?             @map("created_by")
  decidedAt         DateTime?           @map("decided_at") @db.Timestamptz(6)
  decidedById       BigInt?             @map("decided_by")

  setting         Setting          @relation(fields: [settingId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_setting_versions__setting_id")
  approvalRequest ApprovalRequest? @relation(fields: [approvalRequestId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_setting_versions__approval_request_id")
  createdBy       User?            @relation("SettingVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_setting_versions__created_by")
  decidedBy       User?            @relation("SettingVersionDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_setting_versions__decided_by")

  loyaltyMembershipsTiers LoyaltyMembership[] @relation("LoyaltyMembershipTiersVersion")
  pointsEntries           PointsEntry[]       @relation("PointsEntryPointValueVersion")

  advisoryRecommendations AdvisoryRecommendation[] @relation("AdvisoryRecommendationRuleSetVersion")

  styleIntakes StyleIntake[] @relation("StyleIntakeTermsVersion")

  designCheckRuns DesignCheckRun[] @relation("DesignCheckRunRules")

  @@unique([settingId, versionNo], map: "ux_setting_versions__setting_id__version_no")
  @@index([settingId, effectiveFrom(sort: Desc), versionNo(sort: Desc)], map: "ix_setting_versions__resolution", where: raw("status = 'approved'"))
  @@index([approvalRequestId], map: "ix_setting_versions__approval_request_id")
  @@map("setting_versions")
}

/// Operational toggles (e.g. R2 adapters, D-111) — not business values; changes are audited.
model FeatureFlag {
  id           BigInt   @id(map: "pk_feature_flags") @default(autoincrement())
  key          String   @unique(map: "ux_feature_flags__key")
  description  String
  enabled      Boolean  @default(false)
  rules        Json     @default("{}")
  ownerRoleKey String   @map("owner_role_key")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById  BigInt?  @map("created_by")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById  BigInt?  @map("updated_by")
  rowVersion   Int      @default(1) @map("row_version")

  createdBy User? @relation("FeatureFlagCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_feature_flags__created_by")
  updatedBy User? @relation("FeatureFlagUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_feature_flags__updated_by")

  @@map("feature_flags")
}

// ---------------------------------------------------------------------------------------------
// Approval-matrix engine (ADR-0006)
// ---------------------------------------------------------------------------------------------

model ApprovalPolicy {
  id           BigInt   @id(map: "pk_approval_policies") @default(autoincrement())
  publicId     String   @unique(map: "ux_approval_policies__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  key          String   @unique(map: "ux_approval_policies__key")
  subjectType  String   @map("subject_type")
  description  String
  decisionRefs String[] @default([]) @map("decision_refs")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById  BigInt?  @map("created_by")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById  BigInt?  @map("updated_by")
  rowVersion   Int      @default(1) @map("row_version")

  createdBy   User?                   @relation("ApprovalPolicyCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_approval_policies__created_by")
  updatedBy   User?                   @relation("ApprovalPolicyUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_approval_policies__updated_by")
  versions    ApprovalPolicyVersion[]
  requests    ApprovalRequest[]
  delegations ApprovalDelegation[]

  @@map("approval_policies")
}

/// Versioned policy (schema-design §2.1); steps belong to a version.
model ApprovalPolicyVersion {
  id                BigInt              @id(map: "pk_approval_policy_versions") @default(autoincrement())
  policyId          BigInt              @map("policy_id")
  versionNo         Int                 @map("version_no")
  effectiveFrom     DateTime            @map("effective_from") @db.Timestamptz(6)
  status            ConfigVersionStatus @default(draft)
  expiryRule        Json?               @map("expiry_rule")
  onNoMatch         ApprovalNoMatch     @default(fail_closed) @map("on_no_match")
  reason            String
  approvalRequestId BigInt?             @map("approval_request_id")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById       BigInt?             @map("created_by")
  decidedAt         DateTime?           @map("decided_at") @db.Timestamptz(6)
  decidedById       BigInt?             @map("decided_by")

  policy          ApprovalPolicy    @relation(fields: [policyId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_approval_policy_versions__policy_id")
  approvalRequest ApprovalRequest?  @relation("ApprovalPolicyVersionApproval", fields: [approvalRequestId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_approval_policy_versions__approval_request_id")
  createdBy       User?             @relation("ApprovalPolicyVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_approval_policy_versions__created_by")
  decidedBy       User?             @relation("ApprovalPolicyVersionDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_approval_policy_versions__decided_by")
  steps           ApprovalStep[]
  requests        ApprovalRequest[] @relation("ApprovalRequestPolicyVersion")

  @@unique([policyId, versionNo], map: "ux_approval_policy_versions__policy_id__version_no")
  @@index([policyId, effectiveFrom(sort: Desc), versionNo(sort: Desc)], map: "ix_approval_policy_versions__resolution", where: raw("status = 'approved'"))
  @@index([approvalRequestId], map: "ix_approval_policy_versions__approval_request_id")
  @@map("approval_policy_versions")
}

model ApprovalStep {
  id               BigInt            @id(map: "pk_approval_steps") @default(autoincrement())
  policyVersionId  BigInt            @map("policy_version_id")
  stepNo           Int               @map("step_no") @db.SmallInt
  name             String
  approverRoleId   BigInt            @map("approver_role_id")
  approverScope    ApprovalScopeRule @default(platform) @map("approver_scope")
  /// Engine-evaluated condition on amount / pct / entity / flags; null = always (ADR-0006).
  condition        Json?
  quorum           Int               @default(1) @db.SmallInt
  slaMinutes       Int?              @map("sla_minutes")
  slaCalendar      CalendarBasis     @default(business) @map("sla_calendar")
  escalateToRoleId BigInt?           @map("escalate_to_role_id")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  policyVersion  ApprovalPolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_approval_steps__policy_version_id")
  approverRole   Role                  @relation("ApprovalStepApproverRole", fields: [approverRoleId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_approval_steps__approver_role_id")
  escalateToRole Role?                 @relation("ApprovalStepEscalateRole", fields: [escalateToRoleId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_approval_steps__escalate_to_role_id")

  @@unique([policyVersionId, stepNo], map: "ux_approval_steps__policy_version_id__step_no")
  @@index([approverRoleId], map: "ix_approval_steps__approver_role_id")
  @@index([escalateToRoleId], map: "ix_approval_steps__escalate_to_role_id")
  @@map("approval_steps")
}

model ApprovalRequest {
  id              BigInt         @id(map: "pk_approval_requests") @default(autoincrement())
  publicId        String         @unique(map: "ux_approval_requests__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  entityId        BigInt         @map("entity_id")
  policyId        BigInt         @map("policy_id")
  policyVersionId BigInt         @map("policy_version_id")
  subjectType     String         @map("subject_type")
  subjectId       BigInt         @map("subject_id")
  subjectPublicId String         @map("subject_public_id") @db.Uuid
  requesterUserId BigInt         @map("requester_user_id")
  payloadSnapshot Json           @map("payload_snapshot")
  amount          Decimal?       @db.Decimal(14, 2)
  pct             Decimal?       @db.Decimal(7, 4)
  flags           String[]       @default([])
  status          ApprovalStatus @default(pending)
  currentStepNo   Int?           @map("current_step_no") @db.SmallInt
  expiresAt       DateTime?      @map("expires_at") @db.Timestamptz(6)
  decidedAt       DateTime?      @map("decided_at") @db.Timestamptz(6)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion      Int            @default(1) @map("row_version")

  entity                 Entity                  @relation(fields: [entityId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_approval_requests__entity_id")
  policy                 ApprovalPolicy          @relation(fields: [policyId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_approval_requests__policy_id")
  policyVersion          ApprovalPolicyVersion   @relation("ApprovalRequestPolicyVersion", fields: [policyVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_approval_requests__policy_version_id")
  requester              User                    @relation("ApprovalRequestRequester", fields: [requesterUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_approval_requests__requester_user_id")
  steps                  ApprovalRequestStep[]
  actions                ApprovalAction[]
  settingVersions        SettingVersion[]
  policyVersionApprovals ApprovalPolicyVersion[] @relation("ApprovalPolicyVersionApproval")
  consentPurposeVersions ConsentPurposeVersion[]

  // --- Partners (generated back-relations)
  factoryStatusHistories            FactoryStatusHistory[]             @relation("FactoryStatusHistoryApprovalRequest")
  agreementTemplateVersions         AgreementTemplateVersion[]         @relation("AgreementTemplateVersionApprovalRequest")
  factoryParticipationVersions      FactoryParticipationVersion[]      @relation("FactoryParticipationVersionApprovalRequest")
  factoryPricingArrangementVersions FactoryPricingArrangementVersion[] @relation("FactoryPricingArrangementVersionApprovalRequest")
  factoryCapacityVersions           FactoryCapacityVersion[]           @relation("FactoryCapacityVersionApprovalRequest")
  factoryTolerancePolicyVersions    FactoryTolerancePolicyVersion[]    @relation("FactoryTolerancePolicyVersionApprovalRequest")
  factoryPayoutPolicyVersions       FactoryPayoutPolicyVersion[]       @relation("FactoryPayoutPolicyVersionApprovalRequest")
  priceListVersions                 PriceListVersion[]                 @relation("PriceListVersionApprovalRequest")
  priceProposals                    PriceProposal[]                    @relation("PriceProposalApprovalRequest")
  // --- end Partners

  // --- Finance (generated back-relations)
  vendorBankAccounts               VendorBankAccount[]               @relation("VendorBankAccountApprovalRequest")
  // --- end Finance
  // --- Pricing (generated back-relations)
  sellMarginTableVersions          SellMarginTableVersion[]          @relation("SellMarginTableVersionApprovalRequest")
  taxRateVersions                  TaxRateVersion[]                  @relation("TaxRateVersionApprovalRequest")
  customerShippingRateCardVersions CustomerShippingRateCardVersion[] @relation("CustomerShippingRateCardVersionApprovalRequest")
  // --- end Pricing

  paymentScheduleTemplateVersions PaymentScheduleTemplateVersion[] @relation("PaymentScheduleTemplateVersionApprovalRequest")
  refunds                         Refund[]                         @relation("RefundApprovalRequest")

  referralAttributions ReferralAttribution[] @relation("ReferralApprovalRequest")

  companyCreditLimitVersions CompanyCreditLimitVersion[] @relation("CompanyCreditLimitVersionApprovalRequest")
  discountMemos              DiscountMemo[]              @relation("DiscountMemoApprovalRequest")
  companyApprovedGroups      OrderGroup[]                @relation("OrderGroupCompanyApproval")

  // --- Fulfilment B4.2 (generated back-relations)
  milestoneRouteVersions MilestoneRouteVersion[] @relation("MilestoneRouteVersionApprovalRequest")
