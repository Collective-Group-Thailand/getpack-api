  actorUserId      BigInt             @map("actor_user_id")
  onBehalfOfUserId BigInt?            @map("on_behalf_of_user_id")
  comment          String?
  ip               String?            @db.Inet
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  request     ApprovalRequest      @relation(fields: [requestId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_approval_actions__request_id")
  requestStep ApprovalRequestStep? @relation(fields: [requestStepId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_approval_actions__request_step_id")
  actor       User                 @relation("ApprovalActionActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_approval_actions__actor_user_id")
  onBehalfOf  User?                @relation("ApprovalActionOnBehalfOf", fields: [onBehalfOfUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_approval_actions__on_behalf_of_user_id")

  @@unique([requestId, actorUserId], map: "ux_approval_actions__one_approval_per_person", where: raw("action = 'approve'"))
  @@index([requestId], map: "ix_approval_actions__request_id")
  @@index([requestStepId], map: "ix_approval_actions__request_step_id")
  @@index([actorUserId], map: "ix_approval_actions__actor_user_id")
  @@index([onBehalfOfUserId], map: "ix_approval_actions__on_behalf_of_user_id")
  @@map("approval_actions")
}

