  @@index([actorUserId, occurredAt], map: "ix_activity_logs__actor_user_id__occurred_at")
  @@index([domainEventId], map: "ix_activity_logs__domain_event_id")
  @@map("activity_logs")
}

/// Event envelope (B1 prompt). Not partitioned: the ledger references it by FK (schema-design A-10). Append-only.
