/// Steps materialised from the policy version when the request is created (ADR-0006).
model ApprovalRequestStep {
  id              BigInt             @id(map: "pk_approval_request_steps") @default(autoincrement())
  requestId       BigInt             @map("request_id")
  stepNo          Int                @map("step_no") @db.SmallInt
  approverRoleId  BigInt             @map("approver_role_id")
  approverScopeId BigInt?            @map("approver_scope_id")
  quorum          Int                @default(1) @db.SmallInt
  dueAt           DateTime?          @map("due_at") @db.Timestamptz(6)
  status          ApprovalStepStatus @default(pending)
  completedAt     DateTime?          @map("completed_at") @db.Timestamptz(6)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  request      ApprovalRequest  @relation(fields: [requestId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_approval_request_steps__request_id")
  approverRole Role             @relation(fields: [approverRoleId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_approval_request_steps__approver_role_id")
  actions      ApprovalAction[]

  @@unique([requestId, stepNo], map: "ux_approval_request_steps__request_id__step_no")
  @@index([approverRoleId, status], map: "ix_approval_request_steps__approver_role_id__status")
  @@index([status, dueAt], map: "ix_approval_request_steps__status__due_at")
  @@map("approval_request_steps")
}

/// Append-only (trigger). The requester can never approve; one person approves at most one step.
model ApprovalAction {
  id               BigInt             @id(map: "pk_approval_actions") @default(autoincrement())
  requestId        BigInt             @map("request_id")
  requestStepId    BigInt?            @map("request_step_id")
