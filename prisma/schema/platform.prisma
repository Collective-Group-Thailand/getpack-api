  id                   String    @id(map: "pk_domain_events") @default(dbgenerated("uuidv7()")) @db.Uuid
  type                 String
  aggregateType        String    @map("aggregate_type")
  aggregateId          String    @map("aggregate_id") @db.Uuid
  entityId             BigInt?   @map("entity_id")
  actorType            ActorType @map("actor_type")
  actorUserId          BigInt?   @map("actor_user_id")
  actorApiClientId     BigInt?   @map("actor_api_client_id")
  occurredAt           DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  correlationId        String    @map("correlation_id") @db.Uuid
  causationId          String?   @map("causation_id") @db.Uuid
  payload              Json
  payloadSchemaVersion Int       @default(1) @map("payload_schema_version") @db.SmallInt
  recordedAt           DateTime  @default(now()) @map("recorded_at") @db.Timestamptz(6)

  entity         Entity?            @relation(fields: [entityId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_domain_events__entity_id")
  actorUser      User?              @relation("DomainEventActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_domain_events__actor_user_id")
  actorApiClient ApiClient?         @relation(fields: [actorApiClientId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_domain_events__actor_api_client_id")
  outbox         OutboxMessage[]
  consumptions   EventConsumption[]
  activityLogs   ActivityLog[]
  webhooks       WebhookInbox[]
  notifications  Notification[]

  // --- Fulfilment B4.3 (generated back-relations)
