  messageParams     Json                 @default("{}") @map("message_params")
  domainEventId     String?              @map("domain_event_id") @db.Uuid
  data              Json                 @default("{}")

  entity         Entity?      @relation(fields: [entityId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_activity_logs__entity_id")
  actorUser      User?        @relation("ActivityLogActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_activity_logs__actor_user_id")
  actorApiClient ApiClient?   @relation(fields: [actorApiClientId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_activity_logs__actor_api_client_id")
  onBehalfOf     User?        @relation("ActivityLogOnBehalfOf", fields: [onBehalfOfUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_activity_logs__on_behalf_of_user_id")
