  // --- end Finance B5.1

  webhookDeliveries WebhookDelivery[] @relation("WebhookDeliveryEvent")

  @@index([aggregateType, aggregateId, occurredAt], map: "ix_domain_events__aggregate")
  @@index([type, occurredAt], map: "ix_domain_events__type__occurred_at")
  @@index([correlationId], map: "ix_domain_events__correlation_id")
  @@index([entityId], map: "ix_domain_events__entity_id")
  @@index([actorUserId], map: "ix_domain_events__actor_user_id")
  @@index([actorApiClientId], map: "ix_domain_events__actor_api_client_id")
  @@map("domain_events")
}

model OutboxMessage {
  id            BigInt       @id(map: "pk_outbox_messages") @default(autoincrement())
  eventId       String       @map("event_id") @db.Uuid
  topic         String
  status        OutboxStatus @default(pending)
  attempts      Int          @default(0) @db.SmallInt
  nextAttemptAt DateTime     @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lastError     String?      @map("last_error")
  dispatchedAt  DateTime?    @map("dispatched_at") @db.Timestamptz(6)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  event DomainEvent @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_outbox_messages__event_id")

  @@unique([eventId, topic], map: "ux_outbox_messages__event_id__topic")
  @@index([nextAttemptAt], map: "ix_outbox_messages__due", where: raw("status = ANY (ARRAY['pending'::outbox_status, 'failed'::outbox_status])"))
  @@map("outbox_messages")
}

/// Inbox for idempotent subscribers (notifications, ledger, analytics).
model EventConsumption {
  consumer    String
  eventId     String   @map("event_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)
  outcome     String

  event DomainEvent @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_event_consumptions__event_id")

  @@id([consumer, eventId], map: "pk_event_consumptions")
  @@index([eventId], map: "ix_event_consumptions__event_id")
  @@map("event_consumptions")
}

/// Every inbound provider callback; (provider, provider_event_id) makes replays no-ops.
model WebhookInbox {
  id              BigInt          @id(map: "pk_webhook_inbox") @default(autoincrement())
  provider        WebhookProvider
  providerEventId String          @map("provider_event_id")
  receivedAt      DateTime        @default(now()) @map("received_at") @db.Timestamptz(6)
  signatureValid  Boolean         @map("signature_valid")
  /// Allow-listed headers only.
  headers         Json            @default("{}")
  /// Redacted per provider (PDPA).
  payload         Json
  status          WebhookStatus   @default(received)
  processedAt     DateTime?       @map("processed_at") @db.Timestamptz(6)
  error           String?
  domainEventId   String?         @map("domain_event_id") @db.Uuid

  domainEvent DomainEvent? @relation(fields: [domainEventId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_webhook_inbox__domain_event_id")

  @@unique([provider, providerEventId], map: "ux_webhook_inbox__provider__provider_event_id")
  @@index([status, receivedAt], map: "ix_webhook_inbox__status__received_at")
  @@index([domainEventId], map: "ix_webhook_inbox__domain_event_id")
  @@map("webhook_inbox")
}

/// Durable idempotency store (contract §3); scope = actor|method|path of the request.
model IdempotencyKey {
  scope           String
  key             String            @db.Uuid
  requestSha256   Bytes             @map("request_sha256")
  status          IdempotencyStatus @default(in_progress)
  responseStatus  Int?              @map("response_status") @db.SmallInt
  responseHeaders Json?             @map("response_headers")
  responseBody    Json?             @map("response_body")
  lockedUntil     DateTime?         @map("locked_until") @db.Timestamptz(6)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  expiresAt       DateTime          @map("expires_at") @db.Timestamptz(6)

  @@id([scope, key], map: "pk_idempotency_keys")
  @@index([expiresAt], map: "ix_idempotency_keys__expires_at")
  @@map("idempotency_keys")
}

// ---------------------------------------------------------------------------------------------
// Notifications (D-143, D-144) & web push
// ---------------------------------------------------------------------------------------------

model NotificationTemplate {
  id          BigInt               @id(map: "pk_notification_templates") @default(autoincrement())
  publicId    String               @unique(map: "ux_notification_templates__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  key         String
  channel     NotificationChannel
  category    NotificationCategory
  description String
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById BigInt?              @map("created_by")
  updatedAt   DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById BigInt?              @map("updated_by")
  rowVersion  Int                  @default(1) @map("row_version")

  createdBy User?                         @relation("NotificationTemplateCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_notification_templates__created_by")
  updatedBy User?                         @relation("NotificationTemplateUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_notification_templates__updated_by")
  versions  NotificationTemplateVersion[]
  routes    NotificationRoute[]

  @@unique([key, channel], map: "ux_notification_templates__key__channel")
  @@map("notification_templates")
}

model NotificationTemplateVersion {
  id            BigInt                @id(map: "pk_notification_template_versions") @default(autoincrement())
  templateId    BigInt                @map("template_id")
  versionNo     Int                   @map("version_no")
  locale        LocaleCode
  subject       String?
  /// MJML / Handlebars (email) or plain text.
  body          String
  status        TemplateVersionStatus @default(draft)
  publishedAt   DateTime?             @map("published_at") @db.Timestamptz(6)
  publishedById BigInt?               @map("published_by")
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById   BigInt?               @map("created_by")

  template      NotificationTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_notification_template_versions__template_id")
  publishedBy   User?                @relation("NotificationTemplateVersionPublishedBy", fields: [publishedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_notification_template_versions__published_by")
  createdBy     User?                @relation("NotificationTemplateVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_notification_template_versions__created_by")
  notifications Notification[]

  @@unique([templateId, locale, versionNo], map: "ux_notification_template_versions__template__locale__version")
  @@unique([templateId, locale], map: "ux_notification_template_versions__one_published", where: raw("status = 'published'"))
  @@map("notification_template_versions")
}

/// Routing matrix event × audience × channel (D-143). ux with coalesce(staff_team_id, 0) is in the migration SQL.
model NotificationRoute {
  id          BigInt               @id(map: "pk_notification_routes") @default(autoincrement())
  publicId    String               @unique(map: "ux_notification_routes__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  eventType   String               @map("event_type")
  audience    NotificationAudience
  staffTeamId BigInt?              @map("staff_team_id")
  channel     NotificationChannel
  templateId  BigInt               @map("template_id")
  /// SMS only for critical events (D-143).
  isCritical  Boolean              @default(false) @map("is_critical")
  /// Quiet hours + consent apply (D-144).
  isMarketing Boolean              @default(false) @map("is_marketing")
  enabled     Boolean              @default(true)
  conditions  Json?
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById BigInt?              @map("created_by")
  updatedAt   DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById BigInt?              @map("updated_by")
  rowVersion  Int                  @default(1) @map("row_version")

  staffTeam     Team?                @relation(fields: [staffTeamId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_notification_routes__staff_team_id")
  template      NotificationTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_notification_routes__template_id")
  createdBy     User?                @relation("NotificationRouteCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_notification_routes__created_by")
  updatedBy     User?                @relation("NotificationRouteUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_notification_routes__updated_by")
  notifications Notification[]

  @@index([eventType], map: "ix_notification_routes__event_type")
  @@index([staffTeamId], map: "ix_notification_routes__staff_team_id")
  @@index([templateId], map: "ix_notification_routes__template_id")
  @@map("notification_routes")
}

model NotificationPreference {
  id        BigInt               @id(map: "pk_notification_preferences") @default(autoincrement())
  userId    BigInt               @map("user_id")
  channel   NotificationChannel
  category  NotificationCategory
  enabled   Boolean
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_notification_preferences__user_id")

  @@unique([userId, channel, category], map: "ux_notification_preferences__user__channel__category")
  @@map("notification_preferences")
}

/// Send log and in-app inbox. Idempotent per (event, recipient, channel) — expression index in the migration SQL.
model Notification {
  id                     BigInt              @id(map: "pk_notifications") @default(autoincrement())
  eventId                String              @map("event_id") @db.Uuid
  routeId                BigInt?             @map("route_id")
  recipientUserId        BigInt?             @map("recipient_user_id")
  recipientAddressMasked String?             @map("recipient_address_masked")
  recipientAddressHash   Bytes?              @map("recipient_address_hash")
  channel                NotificationChannel
  templateVersionId      BigInt?             @map("template_version_id")
  status                 NotificationStatus  @default(queued)
  scheduledFor           DateTime?           @map("scheduled_for") @db.Timestamptz(6)
  sentAt                 DateTime?           @map("sent_at") @db.Timestamptz(6)
  deliveredAt            DateTime?           @map("delivered_at") @db.Timestamptz(6)
  readAt                 DateTime?           @map("read_at") @db.Timestamptz(6)
  providerMessageId      String?             @map("provider_message_id")
  error                  String?
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  event           DomainEvent                  @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_notifications__event_id")
  route           NotificationRoute?           @relation(fields: [routeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_notifications__route_id")
  recipient       User?                        @relation(fields: [recipientUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_notifications__recipient_user_id")
  templateVersion NotificationTemplateVersion? @relation(fields: [templateVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_notifications__template_version_id")

  @@index([recipientUserId, channel, createdAt(sort: Desc)], map: "ix_notifications__recipient__channel__created_at")
  @@index([status, scheduledFor], map: "ix_notifications__status__scheduled_for")
  @@index([routeId], map: "ix_notifications__route_id")
  @@index([templateVersionId], map: "ix_notifications__template_version_id")
  @@map("notifications")
}

model WebPushSubscription {
  id            BigInt    @id(map: "pk_web_push_subscriptions") @default(autoincrement())
  publicId      String    @unique(map: "ux_web_push_subscriptions__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  userId        BigInt    @map("user_id")
  endpoint      String    @unique(map: "ux_web_push_subscriptions__endpoint")
  p256dh        String
  authSecretEnc Bytes     @map("auth_secret_enc")
  userAgent     String?   @map("user_agent")
  lastUsedAt    DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_web_push_subscriptions__user_id")

  @@index([userId], map: "ix_web_push_subscriptions__user_id")
  @@map("web_push_subscriptions")
}

// ---------------------------------------------------------------------------------------------
// Business calendars (D-161) & embeddings (ADR-0001)
// ---------------------------------------------------------------------------------------------

/// `th_public` = the one national calendar every factory shares; factory calendars add closures (D-161).
model BusinessCalendar {
  id             BigInt       @id(map: "pk_business_calendars") @default(autoincrement())
  publicId       String       @unique(map: "ux_business_calendars__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  code           String       @unique(map: "ux_business_calendars__code")
  name           String
  kind           CalendarKind
  factoryId      BigInt?      @map("factory_id")
  /// Day-of-week numbers (0 = Sunday) in Asia/Bangkok; always set explicitly (no DB default).
  weekendDays    Int[]        @map("weekend_days") @db.SmallInt
  baseCalendarId BigInt?      @map("base_calendar_id")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById    BigInt?      @map("created_by")
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById    BigInt?      @map("updated_by")
  rowVersion     Int          @default(1) @map("row_version")

  factory          Factory?              @relation("BusinessCalendarFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_business_calendars__factory_id")
  baseCalendar     BusinessCalendar?     @relation("BusinessCalendarBase", fields: [baseCalendarId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_business_calendars__base_calendar_id")
  derivedCalendars BusinessCalendar[]    @relation("BusinessCalendarBase")
  createdBy        User?                 @relation("BusinessCalendarCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_business_calendars__created_by")
  updatedBy        User?                 @relation("BusinessCalendarUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_business_calendars__updated_by")
  days             BusinessCalendarDay[]

  // --- Partners (generated back-relations)
  factoriesCalendar Factory[] @relation("FactoryCalendar")
  // --- end Partners

  @@index([factoryId], map: "ix_business_calendars__factory_id")
  @@index([baseCalendarId], map: "ix_business_calendars__base_calendar_id")
  @@map("business_calendars")
}

model BusinessCalendarDay {
  id          BigInt            @id(map: "pk_business_calendar_days") @default(autoincrement())
  calendarId  BigInt            @map("calendar_id")
  day         DateTime          @db.Date
  kind        CalendarDayKind
  observance  HolidayObservance @default(all)
  nameTh      String            @map("name_th")
  nameEn      String?           @map("name_en")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById BigInt?           @map("created_by")
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById BigInt?           @map("updated_by")

  calendar  BusinessCalendar @relation(fields: [calendarId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_business_calendar_days__calendar_id")
  createdBy User?            @relation("BusinessCalendarDayCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_business_calendar_days__created_by")
  updatedBy User?            @relation("BusinessCalendarDayUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_business_calendar_days__updated_by")

  @@unique([calendarId, day], map: "ux_business_calendar_days__calendar_id__day")
  @@map("business_calendar_days")
}

/// Empty until an AI feature ships (ADR-0001); its HNSW index ships with that feature. subject = catalogue product (B2.1).
model ProductEmbedding {
  id           BigInt                      @id(map: "pk_product_embeddings") @default(autoincrement())
  subjectId    BigInt                      @map("subject_id")
  model        String
  modelVersion String                      @map("model_version")
  embedding    Unsupported("vector(1536)")
  createdAt    DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)

  subject CatalogProduct @relation(fields: [subjectId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_product_embeddings__subject_id")

  @@unique([subjectId, model, modelVersion], map: "ux_product_embeddings__subject__model__version")
  @@map("product_embeddings")
}

/// Empty until an AI feature ships (ADR-0001); its HNSW index ships with that feature. subject_id FK is added with design documents (B4.1).
model DesignEmbedding {
  id           BigInt                      @id(map: "pk_design_embeddings") @default(autoincrement())
  subjectId    BigInt                      @map("subject_id")
  model        String
  modelVersion String                      @map("model_version")
  embedding    Unsupported("vector(1536)")
  createdAt    DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([subjectId, model, modelVersion], map: "ux_design_embeddings__subject__model__version")
  @@map("design_embeddings")
}

// --- Document numbering (schema-design §2.7, migrated with its first user in B2.5) ---------------

/**
 * Statutory documents (accounting-design §4) and non-statutory running codes (§2.7).
 */
enum DocumentType {
  qt
  iv
  tr
  rc
  cn
  dn
  po
  gr
  bs
  pv
  wt
  jv
  fa
  order_group
  job
  claim
  shipment
  rfq
  order
  customer
  company
  support_ticket

  @@map("document_type")
}

enum SequenceReset {
  never
  yearly
  monthly

  @@map("sequence_reset")
}

/**
 * One numbering series per entity and document type. `format` placeholders: `{prefix}`, `{yyyy}`,
 * `{yy}`, `{mm}`, `{seq:N}` (zero-padded). Changes go through `document_series_change` (D-169, B5).
 */
model DocumentSeries {
  id           BigInt        @id(map: "pk_document_series") @default(autoincrement())
  publicId     String        @unique(map: "ux_document_series__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  entityId     BigInt        @map("entity_id")
  docType      DocumentType  @map("doc_type")
  prefix       String
  format       String
  resetPeriod  SequenceReset @map("reset_period")
  isGapless    Boolean       @map("is_gapless")
  description  String
  decisionRefs String[]      @map("decision_refs")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion   Int           @default(1) @map("row_version")

  entity    Entity             @relation("DocumentSeriesEntity", fields: [entityId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_document_series__entity_id")
  sequences DocumentSequence[]

  @@unique([entityId, docType], map: "ux_document_series__entity_id__doc_type")
  @@map("document_series")
}

/**
 * The next number per series and period; taken `FOR UPDATE` inside the issuing transaction.
 */
model DocumentSequence {
  id        BigInt   @id(map: "pk_document_sequences") @default(autoincrement())
  seriesId  BigInt   @map("series_id")
  periodKey String   @map("period_key")
  nextValue BigInt   @default(1) @map("next_value")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  series DocumentSeries @relation(fields: [seriesId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_document_sequences__series_id")

  @@unique([seriesId, periodKey], map: "ux_document_sequences__series_id__period_key")
  @@map("document_sequences")
}

/// D-292 a factory's weekly hours from a day on (effective-dated): `hours` per day of week (`mon`…`sun`, `{from, to}`
/// Bangkok `HH:mm` or null = closed). They replace the weekend and `calendar.business_hours` in the factory's calendar
/// from `effective_from`; a version already in force is never changed (trigger), a later one replaces it.
model FactoryBusinessHours {
  id            BigInt   @id(map: "pk_factory_business_hours") @default(autoincrement())
  publicId      String   @unique(map: "ux_factory_business_hours__public_id") @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  factoryId     BigInt   @map("factory_id")
  effectiveFrom DateTime @map("effective_from") @db.Date
  hours         Json
  createdById   BigInt   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  factory   Factory @relation("FactoryBusinessHoursFactory", fields: [factoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_factory_business_hours__factory_id")
  createdBy User    @relation("FactoryBusinessHoursCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_factory_business_hours__created_by")

  @@unique([factoryId, effectiveFrom], map: "ux_factory_business_hours__factory_id__effective_from")
  @@index([createdById], map: "ix_factory_business_hours__created_by")
  @@map("factory_business_hours")
}
