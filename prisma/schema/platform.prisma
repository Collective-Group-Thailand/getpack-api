/// Partitioned monthly by occurred_at (children in schema `partitions`); append-only (trigger).
model AuditLog {
  id               BigInt        @default(autoincrement())
  occurredAt       DateTime      @default(now()) @map("occurred_at") @db.Timestamptz(6)
  entityId         BigInt?       @map("entity_id")
  actorType        ActorType     @map("actor_type")
  actorUserId      BigInt?       @map("actor_user_id")
  actorApiClientId BigInt?       @map("actor_api_client_id")
  onBehalfOfUserId BigInt?       @map("on_behalf_of_user_id")
  category         AuditCategory
  action           String
  outcome          AuditOutcome
  resourceType     String?       @map("resource_type")
  resourcePublicId String?       @map("resource_public_id") @db.Uuid
  requestId        String?       @map("request_id")
  ip               String?       @db.Inet
  userAgent        String?       @map("user_agent")
  /// Redacted before/after diff — never secrets, tokens or bank data (PDPA).
  data             Json          @default("{}")

  entity         Entity?    @relation(fields: [entityId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_audit_logs__entity_id")
  actorUser      User?      @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_audit_logs__actor_user_id")
  actorApiClient ApiClient? @relation(fields: [actorApiClientId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_audit_logs__actor_api_client_id")
  onBehalfOf     User?      @relation("AuditLogOnBehalfOf", fields: [onBehalfOfUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_audit_logs__on_behalf_of_user_id")

  @@id([id, occurredAt], map: "pk_audit_logs")
  @@index([resourceType, resourcePublicId], map: "ix_audit_logs__resource")
  @@index([actorUserId, occurredAt], map: "ix_audit_logs__actor_user_id__occurred_at")
  @@index([category, occurredAt], map: "ix_audit_logs__category__occurred_at")
  @@map("audit_logs")
}

