          "requestId": "6f1c2d8e-2c7b-4d0e-9d1c-3f1a2b3c4d5e",
          "status": 500,
          "title": "เกิดข้อผิดพลาดในระบบ",
          "type": "https://errors.packio/internal.unexpected"
        }
      },
      "problem.service.unavailable": {
        "summary": "service.unavailable",
        "value": {
          "code": "service.unavailable",
          "detail": "ระบบไม่พร้อมให้บริการชั่วคราว กรุณาลองใหม่ภายหลัง",
          "requestId": "6f1c2d8e-2c7b-4d0e-9d1c-3f1a2b3c4d5e",
          "status": 503,
          "title": "ระบบไม่พร้อมให้บริการ",
          "type": "https://errors.packio/service.unavailable"
        }
      }
    },
    "headers": {
      "XRequestId": {
        "description": "Request id (echoes a valid incoming `X-Request-Id`); also in every problem as `requestId`.",
        "schema": {
          "example": "6f1c2d8e-2c7b-4d0e-9d1c-3f1a2b3c4d5e",
          "type": "string"
        }
      }
    },
    "parameters": {
      "AcceptLanguage": {
        "description": "Language of `title`/`detail` in problems and of generated documents: `th` (default) or `en`.",
        "in": "header",
        "name": "Accept-Language",
        "required": false,
        "schema": {
          "example": "th",
          "type": "string"
        }
      }
    },
    "schemas": {
      "HealthIndicatorState": {
        "properties": {
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/HealthIndicatorStatus"
              }
            ],
            "example": "up"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "HealthIndicatorStatus": {
        "enum": [
          "up",
          "down",
          "degraded"
        ],
        "type": "string"
      },
      "HealthResponse": {
        "properties": {
          "details": {
            "additionalProperties": {
              "$ref": "#/components/schemas/HealthIndicatorState"
            },
            "description": "Every dependency, by name",
            "example": {
              "database": {
                "status": "up"
              },
              "redis": {
                "status": "up"
              },
              "storage": {
                "status": "up"
              }
            },
            "type": "object"
          },
          "error": {
            "additionalProperties": {
              "$ref": "#/components/schemas/HealthIndicatorState"
            },
            "description": "Dependencies that are down, by name",
            "example": {},
            "type": "object"
          },
          "info": {
            "additionalProperties": {
              "$ref": "#/components/schemas/HealthIndicatorState"
            },
            "description": "Dependencies that are up, by name",
            "example": {
              "database": {
                "status": "up"
              },
              "redis": {
                "status": "up"
              },
              "storage": {
                "status": "up"
              }
            },
            "type": "object"
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/HealthStatus"
              }
            ],
            "example": "ok"
          }
        },
        "required": [
          "status",
          "details"
        ],
        "type": "object"
      },
      "HealthStatus": {
        "enum": [
          "ok",
          "error",
          "shutting_down"
        ],
        "type": "string"
      },
      "ProblemDetails": {
        "properties": {
          "code": {
            "description": "Stable machine-readable code; never renamed.",
            "example": "order.invalid_transition",
            "type": "string"
          },
          "detail": {
            "description": "Localised by `Accept-Language` (`th` default, `en`).",
            "example": "ไม่สามารถเปลี่ยนสถานะคำสั่งซื้อได้",
            "type": "string"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/ProblemFieldError"
            },
            "type": "array"
          },
          "requestId": {
            "example": "6f1c2d8e-2c7b-4d0e-9d1c-3f1a2b3c4d5e",
            "type": "string"
          },
          "status": {
            "example": 422,
            "type": "integer"
          },
          "title": {
            "example": "Invalid order transition",
            "type": "string"
          },
          "type": {
            "example": "https://errors.packio/order.invalid_transition",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "detail",
          "requestId"
        ],
        "type": "object"
      },
      "ProblemFieldError": {
        "properties": {
          "code": {
            "description": "Machine-readable rule that failed, e.g. `min`, `isUuid`.",
            "example": "min",
            "type": "string"
          },
          "message": {
            "example": "quantity must not be less than 1",
            "type": "string"
          },
          "path": {
            "description": "Path of the offending field, e.g. `items[0].quantity`.",
            "example": "items[0].quantity",
            "type": "string"
          }
        },
        "required": [
          "path",
          "code",
          "message"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "customer": {
        "bearerFormat": "JWT",
        "description": "Access token with `aud=customer` — `/v1/store/*`",
        "scheme": "bearer",
        "type": "http"
      },
      "partner": {
        "bearerFormat": "JWT",
        "description": "Access token with `aud=partner` — `/v1/partner/*` (users and client-credentials)",
        "scheme": "bearer",
        "type": "http"
      },
      "staff": {
        "bearerFormat": "JWT",
        "description": "Access token with `aud=staff` — `/v1/admin/*`",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "Packio — Your Packaging Production Partner, operated by Collective Group (Thailand).\nRules: `docs/contract/api-conventions.md` (shared with packio-web).\n\n- **Surfaces:** `/v1/auth`, `/v1/store` (customer), `/v1/admin` (staff), `/v1/partner` (factories), `/webhooks`. A token is accepted only on its own audience's prefix.\n- **Money:** decimal strings with exactly 2 decimals (`\"1234.50\"`) plus `currency: \"THB\"` on the object; never JSON numbers. Clients never compute prices.\n- **Dates:** ISO 8601 with offset, rendered in `Asia/Bangkok` (`2026-09-22T14:05:00+07:00`); date-only fields `YYYY-MM-DD`.\n- **IDs:** uuid only; business keys (`orderCode`) are separate fields.\n- **Errors:** RFC 9457 `application/problem+json` with a stable `code`; `title`/`detail` localised by `Accept-Language` (`th` default, `en`).\n- **Lists:** `?page&perPage(≤100)&sort&order&q` → `{ data, meta: { page, perPage, total } }`; feeds use `?cursor&limit` → `{ data, meta: { nextCursor } }`.\n- **Idempotency:** irreversible POSTs require `Idempotency-Key` (uuid); replays within 24 h return the original response.\n- **Concurrency:** editable resources return `ETag`; updates send `If-Match` (412 `concurrency.stale`).\n- **Files:** presign → PUT to the returned URL → reference the `fileId`.",
    "title": "Packio API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Pings PostgreSQL, Redis and object storage (S3) with a 2 s timeout each. 200 when all are up; 503 `service.unavailable` when any is down. Unauthenticated and not rate limited, for load balancers.\n\nImplements: ADR-0001, ADR-0003.",
        "operationId": "ops.health.check",
        "parameters": [
          {
            "$ref": "#/components/parameters/AcceptLanguage"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "details": {
                    "database": {
                      "status": "up"
                    },
                    "redis": {
                      "status": "up"
                    },
                    "storage": {
                      "status": "up"
                    }
                  },
                  "error": {},
                  "info": {
                    "database": {
                      "status": "up"
                    },
                    "redis": {
                      "status": "up"
                    },
                    "storage": {
                      "status": "up"
                    }
                  },
                  "status": "ok"
                },
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "All dependencies are up",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            }
          },
          "500": {
            "content": {
              "application/problem+json": {
                "examples": {
                  "internal.unexpected": {
                    "$ref": "#/components/examples/problem.internal.unexpected"
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Problem: `internal.unexpected`",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            }
          },
          "503": {
            "content": {
              "application/problem+json": {
                "examples": {
                  "service.unavailable": {
                    "$ref": "#/components/examples/problem.service.unavailable"
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Problem: `service.unavailable`",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            }
          }
        },
        "security": [],
        "summary": "Check the API and its dependencies",
        "tags": [
          "ops.health"
        ]
      }
    }
  },
  "servers": [
    {
      "description": "Local development (docker compose + pnpm dev)",
      "url": "http://localhost:3000"
    },
    {
      "description": "Integration",
      "url": "https://{host}",
      "variables": {
        "host": {
          "default": "integration.packio.invalid",
          "description": "Integration host (to be confirmed)"
        }
      }
    },
    {
      "description": "Sandbox",
      "url": "https://{host}",
      "variables": {
        "host": {
          "default": "sandbox.packio.invalid",
          "description": "Sandbox host (to be confirmed)"
        }
      }
    },
    {
      "description": "Production",
      "url": "https://{host}",
      "variables": {
        "host": {
          "default": "api.packio.invalid",
          "description": "Production host (to be confirmed)"
        }
      }
    }
  ],
  "tags": [
    {
      "description": "Liveness and readiness of the API and its dependencies (database, Redis, object storage).",
      "name": "ops.health"
    }
  ]
}
