{
  "components": {
    "schemas": {
      "CursorMeta": {
        "properties": {
          "nextCursor": {
            "example": "eyJpZCI6IjEyMyJ9",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "nextCursor"
        ],
        "type": "object"
      },
      "HealthIndicatorState": {
        "properties": {
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/HealthIndicatorStatus"
              }
            ]
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "HealthIndicatorStatus": {
        "enum": [
          "up",
          "down",
          "degraded"
        ],
        "type": "string"
      },
      "HealthResponse": {
        "properties": {
          "details": {
            "additionalProperties": {
              "$ref": "#/components/schemas/HealthIndicatorState"
            },
            "type": "object"
          },
          "error": {
            "additionalProperties": {
              "$ref": "#/components/schemas/HealthIndicatorState"
            },
            "type": "object"
          },
          "info": {
            "additionalProperties": {
              "$ref": "#/components/schemas/HealthIndicatorState"
            },
            "type": "object"
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/HealthStatus"
              }
            ]
          }
        },
        "required": [
          "status",
          "details"
        ],
        "type": "object"
      },
      "HealthStatus": {
        "enum": [
          "ok",
          "error",
          "shutting_down"
        ],
        "type": "string"
      },
      "PageMeta": {
        "properties": {
          "page": {
            "example": 1,
            "type": "integer"
          },
          "perPage": {
            "example": 25,
            "type": "integer"
          },
          "total": {
            "example": 1234,
            "type": "integer"
          }
        },
        "required": [
          "page",
          "perPage",
          "total"
        ],
        "type": "object"
      },
      "ProblemDetails": {
        "properties": {
          "code": {
            "description": "Stable machine-readable code; never renamed.",
            "example": "order.invalid_transition",
            "type": "string"
          },
          "detail": {
            "description": "Localised by `Accept-Language` (`th` default, `en`).",
            "example": "ไม่สามารถเปลี่ยนสถานะคำสั่งซื้อได้",
            "type": "string"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/ProblemFieldError"
            },
            "type": "array"
          },
          "requestId": {
            "example": "6f1c2d8e-2c7b-4d0e-9d1c-3f1a2b3c4d5e",
            "type": "string"
          },
          "status": {
            "example": 422,
            "type": "integer"
          },
          "title": {
            "example": "Invalid order transition",
            "type": "string"
          },
          "type": {
            "example": "https://errors.packio/order.invalid_transition",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "detail",
          "requestId"
        ],
        "type": "object"
      },
      "ProblemFieldError": {
        "properties": {
          "code": {
            "description": "Machine-readable rule that failed, e.g. `min`, `isUuid`.",
            "example": "min",
            "type": "string"
          },
          "message": {
            "example": "quantity must not be less than 1",
            "type": "string"
          },
          "path": {
            "description": "Path of the offending field, e.g. `items[0].quantity`.",
            "example": "items[0].quantity",
            "type": "string"
          }
        },
        "required": [
          "path",
          "code",
          "message"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "customer": {
        "bearerFormat": "JWT",
        "description": "Access token with `aud=customer` — `/v1/store/*`",
        "scheme": "bearer",
        "type": "http"
      },
      "partner": {
        "bearerFormat": "JWT",
        "description": "Access token with `aud=partner` — `/v1/partner/*` (users and client-credentials)",
        "scheme": "bearer",
        "type": "http"
      },
      "staff": {
        "bearerFormat": "JWT",
        "description": "Access token with `aud=staff` — `/v1/admin/*`",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "Packio — Your Packaging Production Partner (Collective Group (Thailand)). Conventions: docs/contract/api-conventions.md. Errors are RFC 9457 problem details.",
    "title": "Packio API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "Health_check",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "All dependencies are up"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "A dependency is down (`service.unavailable`)"
          }
        },
        "tags": [
          "ops.health"
        ]
      }
    }
  },
  "servers": [],
  "tags": []
}
