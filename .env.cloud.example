# getpack-api — Claude Code cloud VM environment (scripts/cloud-setup.sh).
# SAFE VALUES ONLY: no real secret, no real provider credential, no UAT/production host. Every third-party
# provider is the in-memory fake (INTEGRATIONS_MODE=fake), object storage is the on-disk fake, and the
# observability exporters are off. Use: `cp .env.cloud.example .env` (or `set -a; . ./.env.cloud.example`).
# Full documentation of every variable: .env.example and src/config/env.schema.ts.

# --- Runtime -------------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
LOG_PRETTY=true

# --- Integrations: everything fake ------------------------------------------------------------------
INTEGRATIONS_MODE=fake
# Fake object storage (FakeObjectStorage); objects kept on disk so the API and the worker share them.
OBJECT_STORAGE_MODE=fake
FAKE_OBJECT_STORAGE_DIR=/tmp/getpack-fake-object-storage

# --- Data stores (local PostgreSQL 16 + pgvector, local Redis) ---------------------------------------
DATABASE_URL=postgresql://getpack:getpack@localhost:5432/getpack_dev
SHADOW_DATABASE_URL=postgresql://getpack:getpack@localhost:5432/getpack_shadow
REDIS_URL=redis://localhost:6379

# --- AWS: never reached (fake storage, fake secrets) -------------------------------------------------
AWS_REGION=ap-southeast-1
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET=getpack-cloud-fake
S3_FORCE_PATH_STYLE=true
S3_KEY_PREFIX=
AWS_SECRETS_ID=
SES_REGION=
SES_FROM_ADDRESS="getpack-dummy <no-reply@example.invalid>"
CLAMAV_HOST=

# --- HTTP ------------------------------------------------------------------------------------------
# /docs is always on in development.
DOCS_ENABLED=false
DOCS_ALLOWED_CIDRS=
TRUST_PROXY=0
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=300
AUTH_LOGIN_THROTTLE_LIMIT=10

# --- Observability: off ----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=getpack-api

# --- Auth ------------------------------------------------------------------------------------------
# Empty = ephemeral Ed25519 key per process (development).
JWT_SIGNING_KEYS=
# Placeholders: must be >= 32 characters when set. Not secrets.
OTP_HMAC_SECRET=dummy-otp-hmac-secret-not-a-real-secret-0000
LOOKUP_HMAC_SECRET=dummy-lookup-hmac-secret-not-a-real-secret-00
# 32 zero bytes, base64 (obviously fake); shared by the API and the worker so both decrypt the same rows.
FIELD_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
FIREBASE_PROJECT_ID=dummy
LINE_LOGIN_CHANNEL_ID=dummy

# --- Providers: placeholders only (fake adapters ignore them) -----------------------------------
THAIBULKSMS_API_KEY=dummy
THAIBULKSMS_API_SECRET=dummy
THAIBULKSMS_SENDER=dummy
THAIBULKSMS_FORCE=
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=dummy
LINE_MESSAGING_CHANNEL_SECRET=dummy
LINE_MESSAGING_CHANNEL_ID=dummy
VAPID_PUBLIC_KEY=dummy
VAPID_PRIVATE_KEY=dummy
VAPID_SUBJECT=mailto:dummy@example.invalid
PDF_CHROMIUM_PATH=
SCB_API_BASE_URL=http://localhost:9/scb-dummy
SCB_API_KEY=dummy
SCB_API_SECRET=dummy
SCB_BILLER_ID=000000000000000
SCB_REF3_PREFIX=TST
SCB_MERCHANT_ID=dummy
SCB_TERMINAL_ID=dummy
TWOC2P_BASE_URL=http://localhost:9/2c2p-dummy
TWOC2P_API_VERSION=4.3
TWOC2P_MERCHANT_ID=dummy
TWOC2P_SECRET_KEY=dummy
TWOC2P_PAYMENT_ACTION_URL=http://localhost:9/2c2p-dummy
TWOC2P_MERCHANT_PRIVATE_KEY=dummy
TWOC2P_PUBLIC_KEY=dummy
SLIP2GO_API_URL=http://localhost:9/slip2go-dummy
SLIP2GO_SECRET_KEY=dummy

# --- Storefront --------------------------------------------------------------------------------------
STOREFRONT_BASE_URL=http://localhost:3001
# Empty: revalidation tags are only recorded, never POSTed anywhere.
STOREFRONT_REVALIDATE_URL=
STOREFRONT_REVALIDATE_SECRET=dummy
PUBLIC_API_BASE_URL=http://localhost:3000
MERCHANT_FEED_LINK_TEMPLATE=http://localhost:3001/th/products/{sku}

# --- Seeds -------------------------------------------------------------------------------------------
# Obviously fake passwords of the seeded staff users (<role>@example.invalid).
DEV_SEED_PASSWORD=getpack-dev-password
# `pnpm db:seed:uat` opt-in; this VM's database is local and disposable.
UAT_SEED_CONFIRM=uat-only
UAT_SEED_PASSWORD=getpack-dev-password
UAT_INSTANT_TYPES=
# Empty: the UAT seed uses its built-in obviously fake entity (UAT_FAKE_ENTITY).
SEED_ENTITY_CODE=
SEED_ENTITY_DISPLAY_NAME=
SEED_ENTITY_LEGAL_NAME_TH=
SEED_ENTITY_LEGAL_NAME_EN=
SEED_ENTITY_TAX_ID=
SEED_ENTITY_BRANCH_CODE=
SEED_ENTITY_ADDRESS_TH=
SEED_ENTITY_PHONE=
