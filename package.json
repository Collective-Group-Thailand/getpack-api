{
  "name": "packio-api",
  "version": "0.43.1",
  "description": "Packio — Your Packaging Production Partner · backend (NestJS)",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.18.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "build": "nest build",
    "start": "node dist/src/main.js",
    "start:worker": "node dist/src/worker.js",
    "dev": "NODE_OPTIONS=--max-old-space-size=8192 nest start --watch",
    "dev:worker": "NODE_OPTIONS=--max-old-space-size=8192 nest start --watch --entryFile src/worker",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.ts --selectProjects unit",
    "uat:populate": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.ts --selectProjects uat --runInBand",
    "test:int": "NODE_OPTIONS=--max-old-space-size=6144 node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.ts --selectProjects integration --runInBand",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.ts --selectProjects e2e --maxWorkers=1 --workerIdleMemoryLimit=1536MB",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.ts --selectProjects unit --coverage",
    "contract:build": "nest build && node dist/scripts/contract-build.js",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "nest build && node dist/prisma/seed/run.js reference",
    "db:seed:dev": "nest build && node dist/prisma/seed/run.js dev",
    "db:seed:uat": "nest build && node dist/prisma/seed/run.js uat",
    "contract:observed-errors": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/contract-observed-errors.ts",
    "contract:lint": "spectral lint contract/openapi.json --ruleset contract/spectral/.spectral.yaml --fail-severity warn",
    "rbac:build": "nest build && node dist/scripts/rbac-build.js",
    "launch:settings": "nest build && node dist/scripts/launch-settings-build.js",
    "release:check": "nest build && node dist/scripts/release-hygiene.js",
    "styles:import": "nest build && node dist/scripts/styles-import.js",
    "cms:home-photos": "nest build && node dist/scripts/cms-home-photos.js",
    "dieline:vendor": "bash scripts/dieline-vendor.sh",
    "styles:recipes-from-engine": "nest build && node dist/scripts/styles-recipes-from-engine.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1138.0",
    "@aws-sdk/client-secrets-manager": "^3.1138.0",
    "@aws-sdk/client-sesv2": "^3.1138.0",
    "@aws-sdk/s3-request-presigner": "^3.1138.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.0.4",
    "@nestjs/core": "^12.0.4",
    "@nestjs/platform-express": "^12.0.4",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.0",
    "@node-rs/argon2": "^2.2.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@scalar/api-reference": "^1.71.0",
    "@scalar/nestjs-api-reference": "^1.2.21",
    "@sentry/nestjs": "^10.75.2",
    "ajv": "^8.20.0",
    "bullmq": "^6.3.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "decimal.js": "^10.6.0",
    "dotenv": "^18.0.3",
    "exceljs": "^4.4.0",
    "express": "5.2.1",
    "handlebars": "^4.7.9",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "mjml": "^5.4.1",
    "nestjs-i18n": "^10.8.5",
    "nestjs-pino": "^5.2.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "puppeteer-core": "^24.43.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.5",
    "@nestjs/schematics": "^12.0.5",
    "@nestjs/testing": "^12.0.4",
    "@stoplight/spectral-cli": "^6.16.3",
    "@stoplight/spectral-core": "^1.23.1",
    "@stoplight/spectral-parsers": "^1.0.5",
    "@stoplight/spectral-ruleset-bundler": "^1.7.0",
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@testcontainers/postgresql": "^12.1.0",
    "@testcontainers/redis": "^12.1.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/mjml": "^5.0.0",
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "fast-check": "^4.10.2",
    "jest": "^30.5.2",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "prisma": "7.10.0",
    "supertest": "^7.3.0",
    "testcontainers": "^12.1.0",
    "ts-node": "^10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma",
      "@swc/core",
      "protobufjs",
      "msgpackr-extract",
      "@parcel/watcher",
      "cpu-features",
      "ssh2",
      "unrs-resolver"
    ]
  }
}
