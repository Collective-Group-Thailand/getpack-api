# packio-api environment. Copy to `.env` for local development (`cp .env.example .env`).
# Every variable is validated at start-up (src/config/env.schema.ts); the process exits listing
# every invalid variable. Business values are NOT configured here — they are effective-dated
# settings in the database (ADR-0005).

# --- Runtime -------------------------------------------------------------------------------------
# development | test | production
NODE_ENV=development
# HTTP port of the API process.
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Human-readable single-line logs (development only; production logs are JSON).
LOG_PRETTY=true

# --- Integrations --------------------------------------------------------------------------------
# fake = in-memory fakes for every third-party provider (tests, `pnpm dev`, contract build).
# real = AWS and providers. Must be `real` when NODE_ENV=production.
INTEGRATIONS_MODE=fake

# --- Data stores (docker-compose.yml) --------------------------------------------------------------
# PostgreSQL 18 + pgvector.
DATABASE_URL=postgresql://packio:packio@localhost:5432/packio
# Shadow database for `prisma migrate dev` / drift checks (created by docker/postgres/init-shadow-db.sql).
SHADOW_DATABASE_URL=postgresql://packio:packio@localhost:5432/packio_shadow
# Redis: BullMQ, idempotency keys, caches.
REDIS_URL=redis://localhost:6379

# --- AWS (LocalStack in development) ----------------------------------------------------------------
AWS_REGION=ap-southeast-1
# Custom endpoint for LocalStack; leave empty for real AWS.
AWS_ENDPOINT_URL=http://localhost:4566
# LocalStack dummy credentials (real deployments use the task/instance role — never keys in env).
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# Private bucket for artwork, proofs, documents.
S3_BUCKET=packio-dev
# Path-style URLs (required by LocalStack).
S3_FORCE_PATH_STYLE=true
# Optional Secrets Manager secret (JSON object of VAR=value) loaded before validation.
# Explicit environment variables win over secret values. Ignored when INTEGRATIONS_MODE=fake.
AWS_SECRETS_ID=

# --- HTTP ------------------------------------------------------------------------------------------
# API docs: /docs (Scalar), /docs/swagger, /docs-json, /docs.yaml (contract §5).
# development/test: always on. production: only when DOCS_ENABLED=true AND the caller IP is in
# DOCS_ALLOWED_CIDRS (comma-separated IPs/CIDRs; empty = nobody). Staff-token access arrives in B1.3.
DOCS_ENABLED=false
DOCS_ALLOWED_CIDRS=
# Reverse-proxy hops in front of the API (Express `trust proxy`) so client IPs are real — used by
# rate limiting and the docs allow-list. 0 locally; typically 1 behind a single load balancer.
TRUST_PROXY=0
# Global rate limit per client: THROTTLE_LIMIT requests per THROTTLE_TTL_SECONDS.
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=300
# Sign-in attempts per IP per minute (password, OTP verify, client credentials).
AUTH_LOGIN_THROTTLE_LIMIT=10

# --- Observability ---------------------------------------------------------------------------------
# Sentry DSN; empty disables Sentry. PII is never sent.
SENTRY_DSN=
# Share of requests traced by Sentry (0–1).
SENTRY_TRACES_SAMPLE_RATE=0
# OTLP/HTTP collector base URL (e.g. http://localhost:4318); empty disables OpenTelemetry export.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Service name on traces and logs (the worker appends "-worker").
OTEL_SERVICE_NAME=packio-api

# --- Auth (ADR-0004) --------------------------------------------------------------------------
# JSON array of Ed25519 private JWKs with `kid`; first signs, others verify (rotation).
# Required in production (from Secrets Manager); empty in dev/test = ephemeral key per process.
JWT_SIGNING_KEYS=
# HMAC key for OTP codes, at least 32 characters. Required in production.
OTP_HMAC_SECRET=
# Firebase project for Google/Apple ID-token exchange (customer login).
FIREBASE_PROJECT_ID=
# LINE Login channel id (LIFF uses the same channel).
LINE_LOGIN_CHANNEL_ID=
# ThaiBulkSMS credentials and sender name (customer OTP; critical SMS, D-143).
THAIBULKSMS_API_KEY=
THAIBULKSMS_API_SECRET=
THAIBULKSMS_SENDER=

# --- Seeds (`pnpm db:seed`) -------------------------------------------------------------------------
# The reference seed creates the issuing legal entity (D-092). Company data is never hard-coded: set
# these from the company's official registration. Required: code and display name; the legal fields
# become entity-scoped settings (a superadmin can also enter them later). `pnpm db:seed:dev` ignores
# them and uses an obviously fake entity instead.
# `pnpm db:seed:dev` only (refuses to run in production): password of the fake staff users
# <role>@example.invalid. Obviously fake, for local development.
DEV_SEED_PASSWORD=packio-dev-password

SEED_ENTITY_CODE=
SEED_ENTITY_DISPLAY_NAME=
SEED_ENTITY_LEGAL_NAME_TH=
SEED_ENTITY_LEGAL_NAME_EN=
# 13 digits.
SEED_ENTITY_TAX_ID=
# 00000 = head office.
SEED_ENTITY_BRANCH_CODE=
